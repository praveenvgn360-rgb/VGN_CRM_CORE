@{
    ViewBag.Title = "Indent Request — VGN ERP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ═══════════════════════════════════════════════════════════════════════
       ERP ADAPTIVE THEME SYSTEM (Light / Dark / High-Contrast / Font-Scale)
       ═══════════════════════════════════════════════════════════════════════ */
    :root {
        --erp-primary: var(--primary, #0088cc);
        --erp-primary-rgb: var(--primary-rgb, 0, 136, 204);
        --erp-primary-hover: var(--primary, #0077b3);
        --erp-primary-light: rgba(var(--primary-rgb, 0, 136, 204), 0.1);
        --erp-surface: var(--surface, #ffffff);
        --erp-surface-secondary: #f8fafc;
        --erp-surface-tertiary: #f1f5f9;
        --erp-border: var(--border, #e2e8f0);
        --erp-border-strong: #cbd5e1;
        --erp-text: var(--text, #0f172a);
        --erp-text-muted: var(--text-muted, #64748b);
        --erp-shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        --erp-shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
    }

    [data-theme="dark"], .dark {
        --erp-surface: var(--surface, #1e293b);
        --erp-surface-secondary: #0f172a;
        --erp-surface-tertiary: #162032;
        --erp-border: var(--border, #334155);
        --erp-border-strong: #475569;
        --erp-text: var(--text, #f8fafc);
        --erp-text-muted: var(--text-muted, #94a3b8);
        --erp-primary-light: rgba(var(--primary-rgb, 56, 189, 248), 0.15);
        --erp-shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.3);
        --erp-shadow-md: 0 4px 10px rgba(0, 0, 0, 0.4);
    }

    [data-contrast="high"] {
        --erp-border: #64748b;
        --erp-border-strong: #1e293b;
    }

    [data-contrast="high"][data-theme="dark"], [data-contrast="high"].dark {
        --erp-border: #94a3b8;
        --erp-border-strong: #f1f5f9;
    }

    .erp-card {
        background-color: var(--erp-surface);
        border: 1px solid var(--erp-border);
        border-radius: 12px;
        box-shadow: var(--erp-shadow-sm);
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .erp-header-bg {
        background: linear-gradient(180deg, #eaf4fb 0%, #d8ebf8 100%);
        color: #0b3d64;
        border-bottom: 2px solid #b2d2ec;
    }

    .dark .erp-header-bg, [data-theme="dark"] .erp-header-bg {
        background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
        color: #38bdf8;
        border-bottom: 2px solid #334155;
    }

    .btn-theme {
        background-color: var(--erp-primary) !important;
        color: #ffffff !important;
        font-weight: 600 !important;
        transition: all 0.15s ease-in-out;
        border: 1px solid rgba(0, 0, 0, 0.15) !important;
        box-shadow: 0 2px 6px rgba(var(--erp-primary-rgb), 0.35) !important;
    }
    .btn-theme:hover {
        filter: brightness(0.92);
        color: #ffffff !important;
        box-shadow: 0 4px 10px rgba(var(--erp-primary-rgb), 0.45) !important;
    }

    .btn-modal-save {
        background-color: var(--erp-primary) !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        border: 1px solid rgba(0, 0, 0, 0.15) !important;
        box-shadow: 0 3px 8px rgba(var(--erp-primary-rgb), 0.35) !important;
        transition: all 0.15s ease-in-out;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    .btn-modal-save:hover {
        filter: brightness(0.92);
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(var(--erp-primary-rgb), 0.5) !important;
    }

    .btn-modal-cancel {
        background-color: var(--erp-surface) !important;
        color: var(--erp-text) !important;
        font-weight: 600 !important;
        border: 1px solid var(--erp-border-strong) !important;
        transition: all 0.15s ease-in-out;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    .btn-modal-cancel:hover {
        background-color: var(--erp-surface-secondary) !important;
    }

    .drawer-panel {
        background-color: var(--erp-surface-secondary);
        border-top: 1px solid var(--erp-border);
        border-bottom: 2px solid var(--erp-border-strong);
    }

    .iow-card {
        background-color: var(--erp-surface);
        border: 1px solid var(--erp-border);
        border-radius: 10px;
        box-shadow: var(--erp-shadow-sm);
        transition: border-color 0.15s;
    }
    .iow-card:hover {
        border-color: var(--erp-primary);
    }

    .erp-input {
        background-color: var(--erp-surface);
        border: 1px solid var(--erp-border);
        color: var(--erp-text);
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .erp-input:focus {
        border-color: var(--erp-primary) !important;
        box-shadow: 0 0 0 2px rgba(var(--erp-primary-rgb), 0.2) !important;
        outline: none;
    }

    /* Custom scrollbars */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.03);
        border-radius: 4px;
    }
    .dark .custom-scrollbar::-webkit-scrollbar-track, [data-theme="dark"] .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.03);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }
    .dark .custom-scrollbar::-webkit-scrollbar-thumb, [data-theme="dark"] .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #475569;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    /* Select2 Container sizing & responsive theme compatibility */
    .select2-container {
        width: 100% !important;
    }
    .select2-container--default .select2-selection--single {
        height: 32px !important;
        display: flex;
        align-items: center;
        border-radius: 6px;
        border: 1px solid var(--erp-border) !important;
        background-color: var(--erp-surface) !important;
        color: var(--erp-text) !important;
        font-size: 12px;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 30px !important;
        padding-left: 8px;
        padding-right: 20px;
        color: var(--erp-text) !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 30px !important;
    }
    .select2-dropdown {
        background-color: var(--erp-surface) !important;
        border: 1px solid var(--erp-border-strong) !important;
        color: var(--erp-text) !important;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
        border-radius: 8px !important;
        z-index: 1000000 !important;
    }
    .select2-search__field {
        background-color: var(--erp-surface-secondary) !important;
        border: 1px solid var(--erp-border) !important;
        color: var(--erp-text) !important;
        border-radius: 6px !important;
        font-size: 12px !important;
    }
    .select2-results__option {
        color: var(--erp-text) !important;
        font-size: 12px !important;
        padding: 6px 10px !important;
    }
    .select2-results__option--highlighted[aria-selected] {
        background-color: var(--erp-primary) !important;
        color: #ffffff !important;
    }

    /* Screen Adaptation helpers */
    @@media (max-width: 640px) {
        .sticky-summary-actions {
            width: 100%;
            justify-content: stretch;
        }
        .sticky-summary-actions button {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<div class="w-full max-w-[1720px] mx-auto px-2 sm:px-4 lg:px-6 py-3 space-y-4 font-sans text-slate-800 dark:text-slate-100">

    <!-- ═══════════════════════════════════════════════════════════════════════
         VIEW 1 — INDENT REQUEST LIST SCREEN (DevExtreme DataGrid)
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="viewIndentList" class="space-y-4">
        <!-- Header Bar -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-[var(--erp-surface)] p-4 sm:p-5 rounded-2xl shadow-sm border border-[var(--erp-border)]">
            <div class="flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-[#0088cc] dark:text-sky-400 text-xl shadow-xs">
                    <i class="fas fa-clipboard-list"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2.5">
                        <h1 class="text-xl font-bold tracking-tight text-slate-800 dark:text-slate-100">Indent Request</h1>
                        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20" id="badgeTotalIndent">
                            0 Requests
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Resource-first requisition flow with IOW allocations, WBS breakdowns, and auto-summed quantities</p>
                </div>
            </div>

            <!-- Top Action Buttons -->
            <div class="flex items-center gap-2.5 w-full md:w-auto justify-end flex-wrap">
                <button type="button" onclick="loadIndentGrid()" class="px-3.5 py-2 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Refresh List">
                    <i class="fas fa-sync-alt text-slate-500"></i>
                    <span>Refresh</span>
                </button>
                <button type="button" onclick="openNewIndentForm()" class="btn-theme px-4 py-2 rounded-lg text-xs flex items-center gap-2 shadow-md cursor-pointer transition transform active:scale-95">
                    <i class="fas fa-plus font-bold"></i>
                    <span>New Indent Request</span>
                </button>
            </div>
        </div>

        <!-- Summary Stats Strip -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 sm:gap-4">
            <div class="bg-[var(--erp-surface)] border border-[var(--erp-border)] rounded-xl p-4 flex items-center justify-between shadow-2xs">
                <div>
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Total Requests</span>
                    <span class="text-2xl font-black text-slate-800 dark:text-slate-100 mt-1 block" id="statTotalRequests">0</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-sky-500/10 text-[#0088cc] flex items-center justify-center text-lg">
                    <i class="fas fa-file-invoice"></i>
                </div>
            </div>
            <div class="bg-[var(--erp-surface)] border border-[var(--erp-border)] rounded-xl p-4 flex items-center justify-between shadow-2xs">
                <div>
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Total Items Indented</span>
                    <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1 block" id="statTotalItems">0</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-lg">
                    <i class="fas fa-cubes"></i>
                </div>
            </div>
            <div class="bg-[var(--erp-surface)] border border-[var(--erp-border)] rounded-xl p-4 flex items-center justify-between shadow-2xs">
                <div>
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Active Status</span>
                    <span class="text-2xl font-black text-blue-600 dark:text-blue-400 mt-1 block" id="statActiveRequests">0</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center text-lg">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
        </div>

        <!-- DevExtreme DataGrid Card -->
        <div class="bg-[var(--erp-surface)] border border-[var(--erp-border)] rounded-xl shadow-xs p-4 sm:p-5">
            <div id="dxGridIndent"></div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VIEW 2 — INDENT REQUEST ENTRY / EDIT FORM
         Resource -> IOW -> Multiple WBS Allocation Hierarchy
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="viewIndentForm" style="display: none;" class="space-y-4">
        <!-- Navigation Header Bar -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 p-3.5 sm:p-4 rounded-xl shadow-2xs border border-[var(--erp-border)] bg-[var(--erp-surface)]">
            <div class="flex items-center gap-3 flex-wrap">
                <button type="button" onclick="switchToIndentList()" class="px-3.5 py-1.5 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                    <i class="fas fa-arrow-left text-xs"></i>
                    <span>Back to List</span>
                </button>
                <div class="h-4 w-[1px] bg-slate-300 dark:bg-slate-600 hidden sm:block"></div>
                <span class="text-sm font-bold text-sky-700 dark:text-sky-400 flex items-center gap-2" id="lblIndentFormTitle">
                    <i class="fas fa-edit text-xs"></i>
                    <span>Request for Creation - Indent Request Add</span>
                </span>
                <span id="badgeEditMode" class="hidden text-xs font-bold px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 border border-amber-500/20">Edit Mode</span>
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                <button type="button" onclick="switchToIndentList()" class="px-4 py-1.5 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-600 transition cursor-pointer">
                    Cancel
                </button>
                <button type="button" onclick="saveIndentRequest()" class="btn-modal-save px-5 py-1.5 rounded-lg text-xs font-bold text-white shadow-md flex items-center gap-1.5 cursor-pointer transition transform active:scale-95">
                    <i class="fas fa-save text-xs"></i>
                    <span>Save Indent</span>
                </button>
            </div>
        </div>

        <!-- Master Section Card (Project_IndentRequestMas) -->
        <div class="erp-card p-4 sm:p-5 space-y-4">
            <input type="hidden" id="hdnIndentMasId" value="0" />
            <input type="hidden" id="hdnCostcenterId" value="" />
            <input type="hidden" id="hdnProectKickOfId" value="" />

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">
                <!-- Cost Centre / Project -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                        <i class="fas fa-building text-sky-500 mr-1"></i> Cost Centre / Project <span class="text-rose-500">*</span>
                    </label>
                    <select id="ddlProject" class="select2 w-full text-xs">
                        <option value="">-- Select Cost Centre --</option>
                    </select>
                </div>

                <!-- Request Type -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                        <i class="fas fa-tags text-indigo-500 mr-1"></i> Request Type <span class="text-rose-500">*</span>
                    </label>
                    <select id="ddlRequestType" class="select2 w-full text-xs">
                        <option value="Material" selected>Material</option>
                        <option value="Service">Service</option>
                        <option value="Machinery">Machinery / Equipment</option>
                        <option value="Consumables">Consumables</option>
                        <option value="Labour">Labour</option>
                    </select>
                </div>

                <!-- Request No (Auto-generated) -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                        <i class="fas fa-hashtag text-slate-400 mr-1"></i> Request No
                    </label>
                    <input type="text" id="txtRequestNo" readonly placeholder="Auto-generated" class="w-full text-xs font-bold px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-100 dark:bg-slate-900/80 text-sky-700 dark:text-sky-300 focus:outline-none cursor-not-allowed font-mono" />
                </div>

                <!-- Required Date / Date & Time -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                        <i class="fas fa-calendar-alt text-amber-500 mr-1"></i> Required Date <span class="text-rose-500">*</span>
                    </label>
                    <input type="date" id="txtMasterRequiredDate" class="w-full text-xs font-semibold px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-sky-500 erp-input" />
                </div>
            </div>

            <!-- Master Remarks -->
            <div>
                <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                    <i class="fas fa-comment-alt text-emerald-500 mr-1"></i> Overall Requisition Remarks / General Notes
                </label>
                <input type="text" id="txtMainRemarks" placeholder="Enter requisition notes or site delivery instructions..." class="w-full text-xs px-3.5 py-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-[#f8fafc] dark:bg-slate-900/60 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-sky-500 erp-input" />
            </div>
        </div>

        <!-- Detail Section: Enter Request Quantity (Resource -> IOW -> WBS) -->
        <div class="erp-card shadow-md overflow-hidden flex flex-col">
            <!-- Toolbar -->
            <div class="erp-header-bg px-4 py-2.5 flex items-center justify-between flex-wrap gap-2.5 flex-shrink-0">
                <div class="flex items-center gap-2.5">
                    <span class="font-bold text-xs uppercase tracking-wide flex items-center gap-1.5">
                        <i class="fas fa-layer-group text-sm"></i>
                        <span>Enter Request Quantity</span>
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full bg-white dark:bg-slate-800 text-sky-700 dark:text-sky-300 font-bold text-[11px] shadow-2xs" id="badgeItemCount">0 Resources</span>
                </div>

                <div class="flex items-center gap-2">
                    <button type="button" onclick="openResourcePickerModal()" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-[#1b4965] hover:bg-[#133549] text-white shadow-2xs flex items-center gap-1.5 cursor-pointer transition transform active:scale-95" title="Search & Multi-select materials from Resource Master">
                        <i class="fas fa-boxes text-xs"></i>
                        <span>Add Resource</span>
                    </button>
                    <button type="button" onclick="addNewResourceRow()" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-2xs flex items-center gap-1.5 cursor-pointer transition transform active:scale-95" title="Add blank single row">
                        <i class="fas fa-plus text-xs"></i>
                        <span>Add Row</span>
                    </button>
                    <button type="button" onclick="clearAllResourceRows()" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition cursor-pointer" title="Clear all rows">
                        <i class="fas fa-trash-alt mr-1"></i> Clear All
                    </button>
                </div>
            </div>

            <!-- Material Table Container -->
            <div class="overflow-x-auto overflow-y-auto custom-scrollbar flex-1" style="max-height: 65vh; min-height: 280px;">
                <table id="tblIndentItems" class="w-full border-collapse text-xs table-fixed">
                    <thead class="sticky top-0 z-20 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold border-b border-slate-300 dark:border-slate-700 shadow-xs">
                        <tr>
                            <th class="w-12 px-2 py-3 text-center">#</th>
                            <th class="min-w-[280px] px-3 py-3 text-left">Description / Resource <span class="text-rose-500">*</span></th>
                            <th class="w-36 px-2.5 py-3 text-left">Brand / Spec</th>
                            <th class="w-36 px-2.5 py-3 text-right">Qty (From WBS) <span class="text-rose-500">*</span></th>
                            <th class="w-24 px-2 py-3 text-center">Unit <span class="text-rose-500">*</span></th>
                            <th class="w-32 px-2.5 py-3 text-left">Required Date <span class="text-rose-500">*</span></th>
                            <th class="w-48 px-2.5 py-3 text-left">Remarks</th>
                            <th class="w-28 px-1 py-3 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblIndentItemsBody" class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-900">
                        <!-- Populated by JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Sticky Bottom Summary & Action Bar -->
            <div class="sticky bottom-0 z-30 p-3 sm:p-4 bg-white/95 dark:bg-slate-800/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-700 shadow-[0_-6px_20px_rgba(0,0,0,0.08)] flex items-center justify-between flex-wrap gap-3 flex-shrink-0">
                <div class="flex items-center gap-2.5 flex-wrap">
                    <div class="px-3 py-1.5 rounded-lg bg-sky-50 dark:bg-slate-700 border border-sky-200 dark:border-slate-600 text-xs font-bold text-sky-800 dark:text-sky-300 flex items-center gap-1.5 shadow-2xs">
                        <i class="fas fa-cubes text-sky-600"></i>
                        <span>Materials:</span>
                        <strong id="lblSummaryTotalRes" class="font-black text-sky-700 dark:text-sky-300">0</strong>
                    </div>
                    <div class="px-3 py-1.5 rounded-lg bg-indigo-50 dark:bg-slate-700 border border-indigo-200 dark:border-slate-600 text-xs font-bold text-indigo-800 dark:text-indigo-300 flex items-center gap-1.5 shadow-2xs">
                        <i class="fas fa-sitemap text-indigo-600"></i>
                        <span>IOWs:</span>
                        <strong id="lblSummaryTotalIow" class="font-black text-indigo-700 dark:text-indigo-300">0</strong>
                    </div>
                    <div class="px-3.5 py-1.5 rounded-lg bg-emerald-50 dark:bg-slate-700 border border-emerald-200 dark:border-slate-600 text-xs font-bold text-emerald-800 dark:text-emerald-300 flex items-center gap-2 shadow-2xs">
                        <i class="fas fa-calculator text-emerald-600"></i>
                        <span>Total Allocated Qty:</span>
                        <strong id="lblSummaryGrandQty" class="font-mono text-sm font-black text-emerald-700 dark:text-emerald-300">0.00</strong>
                    </div>
                </div>

