                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase block">Cost Centre</span>
                        <span class="font-bold text-slate-800 dark:text-slate-100" id="modalProject">—</span>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase block">Request Type</span>
                        <span class="font-bold text-slate-800 dark:text-slate-100" id="modalType">—</span>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase block">Date &amp; Time</span>
                        <span class="font-bold text-slate-800 dark:text-slate-100" id="modalDate">—</span>
                    </div>
