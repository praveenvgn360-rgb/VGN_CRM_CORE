@{
    ViewBag.Title = "Stage Payment Due Report - VGN ERP";
}

<style>
    /* Tabs */
    .tab-btn {
        transition: all 0.3s ease;
    }
    .tab-btn.active {
        border-bottom-color: var(--primary);
        color: var(--primary);
    }
    .tab-btn:hover:not(.active) {
        color: var(--primary);
        border-bottom-color: var(--primary);
        opacity: 0.7;
    }

    /* Content Sections */
    .content-section {
        display: none;
        animation: fadeIn 0.5s ease;
    }
    .content-section.active {
        display: block;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    /* ── Loader overlay ── */
    .sa-loader-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 1rem;
    }

    .sa-loader-overlay.show {
        display: flex;
    }

    .sa-loader-overlay .spinner-ring {
        width: 60px;
        height: 60px;
        border: 5px solid rgba(255,255,255,.25);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: sa-spin .8s linear infinite;
    }

    .sa-loader-overlay .msg {
        color: #fff;
        font-size: .92rem;
        font-weight: 600;
        letter-spacing: .3px;
    }

    @@keyframes sa-spin {
        to { transform: rotate(360deg); }
    }
    
    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--border, #cbd5e1); border-radius: 10px; }

    /* Layout Specifics */
    .stat-card-input {
        background: transparent; border: 0; padding: 0; outline: none;
        font-weight: 900; font-size: 1.25rem; line-height: 1; text-align: right;
        color: var(--text);
    }
    .stat-card-input:focus { outline: none; box-shadow: none; }
    
    /* Theme Integration */
    .theme-card {
        background-color: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
    }
    .theme-text {
        color: var(--text);
    }
    .theme-text-muted {
        color: var(--text-muted);
    }
    .theme-bg {
        background-color: var(--bg);
    }

    #txtBalValue, #txtTotCum, #txtRecvdCum, #txtBalCum {
        color: #ea580c !important; /* Tailwind orange-600 */
    }

    #gridContainer, #gridCumulativeNew, #modal_grid {
        height: 380px;
    }

    .balance-highlight .dx-datagrid-text-content {
        text-align: right;
    }
</style>

<input type="hidden" id="HEmpId" value="@Context.Request.Query["EmpID"]" />
<input type="hidden" id="HMonthValue" value="@Context.Request.Query["Month"]" />


<!-- Loader -->
<div class="sa-loader-overlay" id="loader">
    <div class="spinner-ring"></div>
    <div class="msg">Loading Data, Please Wait...</div>
</div>

<!-- Tabs and Buttons -->
<div class="flex border-b border-gray-200 dark:border-gray-700 mb-6 overflow-x-auto">
    <button id="tab_StageWise" class="tab-btn active px-4 py-2 border-b-2 font-medium text-sm border-primary text-primary whitespace-nowrap" data-section="divStagepayment">
        <i class="bi bi-file-earmark-bar-graph me-2"></i>STAGE PAYMENT DUE REPORT
    </button>
    <button id="tab_Abstract" class="tab-btn px-4 py-2 border-b-2 border-transparent font-medium text-sm text-gray-500 whitespace-nowrap" data-section="divAbstract">
        <i class="bi bi-file-earmark-spreadsheet me-2"></i>ABSTRACT REPORT
    </button>
    <button id="tab_Cumulative" class="tab-btn px-4 py-2 border-b-2 border-transparent font-medium text-sm text-gray-500 whitespace-nowrap" data-section="divCumulative">
        <i class="bi bi-file-earmark-ruled me-2"></i>CUMULATIVE DUE REPORT
    </button>
    
    <div class="ml-auto flex items-center gap-2 pl-4 pb-1">
        <button type="button" class="btn-clear flex items-center justify-center py-1.5 px-3 h-[32px] text-xs font-semibold rounded-md transition-colors" id="btn_clear">
            <i class="bi bi-eraser mr-1"></i> CLEAR
        </button>
        <button type="button" class="btn-load flex items-center justify-center py-1.5 px-3 h-[32px] text-xs font-semibold rounded-md transition-colors" id="btn_refresh">
            <i class="bi bi-arrow-repeat mr-1"></i> LOAD
        </button>
        <button type="button" class="btn-load hidden flex items-center justify-center py-1.5 px-3 h-[32px] text-xs font-semibold rounded-md transition-colors" id="btn_CumLoad">
            <i class="bi bi-arrow-repeat mr-1"></i> LOAD
        </button>
    </div>
</div>

<!-- STAGE PAYMENT DUE SECTION -->
<div id="divStagepayment" class="content-section active">
    <div class="theme-card rounded-2xl shadow-sm p-5 mb-5 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

        <div class="flex justify-between items-center mb-4 pb-3 border-b relative z-10" style="border-color: var(--border);">
            <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                    <i class="bi bi-table"></i>
                </div>
                <h3 class="font-bold theme-text uppercase text-sm tracking-wider">TOTAL : <span id="grid_count" class="text-primary font-black ml-1">0</span></h3>
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold theme-text-muted theme-bg border px-3 py-1.5 rounded-lg shadow-inner" style="border-color: var(--border);">
                <span>BALANCE AMOUNT:</span>
                <span id="txtBalValue" class="font-black text-base leading-none"></span>
            </div>
        </div>

        <div class="w-full custom-scrollbar relative z-10">
            <div id="gridContainer"></div>
            <div id="loadingPanel"></div>
        </div>
    </div>
</div>

<!-- ABSTRACT REPORT SECTION -->
<div id="divAbstract" class="content-section">
    <!-- Stagewise Abstract -->
    <div class="theme-card rounded-2xl shadow-sm p-5 mb-5 relative overflow-hidden">
        <div class="flex justify-between items-center mb-4 pb-3 border-b relative z-10" style="border-color: var(--border);">
            <h3 class="font-bold theme-text uppercase text-sm tracking-wider flex items-center gap-2">
                <i class="bi bi-bar-chart-steps text-primary"></i>
                STAGEWISE ABSTRACT
            </h3>
            <div class="flex items-center gap-2 text-xs font-semibold theme-text-muted theme-bg border px-3 py-1.5 rounded-lg shadow-inner" style="border-color: var(--border);">
                <span>ROW COUNT:</span>
                <span id="grid_countStage" class="text-primary font-black text-base leading-none">0</span>
            </div>
        </div>
        <div id="gridStageWise" class="w-full custom-scrollbar relative z-10"></div>
    </div>

    <!-- Amountwise Abstract -->
    <div class="theme-card rounded-2xl shadow-sm p-5 mb-5 relative overflow-hidden">
        <div class="flex justify-between items-center mb-4 pb-3 border-b relative z-10" style="border-color: var(--border);">
            <h3 class="font-bold theme-text uppercase text-sm tracking-wider flex items-center gap-2">
                <i class="bi bi-cash-stack text-primary"></i>
                AMOUNTWISE ABSTRACT
            </h3>
            <div class="flex items-center gap-2 text-xs font-semibold theme-text-muted theme-bg border px-3 py-1.5 rounded-lg shadow-inner" style="border-color: var(--border);">
                <span>ROW COUNT:</span>
                <span id="grid_countAmount" class="text-primary font-black text-base leading-none">0</span>
            </div>
        </div>
        <div id="gridContainerAmountWise" class="w-full custom-scrollbar relative z-10"></div>
    </div>

    <!-- Projectwise Abstract -->
    <div class="theme-card rounded-2xl shadow-sm p-5 mb-5 relative overflow-hidden">
        <div class="flex justify-between items-center mb-4 pb-3 border-b relative z-10" style="border-color: var(--border);">
            <h3 class="font-bold theme-text uppercase text-sm tracking-wider flex items-center gap-2">
                <i class="bi bi-building text-primary"></i>
                PROJECTWISE ABSTRACT
            </h3>
            <div class="flex items-center gap-2 text-xs font-semibold theme-text-muted theme-bg border px-3 py-1.5 rounded-lg shadow-inner" style="border-color: var(--border);">
                <span>ROW COUNT:</span>
                <span id="grid_countProject" class="text-primary font-black text-base leading-none">0</span>
            </div>
        </div>
        <div id="gridContainerProjectWise" class="w-full custom-scrollbar relative z-10"></div>
    </div>
</div>

<!-- CUMULATIVE DUE REPORT SECTION -->
<div id="divCumulative" class="content-section">
    <div class="theme-card rounded-2xl shadow-sm p-5 mb-5 relative overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center mb-5 relative z-10">
            <!-- Radio Buttons -->
            <div class="col-span-1 md:col-span-3">
                <div class="flex theme-bg rounded-lg p-1 border shadow-inner" style="border-color: var(--border);">
                    <label class="flex-1 text-center relative cursor-pointer m-0">
                        <input type="radio" id="inlineRadio1" name="EnquiryType" value="FLAT" checked class="peer sr-only">
                        <div class="py-1.5 text-xs font-bold theme-text-muted rounded-md peer-checked:bg-[var(--surface)] peer-checked:text-primary peer-checked:shadow-sm transition-all duration-200">FLAT</div>
                    </label>
                    <label class="flex-1 text-center relative cursor-pointer m-0">
                        <input type="radio" id="inlineRadio2" name="EnquiryType" value="PLOT" class="peer sr-only">
                        <div class="py-1.5 text-xs font-bold theme-text-muted rounded-md peer-checked:bg-[var(--surface)] peer-checked:text-primary peer-checked:shadow-sm transition-all duration-200">PLOT</div>
                    </label>
                    <label class="flex-1 text-center relative cursor-pointer m-0">
                        <input type="radio" id="inlineRadio3" name="EnquiryType" value="VILLA" class="peer sr-only">
                        <div class="py-1.5 text-xs font-bold theme-text-muted rounded-md peer-checked:bg-[var(--surface)] peer-checked:text-primary peer-checked:shadow-sm transition-all duration-200">VILLA</div>
                    </label>
                </div>
            </div>
            
            <!-- Project Layout Dropdown -->
            <div class="col-span-1 md:col-span-3">
                <select class="select2 form-select w-full" id="dd_ProjectLayout"></select>
            </div>

            <!-- Stats (Total, Received, Balance) -->
            <div class="col-span-1 md:col-span-6 grid grid-cols-3 gap-2">
                <div class="theme-card p-3 rounded-xl border flex flex-col items-center justify-center text-center shadow-sm" style="border-color: var(--border);">
                    <span class="text-[10px] font-bold theme-text-muted uppercase tracking-wider mb-1">TOTAL</span>
                    <span id="txtTotCum" class="font-black text-sm"></span>
                </div>
                <div class="theme-card p-3 rounded-xl border flex flex-col items-center justify-center text-center shadow-sm" style="border-color: var(--border);">
                    <span class="text-[10px] font-bold theme-text-muted uppercase tracking-wider mb-1">RECEIVED</span>
                    <span id="txtRecvdCum" class="font-black text-sm"></span>
                </div>
                <div class="theme-card p-3 rounded-xl border flex flex-col items-center justify-center text-center shadow-sm" style="border-color: var(--border);">
                    <span class="text-[10px] font-bold theme-text-muted uppercase tracking-wider mb-1">BALANCE</span>
                    <span id="txtBalCum" class="font-black text-sm"></span>
                </div>
            </div>
        </div>

        <div class="flex justify-between items-center mb-4 pb-3 border-b relative z-10" style="border-color: var(--border);">
            <h3 class="font-bold theme-text uppercase text-sm tracking-wider flex items-center gap-2">
                <i class="bi bi-list-columns-reverse text-primary"></i>
                Cumulative Data
            </h3>
            <div class="flex items-center gap-2 text-xs font-semibold theme-text-muted theme-bg border px-3 py-1.5 rounded-lg shadow-inner" style="border-color: var(--border);">
                <span>ROW COUNT:</span>
                <span id="grid_countcum" class="text-primary font-black text-base leading-none">0</span>
            </div>
        </div>

        <div class="w-full custom-scrollbar relative z-10">
            <div id="gridCumulativeNew"></div>
            <div id="loadingPanel_1"></div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="cellModal" tabindex="-1" role="dialog" aria-labelledby="cellModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content theme-card border-0 shadow-lg rounded-xl">
            <div class="modal-header border-b" style="border-color: var(--border);">
                <h5 class="modal-title font-bold theme-text uppercase tracking-wider text-sm" id="cellModalLabel">ABSTRACT DETAILS</h5>
                <button type="button" class="close text-gray-500 hover:text-gray-700" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                 <div id="modal_grid"></div>
            </div>
            <div class="modal-footer border-t" style="border-color: var(--border);">
                <button type="button" class="btn btn-secondary py-1.5 px-4 rounded-lg font-medium text-sm transition-colors" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Tab switching logic for the view
            $('.tab-btn').click(function (e) {
                e.preventDefault();
                const section = $(this).data('section');
                
                // Update tabs styling
                $('.tab-btn').removeClass('active border-primary text-primary').addClass('border-transparent text-gray-500');
                $(this).removeClass('border-transparent text-gray-500').addClass('active border-primary text-primary');

                // Switch section display
                $('.content-section').removeClass('active');
                $(`#${section}`).addClass('active');
            });
        });
    </script>
    <script src="~/js/applicationjs/CommonValidation.js"></script>
    <script src="~/js/applicationjs/StagewisePaymentDue.js"></script>
}