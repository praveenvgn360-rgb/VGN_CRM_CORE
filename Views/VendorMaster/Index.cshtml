        function removeBankRow(rowId) {
            const rows = document.querySelectorAll(".bank-entry-row");
            if (rows.length <= 1) {
                showToast("At least one bank account row must remain", "warning");
                return;
            }
            const el = document.getElementById(rowId);
            if (el) {
                const wasDefault = el.querySelector(".bank-default-radio")?.checked;
                el.remove();
                if (wasDefault) {
                    const firstRadio = document.querySelector(".bank-default-radio");
                    if (firstRadio) firstRadio.checked = true;
                }
            }
        }

        function collectBanksData() {
            const list = [];
            const rows = document.querySelectorAll(".bank-entry-row");
            rows.forEach(r => {
                const acNo = r.querySelector(".bank-acno")?.value.trim();
                if (acNo) {
                    list.push({
                        accountHolderName: r.querySelector(".bank-acholder")?.value.trim() || '',
                        accountNo: acNo,
                        accountType: r.querySelector(".bank-actype")?.value || 'Current A/c',
                        bankName: r.querySelector(".bank-name")?.value.trim() || '',
                        branchName: r.querySelector(".bank-brname")?.value.trim() || '',
                        branchCode: r.querySelector(".bank-brcode")?.value.trim() || '',
                        ifscCode: (r.querySelector(".bank-ifsc")?.value.trim() || '').toUpperCase(),
                        micrCode: r.querySelector(".bank-micr")?.value.trim() || '',
                        defaultBank: r.querySelector(".bank-default-radio")?.checked ? 'Yes' : 'No',
                        status: '1'
                    });
                }
            });
            return list;
        }

