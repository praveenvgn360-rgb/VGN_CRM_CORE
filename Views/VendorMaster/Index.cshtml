                    <button type="button" onclick="closeViewModal()" class="btn-cancel !text-xs !py-2 !px-4 cursor-pointer">Close</button>
                    <button type="button" id="btnEditFromView" class="btn-vm-primary !text-xs !py-2 !px-4 text-white cursor-pointer flex items-center gap-1.5">
