                        <button type="button" onclick="closeQuickCategoryModal()" class="btn-cancel !text-xs !py-1.5 !px-3 cursor-pointer">Cancel</button>
                        <button type="button" onclick="submitQuickCategory()" class="btn-vm-primary !text-xs !py-1.5 !px-4 text-white cursor-pointer">Save Category</button>
