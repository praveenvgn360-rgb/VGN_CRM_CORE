</div>

@section Scripts {
    <script>
        // ═══════════════════════════════════════════════════════════════════════
        // VENDOR MASTER CLIENT CONTROLLER (DEVTREME DATAGRID INTEGRATION)
        // ═══════════════════════════════════════════════════════════════════════
        let currentStep = 1;
        let vendorDataCache = [];
        let bankRowCounter = 0;
        let branchRowCounter = 0;
        let gridInstance = null;

        const stepNames = [
            "General Details",
            "Address Details",
            "Contact Details",
            "Statutory & GST",
            "Bank Details",
            "Branch Details"
        ];

        $(document).ready(function () {
            initSelect2Dropdowns();
            initVendorGrid();
            loadDropdownMasters();
            loadVendorData();
            initLiveValidationListeners();
        });

        function initSelect2Dropdowns() {
            if ($.fn.select2) {
                $('.vm-select2').select2({
                    width: '100%',
                    dropdownAutoWidth: true
                });
            }
        }

        function initLiveValidationListeners() {
            // Live clear validation styling as the user types
            $(document).on('input', 'input, textarea', function () {
                const el = this;
                $(el).removeClass('is-invalid shake-err vm-focus-pulse');
                $(el).closest('.vm-input-icon-wrap, .vm-input-code-wrap').removeClass('is-invalid shake-err vm-focus-pulse');
                $(el).siblings('.vm-val-msg').hide();
                $(el).closest('.vm-input-icon-wrap, .vm-input-code-wrap').siblings('.vm-val-msg').hide();
            });

            // Live clear validation styling on select dropdown change
            $(document).on('change', 'select', function () {
                $(this).removeClass('is-invalid shake-err vm-focus-pulse');
                $(this).next('.select2-container').find('.select2-selection').removeClass('is-invalid vm-focus-pulse');
                $(this).siblings('.vm-val-msg').hide();
            });

            // Live auto-uppercase alphanumeric fields
            $(document).on('input', '#txtPanNo', function () {
                this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            });
            $(document).on('input', '#txtGSTIn', function () {
                this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            });
            $(document).on('input', '.bank-ifsc', function () {
                this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            });
        }

        // ── 0. FULL PAGE LOADER HELPERS ───────────────────────────────────────
        function showFullPageLoader(text = "Loading Vendor Management...") {
            const loader = document.getElementById("full-page-loader");
            if (loader) {
                const textEl = loader.querySelector(".loader-text");
                if (textEl) textEl.textContent = text;
                loader.classList.remove("hidden");
            }
        }

        function hideFullPageLoader() {
            const loader = document.getElementById("full-page-loader");
            if (loader) {
                loader.classList.add("hidden");
            }
        }

        // ── 1. DROPDOWN MASTERS LOADER ────────────────────────────────────────
        function loadDropdownMasters() {
            // Load Vendor Types
            $.ajax({
                url: '/VendorMaster/GetVendorTypes',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        const $ddlType = $('#ddlVendorType');
                        $ddlType.empty().append('<option value="">Select Vendor Type</option>');

                        res.data.forEach(t => {
                            $ddlType.append(new Option(t.vendorTypeName, t.vendorTypeId));
                        });
                        $ddlType.trigger('change.select2');
                    }
                },
                error: function (err) {
                    console.error("Error loading types:", err);
                }
            });

            // Load Vendor Categories
            $.ajax({
                url: '/VendorMaster/GetVendorCategories',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        const $ddlCat = $('#ddlVendorCategory');
                        $ddlCat.empty().append('<option value="">Select Vendor Category</option>');

                        res.data.forEach(c => {
                            $ddlCat.append(new Option(c.vendorCategoryName, c.vendorCategoryId));
                        });
                        $ddlCat.trigger('change.select2');
                    }
                },
                error: function (err) {
                    console.error("Error loading categories:", err);
                }
            });
        }

        // ── 2. DEVTREME DATAGRID INITIALIZATION & DATA BINDING ────────────────
        function initVendorGrid() {
            gridInstance = $("#dxGridVendorMaster").dxDataGrid({
                dataSource: [],
                keyExpr: "vendorId",
                showBorders: true,
                showRowLines: true,
                rowAlternationEnabled: true,
                hoverStateEnabled: true,
                columnAutoWidth: true,
                wordWrapEnabled: false,
                allowColumnResizing: true,
                columnResizingMode: "widget",
                allowColumnReordering: true,
                searchPanel: {
                    visible: true,
                    width: 280,
                    placeholder: "Search vendors, GST, PAN..."
                },
                headerFilter: {
                    visible: true
                },
                export: {
                    enabled: true,
                    fileName: "Vendor_Directory_VGN_ERP_" + new Date().toISOString().slice(0, 10)
                },
                paging: {
                    pageSize: 15
                },
                pager: {
                    visible: true,
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 15, 25, 50, 100],
                    showInfo: true,
                    showNavigationButtons: true
                },
                columns: [
                    {
                        caption: "Actions",
                        width: 110,
                        alignment: "center",
                        allowFiltering: false,
                        allowSorting: false,
                        allowExporting: false,
                        cellTemplate: function (container, options) {
                            var vId = options.data.vendorId;
                            var vName = (options.data.vendorName || '').replace(/'/g, "\\'");

                            // Standard Colorful Action Buttons: View = Teal, Edit = Blue, Delete = Rose
                            var $btnView = $(`
                                <button type="button" class="btn-grid-action btn-action-view mr-1" title="View Full Dossier">
                                    <i class="fas fa-eye"></i>
                                </button>
                            `).on('click', function () {
                                viewVendor(vId);
                            });

                            var $btnEdit = $(`
                                <button type="button" class="btn-grid-action btn-action-edit mr-1" title="Edit Vendor">
                                    <i class="fas fa-edit"></i>
                                </button>
                            `).on('click', function () {
                                editVendor(vId);
                            });

                            var $btnDelete = $(`
                                <button type="button" class="btn-grid-action btn-action-delete" title="Deactivate Vendor">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            `).on('click', function () {
                                deleteVendor(vId, vName);
                            });

                            container.append($btnView).append($btnEdit).append($btnDelete);
                        }
                    },
                    {
                        dataField: "vendorCode",
                        caption: "Code",
                        width: 120,
                        cellTemplate: function (container, options) {
                            var code = options.data.vendorCode || '-';
                            $(`<span class="px-2.5 py-1 rounded-md bg-[var(--vm-primary)]/10 text-[var(--vm-primary)] font-mono font-bold text-xs border border-[var(--vm-primary)]/20 shadow-2xs">${code}</span>`).appendTo(container);
                        }
                    },
                    {
                        dataField: "vendorName",
                        caption: "Vendor Name",
                        minWidth: 230,
                        cellTemplate: function (container, options) {
                            var name = options.data.vendorName || '-';
                            var workNature = options.data.workNature ? `<span class="text-[10px] text-[var(--vm-text-muted)] block font-medium mt-0.5"><i class="fas fa-briefcase mr-1 opacity-70"></i>${options.data.workNature}</span>` : '';
                            $(`<div><span class="font-bold text-[var(--vm-text)] text-xs">${name}</span>${workNature}</div>`).appendTo(container);
                        }
                    },
                    {
                        dataField: "vendorTypeName",
                        caption: "Vendor Type",
                        minWidth: 140,
                        cellTemplate: function (container, options) {
                            var type = options.data.vendorTypeName || '-';
                            $(`<span class="font-medium text-[var(--vm-text)] text-xs">${type}</span>`).appendTo(container);
                        }
                    },
                    {
                        dataField: "vendorCategoryName",
                        caption: "Category",
                        minWidth: 140,
                        cellTemplate: function (container, options) {
                            var cat = options.data.vendorCategoryName || '-';
                            $(`<span class="text-[var(--vm-text-muted)] text-xs">${cat}</span>`).appendTo(container);
                        }
                    },
                    {
                        caption: "Location",
                        dataField: "city",
                        minWidth: 140,
                        cellTemplate: function (container, options) {
                            var city = options.data.city || '-';
                            var state = options.data.state || '';
                            $(`<div><span class="font-medium text-xs text-[var(--vm-text)]">${city}</span><span class="text-[10px] text-[var(--vm-text-muted)] block">${state}</span></div>`).appendTo(container);
                        }
                    },
                    {
                        caption: "Contact Info",
                        dataField: "contactPerson",
                        minWidth: 160,
                        cellTemplate: function (container, options) {
                            var person = options.data.contactPerson || '-';
                            var phone = options.data.phoneNumber || options.data.contactNo || '';
                            $(`<div><span class="font-semibold text-xs text-[var(--vm-text)]">${person}</span><span class="text-[10px] text-[var(--vm-text-muted)] block">${phone}</span></div>`).appendTo(container);
                        }
                    },
                    {
                        caption: "GSTIN / PAN",
                        dataField: "gstIn",
                        minWidth: 160,
                        cellTemplate: function (container, options) {
                            var gst = options.data.gstIn;
                            var pan = options.data.panNo ? `<span class="text-[10px] font-mono text-[var(--vm-text-muted)] block">PAN: ${options.data.panNo}</span>` : '';
                            if (gst && gst.trim().length > 0) {
                                $(`<div>
                                    <a href="https://services.gst.gov.in/services/searchtp" target="_blank" rel="noopener noreferrer" class="font-mono font-bold text-xs text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 hover:underline inline-flex items-center gap-1 cursor-pointer" title="Verify Taxpayer on Government GST Portal (Opens in a new tab)">
                                        <span>${gst}</span>
                                        <i class="fas fa-external-link-alt text-[9px] opacity-75"></i>
                                    </a>
                                    ${pan}
                                </div>`).appendTo(container);
                            } else {
                                $(`<div><span class="font-mono text-xs text-[var(--vm-text-muted)]">-</span>${pan}</div>`).appendTo(container);
                            }
                        }
                    },
                    {
                        caption: "Primary Bank",
                        dataField: "primaryBankName",
                        minWidth: 160,
                        cellTemplate: function (container, options) {
                            var bank = options.data.primaryBankName || '-';
                            var ac = options.data.primaryAccountNo ? `<span class="text-[10px] font-mono text-[var(--vm-text-muted)] block">A/c: ${options.data.primaryAccountNo}</span>` : '';
                            $(`<div><span class="font-semibold text-xs text-[var(--vm-text)]">${bank}</span>${ac}</div>`).appendTo(container);
                        }
                    },
                    {
                        dataField: "bankCount",
                        caption: "Banks",
                        width: 75,
                        alignment: "center",
                        cellTemplate: function (container, options) {
                            var count = options.data.bankCount || 0;
                            $(`<span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-900/60">${count}</span>`).appendTo(container);
                        }
                    },
                    {
                        dataField: "branchCount",
                        caption: "Branches",
                        width: 80,
                        alignment: "center",
                        cellTemplate: function (container, options) {
                            var count = options.data.branchCount || 0;
                            $(`<span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-300 dark:border-slate-700">${count}</span>`).appendTo(container);
                        }
                    },
                    {
                        dataField: "status",
                        caption: "Status",
                        width: 95,
                        alignment: "center",
                        cellTemplate: function (container, options) {
                            var isInactive = options.data.status === '0' || (options.data.status || '').toLowerCase() === 'inactive';
                            var badge = isInactive
                                ? `<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-900/60"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Inactive</span>`
                                : `<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/60"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Active</span>`;
                            $(badge).appendTo(container);
                        }
                    }
                ],
                onContentReady: function (e) {
                    if (window.vgnFitGridHeaders) {
                        window.vgnFitGridHeaders(e.element[0]);
                    }
                }
            }).dxDataGrid("instance");
        }

        // ── 3. VENDOR DATA LOADER & KPI STATS ─────────────────────────────────
        function loadVendorData() {
            showFullPageLoader("Fetching Vendor Directory...");

            $.ajax({
                url: '/VendorMaster/GetVendorList',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    hideFullPageLoader();

                    if (!res || !res.success) {
                        showToast(res ? res.message : 'Error loading vendor directory', 'error');
                        return;
                    }

                    vendorDataCache = res.data || [];
                    document.getElementById("badgeVendorCount").innerText = `${vendorDataCache.length} Vendors`;

                    // Update 4 KPI Stat Counters
                    updateKpiStats(vendorDataCache);

                    // Update DevExtreme Grid
                    if (gridInstance) {
                        gridInstance.option("dataSource", vendorDataCache);
                        gridInstance.refresh();
                    }
                },
                error: function (err) {
                    hideFullPageLoader();
                    console.error("Fetch error:", err);
                    showToast("Failed to communicate with server.", "error");
                }
            });
        }

        function updateKpiStats(data) {
            const total = data.length;
            const active = data.filter(v => v.status === '1' || (v.status || '').toLowerCase() === 'active').length;
            const gstRegistered = data.filter(v => (v.gstIn || '').trim().length > 0).length;
            const totalBranches = data.reduce((acc, v) => acc + (v.branchCount || 0), 0);

            document.getElementById("statTotalVendors").innerText = total;
            document.getElementById("statApprovedVendors").innerText = active;
            document.getElementById("statGstVendors").innerText = gstRegistered;
            document.getElementById("statTotalBranches").innerText = totalBranches;
        }

        // ── 4. VIEW TOGGLING ──────────────────────────────────────────────────
        function showListView() {
            document.getElementById("viewVendorWizard").style.display = "none";
            document.getElementById("viewVendorList").style.display = "block";
            document.getElementById("badgeCurrentMode").innerText = "Directory View";
            if (gridInstance) {
                gridInstance.refresh();
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function openCreateVendorWizard() {
            resetWizardForm();
            autoGenerateCode();
            document.getElementById("viewVendorList").style.display = "none";
            document.getElementById("viewVendorWizard").style.display = "block";
            document.getElementById("badgeCurrentMode").innerText = "Create Vendor";
            jumpToStep(1);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ── 5. STEPPER NAVIGATION (UNBLOCKED - VALIDATION ONLY ON FINAL SAVE) ──
        function jumpToStep(targetStep) {
            if (targetStep < 1 || targetStep > 6) return;

            // Hide all panels & update step cards
            for (let i = 1; i <= 6; i++) {
                const panel = document.getElementById(`stepContent${i}`);
                if (panel) panel.style.display = "none";

                const node = document.getElementById(`stepNode${i}`);
                if (node) {
                    node.classList.remove("active");
                    const badge = node.querySelector(".vm-step-badge");
                    const statusText = node.querySelector(".vm-step-status");

                    if (i < targetStep) {
                        // Completed state: Theme-consistent soft tint with checkmark (NO green!)
                        node.classList.add("completed");
                        if (badge) badge.innerHTML = `<i class="fas fa-check text-xs text-white"></i>`;
                        if (statusText) statusText.textContent = "Done";
                    } else if (i === targetStep) {
                        // Active state: Filled with primary theme color
                        node.classList.remove("completed");
                        node.classList.add("active");
                        if (badge) badge.innerText = i;
                        if (statusText) statusText.textContent = "Active";
                    } else {
                        // Pending state
                        node.classList.remove("completed");
                        if (badge) badge.innerText = i;
                        if (statusText) statusText.textContent = "Pending";
                    }
                }
            }

            // Show target panel
            const targetPanel = document.getElementById(`stepContent${targetStep}`);
            if (targetPanel) targetPanel.style.display = "block";

            const targetNode = document.getElementById(`stepNode${targetStep}`);
            if (targetNode) {
                targetNode.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }

            document.getElementById("ddlJumpStep").value = targetStep;
            document.getElementById("lblStepSummary").innerText = `Step ${targetStep} of 6: ${stepNames[targetStep - 1]}`;

            // Adjust back button visibility
            const btnBack = document.getElementById("btnStepBack");
            if (targetStep === 1) {
                btnBack.style.display = "none";
            } else {
                btnBack.style.display = "inline-flex";
            }

            // Adjust Save & Next / Final Button Label
            const btnNext = document.getElementById("btnSaveNext");
            if (targetStep === 6) {
                btnNext.innerHTML = `<span>Save All & Complete</span> <i class="fas fa-check-circle ml-1"></i>`;
            } else {
                btnNext.innerHTML = `<span>Save & Next</span> <i class="fas fa-arrow-right ml-1"></i>`;
            }

            currentStep = targetStep;
            setTimeout(() => {
                $(`#stepContent${targetStep} .vm-select2`).select2({ width: '100%' });
            }, 60);
            window.scrollTo({ top: 120, behavior: 'smooth' });
        }

        function goPreviousStep() {
            if (currentStep > 1) {
                jumpToStep(currentStep - 1);
            }
        }

        // ── 6. COMPREHENSIVE PER-STEP & FULL FORM VALIDATIONS ─────────────────
        function isValidEmail(email) {
            if (!email || typeof email !== 'string') return false;
            const val = email.trim();
            if (val.length < 5 || val.length > 150) return false;
            // Robust standard RFC pattern using Unicode \u0040 to avoid Razor compiler escaping conflicts
            const regex = /^[a-zA-Z0-9._%+-]+[\u0040][a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$/;
            return regex.test(val);
        }

        function validateEmailInput(el) {
            if (!el) return;
            const val = (el.value || '').trim();
            if (val && !isValidEmail(val)) {
                el.classList.add("is-invalid");
                $(el).closest('.vm-input-icon-wrap').addClass("is-invalid");
                $(el).closest('.vm-input-icon-wrap').siblings('.vm-val-msg').show();
            } else {
                el.classList.remove("is-invalid", "shake-err", "vm-focus-pulse");
                $(el).closest('.vm-input-icon-wrap').removeClass("is-invalid shake-err vm-focus-pulse");
                $(el).closest('.vm-input-icon-wrap').siblings('.vm-val-msg').hide();
            }
        }

        function highlightAndFocusElement(el) {
            if (!el) return;
            try {
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch (e) {}

            setTimeout(() => {
                if (typeof el.focus === 'function') {
                    el.focus();
                }
                el.classList.add('vm-focus-pulse');
                $(el).closest('.vm-input-icon-wrap, .vm-input-code-wrap').addClass('vm-focus-pulse');

                if ($(el).hasClass('vm-select2')) {
                    const $s2Sel = $(el).next('.select2-container').find('.select2-selection');
                    $s2Sel.addClass('vm-focus-pulse');
                    try {
                        $(el).select2('open');
                    } catch (e) {}
                }

                $(el).one('input change focusout', function () {
                    $(this).removeClass('vm-focus-pulse is-invalid shake-err');
                    $(this).closest('.vm-input-icon-wrap, .vm-input-code-wrap').removeClass('vm-focus-pulse is-invalid shake-err');
                    $(this).next('.select2-container').find('.select2-selection').removeClass('vm-focus-pulse is-invalid');
                });
            }, 250);
        }

        function showValidationSweetAlert(missingList, firstInvalidEl) {
            if (!missingList || missingList.length === 0) return;

            const listItemsHtml = missingList.slice(0, 8).map(m => `
                <li style="margin-bottom: 7px; line-height: 1.45; text-align: left;">
                    <span style="font-weight: 700; color: #b91c1c;">${m.label}:</span>
                    <span style="color: #475569; font-style: italic; margin-left: 4px;">${m.example}</span>
                </li>
            `).join('');

            const overflowNote = missingList.length > 8 
                ? `<p style="font-size: 11px; color: #64748b; margin-top: 8px; text-align: left;">...and ${missingList.length - 8} more required field(s)</p>` 
                : '';

            if (typeof Swal !== "undefined") {
                Swal.fire({
                    icon: 'warning',
                    title: 'Required Information Missing',
                    html: `
                        <div style="font-size: 13px; text-align: left; padding: 4px 6px;">
                            <p style="font-weight: 600; color: #1e293b; margin-bottom: 10px;">Please provide the following required details:</p>
                            <ul style="list-style-type: disc; padding-left: 20px; max-height: 280px; overflow-y: auto; margin: 0;">
                                ${listItemsHtml}
                            </ul>
                            ${overflowNote}
                        </div>
                    `,
                    confirmButtonText: 'Fix Missing Fields',
                    confirmButtonColor: 'var(--vm-primary, #a82024)',
                    buttonsStyling: true,
                    customClass: {
                        confirmButton: 'btn-vm-primary !px-5 !py-2.5 !text-sm !font-bold !rounded-lg shadow-md'
                    },
                    allowOutsideClick: false
                }).then(() => {
                    highlightAndFocusElement(firstInvalidEl);
                });
            } else {
                alert("Please complete required fields:\n" + missingList.map(m => `- ${m.label}: ${m.example}`).join('\n'));
                highlightAndFocusElement(firstInvalidEl);
            }
        }

        function validateStepFields(step) {
            const panel = document.getElementById(`stepContent${step}`);
            if (panel) {
                panel.querySelectorAll(".is-invalid").forEach(el => el.classList.remove("is-invalid", "shake-err", "vm-focus-pulse"));
                panel.querySelectorAll(".select2-selection").forEach(el => el.classList.remove("vm-focus-pulse"));
                panel.querySelectorAll(".vm-val-msg").forEach(el => el.style.display = "none");
            }

            let isValid = true;
            let missingList = [];
            let firstInvalidEl = null;

            function markStepError(el, fieldLabel, exampleText) {
                if (el) {
                    el.classList.add("is-invalid", "shake-err");
                    const $el = $(el);
                    $el.closest('.vm-input-icon-wrap, .vm-input-code-wrap').addClass("is-invalid shake-err");
                    if ($el.hasClass('vm-select2')) {
                        $el.next('.select2-container').find('.select2-selection').addClass("is-invalid");
                    }
                    $el.siblings('.vm-val-msg').show();
                    $el.closest('.vm-input-icon-wrap, .vm-input-code-wrap').siblings('.vm-val-msg').show();

                    if (!firstInvalidEl) {
                        firstInvalidEl = el;
                    }
                }
                isValid = false;
                missingList.push({ label: fieldLabel, example: exampleText, element: el });
            }

            if (step === 1) {
                const codeEl = document.getElementById("txtVendorCode");
                if (!codeEl || !codeEl.value.trim()) markStepError(codeEl, "Vendor Code", "e.g. VND-0001 (or click Auto)");

                const nameEl = document.getElementById("txtVendorName");
                if (!nameEl || !nameEl.value.trim()) markStepError(nameEl, "Legal Entity / Vendor Name", "e.g. ABC Infra Projects Pvt Ltd");

                const emailEl = document.getElementById("txtEmailId");
                const emailVal = emailEl ? emailEl.value.trim() : "";
                if (!emailVal || !isValidEmail(emailVal)) {
                    markStepError(emailEl, "Primary Official Email", "e.g. orders@@vendor.com (must be a valid email format)");
                }

                const typeEl = document.getElementById("ddlVendorType");
                if (!typeEl || !typeEl.value) markStepError(typeEl, "Vendor Type", "Select a Vendor Type from the dropdown");

                const catEl = document.getElementById("ddlVendorCategory");
                if (!catEl || !catEl.value) markStepError(catEl, "Vendor Category", "Select a Vendor Category from the dropdown");

                const panEl = document.getElementById("txtPanNo");
                const panVal = panEl ? panEl.value.trim().toUpperCase().replace(/\s+/g, '') : "";
                if (panEl) panEl.value = panVal;
                const panRegex = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;
                if (!panVal || !panRegex.test(panVal)) {
                    markStepError(panEl, "PAN Number", "e.g. ABCDE1234F (10 uppercase characters: 5 letters, 4 numbers, 1 letter)");
                }

                const panTypeEl = document.getElementById("ddlPanType");
                if (!panTypeEl || !panTypeEl.value) markStepError(panTypeEl, "PAN Type", "Select PAN Type (Company, Individual, LLP, etc.)");
            } else if (step === 2) {
                const cityEl = document.getElementById("txtCity");
                if (!cityEl || !cityEl.value.trim()) markStepError(cityEl, "City", "e.g. Chennai, Bangalore");
            } else if (step === 3) {
                const contactPersonEl = document.getElementById("txtContactPerson");
                if (!contactPersonEl || !contactPersonEl.value.trim()) markStepError(contactPersonEl, "Contact Person Name", "e.g. Ramesh Kumar");

                const contactNoEl = document.getElementById("txtContactNo");
                const contactPhoneVal = contactNoEl ? contactNoEl.value.trim() : "";
                if (!contactPhoneVal) markStepError(contactNoEl, "Contact Phone / Mobile", "e.g. 9840012345");

                const contactEmailEl = document.getElementById("txtContactEmail");
                const contactEmailVal = contactEmailEl ? contactEmailEl.value.trim() : "";
                if (!contactEmailVal || !isValidEmail(contactEmailVal)) {
                    markStepError(contactEmailEl, "Contact Direct Email", "e.g. representative@@vendor.com (must be a valid email format)");
                }
            } else if (step === 5) {
                const bankRows = document.querySelectorAll(".bank-entry-row");
                if (bankRows.length === 0) {
                    markStepError(document.getElementById("tblBankAccounts"), "Bank Accounts", "At least one Bank Account is required");
                } else {
                    const ifscRegex = /^[A-Z]{4}0[A-Z0-9]{6}$/;
                    bankRows.forEach((r, idx) => {
                        const acEl = r.querySelector(".bank-acno");
                        const typeEl = r.querySelector(".bank-actype");
                        const nameEl = r.querySelector(".bank-name");
                        const brNameEl = r.querySelector(".bank-brname");
                        const brCodeEl = r.querySelector(".bank-brcode");
                        const ifscEl = r.querySelector(".bank-ifsc");

                        if (!acEl || !acEl.value.trim()) markStepError(acEl, `Bank #${idx + 1} Account Number`, "e.g. 50200012345678");
                        if (!typeEl || !typeEl.value.trim()) markStepError(typeEl, `Bank #${idx + 1} Account Type`, "e.g. Current A/c");
                        if (!nameEl || !nameEl.value.trim()) markStepError(nameEl, `Bank #${idx + 1} Bank Name`, "e.g. HDFC Bank, SBI");

                        const ifscVal = ifscEl ? ifscEl.value.trim().toUpperCase().replace(/\s+/g, '') : '';
                        if (ifscEl) ifscEl.value = ifscVal;
                        if (!ifscVal || !ifscRegex.test(ifscVal)) {
                            markStepError(ifscEl, `Bank #${idx + 1} IFSC Code`, "e.g. HDFC0001234 (11 alphanumeric characters)");
                        } else {
                            if (brCodeEl && !brCodeEl.value.trim() && ifscVal.length === 11) {
                                brCodeEl.value = ifscVal.substring(5);
                            }
                            if (brNameEl && !brNameEl.value.trim()) {
                                brNameEl.value = "Main Branch";
                            }
                        }
                    });
                }
            }

            return {
                isValid: isValid,
                missingList: missingList,
                firstInvalidEl: firstInvalidEl
            };
        }

        function handleSaveAndNext() {
            const stepRes = validateStepFields(currentStep);
            if (!stepRes.isValid) {
                showValidationSweetAlert(stepRes.missingList, stepRes.firstInvalidEl);
                return;
            }

            const currentNode = document.getElementById(`stepNode${currentStep}`);
            if (currentNode) currentNode.classList.add("completed");

            if (currentStep < 6) {
                jumpToStep(currentStep + 1);
            } else {
                submitVendorForm();
            }
        }

        function handleSaveAndExit() {
            if (validateFullVendorForm()) {
                submitVendorForm();
            }
        }

        function validateFullVendorForm() {
            document.querySelectorAll(".is-invalid").forEach(el => el.classList.remove("is-invalid", "shake-err", "vm-focus-pulse"));
            document.querySelectorAll(".select2-selection").forEach(el => el.classList.remove("vm-focus-pulse"));

            let allMissing = [];
            let firstErrorStep = null;
            let firstInvalidEl = null;

            for (let step = 1; step <= 6; step++) {
                const stepRes = validateStepFields(step);
                if (!stepRes.isValid) {
                    if (!firstErrorStep) {
                        firstErrorStep = step;
                        firstInvalidEl = stepRes.firstInvalidEl;
                    }
                    allMissing = allMissing.concat(stepRes.missingList);
                }
            }

            if (allMissing.length > 0) {
                if (firstErrorStep && firstErrorStep !== currentStep) {
                    jumpToStep(firstErrorStep);
                }
                showValidationSweetAlert(allMissing, firstInvalidEl);
                return false;
            }

            return true;
        }

        function validatePanInput(el) {
            if (!el) return;
            const val = el.value.trim().toUpperCase().replace(/\s+/g, '');
            el.value = val;
            const panRegex = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;
            if (val && !panRegex.test(val)) {
                el.classList.add("is-invalid");
                showToast("PAN format is invalid (10 characters: 5 letters + 4 digits + 1 letter)", "warning");
            } else {
                el.classList.remove("is-invalid", "shake-err", "vm-focus-pulse");
                $(el).siblings('.vm-val-msg').hide();
            }
        }

        function validateGstInput(el) {
            if (!el) return;
            const val = el.value.trim().toUpperCase().replace(/\s+/g, '');
            el.value = val;
            const gstRegex = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;
            if (val && !gstRegex.test(val)) {
                el.classList.add("is-invalid");
            } else {
                el.classList.remove("is-invalid", "shake-err", "vm-focus-pulse");
            }
        }

        // ── 7. MULTIPLE BANK ACCOUNTS ROW MANAGEMENT (STEP 5) ─────────────────
