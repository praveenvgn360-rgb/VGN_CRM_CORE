        <div class="min-h-full flex items-center justify-center p-4 text-center">
            <div class="relative w-full max-w-md bg-[var(--vm-surface)] rounded-2xl shadow-2xl border border-[var(--vm-border)] text-left transform transition-all my-8 overflow-hidden inline-block p-6">
                <div class="flex items-center justify-between border-b border-[var(--vm-border)] pb-3 mb-4">
                    <h3 class="text-sm font-bold text-[var(--vm-text)] flex items-center gap-2">
                        <i class="fas fa-boxes text-[var(--vm-primary)]"></i> Add New Vendor Category
                    </h3>
                    <button type="button" onclick="closeQuickCategoryModal()" class="text-[var(--vm-text-muted)] hover:text-[var(--vm-text)]">
