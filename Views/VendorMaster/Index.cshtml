                                <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--vm-text-muted)] block">GSTIN</span> 
                                <div class="flex items-center gap-1.5 mt-0.5">
                                    <strong class="text-xs font-mono text-[var(--vm-text)]">${v.gstIn || '-'}</strong>
                                    ${v.gstIn ? `<a href="https://services.gst.gov.in/services/searchtp" target="_blank" rel="noopener noreferrer" class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 hover:bg-blue-100 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800 inline-flex items-center gap-1 transition" title="Verify on Official Government GST Portal (Opens new tab)"><i class="fas fa-external-link-alt text-[8px]"></i>Verify</a>` : ''}
                                </div>
                            </div>
                            <div><span class="text-[10px] font-bold uppercase tracking-wider text-[var(--vm-text-muted)] block">MSME Reg.</span> <strong class="text-xs text-[var(--vm-text)]">${v.msme || 'No'} ${v.msmeNo ? '(' + v.msmeNo + ')' : ''}</strong></div>
                        </div>

                        <!-- Address & Contact -->
                        <div class="p-4 bg-slate-50/70 dark:bg-slate-800/40 rounded-xl border border-[var(--vm-border)]">
                            <h4 class="font-bold text-xs uppercase tracking-wider text-[var(--vm-text)] mb-2 flex items-center gap-1.5">
                                <i class="fas fa-map-marker-alt text-[var(--vm-primary)]"></i> Registered Address & Contact Liaison
                            </h4>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                                <div>
                                    <span class="text-[10px] font-bold uppercase text-[var(--vm-text-muted)] block">Registered Address</span>
                                    <p class="text-[var(--vm-text)]">${v.address || '-'}, ${v.city || ''}, ${v.state || ''} - ${v.pincode || ''}</p>
                                    <span class="text-[11px] text-[var(--vm-text-muted)] block mt-1"><i class="fas fa-phone mr-1"></i>${v.phoneNumber || '-'}</span>
                                </div>
                                <div>
                                    <span class="text-[10px] font-bold uppercase text-[var(--vm-text-muted)] block">Contact Person</span>
                                    <p class="font-bold text-[var(--vm-text)]">${v.contactPerson || '-'} <span class="text-[10px] font-normal text-[var(--vm-text-muted)]">(${v.designation || 'Representative'})</span></p>
                                    <span class="text-[11px] text-[var(--vm-text-muted)] block"><i class="fas fa-phone mr-1"></i>${v.contactNo || '-'}</span>
                                </div>
                            </div>
                        </div>

                        <!-- Bank Accounts Section -->
                        <div class="p-4 bg-slate-50/70 dark:bg-slate-800/40 rounded-xl border border-[var(--vm-border)]">
                            <h4 class="font-bold text-xs uppercase tracking-wider text-[var(--vm-text)] mb-2 flex items-center gap-1.5">
                                <i class="fas fa-university text-[var(--vm-primary)]"></i> Registered Bank Accounts
                            </h4>
                            ${bankHtml}
                        </div>

                        <!-- Branch Network Section -->
                        <div class="p-4 bg-slate-50/70 dark:bg-slate-800/40 rounded-xl border border-[var(--vm-border)]">
                            <h4 class="font-bold text-xs uppercase tracking-wider text-[var(--vm-text)] mb-2 flex items-center gap-1.5">
                                <i class="fas fa-code-branch text-[var(--vm-primary)]"></i> Secondary Branches & Site Locations
                            </h4>
