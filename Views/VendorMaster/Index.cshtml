                    `;

                    document.getElementById("boxViewVendorContent").innerHTML = html;
                    document.getElementById("modalViewVendor").style.display = "block";
                })
                .catch(err => {
                    hideFullPageLoader();
                    console.error("View error:", err);
                    showToast("Error displaying dossier: " + err.message, "error");
                });
        }

        function closeViewModal() {
            document.getElementById("modalViewVendor").style.display = "none";
        }

        // ── 13. DELETE / DEACTIVATE VENDOR ────────────────────────────────────
        function deleteVendor(id, name) {
            if (typeof Swal !== "undefined") {
                Swal.fire({
                    title: 'Deactivate Vendor?',
                    text: `Are you sure you want to deactivate vendor "${name}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e11d48',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, Deactivate',
                    cancelButtonText: 'Cancel'
                }).then(result => {
                    if (result.isConfirmed) {
                        executeDelete(id);
                    }
                });
            } else {
                if (confirm(`Are you sure you want to deactivate vendor "${name}"?`)) {
                    executeDelete(id);
                }
            }
        }

        function executeDelete(id) {
            showFullPageLoader("Deactivating Vendor...");

            fetch(`/VendorMaster/DeleteVendor?id=${id}`, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    hideFullPageLoader();
                    if (res.success) {
                        showToast(res.message || "Vendor deactivated successfully", "success");
                        loadVendorData();
                    } else {
                        showToast(res.message || "Failed to deactivate vendor", "error");
                    }
                })
                .catch(err => {
                    hideFullPageLoader();
                    console.error("Delete error:", err);
                    showToast("Error: " + err.message, "error");
                });
        }

        // ── 14. QUICK ADD TYPE & CATEGORY MODALS ──────────────────────────────
        function openQuickTypeModal() {
            document.getElementById("txtQuickTypeName").value = "";
            document.getElementById("txtQuickTypeCode").value = "";
            document.getElementById("modalQuickType").style.display = "block";
        }

        function closeQuickTypeModal() {
            document.getElementById("modalQuickType").style.display = "none";
        }

        function submitQuickType() {
            const name = document.getElementById("txtQuickTypeName").value.trim();
            const code = document.getElementById("txtQuickTypeCode").value.trim();
            if (!name) {
                showToast("Please enter Type Name", "warning");
                return;
            }

            showFullPageLoader("Adding Vendor Type...");

            fetch('/VendorMaster/QuickAddType', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ vendorTypeName: name, vendorTypeCode: code })
            })
                .then(r => r.json())
                .then(res => {
                    hideFullPageLoader();
                    if (res.success) {
                        showToast("New Vendor Type created!", "success");
                        closeQuickTypeModal();
                        loadDropdownMasters();
                        setTimeout(() => {
                            $('#ddlVendorType').val(res.vendorTypeId).trigger('change');
                        }, 400);
                    } else {
                        showToast(res.message || "Error creating type", "error");
                    }
                })
                .catch(err => {
                    hideFullPageLoader();
                    showToast("Error creating type: " + err.message, "error");
                });
        }

        function openQuickCategoryModal() {
            document.getElementById("txtQuickCategoryName").value = "";
            document.getElementById("txtQuickCategoryCode").value = "";
            document.getElementById("modalQuickCategory").style.display = "block";
        }

        function closeQuickCategoryModal() {
            document.getElementById("modalQuickCategory").style.display = "none";
        }

        function submitQuickCategory() {
            const name = document.getElementById("txtQuickCategoryName").value.trim();
            const code = document.getElementById("txtQuickCategoryCode").value.trim();
            if (!name) {
                showToast("Please enter Category Name", "warning");
                return;
            }

            showFullPageLoader("Adding Vendor Category...");

            fetch('/VendorMaster/QuickAddCategory', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ vendorCategoryName: name, vendorCategoryCode: code })
            })
                .then(r => r.json())
                .then(res => {
                    hideFullPageLoader();
                    if (res.success) {
                        showToast("New Vendor Category created!", "success");
                        closeQuickCategoryModal();
                        loadDropdownMasters();
                        setTimeout(() => {
                            $('#ddlVendorCategory').val(res.vendorCategoryId).trigger('change');
                        }, 400);
                    } else {
                        showToast(res.message || "Error creating category", "error");
                    }
                })
                .catch(err => {
                    hideFullPageLoader();
                    showToast("Error creating category: " + err.message, "error");
                });
        }

        // ── 15. UTILITIES & RESETS ─────────────────────────────────────────────
        function autoGenerateCode() {
            fetch('/VendorMaster/GetNextVendorCode')
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.code) {
                        document.getElementById("txtVendorCode").value = res.code;
                    }
                });
        }

        function resetWizardForm() {
            document.getElementById("hdnVendorId").value = "0";
            document.getElementById("frmVendorWizard").reset();
            
            // Step 5: Reset Banks with 1 default empty row
            document.getElementById("tblBankBody").innerHTML = "";
            bankRowCounter = 0;
            addBankRow();

            // Step 6: Reset Branches
            document.getElementById("tblBranchBody").innerHTML = "";
            branchRowCounter = 0;

            // Reset default values matching system defaults
            document.getElementById("txtCity").value = "Chennai";
            document.getElementById("txtState").value = "Tamil Nadu";
            document.getElementById("txtCountry").value = "India";
            document.getElementById("txtPincode").value = "600077";
            document.getElementById("txtYearOfEstablishment").value = "0";

            // Trigger Select2 updates
            $('#ddlVendorType').val('').trigger('change');
            $('#ddlVendorCategory').val('').trigger('change');
            $('#ddlSupplyType').val('').trigger('change');
            $('#ddlConsultantType').val('').trigger('change');
            $('#ddlCompnayType').val('Private Limited').trigger('change');
            $('#ddlPanType').val('').trigger('change');
            $('#ddlMSME').val('No').trigger('change');
            $('#ddlContactType').val('Primary person').trigger('change');
            $('#ddlGSTVendorType').val('Regular').trigger('change');
            $('#ddlGSTFiling').val('None').trigger('change');
            $('#ddlDutyFree').val('No').trigger('change');

            // Remove all error classes and pulsing focus
            document.querySelectorAll(".is-invalid, .shake-err, .vm-focus-pulse").forEach(el => {
                el.classList.remove("is-invalid", "shake-err", "vm-focus-pulse");
            });
            document.querySelectorAll(".select2-selection").forEach(el => {
                el.classList.remove("vm-focus-pulse");
            });
        }

        function showToast(message, type = "info") {
            if (typeof Swal !== "undefined") {
                const iconType = type === "error" ? "error" : (type === "warning" ? "warning" : "success");
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: iconType,
                    title: message,
                    showConfirmButton: false,
                    timer: 3500,
                    timerProgressBar: true
                });
            } else {
                alert(message);
            }
        }
    </script>
}
