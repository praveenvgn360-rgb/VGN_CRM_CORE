    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- MODAL: VIEW VENDOR EXECUTIVE DOSSIER                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <div id="modalViewVendor" class="fixed inset-0 z-[9999] overflow-y-auto" style="display: none; background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px);">
        <div class="min-h-full flex items-center justify-center p-3 sm:p-5 text-center">
            <div class="relative w-full max-w-4xl bg-[var(--vm-surface)] rounded-2xl shadow-2xl border border-[var(--vm-border)] text-left transform transition-all my-8 overflow-hidden inline-block p-6 sm:p-7">
                <div class="flex items-center justify-between border-b border-[var(--vm-border)] pb-4 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-xl bg-[var(--vm-primary)]/10 text-[var(--vm-primary)] flex items-center justify-center text-lg font-bold">
                            <i class="fas fa-building"></i>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-[var(--vm-text)]" id="lblViewVendorName">Vendor Dossier</h3>
                            <p class="text-xs text-[var(--vm-text-muted)] mt-0.5" id="lblViewVendorCode">VND-0000</p>
