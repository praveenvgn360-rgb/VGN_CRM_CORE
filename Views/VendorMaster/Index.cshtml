                    let branchHtml = '<p class="text-[var(--vm-text-muted)] italic py-2">No branch records registered for this vendor.</p>';
                    if (v.branches && v.branches.length > 0) {
                        branchHtml = `
                            <div class="overflow-x-auto mt-2 rounded-lg border border-[var(--vm-border)]">
                                <table class="w-full text-left text-xs border-collapse">
                                    <tr class="bg-slate-100 dark:bg-slate-800 text-[10px] font-bold uppercase text-[var(--vm-text-muted)] border-b border-[var(--vm-border)]">
                                        <th class="p-2">Branch Name</th>
                                        <th class="p-2">City</th>
                                        <th class="p-2">Phone</th>
                                        <th class="p-2">GSTIN</th>
                                        <th class="p-2 text-center">Status</th>
                                    </tr>
                                    ${v.branches.map(b => `
                                        <tr class="border-b border-[var(--vm-border)] last:border-0 hover:bg-slate-50/50">
                                            <td class="p-2 font-semibold text-[var(--vm-text)]">${b.branchName}</td>
                                            <td class="p-2">${b.city || '-'}</td>
                                            <td class="p-2">${b.phoneNo || '-'}</td>
                                            <td class="p-2 font-mono font-bold">${b.gstIn || '-'}</td>
                                            <td class="p-2 text-center">
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold ${(b.status === '1' || b.status === 'Active') ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300' : 'bg-rose-100 text-rose-800'}">
                                                    ${(b.status === '1' || b.status === 'Active') ? 'Active' : 'Inactive'}
                                                </span>
                                            </td>
                                        </tr>
                                    `).join('')}
                                </table>
                            </div>
                        `;
                    }

                    const html = `
                        <!-- Identity & Classification Grid -->
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 p-4 bg-slate-50/70 dark:bg-slate-800/40 rounded-xl border border-[var(--vm-border)]">
                            <div><span class="text-[10px] font-bold uppercase tracking-wider text-[var(--vm-text-muted)] block">Vendor Type</span> <strong class="text-xs text-[var(--vm-text)]">${v.vendorTypeName || '-'}</strong></div>
                            <div><span class="text-[10px] font-bold uppercase tracking-wider text-[var(--vm-text-muted)] block">Category</span> <strong class="text-xs text-[var(--vm-text)]">${v.vendorCategoryName || '-'}</strong></div>
                            <div><span class="text-[10px] font-bold uppercase tracking-wider text-[var(--vm-text-muted)] block">Work Nature</span> <strong class="text-xs text-[var(--vm-text)]">${v.workNature || '-'}</strong></div>
                            <div><span class="text-[10px] font-bold uppercase tracking-wider text-[var(--vm-text-muted)] block">Constitution</span> <strong class="text-xs text-[var(--vm-text)]">${v.compnayType || '-'}</strong></div>
                            <div><span class="text-[10px] font-bold uppercase tracking-wider text-[var(--vm-text-muted)] block">PAN Number</span> <strong class="text-xs font-mono text-[var(--vm-text)]">${v.panNo || '-'} (${v.panType || 'Company'})</strong></div>
                            <div><span class="text-[10px] font-bold uppercase tracking-wider text-[var(--vm-text-muted)] block">Primary Email</span> <strong class="text-xs text-[var(--vm-text)]">${v.emailId || '-'}</strong></div>
