        // ── 10. SUBMIT VENDOR FORM ─────────────────────────────────────────────
        function submitVendorForm() {
            if (!validateFullVendorForm()) return;

            const vendorId = parseInt(document.getElementById("hdnVendorId").value) || 0;
            const isNew = vendorId === 0;

            const payload = {
                vendorId: vendorId,
                vendorCode: document.getElementById("txtVendorCode").value.trim(),
                vendorName: document.getElementById("txtVendorName").value.trim(),
                emailId: document.getElementById("txtEmailId").value.trim(),
                workNature: document.getElementById("txtWorkNature").value.trim(),
                vendorTypeId: document.getElementById("ddlVendorType").value,
                vendorCategoryId: document.getElementById("ddlVendorCategory").value,
                supplyType: document.getElementById("ddlSupplyType").value,
                consultantType: document.getElementById("ddlConsultantType").value,
                compnayType: document.getElementById("ddlCompnayType").value,
                panNo: document.getElementById("txtPanNo").value.trim().toUpperCase(),
                panType: document.getElementById("ddlPanType").value,
                aadharNo: document.getElementById("txtAadharNo").value.trim(),
                msme: document.getElementById("ddlMSME").value,
                msmeNo: document.getElementById("txtMSMENo").value.trim(),

                // Step 2: Address
                address: document.getElementById("txtAddress").value.trim(),
                city: document.getElementById("txtCity").value.trim(),
                state: document.getElementById("txtState").value.trim(),
                country: document.getElementById("txtCountry").value.trim(),
                pincode: document.getElementById("txtPincode").value.trim(),
                phoneNumber: document.getElementById("txtPhoneNumber").value.trim(),
                chequeName: document.getElementById("txtChequeName").value.trim(),
                category: document.getElementById("txtCategory").value.trim(),
                orgType: document.getElementById("txtOrgType").value.trim(),

                // Step 3: Contact
                contactPerson: document.getElementById("txtContactPerson").value.trim(),
                contactNo: document.getElementById("txtContactNo").value.trim(),
                contactAddress: document.getElementById("txtContactAddress").value.trim(),
                designation: document.getElementById("txtDesignation").value.trim(),
                contactType: document.getElementById("ddlContactType").value,

                // Step 4: Statutory
                yearofEstablishment: document.getElementById("txtYearOfEstablishment").value.trim() || '0',
                esiNo: document.getElementById("txtESINo").value.trim(),
                epfNo: document.getElementById("txtEPFNo").value.trim(),
                gstIn: document.getElementById("txtGSTIn").value.trim().toUpperCase(),
                arnNo: document.getElementById("txtARNNo").value.trim(),
                vendorType: document.getElementById("ddlGSTVendorType").value,
                gstFiling: document.getElementById("ddlGSTFiling").value,
                shopEstablishmentNo: document.getElementById("txtShopEstablishmentNo").value.trim(),
                lwf: document.getElementById("txtLWF").value.trim(),
                pTaxRegNo: document.getElementById("txtPTaxRegNo").value.trim(),
                tdsAccNo: document.getElementById("txtTDSAccNo").value.trim(),
                dutyFree: document.getElementById("ddlDutyFree").value,
                vatNo: document.getElementById("txtVATNo").value.trim(),

                // Step 5: Multiple Bank Accounts
                banks: collectBanksData(),

                // Step 6: Branches (Optional)
                branches: collectBranchesData(),

                // Status: always '1' for active
                status: '1'
            };

            showFullPageLoader(isNew ? "Creating New Vendor..." : "Updating Vendor...");

            fetch('/VendorMaster/SaveVendor', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(res => {
                hideFullPageLoader();

                if (res.success) {
                    showToast(res.message || "Vendor saved successfully!", "success");
                    showListView();
                    loadVendorData();
                } else {
                    showToast(res.message || "Failed to save vendor", "error");
                }
            })
            .catch(err => {
                hideFullPageLoader();
                console.error("Save error:", err);
                showToast("Communication error while saving: " + err.message, "error");
            });
        }

        // ── 11. EDIT VENDOR ───────────────────────────────────────────────────
        function editVendor(id) {
            showFullPageLoader("Loading Vendor Details...");

            fetch(`/VendorMaster/GetVendorById?id=${id}`)
                .then(r => r.json())
                .then(res => {
                    hideFullPageLoader();

                    if (!res.success || !res.data) {
                        showToast(res.message || "Failed to load vendor details", "error");
                        return;
                    }

                    resetWizardForm();
                    const v = res.data;

                    document.getElementById("hdnVendorId").value = v.vendorId;
                    document.getElementById("txtVendorCode").value = v.vendorCode || '';
                    document.getElementById("txtVendorName").value = v.vendorName || '';
                    document.getElementById("txtEmailId").value = v.emailId || '';
                    document.getElementById("txtWorkNature").value = v.workNature || '';
                    $('#ddlVendorType').val(v.vendorTypeId || '').trigger('change');
                    $('#ddlVendorCategory').val(v.vendorCategoryId || '').trigger('change');
                    $('#ddlSupplyType').val(v.supplyType || '').trigger('change');
                    $('#ddlConsultantType').val(v.consultantType || '').trigger('change');
                    $('#ddlCompnayType').val(v.compnayType || 'Private Limited').trigger('change');
                    document.getElementById("txtPanNo").value = v.panNo || '';
                    $('#ddlPanType').val(v.panType || 'Company').trigger('change');
                    document.getElementById("txtAadharNo").value = v.aadharNo || '';
                    $('#ddlMSME').val(v.msme || 'No').trigger('change');
                    document.getElementById("txtMSMENo").value = v.msmeNo || '';

                    // Step 2
                    document.getElementById("txtAddress").value = v.address || '';
                    document.getElementById("txtCity").value = v.city || 'Chennai';
                    document.getElementById("txtState").value = v.state || 'Tamil Nadu';
                    document.getElementById("txtCountry").value = v.country || 'India';
                    document.getElementById("txtPincode").value = v.pincode || '600077';
                    document.getElementById("txtPhoneNumber").value = v.phoneNumber || '';
                    document.getElementById("txtChequeName").value = v.chequeName || '';
                    document.getElementById("txtCategory").value = v.category || '';
                    document.getElementById("txtOrgType").value = v.orgType || '';

                    // Step 3
                    document.getElementById("txtContactPerson").value = v.contactPerson || '';
                    document.getElementById("txtContactNo").value = v.contactNo || '';
                    document.getElementById("txtContactAddress").value = v.contactAddress || '';
                    document.getElementById("txtDesignation").value = v.designation || '';
                    document.getElementById("txtContactEmail").value = v.contactEmail || v.emailId || '';
                    $('#ddlContactType').val(v.contactType || 'Primary person').trigger('change');

                    // Step 4
                    document.getElementById("txtYearOfEstablishment").value = v.yearofEstablishment || '0';
                    document.getElementById("txtESINo").value = v.esiNo || '';
                    document.getElementById("txtEPFNo").value = v.epfNo || '';
                    document.getElementById("txtGSTIn").value = v.gstIn || '';
                    document.getElementById("txtARNNo").value = v.arnNo || '';
                    $('#ddlGSTVendorType').val(v.vendorType || 'Regular').trigger('change');
                    $('#ddlGSTFiling').val(v.gstFiling || 'None').trigger('change');
                    document.getElementById("txtShopEstablishmentNo").value = v.shopEstablishmentNo || '';
                    document.getElementById("txtLWF").value = v.lwf || '';
                    document.getElementById("txtPTaxRegNo").value = v.pTaxRegNo || '';
                    document.getElementById("txtTDSAccNo").value = v.tdsAccNo || '';
                    $('#ddlDutyFree').val(v.dutyFree || 'No').trigger('change');
                    document.getElementById("txtVATNo").value = v.vatNo || '';

                    // Step 5: Populate Banks
                    document.getElementById("tblBankBody").innerHTML = '';
                    bankRowCounter = 0;
                    if (v.banks && v.banks.length > 0) {
                        v.banks.forEach(b => addBankRow(b));
                    } else {
                        addBankRow();
                    }

                    // Step 6: Populate Branches
                    document.getElementById("tblBranchBody").innerHTML = '';
                    branchRowCounter = 0;
                    if (v.branches && v.branches.length > 0) {
                        v.branches.forEach(b => addBranchRow(b));
                    }

                    // Switch to wizard view
                    document.getElementById("viewVendorList").style.display = "none";
                    document.getElementById("viewVendorWizard").style.display = "block";
                    document.getElementById("badgeCurrentMode").innerText = `Edit: ${v.vendorCode || v.vendorName}`;
                    jumpToStep(1);
                })
                .catch(err => {
                    hideFullPageLoader();
                    console.error("Fetch vendor error:", err);
                    showToast("Error loading vendor: " + err.message, "error");
                });
        }

        // ── 12. VIEW VENDOR DOSSIER MODAL ─────────────────────────────────────
        function viewVendor(id) {
            showFullPageLoader("Opening Dossier...");

            fetch(`/VendorMaster/GetVendorById?id=${id}`)
                .then(r => r.json())
