                    <button type="button" onclick="closeQuickTypeModal()" class="text-[var(--vm-text-muted)] hover:text-[var(--vm-text)]">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="space-y-4 text-xs">
                    <div>
                        <label class="vm-label">
                            <span class="vm-label-text">Type Name <span class="req">*</span></span>
                        </label>
                        <input type="text" id="txtQuickTypeName" class="vm-input font-semibold" placeholder="e.g. Material Supplier, Subcontractor, Consultant" />
                    </div>
                    <div>
                        <label class="vm-label">
                            <span class="vm-label-text">Type Code (Optional)</span>
                        </label>
                        <input type="text" id="txtQuickTypeCode" class="vm-input uppercase font-mono" placeholder="e.g. VTM-08" />
