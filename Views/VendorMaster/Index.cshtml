                    <div class="pt-3 border-t border-[var(--vm-border)] flex justify-end gap-2.5">
                        <button type="button" onclick="closeQuickTypeModal()" class="btn-cancel !text-xs !py-1.5 !px-3 cursor-pointer">Cancel</button>
                        <button type="button" onclick="submitQuickType()" class="btn-vm-primary !text-xs !py-1.5 !px-4 text-white cursor-pointer">Save Type</button>
