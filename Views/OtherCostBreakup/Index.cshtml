@{
    ViewBag.Title = "Other Cost Breakup - VGN ERP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-3 sm:p-5 space-y-4 font-sans text-slate-800 dark:text-slate-100 max-w-[1700px] mx-auto">

    <!-- Top View Mode Switcher -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-white dark:bg-slate-800 p-3 sm:p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-600 dark:text-teal-400 text-lg font-bold">
                <i class="fas fa-layer-group"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-slate-800 dark:text-white tracking-tight flex items-center gap-2">
                    <span>Other Cost Breakup</span>
                    <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-teal-100 text-teal-800 dark:bg-teal-900/50 dark:text-teal-300 border border-teal-300 dark:border-teal-700" id="badgeProjectStatus">
                        Select Project
                    </span>
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Break down allocated project other costs into detailed itemized line entries</p>
            </div>
        </div>

        <!-- View Switcher & Quick Navigation -->
        <div class="flex items-center gap-2 flex-wrap">
            <button type="button" id="btnTabEntry" onclick="switchToEntryView()" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-teal-600 text-white hover:bg-teal-700 transition cursor-pointer shadow-xs flex items-center gap-1.5">
                <i class="fas fa-edit text-xs"></i>
                <span>Breakup Entry</span>
            </button>
            <button type="button" id="btnTabRegister" onclick="switchToRegisterView()" class="px-3.5 py-1.5 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                <i class="fas fa-table text-xs"></i>
                <span>Register View</span>
            </button>
            <a href="@Url.Action("Index", "ServiceMaster")" class="px-3 py-1.5 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Manage Master Services">
                <i class="fas fa-cubes text-emerald-600"></i>
                <span>Service Master</span>
            </a>
            <a href="@Url.Action("Index", "OtherCostAllocation")" class="px-3 py-1.5 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Manage Overhead Allocations">
                <i class="fas fa-hand-holding-usd text-teal-600"></i>
                <span>Cost Allocations</span>
            </a>
            <a href="@Url.Action("Index", "ProjectIOW")" class="px-3 py-1.5 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Bill of Quantities">
                <i class="fas fa-th-list text-blue-600"></i>
                <span>BOQ</span>
            </a>
        </div>
    </div>


    <!-- =========================================================================
         1. BREAKUP ENTRY VIEW (PRIMARY WORKFLOW)
         ========================================================================= -->
    <div id="viewBreakupEntry" class="space-y-4">

        <!-- TOP ROW METADATA: 5 Fields exactly matching ProjectIOW (Bill of Quantities) -->
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-sm p-4 space-y-3">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-2 mb-2">
                <span class="text-xs font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider flex items-center gap-2">
                    <i class="fas fa-info-circle text-teal-600"></i>
                    <span>Breakup Header Parameters</span>
                </span>
                <span class="text-[11px] font-semibold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40 px-2.5 py-0.5 rounded-full border border-amber-200 dark:border-amber-800">
                    <i class="fas fa-lock text-[10px] mr-1"></i> Revision is the only changeable field
                </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 text-xs">
                <!-- 1. Reference Date (Locked to today with lock icon - non-editable) -->
                <div>
                    <label class="block font-bold text-slate-600 dark:text-slate-300 mb-1">
                        Reference Date <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="text" id="txtEntryRefDate" readonly value="@DateTime.Now.ToString("dd-MM-yyyy")" class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 cursor-not-allowed select-none focus:outline-none" title="Reference Date is locked to today" />
                        <i class="fas fa-lock absolute right-3 top-2.5 text-slate-400 text-xs pointer-events-none"></i>
                    </div>
                </div>

                <!-- 2. Reference No (Readonly auto-number) -->
                <div>
                    <label class="block font-bold text-slate-600 dark:text-slate-300 mb-1">Reference No</label>
                    <div class="relative">
                        <input type="text" id="txtEntryRefNo" value="1" readonly class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-sky-700 dark:text-sky-400 cursor-not-allowed select-none focus:outline-none" placeholder="Auto" />
                        <i class="fas fa-hashtag absolute right-3 top-2.5 text-slate-400 text-xs pointer-events-none"></i>
                    </div>
                </div>

                <!-- 3. Project Name (Searchable / Selectable Dropdown) -->
                <div>
                    <label class="block font-bold text-slate-600 dark:text-slate-300 mb-1">
                        Project Name <span class="text-rose-500">*</span>
                    </label>
                    <select id="ddlEntryProject" class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-teal-500 dark:border-teal-600 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-teal-500 focus:outline-none cursor-pointer">
                        <option value="">-- Select Project --</option>
                    </select>
                </div>

                <!-- 4. Type (Locked to "Budget") -->
                <div>
                    <label class="block font-bold text-slate-600 dark:text-slate-300 mb-1">Type</label>
                    <div class="relative">
                        <input type="text" id="txtEntryType" value="Budget" readonly class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 cursor-not-allowed select-none focus:outline-none" />
                        <span class="absolute right-2.5 top-2 px-1.5 py-0.5 rounded text-[9px] font-bold bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">Budget</span>
                    </div>
                </div>

                <!-- 5. Revision (THE ONLY CHANGEABLE FIELD) -->
                <div>
                    <label class="block font-bold text-teal-700 dark:text-teal-400 mb-1 flex items-center justify-between">
                        <span>Revision</span>
                        <span class="text-[10px] font-bold text-teal-600 bg-teal-50 dark:bg-teal-950 px-1 rounded">Editable</span>
                    </label>
                    <select id="ddlEntryRevision" class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border-2 border-teal-500 dark:border-teal-400 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-teal-500 focus:outline-none cursor-pointer shadow-xs">
                        <option value="Yes" selected>Yes</option>
                        <option value="No">No</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- SUMMARY METRICS STRIP (NO DECIMALS) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-3.5 flex items-center justify-between shadow-2xs">
                <div>
                    <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Total Overhead Allocated</span>
                    <span class="text-xl font-black text-blue-600 dark:text-blue-400 mt-1 block" id="lblSummaryTotalAllocated">&#8377; 0</span>
                </div>
                <div class="w-9 h-9 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center text-base">
                    <i class="fas fa-hand-holding-usd"></i>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-3.5 flex items-center justify-between shadow-2xs">
                <div>
                    <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Total Breakup Amount</span>
                    <span class="text-xl font-black text-emerald-600 dark:text-emerald-400 mt-1 block" id="lblSummaryTotalBreakup">&#8377; 0</span>
                </div>
                <div class="w-9 h-9 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-base">
                    <i class="fas fa-calculator"></i>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-3.5 flex items-center justify-between shadow-2xs">
                <div>
                    <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Remaining Balance</span>
                    <span class="text-xl font-black text-slate-700 dark:text-slate-200 mt-1 block" id="lblSummaryTotalRemaining">&#8377; 0</span>
                </div>
                <div class="w-9 h-9 rounded-lg bg-slate-500/10 text-slate-500 flex items-center justify-center text-base">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
        </div>

        <!-- Expand / Collapse All Toolbar for Breakup Entry -->
        <div id="breakupCardsToolbar" style="display: none;" class="flex items-center justify-between gap-3 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-xs shadow-2xs">
            <div class="flex items-center gap-2">
                <i class="fas fa-layer-group text-teal-600"></i>
                <span class="font-bold text-slate-700 dark:text-slate-200" id="lblHeadersCountBadge">Allocation Headers</span>
                <span class="text-[11px] text-slate-400 dark:text-slate-500 hidden sm:inline">(Cards collapsed by default. Click chevron or buttons to expand)</span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="expandAllEntryCards()" class="px-3 py-1.5 text-xs font-bold text-slate-800 bg-[#f0a500] hover:bg-[#df9700] rounded-lg transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                    <i class="fas fa-expand-arrows-alt text-[10px]"></i> Expand All
                </button>
                <button type="button" onclick="collapseAllEntryCards()" class="px-3 py-1.5 text-xs font-bold text-white bg-[#0099ff] hover:bg-[#0088e6] rounded-lg transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                    <i class="fas fa-compress-arrows-alt text-[10px]"></i> Collapse All
                </button>
            </div>
        </div>

        <!-- ALLOCATION HEADERS & DYNAMIC BREAKUP CONTAINER -->
        <div id="allocationHeadersContainer" class="space-y-4">
            <!-- Empty state when no project selected -->
            <div id="emptyProjectNotice" class="bg-white dark:bg-slate-800 border border-dashed border-slate-300 dark:border-slate-700 rounded-2xl p-10 text-center">
                <div class="w-14 h-14 mx-auto rounded-full bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center text-2xl mb-3">
                    <i class="fas fa-building"></i>
                </div>
                <h3 class="text-base font-bold text-slate-700 dark:text-slate-200">Select a Project to Begin Breakup</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-md mx-auto">
                    Choose a project above to load all its configured Other Cost Allocations as headers, and easily itemize the breakup entries below each header.
                </p>
            </div>
        </div>

        <!-- BOTTOM REMARKS & SAVE ACTION BAR -->
        <div id="entryBottomActionBar" style="display: none;" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-4 shadow-sm space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
                <div>
                    <label class="block font-bold text-xs text-slate-700 dark:text-slate-300 mb-1">Remarks / Notes</label>
                    <textarea id="txtEntryRemarks" rows="2" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 text-xs text-slate-800 dark:text-slate-100 outline-none focus:ring-1 focus:ring-teal-500" placeholder="Optional breakup remarks..."></textarea>
                </div>
                <div class="flex flex-col justify-center sm:items-end gap-3">
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                        <input type="checkbox" id="chkReadyForApproval" checked class="w-4 h-4 text-teal-600 rounded border-slate-300 focus:ring-teal-500 cursor-pointer" />
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-200">Ready for Approval</span>
                    </label>
                    <div class="flex items-center gap-3">
                        <button type="button" onclick="loadProjectBreakupHeaders($('#ddlEntryProject').val())" class="px-4 py-2 text-xs font-bold bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-lg transition cursor-pointer">
                            <i class="fas fa-undo mr-1"></i> Reset
                        </button>
                        <button type="button" onclick="saveAllBreakups()" class="px-6 py-2 text-xs font-bold text-white bg-teal-600 hover:bg-teal-700 dark:bg-teal-600 dark:hover:bg-teal-700 rounded-lg shadow-md flex items-center gap-2 transition cursor-pointer">
                            <i class="fas fa-save"></i>
                            <span>Save Breakup</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- =========================================================================
         2. REGISTER VIEW (HIGH-LEVEL REPORT MATCHING IMAGES 2 & 3)
         ========================================================================= -->
    <div id="viewBreakupRegister" style="display: none;" class="space-y-4">

        <!-- Top Header Bar (Matching Image 2) -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-white dark:bg-slate-800 p-3.5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
            <div class="flex items-center gap-2 flex-wrap">
                <div class="flex items-center">
                    <span class="inline-block w-[3px] h-6 bg-[#007780] mr-2.5 rounded-full"></span>
                    <h2 class="text-lg font-bold text-[#006870] dark:text-teal-400 tracking-tight">Other Cost Register</h2>
                </div>

                <div class="relative flex items-center ml-2">
                    <select id="ddlRegisterProject" class="text-sm font-bold text-[#006870] dark:text-teal-300 bg-transparent border-0 outline-none cursor-pointer pr-6 py-0.5 focus:ring-0">
                        <option value="">-- Select Project --</option>
                    </select>
                    <i class="fas fa-caret-down text-[#006870] dark:text-teal-400 pointer-events-none -ml-4 text-xs"></i>
                </div>
            </div>

            <!-- Right Action Buttons (Matching Image 2 Colors & Order) -->
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button" onclick="switchToEntryView()" class="px-3.5 py-1.5 text-xs font-bold text-white bg-[#00a699] hover:bg-[#008f84] rounded-lg transition flex items-center gap-1.5 shadow-2xs cursor-pointer">
                    <i class="fas fa-plus text-[11px]"></i> Add / Edit Breakup
                </button>
                <button type="button" onclick="expandAllRegisterRows()" class="px-3.5 py-1.5 text-xs font-bold text-slate-800 bg-[#f0a500] hover:bg-[#df9700] rounded-lg transition flex items-center gap-1.5 shadow-2xs cursor-pointer">
                    <i class="fas fa-expand-arrows-alt text-[11px]"></i> Expand All
                </button>
                <button type="button" onclick="collapseAllRegisterRows()" class="px-3.5 py-1.5 text-xs font-bold text-white bg-[#0099ff] hover:bg-[#0088e6] rounded-lg transition flex items-center gap-1.5 shadow-2xs cursor-pointer">
                    <i class="fas fa-compress-arrows-alt text-[11px]"></i> Collapse All
                </button>
            </div>
        </div>

        <!-- Master Register Table Container (Matching Image 2 & 3) -->
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden shadow-2xs">
            <div class="overflow-x-auto">
                <table class="w-full text-xs" id="tblOtherCostRegister">
                    <thead>
                        <tr class="bg-[#dce8f0] dark:bg-slate-700 text-[#2c3e50] dark:text-slate-100 border-b border-slate-300 dark:border-slate-600 font-bold">
                            <th class="py-2.5 px-3 text-left font-bold w-[260px]">Name</th>
                            <th class="py-2.5 px-3 text-left font-bold w-[220px]">Type</th>
                            <th class="py-2.5 px-3 text-right font-bold w-[130px]">Allocation %</th>
                            <th class="py-2.5 px-3 text-right font-bold w-[170px]">Allocation Amount</th>
                            <th class="py-2.5 px-3 text-right font-bold w-[170px]">Breakup Amount</th>
                            <th class="py-2.5 px-2 text-center font-bold w-[80px]">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblRegisterBody" class="divide-y divide-slate-100 dark:divide-slate-700 bg-white dark:bg-slate-800">
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-400">
                                <i class="fas fa-spinner fa-spin mr-2"></i> Select a project to load Other Cost Register...
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700">
                            <td colspan="4" class="py-3 px-3 text-right font-bold text-slate-600 dark:text-slate-300 text-sm">
                                Total Breakup
                            </td>
                            <td class="py-3 px-3 text-right">
                                <div class="inline-block border-2 border-[#80cbc4] bg-white dark:bg-slate-800 rounded px-4 py-1 text-sm font-bold text-[#008000] dark:text-emerald-400 min-w-[140px] text-right shadow-2xs" id="lblRegisterTotalBreakup">
                                    &#8377; 0
                                </div>
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

    </div>

</div>

<!-- Quick Create Service Modal -->
<div id="modalQuickServiceDialog" class="fixed inset-0 z-[9999] overflow-y-auto" style="display: none; background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);">
    <div class="min-h-full flex items-center justify-center p-3 sm:p-4 text-center">
        <div class="relative w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 text-left transform transition-all my-8 overflow-hidden inline-block">
            
            <div class="p-4 sm:p-5 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between bg-slate-50 dark:bg-slate-800/80">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center text-sm font-bold">
                        <i class="fas fa-plus-circle"></i>
                    </div>
                    <h3 class="text-sm font-bold text-slate-800 dark:text-white">Create New Service</h3>
                </div>
                <button type="button" onclick="closeQuickServiceDialog()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 cursor-pointer">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <form id="frmQuickService" onsubmit="event.preventDefault(); submitQuickCreateService();" class="p-5 space-y-3.5 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">
                        Service Code <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="text" id="txtQuickServiceCode" required class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-white focus:ring-1 focus:ring-teal-500 outline-none" />
                        <button type="button" onclick="refreshQuickAutoCode()" class="absolute right-2 top-1.5 px-2 py-1 rounded text-[10px] font-bold bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 transition" title="Auto Next Code">
                            <i class="fas fa-sync-alt mr-1"></i> Auto
                        </button>
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">
                        Service Name / Description <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" id="txtQuickServiceName" required placeholder="e.g. Legal Fees / PMC Consulting" class="w-full text-xs font-semibold px-3 py-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-white focus:ring-1 focus:ring-teal-500 outline-none" />
                </div>

                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">
                        Service Type <span class="text-rose-500">*</span>
                    </label>
                    <select id="ddlQuickServiceType" class="w-full text-xs font-semibold px-3 py-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-white focus:ring-1 focus:ring-teal-500 outline-none cursor-pointer">
                        <option value="1">test</option>
                    </select>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Default Unit (UOM)</label>
                    <select id="ddlQuickServiceUom" class="w-full text-xs font-semibold px-3 py-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-white focus:ring-1 focus:ring-teal-500 outline-none cursor-pointer">
                        <option value="4">Nos</option>
                        <option value="5">Day</option>
                        <option value="6">Month</option>
                        <option value="9">LS</option>
                        <option value="2">Sqm</option>
                        <option value="10">Sft</option>
                        <option value="1">Cum</option>
                        <option value="3">Rmt</option>
                    </select>
                </div>

                <div class="pt-3 border-t border-slate-200 dark:border-slate-700 flex justify-end gap-2.5">
                    <button type="button" onclick="closeQuickServiceDialog()" class="px-4 py-2 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-100 cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-lg text-xs font-bold text-white bg-teal-600 hover:bg-teal-700 cursor-pointer shadow-md flex items-center gap-1.5">
                        <i class="fas fa-save"></i>
                        <span>Save & Select</span>
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Global state
        var allProjects = [];
        var allServices = [];
        var allUoms = [];
        var currentProjectAllocations = [];
        var activeProjectId = "";
        var activeLineRowForServiceCreation = null;

        $(document).ready(function () {
            loadInitialLookups();
            loadNextRefNo();
        });

        // =========================================================================
        // 1. LOOKUPS LOADER
        // =========================================================================

        function loadNextRefNo() {
            $.ajax({
                url: '/OtherCostBreakup/GetNextRefNo',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.nextRefNo) {
                        $('#txtEntryRefNo').val(res.nextRefNo);
                    }
                }
            });
        }

        function loadInitialLookups() {
            // Load Services for auto-suggest / dropdowns
            $.ajax({
                url: '/OtherCostBreakup/GetServices',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        allServices = res.data;
                        var $dl = $('#dlAvailableServices');
                        $dl.empty();
                        allServices.forEach(function (s) {
                            $dl.append(`<option value="${s.serviceName}">${s.servicecode || ''}</option>`);
                        });
                        refreshAllLineServiceDropdowns();
                    }
                }
            });

            // Load UOM list
            $.ajax({
                url: '/OtherCostBreakup/GetUOMList',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        allUoms = res.data;
                    } else {
                        allUoms = [
                            { unitId: 4, unitName: 'Nos' },
                            { unitId: 5, unitName: 'Day' },
                            { unitId: 6, unitName: 'Month' },
                            { unitId: 9, unitName: 'LS' },
                            { unitId: 2, unitName: 'Sqm' },
                            { unitId: 10, unitName: 'Sft' },
                            { unitId: 1, unitName: 'Cum' },
                            { unitId: 3, unitName: 'Rmt' }
                        ];
                    }

                    // Populate quick modal UOM select
                    var $quickUom = $('#ddlQuickServiceUom');
                    if ($quickUom.length) {
                        $quickUom.empty();
                        allUoms.forEach(function (u) {
                            var isSel = String(u.unitId) === '4' ? 'selected' : '';
                            $quickUom.append(`<option value="${u.unitId}" ${isSel}>${u.unitName}</option>`);
                        });
                    }
                }
            });

            // Load Service Types
            $.ajax({
                url: '/OtherCostBreakup/GetServiceTypes',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        var $quickType = $('#ddlQuickServiceType');
                        if ($quickType.length) {
                            $quickType.empty();
                            res.data.forEach(function (st) {
                                $quickType.append(new Option(st.serviceTypeName, st.serviceTypeId));
                            });
                        }
                    }
                }
            });

            // Load Projects
            $.ajax({
                url: '/OtherCostBreakup/GetProjects',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        allProjects = res.data;
                        var $ddlEntry = $('#ddlEntryProject');
                        var $ddlReg = $('#ddlRegisterProject');

                        $ddlEntry.empty().append('<option value="">-- Select Project --</option>');
                        $ddlReg.empty().append('<option value="">-- Select Project --</option>');

                        allProjects.forEach(function (p) {
                            var pId = p.projectKickoffId || p.ProjectKickoffId;
                            var pName = p.projectName || p.ProjectName;
                            $ddlEntry.append(new Option(pName, pId));
                            $ddlReg.append(new Option(pName, pId));
                        });

                        $ddlEntry.off('change').on('change', function () {
                            var val = $(this).val();
                            activeProjectId = val;
                            $ddlReg.val(val);
                            loadNextRefNo();
                            loadProjectBreakupHeaders(val);
                        });

                        $ddlReg.off('change').on('change', function () {
                            var val = $(this).val();
                            activeProjectId = val;
                            $ddlEntry.val(val);
                            loadRegisterData(val);
                        });

                        // Select preselected project if passed, otherwise first project
                        var preselectedProjectId = '@(ViewBag.SelectedProjectId ?? "")';
                        if (preselectedProjectId && allProjects.some(function(p) { return String(p.projectKickoffId || p.ProjectKickoffId) === String(preselectedProjectId); })) {
                            $ddlEntry.val(preselectedProjectId).trigger('change');
                        } else if (allProjects.length > 0) {
                            var firstId = allProjects[0].projectKickoffId || allProjects[0].ProjectKickoffId;
                            $ddlEntry.val(firstId).trigger('change');
                        }
                    }
                }
            });
        }

        // =========================================================================
        // 2. BREAKUP ENTRY: ALLOCATION HEADERS & INTERACTIVE LINES
        // =========================================================================

        function loadProjectBreakupHeaders(projectId) {
            if (!projectId) {
                $('#badgeProjectStatus').text("Select Project");
                $('#lblSummaryTotalAllocated').html('&#8377; 0');
                $('#lblSummaryTotalBreakup').html('&#8377; 0');
                $('#lblSummaryTotalRemaining').html('&#8377; 0');
                $('#breakupCardsToolbar').hide();
                $('#entryBottomActionBar').hide();
                $('#allocationHeadersContainer').html(`
                    <div id="emptyProjectNotice" class="bg-white dark:bg-slate-800 border border-dashed border-slate-300 dark:border-slate-700 rounded-2xl p-10 text-center">
                        <div class="w-14 h-14 mx-auto rounded-full bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center text-2xl mb-3">
                            <i class="fas fa-building"></i>
                        </div>
                        <h3 class="text-base font-bold text-slate-700 dark:text-slate-200">Select a Project to Begin Breakup</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-md mx-auto">
                            Choose a project above to load all its configured Other Cost Allocations as headers, and easily itemize the breakup entries below each header.
                        </p>
                    </div>
                `);
                return;
            }

            var p = allProjects.find(function (x) { return String(x.projectKickoffId || x.ProjectKickoffId) === String(projectId); });
            var pName = p ? (p.projectName || p.ProjectName) : "Project";
            $('#badgeProjectStatus').text(pName);

            $('#allocationHeadersContainer').html(`
                <div class="py-12 text-center text-slate-400">
                    <i class="fas fa-spinner fa-spin text-2xl mb-2 text-teal-600"></i>
                    <p class="text-xs">Loading Other Cost Allocation headers for ${pName}...</p>
                </div>
            `);

            // Fetch allocations along with any existing breakup child lines
            $.ajax({
                url: '/OtherCostBreakup/GetRegister?projectKickoffId=' + encodeURIComponent(projectId),
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data && res.data.length > 0) {
                        currentProjectAllocations = res.data;
                        $('#breakupCardsToolbar').show();
                        $('#lblHeadersCountBadge').text(res.data.length + ' Allocation Headers');
                        renderAllocationHeaders(res.data);
                        $('#entryBottomActionBar').show();
                    } else {
                        currentProjectAllocations = [];
                        $('#lblSummaryTotalAllocated').html('&#8377; 0');
                        $('#lblSummaryTotalBreakup').html('&#8377; 0');
                        $('#lblSummaryTotalRemaining').html('&#8377; 0');
                        $('#breakupCardsToolbar').hide();
                        $('#entryBottomActionBar').hide();
                        $('#allocationHeadersContainer').html(`
                            <div class="bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-700 rounded-2xl p-8 text-center">
                                <div class="w-12 h-12 mx-auto rounded-full bg-amber-500/10 text-amber-600 flex items-center justify-center text-xl mb-3">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </div>
                                <h3 class="text-sm font-bold text-amber-800 dark:text-amber-200">No Other Cost Allocations Found</h3>
                                <p class="text-xs text-amber-700 dark:text-amber-300 mt-1 max-w-md mx-auto">
                                    No allocation records have been created for <strong>${pName}</strong> yet. You must first create Other Cost Allocations in the allocation module.
                                </p>
                                <div class="mt-4">
                                    <a href="@Url.Action("Index", "OtherCostAllocation")" class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white rounded-lg text-xs font-bold inline-flex items-center gap-2 shadow-sm">
                                        <i class="fas fa-plus"></i> Go to Other Cost Allocation
                                    </a>
                                </div>
                            </div>
                        `);
                    }
                },
                error: function () {
                    $('#breakupCardsToolbar').hide();
                    $('#allocationHeadersContainer').html(`
                        <div class="py-8 text-center text-rose-500">
                            Failed to communicate with server. Please try again.
                        </div>
                    `);
                }
            });
        }

        // Expand / Collapse All Cards in Breakup Entry
        function expandAllEntryCards() {
            $('.allocHeaderCard .subTableBody').slideDown(180);
            $('.allocHeaderCard button[onclick="toggleHeaderCard(this)"] i')
                .removeClass('fa-chevron-down')
                .addClass('fa-chevron-up');
        }

        function collapseAllEntryCards() {
            $('.allocHeaderCard .subTableBody').slideUp(180);
            $('.allocHeaderCard button[onclick="toggleHeaderCard(this)"] i')
                .removeClass('fa-chevron-up')
                .addClass('fa-chevron-down');
        }

        // Render each allocation as a Header Card with interactive lines table (Collapsed by default)
        function renderAllocationHeaders(allocations) {
            var $container = $('#allocationHeadersContainer');
            $container.empty();

            var totalProjectAlloc = 0;
            var totalProjectBreakup = 0;

            allocations.forEach(function (a, index) {
                var masId = a.otherCostMasId;
                var bkId = a.otherCostBreakupId || 0;
                var name = a.name || 'Other Cost';
                var dept = a.deptName || '';
                var allocAmt = Math.round(Number(a.allocationAmount || 0));
                var items = a.items || [];

                totalProjectAlloc += allocAmt;

                // Calculate current breakup sum for this header
                var headerBreakupSum = 0;
                items.forEach(function (it) {
                    headerBreakupSum += Math.round(Number(it.amount || ((it.qty || 1) * (it.rate || 0))));
                });
                totalProjectBreakup += headerBreakupSum;

                var remainingAmt = allocAmt - headerBreakupSum;

                var cardHtml = `
                    <div class="allocHeaderCard bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-sm overflow-hidden" 
                         data-mas-id="${masId}" data-breakup-id="${bkId}" data-alloc-amt="${allocAmt}">
                        
                        <!-- Header Bar (Matching Image 1 & 2) -->
                        <div class="p-3.5 sm:p-4 bg-slate-50/90 dark:bg-slate-800/90 border-b border-slate-200 dark:border-slate-700 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
                            <div class="flex items-center gap-3 flex-wrap">
                                <button type="button" onclick="toggleHeaderCard(this)" class="w-8 h-8 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400 hover:bg-teal-500/20 flex items-center justify-center text-sm transition cursor-pointer" title="Expand / Collapse">
                                    <i class="fas fa-chevron-down transition-transform duration-200"></i>
                                </button>
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="text-sm font-bold text-slate-800 dark:text-white tracking-tight">${name}</h3>
                                        ${dept ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">${dept}</span>` : ''}
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300">Budget</span>
                                    </div>
                                    <span class="text-[11px] text-slate-400">Allocation #${masId}</span>
                                </div>
                            </div>

                            <!-- Right Metrics on Header -->
                            <div class="flex items-center gap-3 flex-wrap">
                                <div class="text-right">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Allocated Cap</span>
                                    <span class="text-xs font-bold text-blue-700 dark:text-blue-300">&#8377; ${formatIndianInteger(allocAmt)}</span>
                                </div>
                                <div class="h-6 w-[1px] bg-slate-200 dark:bg-slate-700"></div>
                                <div class="text-right">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Breakup Sum</span>
                                    <span class="text-xs font-black text-emerald-600 dark:text-emerald-400 headerBreakupDisplay">&#8377; ${formatIndianInteger(headerBreakupSum)}</span>
                                </div>
                                <div class="h-6 w-[1px] bg-slate-200 dark:bg-slate-700"></div>
                                <div class="text-right">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Remaining</span>
                                    <span class="text-xs font-bold headerRemainingDisplay ${remainingAmt < 0 ? 'text-rose-600' : 'text-slate-700 dark:text-slate-300'}">&#8377; ${formatIndianInteger(remainingAmt)}</span>
                                </div>
                                <div class="ml-1 headerStatusBadge">
                                    ${getStatusBadgeHtml(allocAmt, headerBreakupSum)}
                                </div>
                            </div>
                        </div>

                        <!-- Sub-Table Container (Interactive Breakup Lines) - COLLAPSED BY DEFAULT -->
                        <div class="subTableBody p-4 bg-white dark:bg-slate-800 space-y-3" style="display: none;">
                            <div class="border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden shadow-2xs">
                                <table class="w-full text-xs tblBreakupLines">
                                    <thead>
                                        <tr class="bg-[#dce8f0] dark:bg-slate-700 text-[#2c3e50] dark:text-slate-100 font-bold border-b border-slate-300 dark:border-slate-600">
                                            <th class="py-2.5 px-3 text-left w-[45%]">Service Name / Description <span class="text-rose-500">*</span></th>
                                            <th class="py-2.5 px-3 text-left w-[15%]">Unit</th>
                                            <th class="py-2.5 px-3 text-right w-[10%]">Qty</th>
                                            <th class="py-2.5 px-3 text-right w-[15%]">Rate (&#8377;)</th>
                                            <th class="py-2.5 px-3 text-right w-[15%]">Amount (&#8377;)</th>
                                            <th class="py-2.5 px-2 text-center w-[40px]"></th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700 tblLinesBody">
                                        <!-- Dynamic rows will be inserted here -->
                                    </tbody>
                                </table>
                            </div>

                            <!-- Add Row Button & Typing Help -->
                            <div class="flex items-center justify-between pt-1">
                                <span class="text-[11px] text-slate-400">
                                    <i class="fas fa-info-circle mr-1"></i> Select service from dropdown or click + to add new. Amounts automatically sum into the header above.
                                </span>
                                <button type="button" onclick="addNewBreakupLine(this)" class="px-3 py-1.5 rounded-lg text-xs font-bold text-teal-700 dark:text-teal-300 bg-teal-50 dark:bg-teal-950/50 hover:bg-teal-100 dark:hover:bg-teal-900 border border-teal-200 dark:border-teal-800 transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                                    <i class="fas fa-plus text-[10px]"></i> Add Line
                                </button>
                            </div>
                        </div>

                    </div>
                `;

                var $card = $(cardHtml);
                var $tbody = $card.find('.tblLinesBody');

                if (items.length > 0) {
                    items.forEach(function (it) {
                        appendLineRow($tbody, it.description || it.serviceName || '', it.unitId || '4', it.qty || 1, it.rate || 0, it.amount || 0, it.serviceId || '', it.serviceTypeId || '1');
                    });
                } else {
                    // Start with an empty active row ready to select
                    appendLineRow($tbody, '', '4', 1, 0, 0, '', '1');
                }

                $container.append($card);
            });

            updateGrandSummary();
        }

        // Build Service Select Options with Quick Create item
        function buildServiceSelectOptions(selectedServiceId, selectedDesc) {
            var opts = '<option value="">-- Select Service --</option>';
            opts += '<option value="__NEW__" class="font-bold text-teal-600 bg-teal-50 dark:bg-teal-950">+ Create New Service...</option>';

            var matched = false;
            allServices.forEach(function (s) {
                var sId = String(s.serviceId || s.ServiceId || '');
                var sName = s.serviceName || s.ServiceName || '';
                var isSel = '';
                if (selectedServiceId && String(selectedServiceId) === sId) {
                    isSel = 'selected';
                    matched = true;
                } else if (!matched && selectedDesc && sName.toLowerCase() === String(selectedDesc).trim().toLowerCase()) {
                    isSel = 'selected';
                    matched = true;
                }
                var uId = s.unitId || s.UnitId || '';
                var stId = s.serviceTypeId || s.ServiceTypeId || '1';
                opts += `<option value="${sId}" data-uom="${uId}" data-servicetype="${stId}" data-name="${sName}" ${isSel}>${sName}</option>`;
            });

            if (selectedDesc && !matched) {
                opts += `<option value="${selectedServiceId || ''}" data-name="${selectedDesc}" selected>${selectedDesc}</option>`;
            }
            return opts;
        }

        // Add a line row to the specific header's table
        function appendLineRow($tbody, desc, unitId, qty, rate, amount, serviceId, serviceTypeId) {
            var roundQty = qty !== undefined && qty !== null ? parseFloat(qty) : 1;
            var roundRate = rate !== undefined && rate !== null ? Math.round(Number(rate)) : 0;
            var roundAmt = amount !== undefined && amount !== null ? Math.round(Number(amount)) : Math.round(roundQty * roundRate);

            var uomOptions = '';
            allUoms.forEach(function (u) {
                var isSel = String(u.unitId) === String(unitId) ? 'selected' : '';
                uomOptions += `<option value="${u.unitId}" ${isSel}>${u.unitName}</option>`;
            });

            var trHtml = `
                <tr class="breakupLineRow hover:bg-slate-50 dark:hover:bg-slate-750 transition">
                    <td class="p-2">
                        <input type="hidden" class="lineServiceId" value="${serviceId || ''}" />
                        <input type="hidden" class="lineServiceTypeId" value="${serviceTypeId || '1'}" />
                        <div class="flex items-center gap-1.5">
                            <select class="lineServiceSelect flex-1 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 dark:text-slate-100 outline-none focus:ring-1 focus:ring-teal-500 cursor-pointer font-medium" 
                                    onchange="onLineServiceSelectChange(this)">
                                ${buildServiceSelectOptions(serviceId, desc)}
                            </select>
                            <button type="button" onclick="openCreateServiceModalForLine(this)" 
                                    class="w-7 h-7 flex-none rounded-lg bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 border border-teal-200 dark:border-teal-800 hover:bg-teal-600 hover:text-white flex items-center justify-center text-xs transition shadow-2xs cursor-pointer" 
                                    title="Create New Service in Master">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </td>
                    <td class="p-2">
                        <select class="lineUnit w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 dark:text-slate-100 outline-none focus:ring-1 focus:ring-teal-500 cursor-pointer">
                            ${uomOptions}
                        </select>
                    </td>
                    <td class="p-2 text-right">
                        <input type="number" step="1" min="1" class="lineQty w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2.5 py-1.5 text-xs text-right font-semibold text-slate-800 dark:text-slate-100 outline-none focus:ring-1 focus:ring-teal-500" 
                                value="${roundQty || 1}" oninput="onLineQtyRateChange(this)" />
                    </td>
                    <td class="p-2 text-right">
                        <input type="number" step="1" min="0" class="lineRate w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2.5 py-1.5 text-xs text-right font-semibold text-slate-800 dark:text-slate-100 outline-none focus:ring-1 focus:ring-teal-500" 
                                value="${roundRate || ''}" placeholder="0" oninput="onLineQtyRateChange(this)" />
                    </td>
                    <td class="p-2 text-right">
                        <input type="number" step="1" min="0" class="lineAmount w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2.5 py-1.5 text-xs text-right font-bold text-teal-700 dark:text-teal-400 outline-none focus:ring-1 focus:ring-teal-500" 
                                value="${roundAmt || ''}" placeholder="0" oninput="onLineAmountChange(this)" />
                    </td>
                    <td class="p-2 text-center">
                        <button type="button" onclick="deleteBreakupLine(this)" class="text-slate-400 hover:text-rose-600 text-sm cursor-pointer p-1 transition" title="Delete Line">
                            <i class="far fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
            `;

            $tbody.append(trHtml);
        }

        function onLineServiceSelectChange(sel) {
            var $sel = $(sel);
            var val = $sel.val();
            var $row = $sel.closest('tr');

            if (val === '__NEW__') {
                openCreateServiceModalForLine(sel);
                return;
            }

            var $opt = $sel.find('option:selected');
            $row.find('.lineServiceId').val(val || '');

            var uom = $opt.data('uom');
            if (uom) {
                $row.find('.lineUnit').val(String(uom));
            }

            var stId = $opt.data('servicetype');
            if (stId) {
                $row.find('.lineServiceTypeId').val(String(stId));
            }

            var $card = $row.closest('.allocHeaderCard');
            recalculateCardTotal($card);
            updateGrandSummary();
        }

        function openCreateServiceModalForLine(btn) {
            activeLineRowForServiceCreation = $(btn).closest('tr');
            $('#txtQuickServiceName').val('');
            refreshQuickAutoCode();
            $('#modalQuickServiceDialog').fadeIn(150);
            setTimeout(function () {
                $('#txtQuickServiceName').focus();
            }, 200);
        }

        function closeQuickServiceDialog() {
            $('#modalQuickServiceDialog').fadeOut(150);
            if (activeLineRowForServiceCreation) {
                var $sel = activeLineRowForServiceCreation.find('.lineServiceSelect');
                if ($sel.val() === '__NEW__') {
                    $sel.val('');
                }
            }
        }

        function refreshQuickAutoCode() {
            $.ajax({
                url: '/ServiceMaster/GetNextCode',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.nextCode) {
                        $('#txtQuickServiceCode').val(res.nextCode);
                    } else {
                        $('#txtQuickServiceCode').val('SVC' + Math.floor(1000 + Math.random() * 9000));
                    }
                },
                error: function () {
                    $('#txtQuickServiceCode').val('SVC' + Math.floor(1000 + Math.random() * 9000));
                }
            });
        }

        function submitQuickCreateService() {
            var code = $('#txtQuickServiceCode').val().trim();
            var name = $('#txtQuickServiceName').val().trim();
            var typeId = $('#ddlQuickServiceType').val() || '1';
            var unitId = $('#ddlQuickServiceUom').val() || '4';

            if (!code || !name) {
                alert("Please enter Service Code and Service Name.");
                return;
            }

            var payload = {
                serviceId: 0,
                servicecode: code,
                serviceName: name,
                serviceTypeId: typeId,
                unitId: unitId,
                status: "1"
            };

            $.ajax({
                url: '/ServiceMaster/Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res && res.success) {
                        var newSvc = {
                            serviceId: res.serviceId,
                            servicecode: code,
                            serviceName: name,
                            serviceTypeId: typeId,
                            unitId: unitId,
                            status: "1"
                        };
                        allServices.push(newSvc);

                        refreshAllLineServiceDropdowns(newSvc.serviceId);

                        if (activeLineRowForServiceCreation && activeLineRowForServiceCreation.length) {
                            var $sel = activeLineRowForServiceCreation.find('.lineServiceSelect');
                            $sel.val(String(newSvc.serviceId)).trigger('change');
                            activeLineRowForServiceCreation.find('.lineServiceTypeId').val(String(typeId));
                            if (unitId) {
                                activeLineRowForServiceCreation.find('.lineUnit').val(String(unitId));
                            }
                        }

                        $('#modalQuickServiceDialog').fadeOut(150);
                    } else {
                        alert(res.message || "Failed to create service.");
                    }
                },
                error: function () {
                    alert("Error creating service. Please try again.");
                }
            });
        }

        function refreshAllLineServiceDropdowns(selectedIdForActive) {
            $('.allocHeaderCard .tblLinesBody tr').each(function () {
                var $row = $(this);
                var $sel = $row.find('.lineServiceSelect');
                var curVal = $sel.val();
                if ($row.is(activeLineRowForServiceCreation) && selectedIdForActive) {
                    curVal = String(selectedIdForActive);
                }
                var curDesc = $sel.find('option:selected').data('name') || $sel.find('option:selected').text();
                $sel.html(buildServiceSelectOptions(curVal, curDesc));
                $sel.val(curVal);
            });
        }

        function addNewBreakupLine(btn) {
            var $card = $(btn).closest('.allocHeaderCard');
            var $tbody = $card.find('.tblLinesBody');
            appendLineRow($tbody, '', '4', 1, 0, 0, '', '1');
            $tbody.find('tr:last .lineServiceSelect').focus();
        }

        function deleteBreakupLine(btn) {
            var $card = $(btn).closest('.allocHeaderCard');
            var $tbody = $card.find('.tblLinesBody');
            var $row = $(btn).closest('tr');

            if ($tbody.find('tr').length > 1) {
                $row.remove();
            } else {
                // If only 1 row left, simply clear inputs
                $row.find('input').val('');
                $row.find('.lineQty').val('1');
            }

            recalculateCardTotal($card);
            updateGrandSummary();
        }

        function onLineQtyRateChange(input) {
            var $row = $(input).closest('tr');
            var qty = parseFloat($row.find('.lineQty').val()) || 1;
            var rate = parseFloat($row.find('.lineRate').val()) || 0;
            var amt = Math.round(qty * rate);
            $row.find('.lineAmount').val(amt > 0 ? amt : '');
            var $card = $(input).closest('.allocHeaderCard');
            recalculateCardTotal($card);
            updateGrandSummary();
        }

        function onLineAmountChange(input) {
            var $row = $(input).closest('tr');
            var amt = parseFloat($(input).val()) || 0;
            var qty = parseFloat($row.find('.lineQty').val()) || 1;
            if (qty > 0 && amt > 0) {
                var rate = Math.round(amt / qty);
                $row.find('.lineRate').val(rate);
            }
            var $card = $(input).closest('.allocHeaderCard');
            recalculateCardTotal($card);
            updateGrandSummary();
        }

        function onLineFieldChange(input) {
            var $card = $(input).closest('.allocHeaderCard');
            recalculateCardTotal($card);
            updateGrandSummary();
        }

        function recalculateCardTotal($card) {
            var cardBreakupSum = 0;
            $card.find('.tblLinesBody tr').each(function () {
                var amtVal = parseFloat($(this).find('.lineAmount').val()) || 0;
                if (amtVal > 0) {
                    cardBreakupSum += Math.round(amtVal);
                }
            });

            var allocAmt = Math.round(Number($card.data('alloc-amt') || 0));
            var remainingAmt = allocAmt - cardBreakupSum;

            $card.find('.headerBreakupDisplay').html('&#8377; ' + formatIndianInteger(cardBreakupSum));
            var $remDisplay = $card.find('.headerRemainingDisplay');
            $remDisplay.html('&#8377; ' + formatIndianInteger(remainingAmt));

            if (remainingAmt < 0) {
                $remDisplay.removeClass('text-slate-700 dark:text-slate-300').addClass('text-rose-600 font-black');
            } else {
                $remDisplay.removeClass('text-rose-600 font-black').addClass('text-slate-700 dark:text-slate-300 font-bold');
            }

            $card.find('.headerStatusBadge').html(getStatusBadgeHtml(allocAmt, cardBreakupSum));
        }

        function updateGrandSummary() {
            var grandAlloc = 0;
            var grandBreakup = 0;

            $('.allocHeaderCard').each(function () {
                var alloc = Math.round(Number($(this).data('alloc-amt') || 0));
                grandAlloc += alloc;

                $(this).find('.tblLinesBody tr').each(function () {
                    var amt = parseFloat($(this).find('.lineAmount').val()) || 0;
                    if (amt > 0) grandBreakup += Math.round(amt);
                });
            });

            var grandRem = grandAlloc - grandBreakup;

            $('#lblSummaryTotalAllocated').html('&#8377; ' + formatIndianInteger(grandAlloc));
            $('#lblSummaryTotalBreakup').html('&#8377; ' + formatIndianInteger(grandBreakup));
            $('#lblSummaryTotalRemaining').html('&#8377; ' + formatIndianInteger(grandRem));
        }

        function getStatusBadgeHtml(alloc, breakup) {
            if (breakup === 0) {
                return `<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-600">Pending Breakup</span>`;
            } else if (breakup < alloc) {
                return `<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 border border-blue-200 dark:border-blue-800">Partially Broken Up</span>`;
            } else if (breakup === alloc) {
                return `<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">Fully Broken Up</span>`;
            } else {
                return `<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-700 dark:bg-rose-950 dark:text-rose-300 border border-rose-200 dark:border-rose-800 flex items-center gap-1"><i class="fas fa-exclamation-circle"></i> Exceeds Allocation</span>`;
            }
        }

        function toggleHeaderCard(btn) {
            var $card = $(btn).closest('.allocHeaderCard');
            var $sub = $card.find('.subTableBody');
            var $icon = $(btn).find('i');
            if ($sub.is(':visible')) {
                $sub.slideUp(180);
                $icon.removeClass('fa-chevron-up').addClass('fa-chevron-down');
            } else {
                $sub.slideDown(180);
                $icon.removeClass('fa-chevron-down').addClass('fa-chevron-up');
            }
        }

        // =========================================================================
        // 3. SAVE ALL BREAKUPS
        // =========================================================================

        function saveAllBreakups() {
            var pId = $('#ddlEntryProject').val();
            if (!pId) {
                alert("Please select a project.");
                return;
            }

            var breakupsList = [];
            var hasAnyLine = false;
            var exceedsAny = false;

            $('.allocHeaderCard').each(function () {
                var $card = $(this);
                var masId = String($card.data('mas-id') || '');
                var bkId = parseInt($card.data('breakup-id')) || 0;
                var allocAmt = Math.round(Number($card.data('alloc-amt') || 0));

                var items = [];
                var cardSum = 0;

                $card.find('.tblLinesBody tr').each(function () {
                    var $svcSel = $(this).find('.lineServiceSelect');
                    var svcId = $svcSel.val();
                    var desc = $svcSel.find('option:selected').data('name') || $svcSel.find('option:selected').text() || '';
                    if (svcId === '__NEW__' || !svcId) {
                        if (!svcId || svcId === '__NEW__') svcId = "";
                    }
                    var unitId = $(this).find('.lineUnit').val() || '4';
                    var serviceTypeId = $(this).find('.lineServiceTypeId').val() || '1';
                    var qty = parseFloat($(this).find('.lineQty').val()) || 1;
                    var rate = parseFloat($(this).find('.lineRate').val()) || 0;
                    var amt = parseFloat($(this).find('.lineAmount').val()) || 0;

                    if (desc && desc.trim() !== "" && desc !== "-- Select Service --" && amt > 0) {
                        hasAnyLine = true;
                        var roundedAmt = Math.round(amt);
                        cardSum += roundedAmt;
                        items.push({
                            description: desc.trim(),
                            serviceName: desc.trim(),
                            serviceId: svcId || "",
                            serviceTypeId: serviceTypeId,
                            unitId: String(unitId),
                            qty: qty,
                            rate: rate,
                            amount: roundedAmt
                        });
                    }
                });

                if (cardSum > allocAmt) {
                    exceedsAny = true;
                }

                if (items.length > 0 || bkId > 0) {
                    breakupsList.push({
                        otherCostBreakupId: bkId > 0 ? bkId : null,
                        otherCostMasId: masId,
                        proectKickOfId: pId,
                        breakupAmount: cardSum,
                        totalAmount: cardSum,
                        remarks: $('#txtEntryRemarks').val() || "",
                        readyForApproval: $('#chkReadyForApproval').is(':checked'),
                        items: items
                    });
                }
            });

            if (!hasAnyLine) {
                alert("Please select a service and enter quantity & rate for at least one breakup line.");
                return;
            }

            if (exceedsAny) {
                if (!confirm("One or more Other Cost headers exceed their allocated cap amount. Are you sure you want to proceed and save?")) {
                    return;
                }
            }

            var refNoVal = parseFloat($('#txtEntryRefNo').val());
            if (isNaN(refNoVal) || refNoVal <= 0) {
                refNoVal = 1;
            }

            var payload = {
                proectKickOfId: pId,
                projectName: $('#ddlEntryProject option:selected').text(),
                refDate: new Date().toISOString(),
                refNo: refNoVal,
                type: $('#txtEntryType').val() || "Budget",
                revisionStatus: $('#ddlEntryRevision').val() || "Yes",
                remarks: $('#txtEntryRemarks').val() || "",
                readyForApproval: $('#chkReadyForApproval').is(':checked'),
                breakups: breakupsList
            };

            $.ajax({
                url: '/OtherCostBreakup/SaveBatch',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res && res.success) {
                        alert(res.message || "Other Cost Breakup saved successfully!");
                        // Reload headers to refresh with DB IDs
                        loadProjectBreakupHeaders(pId);
                    } else {
                        alert(res.message || "Failed to save breakup.");
                    }
                },
                error: function () {
                    alert("Error saving breakup. Please check connection and try again.");
                }
            });
        }

        // =========================================================================
        // 4. REGISTER VIEW (MATCHING IMAGES 2 & 3)
        // =========================================================================

        function loadRegisterData(pId) {
            if (!pId) {
                $('#tblRegisterBody').html(`
                    <tr>
                        <td colspan="6" class="py-8 text-center text-slate-400">
                            Please select a project to view the Other Cost Register.
                        </td>
                    </tr>
                `);
                $('#lblRegisterTotalBreakup').html('&#8377; 0');
                return;
            }

            $('#tblRegisterBody').html(`
                <tr>
                    <td colspan="6" class="py-8 text-center text-slate-400">
                        <i class="fas fa-spinner fa-spin mr-2"></i> Loading Other Cost Register...
                    </td>
                </tr>
            `);

            $.ajax({
                url: '/OtherCostBreakup/GetRegister?projectKickoffId=' + encodeURIComponent(pId),
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data && res.data.length > 0) {
                        renderRegisterRows(res.data);
                    } else {
                        $('#tblRegisterBody').html(`
                            <tr>
                                <td colspan="6" class="py-8 text-center text-slate-400">
                                    No Other Cost Allocation records found for this project.
                                </td>
                            </tr>
                        `);
                        $('#lblRegisterTotalBreakup').html('&#8377; 0');
                    }
                },
                error: function () {
                    $('#tblRegisterBody').html(`
                        <tr>
                            <td colspan="6" class="py-8 text-center text-rose-500">
                                Failed to communicate with server.
                            </td>
                        </tr>
                    `);
                }
            });
        }

        function renderRegisterRows(rows) {
            var $body = $('#tblRegisterBody');
            $body.empty();

            var grandBreakup = 0;

            rows.forEach(function (r) {
                var childRowId = 'regChild_' + r.otherCostMasId;
                var allocAmt = Math.round(Number(r.allocationAmount || 0));
                var allocPer = Math.round(Number(r.allocationPer || 0));
                var breakupAmt = Math.round(Number(r.breakupAmount || 0));
                grandBreakup += breakupAmt;

                var hasItems = r.items && r.items.length > 0;

                var masterTr = `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-750 transition">
                        <td class="py-2.5 px-3">
                            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 font-medium shadow-2xs">
                                ${r.name}
                            </div>
                        </td>
                        <td class="py-2.5 px-3">
                            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 shadow-2xs">
                                ${r.type || 'Budget'}
                            </div>
                        </td>
                        <td class="py-2.5 px-3 text-right">
                            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-1.5 text-xs text-right text-slate-800 dark:text-slate-100 shadow-2xs">
                                ${allocPer}%
                            </div>
                        </td>
                        <td class="py-2.5 px-3 text-right">
                            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-1.5 text-xs text-right font-semibold text-blue-700 dark:text-blue-300 shadow-2xs">
                                &#8377; ${formatIndianInteger(allocAmt)}
                            </div>
                        </td>
                        <td class="py-2.5 px-3 text-right">
                            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-1.5 text-xs text-right font-bold text-emerald-600 dark:text-emerald-400 shadow-2xs">
                                &#8377; ${formatIndianInteger(breakupAmt)}
                            </div>
                        </td>
                        <td class="py-2.5 px-2 text-center whitespace-nowrap">
                            <button type="button" onclick="toggleRegisterRow('${childRowId}', this)" class="text-[#4a90e2] hover:text-[#2a70c2] text-xl cursor-pointer p-0.5" title="Expand / Collapse">
                                <i class="fas fa-chevron-circle-down"></i>
                            </button>
                            <button type="button" onclick="editHeaderInBreakupEntry('${r.otherCostMasId}')" class="text-[#4a90e2] hover:text-[#2a70c2] text-lg cursor-pointer p-0.5 ml-2" title="Edit in Breakup Entry">
                                <i class="far fa-edit"></i>
                            </button>
                        </td>
                    </tr>
                `;

                var childLinesHtml = '';
                if (hasItems) {
                    r.items.forEach(function (it) {
                        var desc = it.description || it.serviceName || 'Line Item';
                        var unit = it.unitName || 'Nos';
                        var qty = it.qty || 1;
                        var rate = Math.round(Number(it.rate || 0));
                        var amt = Math.round(Number(it.amount || 0));
                        childLinesHtml += `
                            <tr class="bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800">
                                <td class="py-2 px-3 text-left text-slate-700 dark:text-slate-300">${desc}</td>
                                <td class="py-2 px-3 text-left text-slate-600 dark:text-slate-400">${unit}</td>
                                <td class="py-2 px-3 text-right text-slate-700 dark:text-slate-300">${qty}</td>
                                <td class="py-2 px-3 text-right text-slate-700 dark:text-slate-300">&#8377; ${formatIndianInteger(rate)}</td>
                                <td class="py-2 px-3 text-right font-bold text-emerald-600 dark:text-emerald-400">&#8377; ${formatIndianInteger(amt)}</td>
                            </tr>
                        `;
                    });
                } else {
                    childLinesHtml = `
                        <tr>
                            <td colspan="5" class="py-3 px-3 text-center text-slate-400 italic">
                                No breakup line items added yet. Click edit to itemize.
                            </td>
                        </tr>
                    `;
                }

                var childTr = `
                    <tr id="${childRowId}" class="regChildRow hidden bg-slate-50 dark:bg-slate-900">
                        <td colspan="6" class="p-3 pl-8 pr-6">
                            <div class="border border-slate-300 dark:border-slate-700 rounded-xl overflow-hidden shadow-2xs bg-white dark:bg-slate-800">
                                <table class="w-full text-xs">
                                    <thead class="bg-[#b9d5ec] dark:bg-slate-700 text-[#2c3e50] dark:text-slate-100 font-bold border-b border-slate-300 dark:border-slate-600">
                                        <tr>
                                            <th class="py-2 px-3 text-left">Description</th>
                                            <th class="py-2 px-3 text-left w-24">Unit</th>
                                            <th class="py-2 px-3 text-right w-24">Qty</th>
                                            <th class="py-2 px-3 text-right w-28">Rate (&#8377;)</th>
                                            <th class="py-2 px-3 text-right w-32">Amount (&#8377;)</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                                        ${childLinesHtml}
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                `;

                $body.append(masterTr).append(childTr);
            });

            $('#lblRegisterTotalBreakup').html('&#8377; ' + formatIndianInteger(grandBreakup));
        }

        function toggleRegisterRow(childId, btn) {
            var $child = $('#' + childId);
            var $icon = $(btn).find('i');
            if ($child.hasClass('hidden')) {
                $child.removeClass('hidden');
                $icon.removeClass('fa-chevron-circle-down').addClass('fa-chevron-circle-up');
            } else {
                $child.addClass('hidden');
                $icon.removeClass('fa-chevron-circle-up').addClass('fa-chevron-circle-down');
            }
        }

        function expandAllRegisterRows() {
            $('.regChildRow').removeClass('hidden');
            $('#tblRegisterBody button i.fa-chevron-circle-down')
                .removeClass('fa-chevron-circle-down')
                .addClass('fa-chevron-circle-up');
        }

        function collapseAllRegisterRows() {
            $('.regChildRow').addClass('hidden');
            $('#tblRegisterBody button i.fa-chevron-circle-up')
                .removeClass('fa-chevron-circle-up')
                .addClass('fa-chevron-circle-down');
        }

        // =========================================================================
        // 5. VIEW SWITCHING
        // =========================================================================

        function switchToEntryView() {
            $('#viewBreakupRegister').hide();
            $('#viewBreakupEntry').fadeIn(150);
            $('#btnTabEntry').removeClass('bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 border').addClass('bg-teal-600 text-white');
            $('#btnTabRegister').removeClass('bg-teal-600 text-white').addClass('bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-600');
        }

        function editHeaderInBreakupEntry(masId) {
            switchToEntryView();
            setTimeout(function () {
                var $card = $(`.allocHeaderCard[data-mas-id="${masId}"]`);
                if ($card.length) {
                    var $sub = $card.find('.subTableBody');
                    var $icon = $card.find('button[onclick="toggleHeaderCard(this)"] i');
                    $sub.slideDown(180);
                    $icon.removeClass('fa-chevron-down').addClass('fa-chevron-up');
                    $('html, body').animate({
                        scrollTop: $card.offset().top - 100
                    }, 300);
                }
            }, 200);
        }

        function switchToRegisterView() {
            $('#viewBreakupEntry').hide();
            $('#viewBreakupRegister').fadeIn(150);
            $('#btnTabRegister').removeClass('bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 border').addClass('bg-teal-600 text-white');
            $('#btnTabEntry').removeClass('bg-teal-600 text-white').addClass('bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-600');
            var pId = $('#ddlEntryProject').val();
            if (pId) {
                $('#ddlRegisterProject').val(pId);
                loadRegisterData(pId);
            }
        }

        // =========================================================================
        // 6. HELPER FUNCTIONS (NO DECIMALS, INDIAN NUMBER FORMATTING)
        // =========================================================================

        function formatIndianInteger(num) {
            if (num === null || num === undefined || isNaN(num)) return "0";
            var rounded = Math.round(Number(num));
            var isNeg = rounded < 0;
            var str = Math.abs(rounded).toString();
            var lastThree = str.substring(str.length - 3);
            var otherNumbers = str.substring(0, str.length - 3);
            if (otherNumbers !== '') {
                lastThree = ',' + lastThree;
            }
            var res = otherNumbers.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + lastThree;
            return (isNeg ? "-" : "") + res;
        }
    </script>
}