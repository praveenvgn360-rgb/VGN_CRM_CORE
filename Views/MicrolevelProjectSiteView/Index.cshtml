@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Pill tabs switching
            const tabs = document.querySelectorAll('.tab-pill');
            const panes = document.querySelectorAll('.tab-pane');

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    // Reset all tabs
                    tabs.forEach(t => {
                        t.classList.remove('active', 'border-indigo-600', 'text-indigo-600');
                        t.classList.add('border-transparent', 'text-gray-500');
                    });
                    // Set current tab active
                    tab.classList.add('active', 'border-indigo-600', 'text-indigo-600');
                    tab.classList.remove('border-transparent', 'text-gray-500');

                    // Hide all panes
                    panes.forEach(p => p.classList.remove('active'));
                    // Show target pane
                    const target = tab.getAttribute('data-target');
                    const pane = document.getElementById(target);
                    if(pane) {
                        pane.classList.add('active');
                        // Trigger a resize event to ensure DevExtreme grids layout correctly when made visible
                        setTimeout(() => { window.dispatchEvent(new Event('resize')); }, 50);
                    }
                });
            });

            // Initialize Select2 with cleaner look
            $('.select2').select2({
                width: '100%',
                dropdownCssClass: 'rounded-xl border-slate-200 shadow-xl overflow-hidden text-sm',
            });

            // Simple modal toggling (to replace bootstrap data-toggle/data-target where possible)
            // Note: The JS files might still rely on jQuery modal like $('#imgpopup').modal('show') 
            // We ensure classes are toggled or override the modal behavior if needed.
            // But if they use bootstrap JS, these manual toggles help fallback.
            
            function openModal(id) {
                const el = document.getElementById(id);
                if(el) {
                    el.classList.remove('hidden');
                    el.classList.add('flex');
                    document.body.style.overflow = 'hidden';
                }
            }
            
            function closeModal(id) {
                const el = document.getElementById(id);
                if(el) {
                    el.classList.add('hidden');
                    el.classList.remove('flex');
                    document.body.style.overflow = '';
                }
            }

            document.querySelectorAll('.open-modal').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const target = e.currentTarget.getAttribute('data-target');
                    openModal(target);
                });
            });

            document.querySelectorAll('.close-modal').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const target = e.currentTarget.getAttribute('data-modal');
                    closeModal(target);
                });
            });

            // Patch for jQuery modal if used in external JS to use our classes
            if (window.jQuery) {
                const origModal = $.fn.modal;
                $.fn.modal = function(action) {
                    if (action === 'show') {
                        this.removeClass('hidden').addClass('flex');
                        document.body.style.overflow = 'hidden';
                    } else if (action === 'hide') {
                        this.addClass('hidden').removeClass('flex');
                        document.body.style.overflow = '';
                    } else {
                        // Fallback
                        return origModal.apply(this, arguments);
                    }
                };
            }
        });
    </script>
}