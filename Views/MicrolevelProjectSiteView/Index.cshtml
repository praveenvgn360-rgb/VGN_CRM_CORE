@using Microsoft.AspNetCore.Http

@{
    ViewBag.Title = "MicroLevel ProjectSite View";
}

@* @{
    ViewBag.Title = "MicroLevel ProjectSite View";
    Layout = "~/Views/Shared/_Layout.cshtml";
} *@

<!-- Hidden Inputs required for JS -->
<input type="hidden" id="HDept_id" value="@Context.Session.GetString("DepartmentID")" />
<input type="hidden" id="HLogin_id" value="@Context.Session.GetString("UserId")" />
<input type="hidden" id="HProjectID" value="@Context.Request.Query["ProjectId"]" />
<input type="hidden" id="HProjecttype" value="@Context.Request.Query["type"]" />
<input type="hidden" id="HClientID" value="@Context.Request.Query["clientid"]" />
<input type="hidden" id="HMonth" value="@Context.Request.Query["month"]" />
<input type="hidden" id="HStatus" value="@Context.Request.Query["Status"]" />
<input type="hidden" id="HModelFlag" value="@Context.Request.Query["ModelFlag"]" />
<input type="hidden" id="HFromRange" value="@Context.Request.Query["FromRange"]" />
<input type="hidden" id="HToRange" value="@Context.Request.Query["ToRange"]" />
<input type="hidden" id="HStockType" value="@Context.Request.Query["StockType"]" />
<input type="hidden" id="Huser_id" value="@Context.Session.GetString("UserId")" />

<style>
    /* ══════════════════════════════════════════════════════════════════
       MicrolevelProjectSiteView — Page Styles
       ALL font-size and font-family values use CSS variables from
       _Layout.cshtml so the Settings → Font controls affect this page
       exactly like every other page in the application.
    ══════════════════════════════════════════════════════════════════ */

    .glass-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }

    [data-theme="dark"] .glass-card {
        background: #1e293b;
        border: 1px solid #334155;
        box-shadow: 0 2px 12px rgba(0,0,0,0.2);
    }

    /* KPI input fields */
    .kpi-input {
        width: 75px;
        background: transparent !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 2px;
        box-shadow: none !important;
        outline: none !important;
        font-weight: 700;
        font-size: 0.7rem;
        font-family: var(--font-family);
        color: inherit;
        text-align: right;
        padding: 0 4px;
        margin: 0;
        height: 18px;
    }

    [data-theme="dark"] .kpi-input {
        border-color: #475569 !important;
    }

    .kpi-table {
        width: max-content;
        border-collapse: separate;
        border-spacing: 0;
    }

    /* KPI table headers */
    .kpi-table th {
        font-size: 0.7rem;
        font-family: var(--font-family);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 2px 4px;
        border-bottom: 2px solid #e2e8f0;
        text-align: center;
    }

    [data-theme="dark"] .kpi-table th {
        border-bottom-color: #334155;
    }

    .kpi-table td {
        padding: 1px 4px;
        border-bottom: 1px dashed #e2e8f0;
        transition: all 0.2s ease;
    }

    [data-theme="dark"] .kpi-table td {
        border-bottom-color: #334155;
    }

    .kpi-table tr:hover td {
        background: rgba(241, 245, 249, 0.4);
    }
    [data-theme="dark"] .kpi-table tr:hover td {
        background: rgba(15, 23, 42, 0.4);
    }

    .kpi-table tr:last-child td {
        border-bottom: none;
    }

    .status-indicator {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        box-shadow: 0 0 0 1px rgba(255,255,255,0.5);
    }

    /* Row labels */
    .row-label {
        font-size: 0.7rem;
        font-family: var(--font-family);
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    [data-theme="dark"] .row-label {
        color: #94a3b8;
    }

    .color-avail { color: #0284c7; }
    .color-book  { color: #d97706; }
    .color-block { color: #dc2626; }
    .color-reg   { color: #7c3aed; }
    .color-total { color: #059669; font-weight: 800; }

    [data-theme="dark"] .color-avail { color: #38bdf8; }
    [data-theme="dark"] .color-book  { color: #fbbf24; }
    [data-theme="dark"] .color-block { color: #f87171; }
    [data-theme="dark"] .color-reg   { color: #a78bfa; }
    [data-theme="dark"] .color-total { color: #34d399; }

    .bg-avail { background-color: #0ea5e9; }
    .bg-book  { background-color: #f59e0b; }
    .bg-block { background-color: #ef4444; }
    .bg-reg   { background-color: #8b5cf6; }
    .bg-total { background-color: #10b981; }

    .tab-pane {
        display: none;
        animation: slideUpFade 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .tab-pane.active {
        display: block;
    }

    @@keyframes slideUpFade {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .loader-container {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
    }
    .loader-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(79, 70, 229, 0.2);
        border-top-color: #4f46e5;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Modal Styles */
    .modal-overlay {
        backdrop-filter: blur(5px);
        background: rgba(15, 23, 42, 0.6);
    }
    .modal-content {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    /* Select2 — font follows global layout variables */
    .select2-container--default .select2-selection--single {
        border-radius: 4px;
        border: 1px solid #e2e8f0;
        height: 24px;
        display: flex;
        align-items: center;
        font-size: 0.75rem;
        font-family: var(--font-family);
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 22px !important;
        padding-left: 4px !important;
    }
    [data-theme="dark"] .select2-container--default .select2-selection--single {
        background-color: #1e293b;
        border-color: #334155;
    }
    [data-theme="dark"] .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #e2e8f0;
    }

    /* ══ DataGrid — visual wrapper only (fonts handled globally by _Layout.cshtml) ══
       _Layout.cshtml global rules set font-size, font-family on .dx-datagrid,
       .dx-header-row, .dx-data-row, .dx-filter-row using --font-size-grid,
       --font-size-grid-header, and --font-family CSS variables — same as every
       other page. DO NOT re-declare font-size/font-family here. */
    .dx-datagrid {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }
    [data-theme="dark"] .dx-datagrid {
        border-color: #334155;
    }
    .grid-wrapper {
        min-height: 200px;
    }
</style>

<div class="px-4 py-3 max-w-[1920px] mx-auto">

