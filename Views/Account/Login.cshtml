@model VGN_CRM_CORE.Models.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Sign in — VGN 360</title>
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<link href="~/css/font-awesome.css" rel="stylesheet" />
<link href="~/css/login-galaxy.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<div class="login-card">
<section class="panel-left" aria-label="VGN 360 department galaxy">
<header class="galaxy-header">
    <a class="brand" href="/" aria-label="VGN Homes">
        <img src="https://www.vgnhomes.org/assets/logo-383UpFOO.svg" alt="VGN Homes" class="brand-svg-logo" />
    </a>
</header>
<div class="galaxy-intro"><span class="eyebrow">ONE UNIVERSE. ENDLESS POSSIBILITIES.</span><h1>Every department.<br /><span>One connected universe.</span></h1></div>
<div class="galaxy-viewport">
<div class="galaxy-stage" id="galaxyStage">
<div class="nebula" aria-hidden="true"></div>
<div class="galaxy-core">
    <img src="~/images/VGN360.png" alt="VGN 360" class="galaxy-center-logo" />
</div>
<ul class="departments" aria-label="Departments">
    <li class="department planet-0" style="--delay:-0.0s"><span class="planet" aria-hidden="true"></span><span class="planet-label">PROJECT MANAGEMENT</span></li>
    <li class="department planet-1" style="--delay:-0.7s"><span class="planet" aria-hidden="true"></span><span class="planet-label">ORGANIZATION &amp; ADMINISTRATION</span></li>
    <li class="department planet-2" style="--delay:-1.4s"><span class="planet" aria-hidden="true"></span><span class="planet-label">LAND PURCHASE</span></li>
    <li class="department planet-3" style="--delay:-2.1s"><span class="planet" aria-hidden="true"></span><span class="planet-label">LIAISON</span></li>
    <li class="department planet-0" style="--delay:-2.8s"><span class="planet" aria-hidden="true"></span><span class="planet-label">LEGAL</span></li>
    <li class="department planet-1" style="--delay:-3.5s"><span class="planet" aria-hidden="true"></span><span class="planet-label">CIVIL PLANNING &amp; MONITORING</span></li>
    <li class="department planet-2" style="--delay:-4.2s"><span class="planet" aria-hidden="true"></span><span class="planet-label">BOQ &amp; ESTIMATION</span></li>
    <li class="department planet-3" style="--delay:-4.9s"><span class="planet" aria-hidden="true"></span><span class="planet-label">STORES</span></li>
    <li class="department planet-0" style="--delay:-5.6s"><span class="planet" aria-hidden="true"></span><span class="planet-label">PURCHASE</span></li>
    <li class="department planet-1" style="--delay:-6.3s"><span class="planet" aria-hidden="true"></span><span class="planet-label">MARKETING</span></li>
    <li class="department planet-2" style="--delay:-7.0s"><span class="planet" aria-hidden="true"></span><span class="planet-label">PRESALES &amp; TELECALLER</span></li>
    <li class="department planet-3" style="--delay:-7.7s"><span class="planet" aria-hidden="true"></span><span class="planet-label">SALES</span></li>
    <li class="department planet-0" style="--delay:-8.4s"><span class="planet" aria-hidden="true"></span><span class="planet-label">CRM</span></li>
    <li class="department planet-1" style="--delay:-9.1s"><span class="planet" aria-hidden="true"></span><span class="planet-label">DOCUMENTATION</span></li>
    <li class="department planet-2" style="--delay:-9.8s"><span class="planet" aria-hidden="true"></span><span class="planet-label">IT</span></li>
    <li class="department planet-3" style="--delay:-10.5s"><span class="planet" aria-hidden="true"></span><span class="planet-label">HR</span></li>
    <li class="department planet-0" style="--delay:-11.2s"><span class="planet" aria-hidden="true"></span><span class="planet-label">FINANCE &amp; ACCOUNTS</span></li>
    <li class="department planet-1" style="--delay:-11.9s"><span class="planet" aria-hidden="true"></span><span class="planet-label">TRANSPORT</span></li>
    <li class="department planet-2" style="--delay:-12.6s"><span class="planet" aria-hidden="true"></span><span class="planet-label">FILE MANAGEMENT</span></li>
</ul>
</div>
</div>
<footer class="galaxy-footer">
    <button type="button" id="motionToggle" aria-pressed="false">Pause motion <span aria-hidden="true">Ⅱ</span></button>
</footer>
</section>
    <div class="panel-right">
        <div class="brand-logo-container">
            <img src="~/images/VGN360.png" alt="VGN 360" class="brand-logo-img" />
        </div>
        <div class="welcome-heading">
            <div class="welcome-title">Welcome back.</div>
            <div class="welcome-sub">Your workspace. Your people. One connected universe.</div>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(""))
        {
            <div class="alert-box" id="alertBox">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @foreach (var err in ViewData.ModelState[""].Errors)
                {
                    <span>@err.ErrorMessage</span>
                }
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@ViewBag.ReturnUrl" />

            <div class="field-wrap">
                <label for="UserId" class="field-label"><i class="bi bi-person" style="margin-right:7px;color:#d10000"></i>User ID</label>
                <div class="input-shell">
                    <span class="input-icon"><i class="bi bi-person"></i></span>
                    <input asp-for="UserId" id="UserId" placeholder="Enter your User ID" autocomplete="username" />
                </div>
                <span asp-validation-for="UserId" class="err-msg"></span>
            </div>

            <div class="field-wrap">
                <label for="PasswordInput" class="field-label"><i class="bi bi-lock" style="margin-right:7px;color:#d10000"></i>Password</label>
                <div class="input-shell pos-rel">
                    <span class="input-icon"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" id="PasswordInput" placeholder="Enter your password" autocomplete="current-password" style="padding-right:42px" />
                    <button type="button" class="eye-btn" onclick="togglePwd()" title="Show password" aria-label="Show password" aria-pressed="false">
                        <i class="bi bi-eye-slash" id="pwdIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="err-msg"></span>
            </div>

            <div class="field-wrap" style="margin-bottom:24px">
                <label for="LoginType" class="field-label"><i class="bi bi-people" style="margin-right:7px;color:#d10000"></i>Login Type</label>
                <div class="input-shell pos-rel">
                    <span class="input-icon"><i class="bi bi-people"></i></span>
                    <select name="LoginType" id="LoginType">
                        <option value="CORPORATE">CORPORATE</option>
                        <option value="CHANNELPARTNER">CHANNEL PARTNER</option>
                    </select>
                    <i class="bi bi-chevron-down" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);pointer-events:none;color:#94a3b8;font-size:0.75rem"></i>
                </div>
            </div>

            <button type="submit" class="btn-signin">
                <i class="bi bi-box-arrow-in-right"></i>
                <span>Sign In to VGN 360</span>
            </button>
        </form>
    </div>
</div>


<script src="~/js/login-galaxy.js" asp-append-version="true"></script>
@if (ViewBag.KickedOut == true)
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.32/dist/sweetalert2.all.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.32/dist/sweetalert2.min.css" rel="stylesheet">
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
                icon: 'warning',
                title: 'Session Ended',
                text: 'Same userid logged in using another system.',
                confirmButtonColor: '#d10000',
                customClass: {
                    popup: 'rounded-2xl shadow-2xl border-0 bg-white text-gray-900',
                    confirmButton: 'inline-flex items-center justify-center rounded-xl px-6 py-2 font-bold text-white cursor-pointer bg-red-600 hover:bg-red-700'
                }
            });
        });
    </script>
}

</body>
</html>
