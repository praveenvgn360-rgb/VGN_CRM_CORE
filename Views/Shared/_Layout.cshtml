        .bi-list-task::before { content: "\f0ca"; }
        .bi-lightning-fill::before { content: "\f0e7"; }
        .bi-lightning-charge::before { content: "\f0e7"; }
        .bi-scales::before { content: "\f24e"; }
        .bi-mic-fill::before { content: "\f130"; }
        /* Social Media */
        .bi-facebook::before { content: "\f09a"; font-family: "Font Awesome 6 Brands", "Font Awesome 5 Brands"; font-weight: 400; }
        .bi-instagram::before { content: "\f16d"; font-family: "Font Awesome 6 Brands", "Font Awesome 5 Brands"; font-weight: 400; }
        .bi-youtube::before { content: "\f167"; font-family: "Font Awesome 6 Brands", "Font Awesome 5 Brands"; font-weight: 400; }
        .bi-linkedin::before { content: "\f0e1"; font-family: "Font Awesome 6 Brands", "Font Awesome 5 Brands"; font-weight: 400; }
        .bi-whatsapp::before { content: "\f232"; font-family: "Font Awesome 6 Brands", "Font Awesome 5 Brands"; font-weight: 400; }
        .bi-google::before { content: "\f1a0"; font-family: "Font Awesome 6 Brands", "Font Awesome 5 Brands"; font-weight: 400; }
        /* Login page */
        .bi-lock::before { content: "\f023"; }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>

    <!-- ██ CIRCULAR / ANNOUNCEMENT SCROLLING BAR ████████████ -->
    <div class="circular-bar" id="circularBar">
        <div class="circular-bar-label">
            <i class="fas fa-bullhorn"></i> CIRCULARS
        </div>
        <div class="circular-bar-track">
            <div class="circular-bar-inner" id="circularBarInner">
                <!-- items injected by JS — duplicated for seamless loop -->
            </div>
        </div>
    </div>

    <!-- ██ SIDEBAR ████████████████████████████████████████████ -->


    <nav id="sidebar">
        <!-- 1. TABS AT THE TOP (as per Screenshot 1) -->
        <div class="sidebar-tabs">
            <button class="sb-tab active" id="tab-grid" onclick="switchSidebarView('tiles', this)" title="Tiles View">
                <i class="fas fa-th"></i>
            </button>
            <button class="sb-tab" id="tab-list" onclick="switchSidebarView('list', this)" title="List View">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <!-- 2. LOGO AREA -->
        <div class="sidebar-logo">
            <img src="~/images/VGN360.png" alt="VGN360" style="max-height:56px; max-width:100%; object-fit:contain;" />
        </div>

        <!-- 2.5 MENU SEARCH BOX -->
        <div class="sidebar-search-wrap">
            <div class="sidebar-search">
                <i class="fas fa-search"></i>
                <input type="text" id="menuSearch" placeholder="Search menus..." onkeyup="filterMenus()">
            </div>
        </div>

        <!-- 3. MAIN NAVIGATION CONTENT -->
        <div class="sidebar-nav" id="sidebar-home">
            @* "Main" section label intentionally removed — no hardcoded group header needed *@

            <!-- Dashboard (Tiles View) -->
            <a class="nav-link-tile tile-blue grid-only-item @(ViewBag.ActiveMenu == "Dashboard" ? "active" : "")" href="/GeneralDashboard/Index" title="Dashboard">
                <i class="fas fa-th-large"></i><span>Dashboard</span>
            </a>

            <!-- Dashboard (List View) -->
            <a class="nav-link list-only-item @(ViewBag.ActiveMenu == "Dashboard" ? "active" : "")" href="/GeneralDashboard/Index" title="Dashboard">
                <i class="fas fa-th-large"></i><span>Dashboard</span>
            </a>

            @if (dynamicMenus != null && dynamicMenus.Any())
            {
                var departments = dynamicMenus.GroupBy(m => m.Department).OrderBy(g => g.Key).ToList();
                string[] tileColors = { "tile-cyan", "tile-purple", "tile-green", "tile-blue", "tile-brown", "tile-pink", "tile-red", "tile-lime", "tile-orange", "tile-teal" };

                // FIX #4: shared module-type display order used for BOTH list view and detail-template view
                string[] moduleTypeOrder = { "DASHBOARD", "MASTER", "ACTIVITY", "REPORT" };

                for (int i = 0; i < departments.Count; i++)
                {
                    var deptGroup = departments[i];
                    string deptName = deptGroup.Key ?? "COMMON";
                    string safeDeptId = "dept-" + i;
                    string colorClass = tileColors[i % tileColors.Length];

                    // Icon Mapping
                    string icon = "fa-folder-open";
                    if (deptName.Contains("ADMINISTRATION")) { icon = "fa-id-badge"; }
                    else if (deptName.Contains("HR") || deptName.Contains("HUMAN")) { icon = "fa-users"; }
                    else if (deptName.Contains("SALES")) { icon = "fa-shopping-cart"; }
                    else if (deptName.Contains("CIVIL")) { icon = "fa-building"; }
                    else if (deptName.Contains("PURCHASE")) { icon = "fa-shopping-bag"; }
                    else if (deptName.Contains("IT")) { icon = "fa-microchip"; }
                    else if (deptName.Contains("FINANCE") || deptName.Contains("ACCOUNTS")) { icon = "fa-money-bill-wave"; }
                    else if (deptName.Contains("CRM")) { icon = "fa-headset"; }

                    <!-- LIST VIEW ITEM (Accordion) -->
                    <a class="nav-link list-only-item" onclick="vgnToggle(this,'#@safeDeptId')" data-vgn-target="#@safeDeptId" style="justify-content:space-between" title="@deptName">
                        <span class="flex items-center gap-2">
                            <i class="fas @icon"></i>
                            <span>@deptName</span>
                        </span>
                        <i class="fas fa-chevron-down text-sm" style="transition:transform .2s"></i>
                    </a>

                    <div class="nav-sub list-only-item flex-col" id="@safeDeptId" style="display:none;">
                        @{
                            var moduleTypes = deptGroup
                            .GroupBy(m => m.ModuleType)
                            .OrderBy(g =>
                            {
                                int idx = Array.IndexOf(moduleTypeOrder, (g.Key ?? "").ToUpper());
                                return idx == -1 ? int.MaxValue : idx;
                            });
                        }
                        @foreach (var modGroup in moduleTypes)
                        {
                            string modType = modGroup.Key ?? "OTHER";
                            <!-- FIX #4: module-type sub-header now rendered in LIST view too -->
                            <div class="nav-section-sub list-only-item"><span class="nav-label-sub">@modType</span></div>
                            @foreach (var item in modGroup.OrderBy(m => m.ModuleCaptionName))
                            {
                                string url = "/" + item.ControllerName + "/" + item.ActionName;
                                <a class="nav-link list-only-item" href="@url" style="font-size: 0.82rem; padding: 0.4rem 1rem 0.4rem 2rem">
                                    <span>@item.ModuleCaptionName</span>
                                </a>
                            }
                        }
                    </div>

                    <!-- GRID VIEW TILE -->
                    <div class="nav-link-tile @colorClass grid-only-item" onclick="openSidebarDetail('@deptName', '@safeDeptId')" title="@deptName">
                        <i class="fas @icon"></i>
                        <span>@deptName</span>
                    </div>
                }
            }
        </div>

        <!-- 4. DETAIL / SUBMENU VIEW (Overlays Main Nav) -->
        <div class="sidebar-detail-view" id="sidebar-detail">
            <div class="detail-header">
                <button class="detail-back-btn" onclick="closeSidebarDetail()">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <h5 class="detail-title" id="detail-view-title">Menu</h5>
            </div>
            <div class="sidebar-nav" id="detail-view-body">
                <!-- Submenus dynamic injection -->
            </div>
        </div>

        <!-- 5. TEMPLATES FOR GRID DETAIL VIEWS -->
        @if (dynamicMenus != null && dynamicMenus.Any())
        {
            <div id="detail-templates" style="display:none">
                @{
                    var depts_t = dynamicMenus.GroupBy(m => m.Department).OrderBy(g => g.Key).ToList();
                    string[] moduleTypeOrder_t = { "DASHBOARD", "MASTER", "ACTIVITY", "REPORT" };
                    for (int i = 0; i < depts_t.Count; i++)
                    {
                        var deptGroup = depts_t[i];
                        string safeDeptId = "dept-" + i;
                        <div id="@safeDeptId-template">
                            @{
                                // FIX #4: use the SAME priority order here as in the live list view
                                // (previously this block sorted alphabetically by g.Key, which made
                                // tile-detail order disagree with list-view order)
                                var moduleTypes = deptGroup
                                .GroupBy(m => m.ModuleType)
                                .OrderBy(g =>
                                {
                                    int idx = Array.IndexOf(moduleTypeOrder_t, (g.Key ?? "").ToUpper());
                                    return idx == -1 ? int.MaxValue : idx;
                                });
                            }
                            @foreach (var modGroup in moduleTypes)
                            {
                                string modType = modGroup.Key ?? "OTHER";
                                <div class="nav-section"><span class="nav-label">@modType</span></div>
                                @foreach (var item in modGroup.OrderBy(m => m.ModuleCaptionName))
                                {
                                    string url = "/" + item.ControllerName + "/" + item.ActionName;
                                    <a class="nav-link" href="@url">
                                        <i class="fas fa-circle" style="font-size:0.4rem;opacity:0.5"></i>
                                        <span>@item.ModuleCaptionName</span>
                                        <i class="fas fa-chevron-right ml-auto text-sm opacity-30"></i>
                                    </a>
                                }
                            }
                        </div>
                    }
                }
            </div>
        }
    </nav>

    <!-- ██ TOPBAR ████████████████████████████████████████████ -->
    <header id="topbar">
        <button class="topbar-toggle" id="sidebarToggle" title="Toggle sidebar">
            <i class="fas fa-bars"></i>
        </button>

        @{
            string rawTitle = ViewBag.Title?.ToString() ?? "";
            // Strip " - VGN ERP" suffix if present
            string pageTitle = rawTitle.Contains(" - ") ? rawTitle.Substring(0, rawTitle.LastIndexOf(" - ")) : rawTitle;
        }
        @if (!string.IsNullOrEmpty(pageTitle))
        {
            <span class="topbar-page-title">@pageTitle</span>
        }

        <div class="topbar-right">
            <!-- CHAT BTN -->
            <div class="notif-btn-wrap">
                <button class="topbar-btn" id="openChatBtn" title="Live Chat" onclick="openChatPanel()">
                    <i class="fas fa-comments"></i>
                </button>
                <span class="notif-badge" id="chatUnreadTotal" style="display:none;">0</span>
            </div>

            <!-- NOTIFICATION BELL -->
            <div class="notif-btn-wrap">
                <button class="topbar-btn" id="openNotif" title="Notifications">
                    <i class="fas fa-bell"></i>
                </button>
                <span class="notif-badge" id="notifCount">3</span>
            </div>

            <!-- SHORTCUTS DROPDOWN -->
            <div class="dropdown inline-block relative" id="shortcutsDropdownWrap">
                <button class="topbar-btn" title="Shortcuts" onclick="vgnDropdown('shortcutsMenu')">
                    <i class="fas fa-th"></i>
                </button>
                <div id="shortcutsMenu" class="vgn-dropdown-menu absolute right-0 shadow-xl border-0 p-3" style="display:none; min-width: 280px; border-radius: 12px; background: var(--surface); z-index: 1000;">
                    <h6 class="uppercase font-bold mb-3 px-1" style="font-size: 0.75rem; letter-spacing: 0.5px; color: var(--text-muted);">Quick Shortcuts</h6>
                    <div class="grid grid-cols-3 gap-2">
                        <div>
                            <a class="dropdown-item block p-2 rounded-lg text-center flex flex-col items-center justify-center h-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors" href="/GeneralDashboard/Index" style="white-space: normal; background: transparent;">
                                <div class="rounded-full flex items-center justify-center mb-2" style="width: 42px; height: 42px; background: rgba(70,128,255,0.1); color: var(--primary);">
                                    <i class="fas fa-book text-xl"></i>
                                </div>
                                <span style="font-size: 0.72rem; font-weight: 600; color: var(--text);">Daybook</span>
                            </a>
                        </div>
                        <div>
                            <a class="dropdown-item block p-2 rounded-lg text-center flex flex-col items-center justify-center h-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors" href="#" style="white-space: normal; background: transparent;">
                                <div class="rounded-full flex items-center justify-center mb-2" style="width: 42px; height: 42px; background: rgba(249,115,22,0.1); color: #f97316;">
                                    <i class="fas fa-calendar-times text-xl"></i>
                                </div>
                                <span style="font-size: 0.72rem; font-weight: 600; color: var(--text);">Leave</span>
                            </a>
                        </div>
                        <div>
                            <a class="dropdown-item block p-2 rounded-lg text-center flex flex-col items-center justify-center h-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors" href="#" style="white-space: normal; background: transparent;">
                                <div class="rounded-full flex items-center justify-center mb-2" style="width: 42px; height: 42px; background: rgba(16,185,129,0.1); color: #10b981;">
                                    <i class="fas fa-receipt text-xl"></i>
                                </div>
                                <span style="font-size: 0.72rem; font-weight: 600; color: var(--text);">Payslip</span>
                            </a>
                        </div>
                        <div>
                            <a class="dropdown-item block p-2 rounded-lg text-center flex flex-col items-center justify-center h-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors" href="#" style="white-space: normal; background: transparent;">
                                <div class="rounded-full flex items-center justify-center mb-2" style="width: 42px; height: 42px; background: rgba(139,92,246,0.1); color: #8b5cf6;">
                                    <i class="fas fa-ticket-alt text-xl"></i>
                                </div>
                                <span style="font-size: 0.72rem; font-weight: 600; color: var(--text);">Tickets</span>
                            </a>
                        </div>
                        <div>
                            <a class="dropdown-item block p-2 rounded-lg text-center flex flex-col items-center justify-center h-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors" href="#" style="white-space: normal; background: transparent;">
                                <div class="rounded-full flex items-center justify-center mb-2" style="width: 42px; height: 42px; background: rgba(236,72,153,0.1); color: #ec4899;">
                                    <i class="fas fa-paperclip text-xl"></i>
                                </div>
                                <span style="font-size: 0.72rem; font-weight: 600; color: var(--text);">Attach</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MAP LOCATION (BOUNCING) -->
            <button class="topbar-btn" title="Location">
                <i class="fas fa-map-marker-alt text-red-500 bounce-icon"></i>
            </button>

            <!-- FULL SCREEN -->
            <button class="topbar-btn" id="fullScreenBtn" title="Full Screen" onclick="toggleFullScreen()">
                <i class="fas fa-expand"></i>
            </button>

            <!-- SETTINGS TRIGGER -->
            <button class="topbar-btn" id="openSettings" title="Customize">
                <i class="fas fa-sliders-h"></i>
            </button>

            <!-- USER DROPDOWN -->
            <div class="relative" id="userDropdownWrap">
                <div class="topbar-user" id="userDropdown" onclick="vgnDropdown('userMenu')" style="cursor:pointer;">
                    <div class="user-avatar" style="width:34px;height:34px;font-size:.8rem">@(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")</div>
                    <div class="u-info hidden md:block">
                        <div class="name">@userName</div>
                        <div class="role">@userDesignation</div>
                    </div>
                    <i class="fas fa-chevron-down text-sm ml-1 text-gray-400"></i>
                </div>
                <ul id="userMenu" class="vgn-dropdown-menu absolute right-0 shadow-xl rounded-lg py-2" style="display:none; min-width:200px; z-index:1000; background:var(--surface); border:1px solid var(--border);">
                    <li class="px-2">
                        <a class="block rounded-lg px-4 py-2 transition-colors" href="#" onclick="vgnModal('profileModal')" style="color:var(--text);">
                            <i class="fas fa-user mr-2"></i>My Profile
                        </a>
                    </li>
                    <li class="my-1"><hr style="border-color:var(--border); margin:0;"></li>
                    <li class="px-2">
                        <a class="block rounded-lg px-4 py-2 transition-colors" href="/Account/Logout" style="color:#ef4444;">
                            <i class="fas fa-sign-out-alt mr-2"></i>Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- PROFILE MODAL (vanilla JS) -->
    <div id="profileModal" style="display:none; position:fixed; inset:0; z-index:2000; align-items:center; justify-content:center; background:rgba(0,0,0,.45);">
        <div style="background:var(--surface); border-radius:16px; width:90%; max-width:520px; max-height:90vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.25); color:var(--text);">
            <div style="background:var(--primary); color:#fff; padding:1.25rem 1.5rem; border-radius:16px 16px 0 0; display:flex; justify-content:space-between; align-items:center;">
                <h5 style="margin:0; font-size:1.1rem; font-weight:700;"><i class="fas fa-id-badge mr-2"></i>My Profile</h5>
                <button onclick="vgnModalClose('profileModal')" style="background:none; border:none; color:#fff; font-size:1.25rem; cursor:pointer; opacity:.8; line-height:1;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div style="padding:1.5rem;">
                    <div class="text-center mb-6">
                        <div class="user-avatar mx-auto mb-3" style="width:80px;height:80px;font-size:2rem;box-shadow:0 4px 10px rgba(0,0,0,0.1)">@(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")</div>
                        <h5 class="mb-1 font-bold text-xl" style="color:var(--text)">@userName</h5>
                        <p class="mb-0 text-sm text-[var(--text-muted)]">@userDesignation</p>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs text-[var(--text-muted)] mb-1 block">Department</label>
                            <div class="font-medium">@(user?.Department ?? "N/A")</div>
                        </div>
                        <div>
                            <label class="text-xs text-[var(--text-muted)] mb-1 block">Mobile No</label>
                            <div class="font-medium">@(user?.MobileNo ?? "N/A")</div>
                        </div>
                        <div class="col-span-1 sm:col-span-2">
                            <label class="text-xs text-[var(--text-muted)] mb-1 block">Email ID</label>
                            <div class="font-medium">@(user?.Email ?? "N/A")</div>
                        </div>
                        <div class="col-span-1 sm:col-span-2 mt-4 pt-4 border-t border-gray-200/20">
                            <h6 class="font-bold mb-4 text-sm"><i class="fas fa-sitemap mr-2 text-primary"></i>Reporting Manager</h6>
                        </div>
                        <div>
                            <label class="text-xs text-[var(--text-muted)] mb-1 block">Name</label>
                            <div class="font-medium">@(user?.RptEmpName ?? "N/A")</div>
                        </div>
                        <div>
                            <label class="text-xs text-[var(--text-muted)] mb-1 block">Mobile No</label>
                            <div class="font-medium">@(user?.ReportingMobileNum ?? "N/A")</div>
                        </div>
                        <div class="col-span-1 sm:col-span-2">
                            <label class="text-xs text-[var(--text-muted)] mb-1 block">Email ID</label>
                            <div class="font-medium">@(user?.ReprotingMailId ?? "N/A")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ██ MAIN CONTENT ████████████████████████████████████ -->
    <main id="main-content">
        @RenderBody()
        <!-- Spacer to prevent content from hiding behind the fixed footer -->
        <div style="height: 80px; width: 100%;"></div>
        @await Html.PartialAsync("_footer")
    </main>

    <!-- ══════════════════════════════════════════════════════
         NOTIFICATION RIGHT PANEL
    ══════════════════════════════════════════════════════ -->
    <div id="notif-overlay" onclick="closeNotifPanel()"></div>
    <div id="notif-panel">
        <div class="np-header">
            <div>
                <div class="np-title"><i class="fas fa-bell mr-2 text-primary"></i>Notifications</div>
                <div style="font-size:.75rem;color:var(--text-muted)" id="unreadLabel">3 unread notifications</div>
            </div>
            <div class="flex items-center gap-2">
                <button class="np-mark-all" onclick="markAllRead()">Mark all read</button>
                <button class="np-close" onclick="closeNotifPanel()"><i class="fas fa-times"></i></button>
            </div>
        </div>

        <!-- Tabs: Notifications | Circulars -->
        <div class="np-tabs">
            <button class="np-tab active" onclick="switchTab('notifs',this)">
                <i class="fas fa-bell mr-1"></i>Alerts
            </button>
            <button class="np-tab" onclick="switchTab('circulars',this)">
                <i class="fas fa-bullhorn mr-1"></i>Circulars
            </button>
            <button class="np-tab" onclick="switchTab('system',this)">
                <i class="fas fa-info-circle mr-1"></i>System
            </button>
        </div>

        <div class="np-body">

            <!-- ALERTS TAB -->
            <div class="np-section active" id="tab-notifs">
                <div class="notif-item unread" onclick="markRead(this)">
                    <div class="notif-icon blue"><i class="fas fa-cart-arrow-down"></i></div>
                    <div class="notif-body">
                        <div class="notif-title">New Order #1085 received</div>
                        <div class="notif-desc">Rajan Traders placed an order for ₹18,400</div>
                        <div class="notif-time"><i class="fas fa-clock mr-1"></i>2 minutes ago</div>
                    </div>
                </div>
                <div class="notif-item unread" onclick="markRead(this)">
                    <div class="notif-icon orange"><i class="fas fa-exclamation-triangle"></i></div>
                    <div class="notif-body">
                        <div class="notif-title">Low stock alert</div>
                        <div class="notif-desc">Item "VGN Bricks 6 inch" has only 12 units left</div>
                        <div class="notif-time"><i class="fas fa-clock mr-1"></i>15 minutes ago</div>
                    </div>
                </div>
                <div class="notif-item unread" onclick="markRead(this)">
                    <div class="notif-icon green"><i class="fas fa-coins"></i></div>
                    <div class="notif-body">
                        <div class="notif-title">Payment received</div>
                        <div class="notif-desc">₹52,000 credited from ABC Builders</div>
                        <div class="notif-time"><i class="fas fa-clock mr-1"></i>1 hour ago</div>
                    </div>
                </div>
                <div class="notif-item" onclick="markRead(this)">
                    <div class="notif-icon purple"><i class="fas fa-user-check"></i></div>
                    <div class="notif-body">
                        <div class="notif-title">New user registered</div>
                        <div class="notif-desc">PRAVEEN L has been approved as Employee</div>
                        <div class="notif-time"><i class="fas fa-clock mr-1"></i>Yesterday</div>
                    </div>
                </div>
                <div class="notif-item" onclick="markRead(this)">
                    <div class="notif-icon red"><i class="fas fa-file-times"></i></div>
                    <div class="notif-body">
                        <div class="notif-title">Report generation failed</div>
                        <div class="notif-desc">Monthly MIS report could not be generated</div>
                        <div class="notif-time"><i class="fas fa-clock mr-1"></i>2 days ago</div>
                    </div>
                </div>
            </div>

            <!-- CIRCULARS TAB -->
            <div class="np-section" id="tab-circulars">
                <div style="padding:2rem;text-align:center;color:var(--text-muted);font-size:0.85rem">
                    <div class="spinner-border text-primary spinner-border-sm mb-2" role="status"></div>
                    <div>Loading circulars...</div>
                </div>
            </div>

            <!-- SYSTEM TAB -->
            <div class="np-section" id="tab-system">
                <div class="notif-item">
