            --btn-update-bg-hover: #059669;
            --btn-update-color: #ffffff;
            --btn-update-border: #059669;
            /* EDIT   → soft orange in dark */
            --btn-edit-bg: #fb923c;
            --btn-edit-bg-hover: #f97316;
            --btn-edit-color: #ffffff;
            --btn-edit-border: #f97316;
            --sidebar-bg: #111320;
            --sidebar-text: rgba(255,255,255,.75);
            --sidebar-active: rgba(255,255,255,.05);
            --sidebar-border: rgba(255,255,255,.06);
            --sidebar-hover-bg: rgba(255,255,255,.10);
