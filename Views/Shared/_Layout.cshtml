    <!-- DevExtreme Global Override -->
    <script>
        DevExpress.ui.dxDataGrid.defaultOptions({
            options: {
                height: 500,
                filterRow: {
                    visible: false
                },
                headerFilter: {
                    visible: true   /* Enable filter popup on click — icon is hidden via CSS, shown on hover */
                },
                onToolbarPreparing: function(e) {
                    var toolbarItems = e.toolbarOptions.items;
                    toolbarItems.unshift({
                        location: 'before',
                        template: function() {
                            return $('<div/>')
                                .addClass('sa-count-badge')
                                .html('<i class="fas fa-table"></i> <span class="grid-row-count-val">0</span> Rows');
                        }
                    });
                },
                onContentReady: function(e) {
                    var count = e.component.totalCount();
                    if(count === -1) count = e.component.getDataSource() ? e.component.getDataSource().items().length : 0;

                    var formatIndian = function(n) {
                        if (n === null || n === undefined || isNaN(n)) return '0';
                        n = Math.round(n);
                        var s = n.toString();
                        if (s.length <= 3) return s;
                        var last3 = s.slice(-3);
                        var rest = s.slice(0, -3);
                        return rest.replace(/\B(?=(\d{2})+(?!\d))/g, ',') + ',' + last3;
                    };

                    var badge = e.element.find('.grid-row-count-val');
                    if(badge.length) {
                        badge.text(formatIndian(count));
                    }

                    // ── Dynamic header text fitting ──────────────────────────────
                    // Runs every time grid is ready (initial load, column resize, etc.)
                    if (typeof window.vgnFitGridHeaders === 'function') {
                        window.vgnFitGridHeaders(e.element[0]);
                    }
                }
            }
        });
    </script>

    <!-- ═══ VGN: Dynamic DataGrid Column Header Auto-Fit ═══
         vgnFitGridHeaders(gridEl) — call with a .dx-datagrid DOM element
         - Reads current --font-size-base (user setting)
         - Measures each header cell's available width vs text width
         - Shrinks font size in 0.5px steps to fit; minimum = 9px
         - Sets native title="" on the <td> for full-text tooltip
         - Hooked into: onContentReady (all grids) + setFontSize (on change)
    ═══════════════════════════════════════════════════════════════ -->
    <script>
        (function () {
            // Measure text width using an off-screen Canvas (fast, no reflow)
            var _canvas = document.createElement('canvas');
            var _ctx = _canvas.getContext('2d');

            function measureText(text, fontStr) {
                _ctx.font = fontStr;
                return _ctx.measureText(text).width;
            }

            function getBaseFontPx() {
                // Read --font-size-grid-header (grid-specific) from :root
                // Falls back to --font-size-base if not set, default 12.5px
                var raw = getComputedStyle(document.documentElement)
                    .getPropertyValue('--font-size-grid-header').trim();
                if (!raw) {
                    // fallback: use base and scale it
                    raw = getComputedStyle(document.documentElement)
                        .getPropertyValue('--font-size-base').trim();
                    var base = parseFloat(raw) || 14;
                    return Math.round(base * 0.893 * 10) / 10;
                }
                if (raw.endsWith('px')) return parseFloat(raw);
                if (raw.endsWith('rem')) return parseFloat(raw) * 16;
                return parseFloat(raw) || 12.5;
            }

            function getFontFamily() {
                var raw = getComputedStyle(document.documentElement)
                    .getPropertyValue('--font-family').trim();
                return raw || "'Segoe UI', system-ui, sans-serif";
            }

            window.vgnFitGridHeaders = function (gridEl) {
                if (!gridEl) return;
                var headerCells = gridEl.querySelectorAll(
                    '.dx-header-row .dx-datagrid-text-content'
                );
                if (!headerCells.length) return;

                var basePx     = getBaseFontPx();
                var fontFamily = getFontFamily();
                var MIN_PX     = 9;   // never go below 9px
                var STEP       = 0.5; // shrink granularity

                headerCells.forEach(function (span) {
                    var td = span.closest('td');
                    if (!td) return;

                    var text = span.textContent.trim();
                    if (!text) return;

                    // ── Measure the actual available width for text ──────────────
                    // DevExtreme places the text-content span inside a container
                    // that already accounts for sort/filter icons. Use the span's
                    // own offsetWidth (which DX constrains) as the real budget.
                    // Fallback: td width minus icon space (sort=18px, filter=20px,
                    // padding=12px → 50px total reserve).
                    var available;
                    var spanW = span.offsetWidth;
                    if (spanW > 0) {
                        available = spanW - 4; // tiny buffer for rounding
                    } else {
                        var cellW = td.getBoundingClientRect().width;
                        if (cellW <= 0) return;
                        // Count icons inside the td (sort arrow + header filter)
                        var iconCount = td.querySelectorAll(
                            '.dx-sort, .dx-sort-up, .dx-sort-down, .dx-header-filter'
                        ).length;
                        var iconPad = 12 + (iconCount * 20); // base padding + per-icon
                        available = Math.max(cellW - iconPad, 20);
                    }

                    // ── Reset any previous fitted size before re-measuring ───────
                    span.style.fontSize = '';

                    // ── Shrink from base until text fits ─────────────────────────
                    var fitted = basePx;
                    while (fitted > MIN_PX) {
                        var fontStr = '700 ' + fitted + 'px ' + fontFamily;
                        var textW = measureText(text, fontStr);
                        if (textW <= available) break;
                        fitted -= STEP;
                    }
                    fitted = Math.max(fitted, MIN_PX);

                    // ── Apply ────────────────────────────────────────────────────
                    if (fitted < basePx - 0.4) {
                        span.style.fontSize = fitted + 'px';
                        span.setAttribute('data-fitted', 'true');
                    } else {
                        span.removeAttribute('data-fitted'); // let CSS var rule
                    }

                    // Native tooltip so full text is always accessible
                    td.title = text;
                });
            };

            // Re-fit headers when window is resized (column widths change)
            var _resizeTimer;
            window.addEventListener('resize', function () {
                clearTimeout(_resizeTimer);
                _resizeTimer = setTimeout(function () {
                    document.querySelectorAll('.dx-datagrid').forEach(function (g) {
                        // Reset fitted flags so we remeasure from base
                        g.querySelectorAll('.dx-header-row .dx-datagrid-text-content[data-fitted]')
                            .forEach(function (el) {
                                el.removeAttribute('data-fitted');
                                el.style.fontSize = '';
                            });
                        window.vgnFitGridHeaders(g);
                    });
                }, 150);
            });
        })();
    </script>

    <style>
        /* ── Global Grid Row count badge ── */
        .sa-count-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary);
            color: #fff;
            font-size: .75rem;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 20px;
            white-space: nowrap;
        }

        /* ═══════════════════════════════════════════════════════════
           DEVEXTREME GRID TOOLBAR — THEME-AWARE OVERRIDES
           Fixes Export to Excel, Column Chooser, Filter Panel icons
           and Create Filter link visibility in both light & dark modes
           ═══════════════════════════════════════════════════════════ */

        /* ── Toolbar container ─────────────────────────────── */
        .dx-datagrid-header-panel {
            background: var(--surface) !important;
            border-bottom: 1px solid var(--border) !important;
            padding: 6px 8px !important;
        }

        /* ── Toolbar buttons (Export, Column Chooser, Filter Panel) */
        .dx-datagrid-toolbar-button .dx-button,
        .dx-datagrid .dx-toolbar .dx-button {
            background: var(--surface) !important;
            border: 1px solid var(--border) !important;
            border-radius: 8px !important;
            color: var(--text) !important;
            box-shadow: none !important;
            min-width: 36px;
            height: 36px;
        }

        .dx-datagrid-toolbar-button .dx-button:hover,
        .dx-datagrid .dx-toolbar .dx-button:hover {
            background: rgba(var(--primary-rgb), 0.08) !important;
            border-color: var(--primary) !important;
            color: var(--primary) !important;
        }

        /* ── Button icon SVG paths ─────────────────────────── */
        .dx-datagrid .dx-toolbar .dx-button .dx-icon,
        .dx-datagrid-toolbar-button .dx-icon {
            color: var(--text) !important;
        }

        .dx-datagrid .dx-toolbar .dx-button:hover .dx-icon,
        .dx-datagrid-toolbar-button .dx-button:hover .dx-icon {
            color: var(--primary) !important;
        }

        /* ── SVG icons inside toolbar buttons ─────────────── */
        .dx-datagrid .dx-toolbar .dx-button .dx-icon svg path,
        .dx-datagrid .dx-toolbar .dx-button .dx-icon svg rect,
        .dx-datagrid .dx-toolbar .dx-button .dx-icon svg polygon {
            fill: var(--text) !important;
        }

        .dx-datagrid .dx-toolbar .dx-button:hover .dx-icon svg path,
        .dx-datagrid .dx-toolbar .dx-button:hover .dx-icon svg rect,
        .dx-datagrid .dx-toolbar .dx-button:hover .dx-icon svg polygon {
            fill: var(--primary) !important;
        }

        /* Dark theme SVG icon inversion ─────────────────── */
        [data-theme="dark"] .dx-datagrid .dx-toolbar .dx-button .dx-icon.dx-icon-export-excel-button,
        [data-theme="dark"] .dx-datagrid .dx-toolbar .dx-button .dx-icon.dx-icon-column-chooser,
        [data-theme="dark"] .dx-datagrid .dx-toolbar .dx-button .dx-icon {
            filter: brightness(0) invert(0.8) !important;
        }

        [data-theme="dark"] .dx-datagrid .dx-toolbar .dx-button:hover .dx-icon {
            filter: none !important;
            color: var(--primary) !important;
        }

        /* ── Export to Excel button ────────────────────────── */
        .dx-datagrid .dx-toolbar .dx-button.dx-button-has-icon:not(.dx-button-has-text) {
            background: var(--surface) !important;
            border: 1px solid var(--border) !important;
            border-radius: 8px !important;
        }

        /* ── Search Panel ──────────────────────────────────── */
        .dx-datagrid .dx-toolbar .dx-texteditor {
            background: var(--surface) !important;
            border: 1px solid var(--border) !important;
            border-radius: 8px !important;
            color: var(--text) !important;
        }

        .dx-datagrid .dx-toolbar .dx-texteditor-input {
            background: transparent !important;
            color: var(--text) !important;
            font-size: 0.8125rem !important;
        }

        .dx-datagrid .dx-toolbar .dx-texteditor-input::placeholder {
            color: var(--text-muted) !important;
        }

        .dx-datagrid .dx-toolbar .dx-texteditor .dx-icon-search {
            color: var(--text-muted) !important;
        }

        .dx-datagrid .dx-toolbar .dx-texteditor .dx-icon-clear {
            color: var(--text-muted) !important;
        }

        [data-theme="dark"] .dx-datagrid .dx-toolbar .dx-texteditor .dx-icon-search {
            filter: brightness(0) invert(0.7) !important;
        }

        /* ── Filter Panel ("Create Filter" link at bottom) ── */
        .dx-datagrid-filter-panel {
            background: var(--surface) !important;
            border-top: 1px solid var(--border) !important;
            padding: 6px 12px !important;
        }

        .dx-datagrid-filter-panel .dx-datagrid-filter-panel-text,
        .dx-datagrid-filter-panel .dx-datagrid-filter-panel-clear-filter,
        .dx-datagrid-filter-panel-link {
            color: var(--primary) !important;
            font-size: 0.8rem !important;
            font-weight: 600 !important;
            text-decoration: none !important;
        }

        .dx-datagrid-filter-panel .dx-datagrid-filter-panel-text:hover,
        .dx-datagrid-filter-panel-link:hover {
            color: var(--text) !important;
            text-decoration: underline !important;
        }

        .dx-datagrid-filter-panel .dx-icon-filter {
            color: var(--primary) !important;
        }

        [data-theme="dark"] .dx-datagrid-filter-panel .dx-icon-filter {
            filter: none !important;
            color: var(--primary) !important;
        }

        /* ── Column Chooser popup ──────────────────────────── */
        .dx-column-chooser {
            background: var(--surface) !important;
            border: 1px solid var(--border) !important;
            border-radius: 10px !important;
            box-shadow: 0 8px 32px rgba(0,0,0,.18) !important;
        }

        .dx-column-chooser .dx-popup-title {
            background: var(--surface) !important;
            border-bottom: 1px solid var(--border) !important;
            color: var(--text) !important;
            font-size: .85rem !important;
            font-weight: 700 !important;
        }

        .dx-column-chooser .dx-list-item {
            color: var(--text) !important;
            border-color: var(--border) !important;
        }

        .dx-column-chooser .dx-list-item:hover {
            background: rgba(var(--primary-rgb), 0.06) !important;
        }

        .dx-column-chooser .dx-checkbox-icon {
            border-color: var(--border) !important;
            background: var(--surface) !important;
        }

        .dx-column-chooser .dx-checkbox-checked .dx-checkbox-icon {
            background: var(--primary) !important;
            border-color: var(--primary) !important;
        }

        /* ── Grid overall background / borders ─────────────── */
        .dx-datagrid {
            background: var(--surface) !important;
            color: var(--text) !important;
            border-color: var(--border) !important;
        }

        .dx-datagrid-borders > .dx-datagrid-header-panel,
        .dx-datagrid-borders > .dx-datagrid-filter-panel,
        .dx-datagrid-borders > .dx-datagrid-pager {
            border-color: var(--border) !important;
        }

        .dx-datagrid .dx-row > td {
            border-color: var(--border) !important;
        }

        /* ── Toolbar grouping container ─────────────────────── */
        .dx-toolbar {
            background: transparent !important;
        }

        .dx-toolbar-items-container {
            background: transparent !important;
        }

        /* ══════════════════════════════════════════════════════════
           DYNAMIC COLUMN HEADER TEXT — scales with user font setting
           Base size = --font-size-base (set in Settings → Font Size)
           Overflowing headers shrink via JS (vgnFitGridHeaders)
           ══════════════════════════════════════════════════════════ */

        /* Header row cell */
        .dx-datagrid .dx-header-row > td {
            vertical-align: middle !important;
        }

        /* The actual visible text span inside each header cell
           Uses --font-size-grid-header (slightly smaller than body base)
           so grid headers feel compact relative to form textboxes */
        .dx-datagrid .dx-header-row .dx-datagrid-text-content {
            font-size: var(--font-size-grid-header) !important;
            font-family: var(--font-family) !important;
            font-weight: 700 !important;
            white-space: normal !important;
            overflow: visible !important;
            text-overflow: unset !important;
            display: block !important;
            word-break: break-word !important;
            line-height: 1.25 !important;
            transition: font-size 0.15s ease !important;
        }

        /* When JS has applied a fitted size, keep it smooth */
        .dx-datagrid .dx-header-row .dx-datagrid-text-content[data-fitted="true"] {
            /* size set inline by vgnFitGridHeaders() — no override here */
        }

        /* ── LIGHT THEME ────────────────────────────────── */
        :root {
            --primary: #4680FF;
            --primary-rgb: 70,128,255;
            --sidebar-w: 260px;
            --sidebar-mini: 70px;
            --topbar-h: 64px;
            --radius: 12px;
            --trans: .22s ease;
            --font-family: 'Segoe UI', system-ui, sans-serif;
            --font-size-base: 14px;
            /* Grid-specific sizes: smaller than form controls for visual balance */
            --font-size-grid: 12px;          /* ~85% of base — data cell rows        */
            --font-size-grid-header: 12.5px; /* ~89% of base — column header text    */
            /* LIGHT theme colors */
            --bg: #f4f6fb;
            --surface: #ffffff;
            /* ── Action Button Semantic Color Variables (LIGHT) ── */
            /* LOAD  → Blue */
            --btn-load-bg: #2563eb;
            --btn-load-bg-hover: #1d4ed8;
            --btn-load-color: #ffffff;
            --btn-load-border: #1d4ed8;
            /* APPLY → Sky Blue */
            --btn-apply-bg: #0ea5e9;
            --btn-apply-bg-hover: #0284c7;
            --btn-apply-color: #ffffff;
            --btn-apply-border: #0284c7;
            /* SAVE  → Green */
            --btn-save-bg: #16a34a;
            --btn-save-bg-hover: #15803d;
            --btn-save-color: #ffffff;
            --btn-save-border: #15803d;
            /* CANCEL → Grey */
            --btn-cancel-bg: #6b7280;
            --btn-cancel-bg-hover: #4b5563;
            --btn-cancel-color: #ffffff;
            --btn-cancel-border: #4b5563;
            /* CLEAR  → Grey (lighter shade) */
            --btn-clear-bg: #9ca3af;
            --btn-clear-bg-hover: #6b7280;
            --btn-clear-color: #ffffff;
            --btn-clear-border: #6b7280;
            /* DELETE → Red */
            --btn-delete-bg: #dc2626;
            --btn-delete-bg-hover: #b91c1c;
            --btn-delete-color: #ffffff;
            --btn-delete-border: #b91c1c;
            /* UPDATE → Green (slightly different shade) */
            --btn-update-bg: #059669;
            --btn-update-bg-hover: #047857;
            --btn-update-color: #ffffff;
            --btn-update-border: #047857;
            /* EDIT   → Soft Orange (not dark) */
            --btn-edit-bg: #f97316;
            --btn-edit-bg-hover: #ea580c;
            --btn-edit-color: #ffffff;
            --btn-edit-border: #ea580c;
            /* Sidebar light theme colors by default */
            --sidebar-bg: #ffffff;
            --sidebar-text: #4b5563; /* text-gray-600 */
            --sidebar-active: rgba(0,0,0,.05);
            --sidebar-border: #e5e7eb;
            --sidebar-hover-bg: rgba(0,0,0,.05);
            --sidebar-hover-color: var(--primary);
            --sidebar-label-color: #9ca3af;
