            --sidebar-tabs-border: #e5e7eb;
            --sidebar-tab-color: #6b7280;
            --sidebar-tab-active-color: var(--primary);
            --sidebar-tab-active-bg: transparent;
            --topbar-bg: #ffffff;
            --text: #1a1a2e;
            --text-muted: #6c757d;
            --border: #d1d5db;
            --card-shadow: 0 2px 12px rgba(0,0,0,.06);
            --icon-filter: none;
        }

        /* ── DARK THEME ──────────────────────────────────── */
        [data-theme="dark"] {
            --bg: #0f1117;
            --surface: #1a1d27;
            /* ── Action Button Semantic Color Variables (DARK overrides) ── */
            /* LOAD  → slightly brighter blue in dark */
