@{
    ViewBag.Title = "Service Master — VGN ERP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-3 sm:p-5 space-y-4 font-sans text-slate-800 dark:text-slate-100 max-w-[1700px] mx-auto">

    <!-- Header Navigation & Action Bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-600 dark:text-teal-400 text-lg font-bold">
                <i class="fas fa-cubes"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-slate-800 dark:text-white tracking-tight flex items-center gap-2">
                    <span>Service Master</span>
                    <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-teal-100 text-teal-800 dark:bg-teal-900/50 dark:text-teal-300 border border-teal-300 dark:border-teal-700" id="badgeServiceCount">
                        0 Services
                    </span>
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Manage master line services and descriptions used across Other Cost Breakups and BOQ items</p>
            </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <a href="@Url.Action("Index", "OtherCostBreakup")" class="px-3.5 py-2 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                <i class="fas fa-layer-group text-teal-600"></i>
                <span>Cost Breakup</span>
            </a>
            <a href="@Url.Action("Index", "OtherCostAllocation")" class="px-3.5 py-2 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                <i class="fas fa-hand-holding-usd text-blue-600"></i>
                <span>Cost Allocations</span>
            </a>
            <button type="button" onclick="loadGridServices()" class="px-3.5 py-2 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Refresh Service List">
                <i class="fas fa-sync-alt text-xs"></i>
                <span>Refresh</span>
            </button>
            <button type="button" onclick="openAddServiceModal()" class="px-4 py-2 rounded-lg text-xs font-bold bg-teal-600 hover:bg-teal-700 text-white transition cursor-pointer flex items-center gap-1.5 shadow-md">
                <i class="fas fa-plus text-xs"></i>
                <span>Add New Service</span>
            </button>
        </div>
    </div>

    <!-- Data Grid Container -->
    <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-sm p-4 sm:p-5">
        <div id="dxGridServiceMaster"></div>
    </div>

</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- ADD / EDIT SERVICE MODAL                                                -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div id="modalServiceEdit" class="fixed inset-0 z-[9999] overflow-y-auto" style="display: none; background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);">
    <div class="min-h-full flex items-center justify-center p-3 sm:p-4 text-center">
        <div class="relative w-full max-w-lg bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 text-left transform transition-all my-8 overflow-hidden inline-block">
            
            <div class="p-4 sm:p-5 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between bg-slate-50 dark:bg-slate-800/80">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center text-sm font-bold">
                        <i class="fas fa-cubes"></i>
                    </div>
                    <h3 class="text-sm font-bold text-slate-800 dark:text-white" id="modalServiceTitle">Create New Service</h3>
                </div>
                <button type="button" onclick="closeServiceModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 cursor-pointer">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <form id="frmService" onsubmit="event.preventDefault(); submitServiceForm();" class="p-5 space-y-4 text-xs">
                <input type="hidden" id="txtModalServiceId" value="0" />

                <!-- Service Code -->
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">
                        Service Code <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="text" id="txtModalServiceCode" required class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-white focus:ring-1 focus:ring-teal-500 outline-none" placeholder="e.g. SVC-0001" />
                        <button type="button" onclick="refreshAutoCode()" class="absolute right-2 top-1.5 px-2 py-1 rounded text-[10px] font-bold bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 transition" title="Generate Next Code">
                            <i class="fas fa-sync-alt mr-1"></i> Auto
                        </button>
                    </div>
                    <span class="text-[10px] text-slate-400 block mt-1">Unique alphanumeric code in Project_ServiceMas</span>
                </div>

                <!-- Service Name / Description -->
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">
                        Service Name / Description <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" id="txtModalServiceName" required class="w-full text-xs font-semibold px-3 py-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-white focus:ring-1 focus:ring-teal-500 outline-none" placeholder="e.g. Outdoor Hoardings / PMC Consulting Fees" />
                </div>

                <!-- Service Type -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block font-bold text-slate-700 dark:text-slate-300">
                            Service Type <span class="text-rose-500">*</span>
                        </label>
                        <button type="button" onclick="promptAddNewServiceType()" class="text-[11px] font-bold text-teal-600 hover:text-teal-700 dark:text-teal-400 cursor-pointer">
                            <i class="fas fa-plus-circle mr-0.5"></i> Add Type
                        </button>
                    </div>
                    <select id="ddlModalServiceType" class="w-full text-xs font-semibold px-3 py-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-white focus:ring-1 focus:ring-teal-500 outline-none cursor-pointer">
                        <option value="1">test</option>
                    </select>
                </div>

                <!-- Unit (UOM) -->
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">
                        Default Unit (UOM) <span class="text-rose-500">*</span>
                    </label>
                    <select id="ddlModalServiceUom" class="w-full text-xs font-semibold px-3 py-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-white focus:ring-1 focus:ring-teal-500 outline-none cursor-pointer">
                        <option value="4">Nos</option>
                        <option value="5">Day</option>
                        <option value="6">Month</option>
                        <option value="9">LS</option>
                        <option value="2">Sqm</option>
                        <option value="10">Sft</option>
                        <option value="1">Cum</option>
                        <option value="3">Rmt</option>
                    </select>
                </div>

                <div class="pt-3 border-t border-slate-200 dark:border-slate-700 flex justify-end gap-2.5">
                    <button type="button" onclick="closeServiceModal()" class="px-4 py-2 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" id="btnSaveServiceSubmit" class="px-5 py-2 rounded-lg text-xs font-bold text-white bg-teal-600 hover:bg-teal-700 cursor-pointer shadow-md flex items-center gap-1.5">
                        <i class="fas fa-save"></i>
                        <span>Save Service</span>
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        var gridInstance = null;
        var uomList = [];

        $(document).ready(function () {
            loadUomDropdown();
            loadServiceTypeDropdown();
            initServiceGrid();
            loadGridServices();
        });

        function loadUomDropdown() {
            $.ajax({
                url: '/ServiceMaster/GetUOMList',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        uomList = res.data;
                        var $ddl = $('#ddlModalServiceUom');
                        $ddl.empty();
                        uomList.forEach(function (u) {
                            $ddl.append(new Option(u.unitName, u.unitId));
                        });
                        $ddl.val('4'); // Default to Nos
                    }
                }
            });
        }

        function loadServiceTypeDropdown(selectedId) {
            $.ajax({
                url: '/ServiceMaster/GetServiceTypeList',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        var $ddl = $('#ddlModalServiceType');
                        $ddl.empty();
                        res.data.forEach(function (st) {
                            $ddl.append(new Option(st.serviceTypeName, st.serviceTypeId));
                        });
                        if (selectedId) {
                            $ddl.val(String(selectedId));
                        }
                    }
                }
            });
        }

        function promptAddNewServiceType() {
            Swal.fire({
                title: 'Add New Service Type',
                input: 'text',
                inputLabel: 'Service Type Name',
                inputPlaceholder: 'e.g. Consultancy, Legal, Marketing, Civil',
                showCancelButton: true,
                confirmButtonText: 'Save Type',
                confirmButtonColor: '#0d9488',
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Service Type Name cannot be empty!';
                    }
                }
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    $.ajax({
                        url: '/ServiceMaster/SaveServiceType',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ serviceTypeName: result.value.trim() }),
                        success: function (res) {
                            if (res && res.success) {
                                loadServiceTypeDropdown(res.serviceTypeId);
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Service Type Created',
                                    text: res.message || 'Service Type added successfully.',
                                    timer: 1500,
                                    showConfirmButton: false,
                                    toast: true,
                                    position: 'top-end'
                                });
                            } else {
                                Swal.fire('Error', res.message || 'Failed to add Service Type.', 'error');
                            }
                        }
                    });
                }
            });
        }

        function initServiceGrid() {
            gridInstance = $("#dxGridServiceMaster").dxDataGrid({
                dataSource: [],
                keyExpr: "serviceId",
                showBorders: true,
                showRowLines: true,
                rowAlternationEnabled: true,
                hoverStateEnabled: true,
                columnAutoWidth: true,
                wordWrapEnabled: false,
                allowColumnResizing: true,
                searchPanel: {
                    visible: true,
                    width: 260,
                    placeholder: "Search services..."
                },
                headerFilter: { visible: true },
                export: { enabled: true, fileName: "ServiceMaster" },
                paging: { pageSize: 15 },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 15, 25, 50],
                    showInfo: true
                },
                columns: [
                    {
                        caption: "Actions",
                        width: 90,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "left",
                        cellTemplate: function (container, options) {
                            var $btnEdit = $(`
                                <button type="button" class="text-sky-600 hover:text-sky-800 dark:text-sky-400 p-1.5 rounded hover:bg-sky-50 dark:hover:bg-slate-700 transition cursor-pointer" title="Edit Service">
                                    <i class="fas fa-edit"></i>
                                </button>
                            `).on('click', function () {
                                openEditServiceModal(options.data);
                            });

                            var $btnDel = $(`
                                <button type="button" class="text-rose-600 hover:text-rose-800 dark:text-rose-400 p-1.5 rounded hover:bg-rose-50 dark:hover:bg-slate-700 transition ml-1 cursor-pointer" title="Delete Service">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            `).on('click', function () {
                                confirmDeleteService(options.data.serviceId, options.data.serviceName);
                            });

                            container.append($btnEdit).append($btnDel);
                        }
                    },
                    {
                        dataField: "servicecode",
                        caption: "Service Code",
                        width: 150,
                        cellTemplate: function (container, options) {
                            $(`<span class="font-mono font-bold text-teal-700 dark:text-teal-400">${options.value || '—'}</span>`).appendTo(container);
                        }
                    },
                    {
                        dataField: "serviceName",
                        caption: "Service Name / Description",
                        minWidth: 280,
                        cellTemplate: function (container, options) {
                            $(`<span class="font-semibold text-slate-800 dark:text-slate-100">${options.value || '—'}</span>`).appendTo(container);
                        }
                    },
                    {
                        dataField: "serviceTypeName",
                        caption: "Service Type",
                        width: 170,
                        cellTemplate: function (container, options) {
                            var st = options.value || 'General';
                            $(`<span class="px-2.5 py-0.5 rounded-md bg-sky-50 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800 font-semibold text-xs">${st}</span>`).appendTo(container);
                        }
                    },
                    {
                        dataField: "unitName",
                        caption: "Default Unit",
                        width: 140,
                        cellTemplate: function (container, options) {
                            var u = options.value || 'Nos';
                            $(`<span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium text-xs">${u}</span>`).appendTo(container);
                        }
                    },
                    {
                        dataField: "status",
                        caption: "Status",
                        width: 110,
                        alignment: "center",
                        cellTemplate: function (container, options) {
                            var isActive = options.value === "1";
                            var badge = isActive 
                                ? `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">Active</span>`
                                : `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 dark:bg-rose-950/50 dark:text-rose-300 border border-rose-200 dark:border-rose-800">Inactive</span>`;
                            $(badge).appendTo(container);
                        }
                    }
                ]
            }).dxDataGrid("instance");
        }

        function loadGridServices() {
            $.ajax({
                url: '/ServiceMaster/GetAll',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        var grid = $("#dxGridServiceMaster").dxDataGrid("instance");
                        if (grid) grid.option("dataSource", res.data);
                        $('#badgeServiceCount').text(res.data.length + ' Service' + (res.data.length !== 1 ? 's' : ''));
                    }
                }
            });
        }

        function openAddServiceModal() {
            $('#modalServiceTitle').text('Create New Service');
            $('#txtModalServiceId').val('0');
            $('#txtModalServiceName').val('');
            $('#ddlModalServiceType').prop('selectedIndex', 0);
            $('#ddlModalServiceUom').val('4');
            refreshAutoCode();
            $('#modalServiceEdit').fadeIn(150);
        }

        function openEditServiceModal(item) {
            if (!item) return;
            $('#modalServiceTitle').text('Edit Service');
            $('#txtModalServiceId').val(item.serviceId || '0');
            $('#txtModalServiceCode').val(item.servicecode || '');
            $('#txtModalServiceName').val(item.serviceName || '');
            $('#ddlModalServiceType').val(String(item.serviceTypeId || '1'));
            $('#ddlModalServiceUom').val(item.unitId || '4');
            $('#modalServiceEdit').fadeIn(150);
        }

        function closeServiceModal() {
            $('#modalServiceEdit').fadeOut(150);
        }

        function refreshAutoCode() {
            $.ajax({
                url: '/ServiceMaster/GetNextCode',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.nextCode) {
                        $('#txtModalServiceCode').val(res.nextCode);
                    }
                }
            });
        }

        function submitServiceForm() {
            var id = parseInt($('#txtModalServiceId').val()) || 0;
            var code = $('#txtModalServiceCode').val().trim();
            var name = $('#txtModalServiceName').val().trim();
            var typeId = $('#ddlModalServiceType').val() || "1";
            var unitId = $('#ddlModalServiceUom').val();

            if (!code) {
                Swal.fire('Validation Warning', 'Please enter a Service Code.', 'warning');
                return;
            }
            if (!name) {
                Swal.fire('Validation Warning', 'Please enter a Service Name / Description.', 'warning');
                return;
            }

            var payload = {
                serviceId: id > 0 ? id : null,
                servicecode: code,
                serviceName: name,
                serviceTypeId: typeId,
                unitId: unitId,
                status: "1"
            };

            Swal.fire({
                title: id > 0 ? 'Updating service...' : 'Saving service...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/ServiceMaster/Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    Swal.close();
                    if (res && res.success) {
                        closeServiceModal();
                        loadGridServices();
                        Swal.fire({
                            icon: 'success',
                            title: 'Saved!',
                            text: res.message || 'Service saved successfully.',
                            timer: 1800,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                    } else {
                        Swal.fire('Save Failed', res.message || 'Could not save service.', 'error');
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire('Error', 'Server communication error.', 'error');
                }
            });
        }

        function confirmDeleteService(serviceId, serviceName) {
            Swal.fire({
                title: 'Delete Service?',
                html: `Are you sure you want to delete <strong>${serviceName}</strong>?<br/><span class="text-xs text-slate-500">This will deactivate the service in Project_ServiceMas.</span>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/ServiceMaster/Delete?id=' + encodeURIComponent(serviceId),
                        type: 'POST',
                        success: function (res) {
                            if (res && res.success) {
                                loadGridServices();
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: 'Service has been deleted.',
                                    timer: 1500,
                                    showConfirmButton: false,
                                    toast: true,
                                    position: 'top-end'
                                });
                            } else {
                                Swal.fire('Error', res.message || 'Could not delete service.', 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Server communication error.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
