@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "Sales DSR Report - VGN ERP";
}


<style>
    /* Content Sections */
    .content-section {
        display: none;
        animation: slideUpFade 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .content-section.active {
        display: block;
    }

    @@keyframes slideUpFade {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--border, #cbd5e1); border-radius: 10px; }

    /* Theme Integration */
    .theme-card {
        background-color: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
    }
    .theme-text {
        color: var(--text);
    }
    .theme-text-muted {
        color: var(--text-muted);
    }
    .theme-bg {
        background-color: var(--bg);
    }

    /* ── Loader overlay ── */
    .sa-loader-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 1rem;
    }

    .sa-loader-overlay.show {
        display: flex;
    }

    .sa-loader-overlay .spinner-ring {
        width: 60px;
        height: 60px;
        border: 5px solid rgba(255,255,255,.25);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: sa-spin .8s linear infinite;
    }

    .sa-loader-overlay .msg {
        color: #fff;
        font-size: .92rem;
        font-weight: 600;
        letter-spacing: .3px;
    }

    @@keyframes sa-spin {
        to { transform: rotate(360deg); }
    }

    /* ── Summary row — distinct primary color ── */
    .dx-footer-row {
        background: rgba(var(--primary-rgb), 0.18) !important;
        border-top: 2px solid var(--primary) !important;
    }
    .dx-footer-row td {
        color: var(--primary) !important;
        font-weight: 800 !important;
        font-size: 0.82rem !important;
    }
    .dx-datagrid-summary-item {
        color: var(--primary) !important;
        font-weight: 800 !important;
    }

    /* Modal — pure Tailwind, no Bootstrap */
    .tw-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
    }
    .tw-modal.show {
        display: flex;
    }

    /* ── Filter inputs — pure Tailwind-styled, no Bootstrap ── */
    .filter-input {
        background-color: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        border-radius: 0.5rem;
        height: 36px;
        padding: 0 0.625rem;
        font-size: 0.8rem;
        outline: none;
        transition: border-color .15s;
    }
    .filter-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 2px rgba(var(--primary-rgb), .15);
    }

    /* ── Filter label above input (like VGN_360 style) ── */
    .filter-field {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .filter-field .fl-label {
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        white-space: nowrap;
        line-height: 1;
    }

    /* Time checkbox */
    .tw-check {
        width: 16px;
        height: 16px;
        accent-color: var(--primary);
        cursor: pointer;
        flex-shrink: 0;
    }

    /* Time-toggle pill */
    .time-toggle-pill {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        padding: 6px 12px;
        border-radius: 8px;
        border: 1px dashed var(--border);
        cursor: pointer;
        transition: border-color .15s, background .15s;
        user-select: none;
        flex-shrink: 0;
    }
    .time-toggle-pill:hover {
        border-color: var(--primary);
        background: rgba(var(--primary-rgb), .04);
    }
    .time-toggle-pill .pill-label {
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        line-height: 1;
    }
    .time-toggle-pill .pill-check {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--text-muted);
    }
</style>

<input type="hidden" id="HDeptId" value="@(Context.Session.GetString("DepartmentID") ?? "")" />
<input type="hidden" id="HUserType" value="@(Context.Session.GetString("SalesUserType") ?? "")" />

<!-- Loader -->
<div class="sa-loader-overlay" id="loader">
    <div class="spinner-ring"></div>
    <div class="msg">Loading Data, Please Wait...</div>
</div>

<div class="content-section active">
    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- ROW 1: Compact Filter Toolbar — all items inline, one row -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <div class="theme-card rounded-xl shadow-sm px-4 py-3 mb-4 relative overflow-hidden" style="border-color: var(--border);">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

        <!-- Single flex row — no wrapping for label+input combos -->
        <div class="flex flex-wrap items-end gap-3 relative z-10">

            <!-- Funnel icon label -->
            <div class="flex flex-col items-start gap-0.5 shrink-0">
                <span class="text-[9px] font-black theme-text-muted uppercase tracking-widest opacity-0">.</span>
                <div class="flex items-center gap-2 text-primary" style="height:36px;">
                    <i class="bi bi-funnel-fill text-sm"></i>
                    <span class="font-bold text-xs uppercase tracking-widest theme-text-muted hidden sm:inline">Filters</span>
                </div>
            </div>
            <div class="w-px self-stretch shrink-0 my-0.5" style="background: var(--border);"></div>

            <!-- TIME Toggle pill -->
            <label class="time-toggle-pill" for="chkWithTime">
                <span class="pill-label">Time</span>
                <div class="pill-check">
                    <input type="checkbox" id="chkWithTime" class="tw-check">
                    <span id="chkTimeLabel" class="text-[11px] font-bold theme-text-muted">Off</span>
                </div>
            </label>
            <div class="w-px self-stretch shrink-0 my-0.5" style="background: var(--border);"></div>

            <!-- FROM — Date -->
            <div class="filter-field" id="from_date_container">
                <span class="fl-label">From</span>
                <input type="date" class="filter-input" id="from_date" style="width:148px;">
            </div>
            
            <!-- FROM — Datetime -->
            <div class="filter-field" id="from_datetime_container" style="display:none;">
                <span class="fl-label">From</span>
                <input type="datetime-local" class="filter-input" id="from_datetime" style="width:195px;">
            </div>

            <!-- TO — Date -->
            <div class="filter-field" id="to_date_container">
                <span class="fl-label">To</span>
                <input type="date" class="filter-input" id="to_date" style="width:148px;">
            </div>
            
            <!-- TO — Datetime -->
            <div class="filter-field" id="to_datetime_container" style="display:none;">
                <span class="fl-label">To</span>
                <input type="datetime-local" class="filter-input" id="to_datetime" style="width:195px;">
            </div>

            <!-- TEAM -->
            <div class="filter-field flex-1 min-w-[150px]">
                <span class="fl-label">Team</span>
                <select class="filter-input w-full" id="teamSelect">
                    <option value="">-- All Teams --</option>
                </select>
            </div>

            <!-- Action Buttons — aligned to bottom -->
            <div class="flex items-end gap-2 shrink-0 ml-auto">
                <div class="flex flex-col gap-0.5">
                    <span class="text-[9px] font-black theme-text-muted uppercase tracking-widest opacity-0">.</span>
                    <div class="flex items-center gap-2">
                        <button type="button" class="btn-load py-1.5 px-4" id="btn_refresh">
                            <i class="bi bi-arrow-repeat"></i> LOAD
                        </button>
                        <button type="button" class="btn-clear py-1.5 px-4" id="btn_clear">
                            <i class="bi bi-eraser"></i> CLEAR
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Grid Section -->
    <div class="theme-card rounded-2xl shadow-sm p-5 flex flex-col relative overflow-hidden">
        <div class="absolute top-0 left-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/3 pointer-events-none"></div>

        <div class="flex justify-between items-center mb-4 pb-3 border-b relative z-10" style="border-color: var(--border);">
            <h3 class="font-bold theme-text uppercase text-sm tracking-wider flex items-center gap-2 m-0">
                <i class="bi bi-table text-primary"></i>
                Sales DSR Data
            </h3>
        </div>
        <div id="gridContainer" class="w-full custom-scrollbar flex-1 relative z-10"></div>
    </div>
</div>

<!-- Tailwind Modal for Details — no Bootstrap -->
<div id="popupContainer" class="tw-modal">
    <div class="theme-card w-full max-w-5xl rounded-2xl shadow-2xl mx-4 flex flex-col max-h-[90vh] overflow-hidden" style="animation: slideUpFade 0.3s ease-out;">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b flex justify-between items-center bg-gray-50/50 dark:bg-gray-800/50" style="border-color: var(--border);">
            <h5 class="font-bold theme-text uppercase tracking-wider m-0" id="popupContainerLabel">DETAILS</h5>
            <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors" onclick="document.getElementById('popupContainer').classList.remove('show');">
                <i class="bi bi-x-lg text-lg"></i>
            </button>
        </div>
        <!-- Modal Body -->
        <div class="p-6 overflow-y-auto custom-scrollbar flex-1">
            <div id="popupContent" class="popup-content min-h-[400px]"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/applicationjs/SalesDSRReport.js"></script>
}
