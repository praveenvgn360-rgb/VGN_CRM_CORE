@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "Sales DSR Report - VGN ERP";
}


<style>
    /* Content Sections */
    .content-section {
        display: none;
        animation: slideUpFade 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .content-section.active {
        display: block;
    }

    @@keyframes slideUpFade {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--border, #cbd5e1); border-radius: 10px; }

    /* Theme Integration */
    .theme-card {
        background-color: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
    }
    .theme-text {
        color: var(--text);
    }
    .theme-text-muted {
        color: var(--text-muted);
    }
    .theme-bg {
        background-color: var(--bg);
    }

    /* ── Loader overlay ── */
    .sa-loader-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 1rem;
    }

    .sa-loader-overlay.show {
        display: flex;
    }

    .sa-loader-overlay .spinner-ring {
        width: 60px;
        height: 60px;
        border: 5px solid rgba(255,255,255,.25);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: sa-spin .8s linear infinite;
    }

    .sa-loader-overlay .msg {
        color: #fff;
        font-size: .92rem;
        font-weight: 600;
        letter-spacing: .3px;
    }

    @@keyframes sa-spin {
        to { transform: rotate(360deg); }
    }

    /* DevExtreme overrides matching core layout */
    .dx-footer-row {
        background: rgba(var(--primary-rgb), .1);
        color: var(--text);
        font-weight: bold;
    }
    .dx-datagrid-summary-item {
        color: var(--text) !important;
    }

    /* Modal Tailwind classes */
    .tw-modal {
        display: none; /* hidden by default */
        position: fixed;
        inset: 0;
        z-index: 9999;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
    }
    .tw-modal.show {
        display: flex;
    }
</style>

<input type="hidden" id="HDeptId" value="@(Context.Session.GetString("DepartmentID") ?? "")" />
<input type="hidden" id="HUserType" value="@(Context.Session.GetString("SalesUserType") ?? "")" />

<!-- Loader -->
<div class="sa-loader-overlay" id="loader">
    <div class="spinner-ring"></div>
    <div class="msg">Loading Data, Please Wait...</div>
</div>

<div class="content-section active">
    <!-- Filters Section -->
    <div class="theme-card rounded-2xl shadow-sm p-5 mb-5 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

        <div class="flex items-center justify-between mb-4 pb-3 border-b relative z-10" style="border-color: var(--border);">
            <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                    <i class="bi bi-funnel-fill"></i>
                </div>
                <h3 class="font-bold theme-text uppercase text-sm tracking-wider m-0">Filters</h3>
            </div>
        </div>

        <div class="flex flex-wrap gap-4 items-end relative z-10">
            <!-- TIME Checkbox -->
            <div class="group flex items-center mb-3 gap-2">
                <input type="checkbox" id="chkWithTime" class="form-check-input cursor-pointer rounded">
                <label for="chkWithTime" class="text-xs font-bold theme-text-muted uppercase tracking-wider mb-0 cursor-pointer">Time</label>
            </div>

            <!-- FROM Date -->
            <div class="group" id="fromDateWrapper">
                <label for="from_date" class="block text-xs font-bold theme-text-muted uppercase tracking-wider mb-1.5">FROM</label>
                <input type="date" class="form-control rounded-lg w-[160px] md:w-[180px] h-[40px] px-3" id="from_date">
            </div>

            <!-- FROM DateTime (hidden) -->
            <div class="group hidden" id="fromDateTimeWrapper">
                <label for="from_datetime" class="block text-xs font-bold theme-text-muted uppercase tracking-wider mb-1.5">FROM</label>
                <input type="datetime-local" class="form-control rounded-lg w-[210px] md:w-[230px] h-[40px] px-3" id="from_datetime">
            </div>

            <!-- TO Date -->
            <div class="group" id="toDateWrapper">
                <label for="to_date" class="block text-xs font-bold theme-text-muted uppercase tracking-wider mb-1.5">TO</label>
                <input type="date" class="form-control rounded-lg w-[160px] md:w-[180px] h-[40px] px-3" id="to_date">
            </div>

            <!-- TO DateTime (hidden) -->
            <div class="group hidden" id="toDateTimeWrapper">
                <label for="to_datetime" class="block text-xs font-bold theme-text-muted uppercase tracking-wider mb-1.5">TO</label>
                <input type="datetime-local" class="form-control rounded-lg w-[210px] md:w-[230px] h-[40px] px-3" id="to_datetime">
            </div>

            <!-- TEAM -->
            <div class="group">
                <label for="teamSelect" class="block text-xs font-bold theme-text-muted uppercase tracking-wider mb-1.5">TEAM</label>
                <select class="form-select w-[160px] md:w-[200px] rounded-lg h-[40px] px-3" id="teamSelect">
                    <option value="">-- All Teams --</option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2">
                <button type="button" class="btn-load px-5 justify-center py-2 h-[40px] rounded-lg" id="btn_refresh">
                    <i class="bi bi-arrow-repeat"></i> LOAD
                </button>
                <button type="button" class="btn-clear px-5 justify-center py-2 h-[40px] rounded-lg" id="btn_clear">
                    <i class="bi bi-eraser"></i> CLEAR
                </button>
            </div>
        </div>
    </div>

    <!-- Data Grid Section -->
    <div class="theme-card rounded-2xl shadow-sm p-5 flex flex-col relative overflow-hidden">
        <div class="absolute top-0 left-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/3 pointer-events-none"></div>

        <div class="flex justify-between items-center mb-4 pb-3 border-b relative z-10" style="border-color: var(--border);">
            <h3 class="font-bold theme-text uppercase text-sm tracking-wider flex items-center gap-2 m-0">
                <i class="bi bi-table text-primary"></i>
                Sales DSR Data
            </h3>
        </div>
        <div id="gridContainer" class="w-full custom-scrollbar flex-1 relative z-10"></div>
    </div>
</div>

<!-- Tailwind Modal for Details -->
<div id="popupContainer" class="tw-modal">
    <div class="theme-card w-full max-w-5xl rounded-2xl shadow-2xl mx-4 flex flex-col max-h-[90vh] overflow-hidden" style="animation: slideUpFade 0.3s ease-out;">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b flex justify-between items-center bg-gray-50/50 dark:bg-gray-800/50" style="border-color: var(--border);">
            <h5 class="font-bold theme-text uppercase tracking-wider m-0" id="popupContainerLabel">DETAILS</h5>
            <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors" onclick="document.getElementById('popupContainer').classList.remove('show');">
                <i class="bi bi-x-lg text-lg"></i>
            </button>
        </div>
        <!-- Modal Body -->
        <div class="p-6 overflow-y-auto custom-scrollbar flex-1">
            <div id="popupContent" class="popup-content min-h-[400px]"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/applicationjs/SalesDSRReport.js"></script>
}
