@{
    ViewBag.Title = "Active Leads Aging Report - VGN ERP";
}

<style>
    /* Tabs */
    .tab-btn {
        transition: all 0.3s ease;
    }
    .tab-btn.active {
        border-bottom-color: var(--primary);
        color: var(--primary);
    }
    .tab-btn:hover:not(.active) {
        color: var(--primary);
        border-bottom-color: var(--primary);
        opacity: 0.7;
    }

    /* Content Sections */
    .content-section {
        display: none;
        animation: slideUpFade 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .content-section.active {
        display: block;
    }

    @@keyframes slideUpFade {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--border, #cbd5e1); border-radius: 10px; }

    /* Layout Specifics */
    .stat-card-input {
        background: transparent; border: 0; padding: 0; outline: none;
        font-weight: 900; font-size: 1.25rem; line-height: 1; text-align: right;
        color: var(--text);
    }
    .stat-card-input:focus { outline: none; box-shadow: none; }
    
    /* Theme Integration */
    .theme-card {
        background-color: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
    }
    .theme-text {
        color: var(--text);
    }
    .theme-text-muted {
        color: var(--text-muted);
    }
    .theme-bg {
        background-color: var(--bg);
    }

    /* ── Loader overlay ── */
    .sa-loader-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 1rem;
    }

    .sa-loader-overlay.show {
        display: flex;
    }

    .sa-loader-overlay .spinner-ring {
        width: 60px;
        height: 60px;
        border: 5px solid rgba(255,255,255,.25);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: sa-spin .8s linear infinite;
    }

    .sa-loader-overlay .msg {
        color: #fff;
        font-size: .92rem;
        font-weight: 600;
        letter-spacing: .3px;
    }

    @@keyframes sa-spin {
        to { transform: rotate(360deg); }
    }

    /* Filter selects — pure Tailwind-style, no Bootstrap */
    .al-filter-select {
        background-color: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        border-radius: 0.5rem;
        height: 34px;
        padding: 0 0.625rem;
        font-size: 0.8rem;
        outline: none;
        width: 100%;
        transition: border-color .15s;
    }
    .al-filter-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 2px rgba(var(--primary-rgb), .15);
    }
</style>

<!-- Hidden fields -->
<input type="hidden" id="HEnquiryNo" value="@Context.Request.Query["EnquiryNo"]" />

<!-- Loader -->
<div class="sa-loader-overlay" id="loader">
    <div class="spinner-ring"></div>
    <div class="msg">Loading Data Please Wait...</div>
</div>

<!-- Tabs -->
<div class="flex border-b border-gray-200 dark:border-gray-700 mb-6 overflow-x-auto">
    <button class="tab-btn active px-4 py-2 border-b-2 font-medium text-sm border-primary text-primary whitespace-nowrap" data-section="activeleads">
        <i class="bi bi-person-lines-fill mr-2"></i>Active Leads
    </button>
    <button class="tab-btn px-4 py-2 border-b-2 border-transparent font-medium text-sm text-gray-500 whitespace-nowrap" data-section="ManualLeads">
        <i class="bi bi-person-fill-add mr-2"></i>Manual Leads
    </button>
</div>

<!-- ACTIVE LEADS SECTION -->
<div id="activeleads" class="content-section active">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- ROW 1: Compact Filter Toolbar (no labels, uses placeholders) -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <div class="theme-card rounded-xl shadow-sm px-4 py-3 mb-4 relative overflow-hidden" style="border-color: var(--border);">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
        <div class="flex flex-wrap items-center gap-3 relative z-10">
            <!-- Funnel icon label -->
            <div class="flex items-center gap-2 text-primary shrink-0">
                <i class="bi bi-funnel-fill text-sm"></i>
                <span class="font-bold text-xs uppercase tracking-widest theme-text-muted hidden sm:inline">Filters</span>
            </div>
            <div class="w-px h-6 shrink-0" style="background: var(--border);"></div>
            <!-- Dropdowns (no labels — placeholder acts as label) -->
            <div class="flex-1 min-w-[140px]">
                <select class="select2 al-filter-select" id="dd_ExecutiveName" data-placeholder="All Executives"></select>
            </div>
            <div class="flex-1 min-w-[140px]">
                <select class="select2 al-filter-select" id="dd_Teammanager" data-placeholder="All Team Managers"></select>
            </div>
            <div class="flex-1 min-w-[140px]">
                <select class="select2 al-filter-select" id="dd_TeamHead" data-placeholder="All Team Heads"></select>
            </div>
            <!-- Category Toggle -->
            <div class="shrink-0">
                <div class="flex theme-bg rounded-lg p-1 border shadow-inner" style="border-color: var(--border);">
                    <label class="relative cursor-pointer m-0">
                        <input type="radio" name="EnquiryType" value="PRIMARY" checked class="peer sr-only">
                        <div class="px-3 py-1.5 text-xs font-bold theme-text-muted rounded-md peer-checked:bg-[var(--surface)] peer-checked:text-primary peer-checked:shadow-sm transition-all duration-200 whitespace-nowrap">PRIMARY</div>
                    </label>
                    <label class="relative cursor-pointer m-0">
                        <input type="radio" name="EnquiryType" value="SECONDARY" class="peer sr-only">
                        <div class="px-3 py-1.5 text-xs font-bold theme-text-muted rounded-md peer-checked:bg-[var(--surface)] peer-checked:text-primary peer-checked:shadow-sm transition-all duration-200 whitespace-nowrap">SECONDARY</div>
                    </label>
                </div>
            </div>
            <!-- Action Buttons -->
            <div class="flex items-center gap-2 shrink-0">
                <button type="button" class="btn-load py-1.5 px-4" id="btn_refresh">
                    <i class="bi bi-arrow-repeat"></i> LOAD
                </button>
                <button type="button" class="btn-clear py-1.5 px-4" id="btn_clear">
                    <i class="bi bi-eraser"></i> CLEAR
                </button>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- ROW 2: DxGrid — PRIMARY ELEMENT (grid first, stats second) -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <div class="theme-card rounded-2xl shadow-sm flex flex-col relative overflow-hidden mb-4" style="min-height: 480px;">
        <div class="absolute top-0 left-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/3 pointer-events-none"></div>

        <!-- Grid Header Bar -->
        <div class="flex flex-wrap justify-between items-center px-5 pt-4 pb-3 border-b gap-3 relative z-10" style="border-color: var(--border);">
            <h3 class="font-bold theme-text uppercase text-sm tracking-wider flex items-center gap-2">
                <i class="bi bi-table text-primary"></i>
                Active Leads Data
            </h3>
            <div class="flex items-center gap-3">
                <!-- Total Records Badge -->
                <div class="flex items-center gap-2 text-xs font-semibold theme-text-muted theme-bg border px-3 py-1.5 rounded-lg shadow-inner" style="border-color: var(--border);">
                    <i class="bi bi-database text-primary text-xs"></i>
                    <span>Total Records:</span>
                    <span id="grid_count" class="text-primary font-black text-base leading-none">0</span>
                </div>
                <!-- Toggle Summary Button -->
                <button type="button" id="btn_toggleSummary" title="Show/Hide Summary Stats"
                    class="flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-lg border transition-all duration-200 hover:shadow-sm"
                    style="background: var(--bg); border-color: var(--border); color: var(--text-muted);">
                    <i class="bi bi-bar-chart-line text-primary"></i>
                    <span class="hidden sm:inline">SUMMARY</span>
                    <i class="bi bi-chevron-down text-[10px] transition-transform duration-300" id="summary_chevron"></i>
                </button>
            </div>
        </div>

        <!-- ── Collapsible Summary Strip (Stats Cards) ── -->
        <div id="summaryStrip" class="overflow-hidden transition-all duration-400 ease-in-out relative z-10" style="max-height: 0; opacity: 0;">
            <div class="px-5 pt-3 pb-4 border-b" style="border-color: var(--border);">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">

                    <!-- Site Visit -->
                    <div class="rounded-xl p-3 relative overflow-hidden" style="background: rgba(59,130,246,0.06); border: 1px solid rgba(59,130,246,0.18);">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="w-6 h-6 rounded-md bg-blue-100 text-blue-600 flex items-center justify-center text-xs"><i class="bi bi-geo-alt"></i></div>
                            <span class="font-black text-[10px] tracking-widest uppercase" style="color: #3b82f6;">Site Visit</span>
                        </div>
                        <div class="flex justify-between items-center text-[10px] font-semibold mb-1">
                            <span class="theme-text-muted">Not Updated</span>
                            <input type="text" id="SvNotUpdated" disabled class="stat-card-input w-10" value="0"/>
                        </div>
                        <div class="flex justify-between items-center text-[10px] font-semibold mb-2">
                            <span class="theme-text-muted">In Progress</span>
                            <input type="text" id="SvInprogress" disabled class="stat-card-input w-10" value="0"/>
                        </div>
                        <div class="flex justify-between items-center rounded-md px-2 py-1" style="background: rgba(249,115,22,0.1); border: 1px solid rgba(249,115,22,0.2);">
                            <div class="flex items-center gap-1" style="color:#f97316;"><i class="bi bi-fire text-[10px] animate-pulse"></i><span class="text-[9px] font-black">HOT</span></div>
                            <input type="text" id="Hotleads" disabled class="stat-card-input w-8" style="color:#f97316;" value="0"/>
                        </div>
                    </div>

                    <!-- Negotiation -->
                    <div class="rounded-xl p-3 relative overflow-hidden" style="background: rgba(99,102,241,0.06); border: 1px solid rgba(99,102,241,0.18);">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="w-6 h-6 rounded-md bg-indigo-100 text-indigo-600 flex items-center justify-center text-xs"><i class="bi bi-chat-dots"></i></div>
                            <span class="font-black text-[10px] tracking-widest uppercase" style="color: #6366f1;">Negotiation</span>
                        </div>
                        <div class="flex justify-between items-center text-[10px] font-semibold mb-1">
                            <span class="theme-text-muted">Not Updated</span>
                            <input type="text" id="NegoNotUpdated" disabled class="stat-card-input w-10" value="0"/>
                        </div>
                        <div class="flex justify-between items-center text-[10px] font-semibold mb-2">
                            <span class="theme-text-muted">In Progress</span>
                            <input type="text" id="NegoInprogress" disabled class="stat-card-input w-10" value="0"/>
                        </div>
                        <div class="flex justify-between items-center rounded-md px-2 py-1" style="background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2);">
                            <div class="flex items-center gap-1" style="color:#3b82f6;"><i class="bi bi-thermometer-half text-[10px]"></i><span class="text-[9px] font-black">WARM</span></div>
                            <input type="text" id="WarmLeads" disabled class="stat-card-input w-8" style="color:#3b82f6;" value="0"/>
                        </div>
                    </div>

                    <!-- Booking Adv. -->
                    <div class="rounded-xl p-3 relative overflow-hidden" style="background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.18);">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="w-6 h-6 rounded-md bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs"><i class="bi bi-cash-coin"></i></div>
                            <span class="font-black text-[10px] tracking-widest uppercase" style="color: #10b981;">Booking Adv.</span>
                        </div>
                        <div class="flex justify-between items-center text-[10px] font-semibold mb-1">
                            <span class="theme-text-muted">Not Updated</span>
                            <input type="text" id="BookNotUpdated" disabled class="stat-card-input w-10" value="0"/>
                        </div>
                        <div class="flex justify-between items-center text-[10px] font-semibold mb-2">
                            <span class="theme-text-muted">In Progress</span>
                            <input type="text" id="BookInprogress" disabled class="stat-card-input w-10" value="0"/>
                        </div>
                        <div class="flex justify-between items-center rounded-md px-2 py-1" style="background: rgba(14,165,233,0.1); border: 1px solid rgba(14,165,233,0.2);">
                            <div class="flex items-center gap-1" style="color:#0ea5e9;"><i class="bi bi-snow text-[10px]"></i><span class="text-[9px] font-black">COLD</span></div>
                            <input type="text" id="ColdLeads" disabled class="stat-card-input w-8" style="color:#0ea5e9;" value="0"/>
                        </div>
                    </div>

                    <!-- Future Proj. -->
                    <div class="rounded-xl p-3 relative overflow-hidden" style="background: rgba(168,85,247,0.06); border: 1px solid rgba(168,85,247,0.18);">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="w-6 h-6 rounded-md bg-purple-100 text-purple-600 flex items-center justify-center text-xs"><i class="bi bi-building"></i></div>
                            <span class="font-black text-[10px] tracking-widest uppercase" style="color: #a855f7;">Future Proj.</span>
                        </div>
                        <div class="flex justify-between items-center text-[10px] font-semibold mb-1">
                            <span class="theme-text-muted">Not Updated</span>
                            <input type="text" id="FutNotUpdated" disabled class="stat-card-input w-10" value="0"/>
                        </div>
                        <div class="flex justify-between items-center text-[10px] font-semibold mb-2">
                            <span class="theme-text-muted">In Progress</span>
                            <input type="text" id="FutInprogress" disabled class="stat-card-input w-10" value="0"/>
                        </div>
                        <div class="flex justify-between items-center rounded-md px-2 py-1" style="background: rgba(139,92,246,0.1); border: 1px solid rgba(139,92,246,0.2);">
                            <div class="flex items-center gap-1" style="color:#8b5cf6;"><i class="bi bi-three-dots text-[10px]"></i><span class="text-[9px] font-black">OTHERS</span></div>
                            <input type="text" id="OtherLeads" disabled class="stat-card-input w-8" style="color:#8b5cf6;" value="0"/>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ── The DxGrid ── -->
        <div id="gridContainer" class="w-full custom-scrollbar flex-1 relative z-10 p-4"></div>
    </div>

</div>

<!-- MANUAL LEADS SECTION -->
<div id="ManualLeads" class="content-section">
    <div class="theme-card rounded-2xl shadow-sm p-5 flex flex-col relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
        
        <div class="flex justify-between items-center mb-4 pb-3 border-b flex-wrap gap-4 relative z-10" style="border-color: var(--border);">
            <h3 class="font-bold theme-text uppercase text-sm tracking-wider flex items-center gap-2">
                <i class="bi bi-person-lines-fill text-primary"></i>
                Manual Leads Data
            </h3>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2 text-xs font-semibold theme-text-muted theme-bg border px-3 py-1.5 rounded-lg shadow-inner" style="border-color: var(--border);">
                    <span>Total Records:</span>
                    <span id="summary_grid_count" class="text-primary font-black text-base leading-none">0</span>
                </div>
                <div class="flex items-center gap-2 border-l pl-4" style="border-color: var(--border);">
                    <button type="button" class="btn-load py-1.5" id="btn_LoadManualLeads">
                        <i class="bi bi-arrow-repeat"></i> LOAD
                    </button>
                    <button type="button" class="btn-clear py-1.5" id="btn_ManualLeadclear">
                        <i class="bi bi-eraser"></i> CLEAR
                    </button>
                </div>
            </div>
        </div>
        <div id="gridContainer1" class="w-full custom-scrollbar flex-1 relative z-10"></div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Tab switching logic
            $('.tab-btn').click(function (e) {
                e.preventDefault();
                const section = $(this).data('section');
                
                // Update tabs styling
                $('.tab-btn').removeClass('active border-primary text-primary').addClass('border-transparent text-gray-500');
                $(this).removeClass('border-transparent text-gray-500').addClass('active border-primary text-primary');

                // Switch section display
                $('.content-section').removeClass('active');
                setTimeout(() => {
                    $(`#${section}`).addClass('active');
                }, 50); // slight delay for smooth animation trigger
            });

            // Summary strip toggle
            let summaryOpen = false;
            const strip = document.getElementById('summaryStrip');
            const chevron = document.getElementById('summary_chevron');
            document.getElementById('btn_toggleSummary').addEventListener('click', function () {
                summaryOpen = !summaryOpen;
                if (summaryOpen) {
                    strip.style.maxHeight = strip.scrollHeight + 'px';
                    strip.style.opacity = '1';
                    chevron.style.transform = 'rotate(180deg)';
                } else {
                    strip.style.maxHeight = '0';
                    strip.style.opacity = '0';
                    chevron.style.transform = 'rotate(0deg)';
                }
            });
        });
    </script>
    <script src="~/js/applicationjs/activeleads_agingreport.js"></script>
}


