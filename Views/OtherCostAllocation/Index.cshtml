            <div class="p-5 space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Other Cost Name <span class="text-rose-500">*</span></label>
                    <input type="text" id="txtModalServiceTypeName" placeholder="e.g. Legal Fees, Admin Expenses, PMC Charges"
                           class="w-full text-xs px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-white focus:ring-1 focus:ring-teal-500 outline-none" />
                </div>
                <p class="text-[11px] text-slate-500">This will be inserted into <code>Project_ServiceGroupMas</code> via stored procedure <code>Web_SaveProjectServiceGroupMas</code>.</p>
            </div>

            <div class="p-4 sm:p-5 border-t border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/70 flex justify-end gap-2.5">
                <button type="button" onclick="closeAddServiceModal()" class="px-4 py-2 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-100 cursor-pointer">
                    Cancel
                </button>
                <button type="button" onclick="saveQuickServiceType()" class="px-5 py-2 rounded-lg text-xs font-bold text-white bg-teal-600 hover:bg-teal-700 cursor-pointer shadow-md">
                    Save & Add to Row
                </button>
