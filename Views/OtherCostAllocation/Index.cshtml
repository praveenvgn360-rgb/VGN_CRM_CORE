        function switchToAllocationList() {
            $('#viewAllocationForm').hide();
            $('#viewAllocationList').fadeIn(150);
        }

        function editAllocation(projectKickoffId) {
            if (!projectKickoffId) return;
            currentEditProectKickOfId = projectKickoffId;
            $('#formModeBadge').text('Edit Allocation').removeClass('bg-blue-100 text-blue-800').addClass('bg-amber-100 text-amber-800');

            Swal.fire({
                title: 'Loading allocation details...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/OtherCostAllocation/GetByProject?projectKickoffId=' + encodeURIComponent(projectKickoffId),
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    Swal.close();
                    if (res && res.success) {
                        var h = res.header || {};
                        $('#ddlFormProject').val(String(projectKickoffId)).trigger('change.select2');

                        var p = allProjects.find(function (x) {
                            return String(x.projectKickoffId || x.ProjectKickoffId) === String(projectKickoffId);
                        });
                        selectedCostcenterId = p ? (p.costCentreId || p.CostCentreId || "") : "";
                        var pName = p ? (p.projectName || p.ProjectName || "") : "";
                        if (selectedCostcenterId) {
                            $('#badgeProjectCostCenter').html(`<i class="fas fa-tag text-[10px]"></i><span>Cost Center: <strong>${selectedCostcenterId}</strong></span>`);
                        } else {
                            $('#badgeProjectCostCenter').html(`<i class="fas fa-check text-[10px]"></i><span>${pName}</span>`);
                        }

                        $('#txtEstimateAmt').val(formatIndianInteger(h.estimateAmt || 0));
                        $('#txtAllocationPer').val(Math.round(h.allocationPer || 10));
                        $('#txtAllocationAmt').val(formatIndianInteger(h.allocationAmt || 0));
                        $('#txtRevisionId').val(h.revisionId || '0');

                        $('#tblOtherCostBody').empty();
                        if (res.items && res.items.length > 0) {
                            res.items.forEach(function (item) {
                                addNewServiceRow(item);
                            });
                        } else {
                            addNewServiceRow();
                        }

                        $('#viewAllocationList').hide();
                        $('#viewAllocationForm').fadeIn(150, function () {
                            if ($('#ddlFormProject').hasClass('select2-hidden-accessible')) {
                                $('#ddlFormProject').select2({
                                    placeholder: '-- Select Project --',
                                    allowClear: true,
                                    width: '100%'
                                });
                            }
                        });
                        updateGridTotals();
                    } else {
                        Swal.fire('Error', res.message || 'Could not load allocation details.', 'error');
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire('Error', 'Failed to load details from server.', 'error');
                }
            });
        }

        // =========================================================================
        // SUBMIT ALLOCATION
        // =========================================================================

        function submitOtherCostAllocation() {
            var pId = $('#ddlFormProject').val();
            if (!pId) {
                Swal.fire('Validation Warning', 'Please select a Project first.', 'warning');
                return;
            }

            var estAmt = parseCurrency($('#txtEstimateAmt').val());
            var allocPer = Math.round(parseFloat($('#txtAllocationPer').val()) || 0);
            var allocAmt = parseCurrency($('#txtAllocationAmt').val());
            var revId = $('#txtRevisionId').val().trim() || '0';

            var totalServicePer = 0;
            var totalServiceAmt = 0;
            var items = [];
            var missingDeptCount = 0;

            $('#tblOtherCostBody tr').each(function () {
                var $row = $(this);
                var masId = parseInt($row.find('.hdnOtherCostMasId').val()) || 0;
                
                var $deptSel = $row.find('.selDepartment');
                var deptId = $deptSel.val();
                var deptName = $deptSel.find('option:selected').text();

                var $sgSel = $row.find('.selServiceGroup');
                var sgVal = $sgSel.val();
                var sgText = $sgSel.find('option:selected').text();

                if (!sgVal || sgVal === "") return;

                if (!deptId || deptId === "") {
                    missingDeptCount++;
                }

                var sPer = Math.round(parseFloat($row.find('.txtRowPer').val()) || 0);
                var sAmt = parseCurrency($row.find('.txtRowAmt').val());

                totalServicePer += sPer;
                totalServiceAmt += sAmt;

                var isExistingId = !isNaN(sgVal) && parseInt(sgVal) > 0;

                items.push({
                    otherCostMasId: masId,
                    deptId: deptId || "",
                    deptName: deptName || "",
                    serviceGroupId: isExistingId ? sgVal : "0",
                    serviceGroupName: isExistingId ? sgText : sgVal,
                    serviceTypeId: isExistingId ? sgVal : "0",
                    serviceTypeName: isExistingId ? sgText : sgVal,
                    serviceAllocationPer: sPer,
                    serviceAllocationAmt: sAmt
                });
            });

            if (items.length === 0) {
                Swal.fire('Validation Warning', 'Please enter at least one service row with an Other Cost Name.', 'warning');
                return;
            }

            if (missingDeptCount > 0) {
                Swal.fire('Validation Warning', 'Please select a Department for each service row before saving.', 'warning');
                return;
            }

            if (totalServicePer > 100 || (allocAmt > 0 && totalServiceAmt > allocAmt)) {
                var overAmt = totalServiceAmt - allocAmt;
                Swal.fire({
                    icon: 'error',
                    title: 'Allocation Limit Exceeded',
                    html: `
                        <div class="text-left text-xs space-y-2">
                            <p>The sum of all department allocations cannot exceed the <strong>Header Allocation Amount</strong>.</p>
                            <div class="p-2.5 rounded bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300">
                                <div><strong>Allocation Cap:</strong> \u20B9 ${formatIndianInteger(allocAmt)} (100%)</div>
                                <div><strong>Total Allocated:</strong> \u20B9 ${formatIndianInteger(totalServiceAmt)} (${totalServicePer}%)</div>
                                <div class="mt-1 font-bold text-rose-800 dark:text-rose-200">Exceeded by \u20B9 ${formatIndianInteger(overAmt > 0 ? overAmt : 0)}</div>
                            </div>
                            <p class="text-slate-500">Please adjust the allocation percentages so the total does not exceed 100%.</p>
                        </div>
                    `
                });
                return;
            }

            var payload = {
                costcenterId: selectedCostcenterId,
                proectKickOfId: pId,
                estimateAmt: estAmt,
                allocationPer: allocPer,
                allocationAmt: allocAmt,
                revisionId: revId,
                items: items
            };

            Swal.fire({
                title: 'Saving Cost Allocation...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/OtherCostAllocation/Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    Swal.close();
                    if (res && res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Saved Successfully',
                            text: res.message || 'Other Cost Allocation records saved!',
                            timer: 2000,
                            showConfirmButton: false
                        });
                        loadServiceGroups();
                        switchToAllocationList();
                        loadGridData();
                    } else {
                        Swal.fire('Save Failed', res.message || 'Error occurred while saving.', 'error');
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire('Error', 'Server communication error.', 'error');
                }
            });
        }

