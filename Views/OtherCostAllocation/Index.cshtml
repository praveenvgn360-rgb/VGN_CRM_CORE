        function getTargetRowId() {
            if (activeModalRowId && $('#' + activeModalRowId).length > 0) return activeModalRowId;
            if (lastActiveRowId && $('#' + lastActiveRowId).length > 0) return lastActiveRowId;
            var $emptyRow = $('#tblOtherCostBody tr').filter(function () {
                var val = $(this).find('.selServiceGroup').val();
                return !val || val === '' || val === '__CREATE_NEW__';
            }).first();
            if ($emptyRow.length > 0) return $emptyRow.attr('id');
            var $lastRow = $('#tblOtherCostBody tr:last');
            if ($lastRow.length > 0) return $lastRow.attr('id');
            return null;
        }

        function openAddServiceModal(rowId) {
            if (rowId && $('#' + rowId).length > 0) {
                activeModalRowId = rowId;
                lastActiveRowId = rowId;
            } else {
                activeModalRowId = getTargetRowId();
                if (activeModalRowId) lastActiveRowId = activeModalRowId;
            }
            $('#txtModalServiceTypeName').val('');
            $('#modalAddServiceType').fadeIn(150);
            setTimeout(function () {
                $('#txtModalServiceTypeName').focus();
            }, 100);
        }

        function closeAddServiceModal() {
            activeModalRowId = null;
            $('#modalAddServiceType').fadeOut(150);
        }

        function createAndSelectServiceGroup(name, targetRowId) {
            if (!name || name.trim() === '') return;
            var cleanName = name.trim();
            var rowId = (targetRowId && $('#' + targetRowId).length > 0) ? targetRowId : getTargetRowId();

            $.ajax({
                url: '/OtherCostAllocation/SaveServiceGroup',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ serviceGroupName: cleanName }),
                success: function (res) {
                    if (res && res.success) {
                        var newId = res.serviceGroupId;
                        var newName = res.serviceGroupName || cleanName;

                        loadServiceGroups(function () {
                            refreshAllServiceDropdowns(newId, rowId, newName);
                        });

                        Swal.fire({
                            icon: 'success',
                            title: 'Other Cost Added',
                            text: `"${newName}" saved to Project_ServiceGroupMas and selected!`,
                            timer: 1500,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                    } else {
                        Swal.fire('Error', res.message || 'Could not save Service Group.', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Server communication error while saving Service Group.', 'error');
                }
            });
        }

        function refreshAllServiceDropdowns(selectIdForTargetRow, targetRowId, newName) {
            var effectiveTargetId = (targetRowId && $('#' + targetRowId).length > 0) 
                                    ? targetRowId 
                                    : (selectIdForTargetRow ? getTargetRowId() : null);

            $('#tblOtherCostBody tr').each(function () {
                var $row = $(this);
                var thisRowId = $row.attr('id');
                var $sel = $row.find('.selServiceGroup');
                var currentVal = $sel.val();
                var isTarget = effectiveTargetId && thisRowId === effectiveTargetId;

                $sel.empty();
                $sel.append(new Option('-- Select or Create Other Cost Name --', '', false, false));
                $sel.append(new Option('+ Create New Other Cost...', '__CREATE_NEW__', false, false));

                allServiceGroups.forEach(function (sg) {
                    $sel.append(new Option(sg.serviceGroupName, sg.serviceGroupId, false, false));
                });

                if (isTarget && selectIdForTargetRow) {
                    if ($sel.find("option[value='" + selectIdForTargetRow + "']").length === 0 && newName) {
                        $sel.append(new Option(newName, selectIdForTargetRow, false, false));
                    }
                    $sel.val(String(selectIdForTargetRow)).trigger('change.select2');
                } else if (currentVal && currentVal !== '__CREATE_NEW__') {
                    $sel.val(currentVal).trigger('change.select2');
                } else {
                    $sel.val('').trigger('change.select2');
                }
            });
        }

        function saveQuickServiceType() {
            var name = $('#txtModalServiceTypeName').val().trim();
            if (!name) {
                Swal.fire('Validation Warning', 'Please enter an Other Cost / Service Group name.', 'warning');
                return;
            }

            var targetRowId = (activeModalRowId && $('#' + activeModalRowId).length > 0) 
                              ? activeModalRowId 
                              : getTargetRowId();

            var mustCreateNewRow = (!targetRowId || $('#' + targetRowId).length === 0);

            closeAddServiceModal();

            $.ajax({
                url: '/OtherCostAllocation/SaveServiceGroup',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ serviceGroupName: name }),
                success: function (res) {
                    if (res && res.success) {
                        var newId = res.serviceGroupId;
                        var newName = res.serviceGroupName || name;

                        loadServiceGroups(function () {
                            if (mustCreateNewRow) {
                                refreshAllServiceDropdowns();
                                addNewServiceRow({ serviceGroupId: newId, serviceGroupName: newName });
                            } else {
                                refreshAllServiceDropdowns(newId, targetRowId, newName);
                            }
                        });

                        Swal.fire({
                            icon: 'success',
                            title: 'Created!',
                            text: `"${newName}" saved to database and selected on row.`,
                            timer: 1500,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                    } else {
                        Swal.fire('Error', res.message || 'Could not save Service Group.', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Server communication error while saving Service Group.', 'error');
                }
            });
        }
    </script>
}