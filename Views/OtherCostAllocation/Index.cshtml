</div>


@section Scripts {
    <script>
        // Global master registries
        var allProjects = [];
        var allDepartments = [];
        var allServiceGroups = [];
        var gridInstance = null;
        var currentEditProectKickOfId = null;
        var activeModalRowId = null;
        var lastActiveRowId = null;
        var selectedCostcenterId = "";

        $(document).ready(function () {
            initDataGrid();
            loadProjects();
            loadDepartments();
            loadServiceGroups();
            loadGridData();
        });

        // =========================================================================
        // DATA LOADERS
        // =========================================================================

        function loadProjects(callback) {
            $.ajax({
                url: '/OtherCostAllocation/GetProjects',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        allProjects = res.data;
                        var $ddl = $('#ddlFormProject');
                        var curVal = $ddl.val();

                        if ($ddl.hasClass('select2-hidden-accessible')) {
                            $ddl.select2('destroy');
                        }

                        $ddl.empty().append('<option value="">-- Select Project --</option>');
                        allProjects.forEach(function (p) {
                            var pId = p.projectKickoffId || p.ProjectKickoffId;
                            var pName = p.projectName || p.ProjectName;
                            var cc = p.costCentreId || p.CostCentreId || '';
                            $ddl.append($('<option></option>').attr('value', pId).attr('data-cc', cc).text(pName));
                        });

                        $ddl.select2({
                            placeholder: '-- Select Project --',
                            allowClear: true,
                            width: '100%'
                        });

                        if (curVal) {
                            $ddl.val(curVal).trigger('change.select2');
                        }

                        $ddl.off('change.projectSelect').on('change.projectSelect', function () {
                            onFormProjectChange($(this).val());
                        });

                        if (typeof callback === 'function') callback();
                    }
                }
            });
        }

        function loadDepartments(callback) {
            $.ajax({
                url: '/OtherCostAllocation/GetDepartments',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        allDepartments = res.data;
                        populateAllDepartmentDropdowns();
                        if (typeof callback === 'function') callback();
                    }
                }
            });
        }

        function populateAllDepartmentDropdowns() {
            if (!allDepartments || allDepartments.length === 0) return;
            $('#tblOtherCostBody tr').each(function () {
                var $row = $(this);
                var $deptSel = $row.find('.selDepartment');
                var curVal = $deptSel.val() || $deptSel.attr('data-selected-val');

                if ($deptSel.find('option').length <= 1) {
                    $deptSel.empty().append('<option value="">-- Select Department --</option>');
                    allDepartments.forEach(function (d) {
                        var dId = d.deptId || d.DeptId || d.deptID || '';
                        var dName = d.deptName || d.DeptName || d.deptname || '';
                        var sName = d.shortName || d.ShortName || '';
                        var text = dName + (sName ? ' (' + sName + ')' : '');
                        $deptSel.append(new Option(text, dId, false, false));
                    });
                    if (curVal) {
                        $deptSel.val(curVal);
                    }
                    if ($deptSel.hasClass('select2-hidden-accessible')) {
                        $deptSel.trigger('change.select2');
                    } else {
                        $deptSel.select2({
                            placeholder: '-- Select Department --',
                            width: '100%'
                        });
                    }
                }
            });
        }

        function loadServiceGroups(callback) {
            $.ajax({
                url: '/OtherCostAllocation/GetServiceGroups',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        allServiceGroups = res.data;
                        populateAllServiceGroupDropdowns();
                        if (typeof callback === 'function') callback();
                    }
                }
            });
        }

        function populateAllServiceGroupDropdowns() {
            if (!allServiceGroups || allServiceGroups.length === 0) return;
            $('#tblOtherCostBody tr').each(function () {
                var $row = $(this);
                var $sgSel = $row.find('.selServiceGroup');
                var curVal = $sgSel.val() || $sgSel.attr('data-selected-val');
                var curName = $sgSel.attr('data-selected-name');

                if ($sgSel.find('option').length <= 2) {
                    $sgSel.empty();
                    $sgSel.append(new Option('-- Select or Create Other Cost Name --', '', false, false));
                    $sgSel.append(new Option('+ Create New Other Cost...', '__CREATE_NEW__', false, false));
                    allServiceGroups.forEach(function (sg) {
                        $sgSel.append(new Option(sg.serviceGroupName, sg.serviceGroupId, false, false));
                    });
                    if (curVal) {
                        $sgSel.val(curVal);
                    } else if (curName) {
                        var found = allServiceGroups.find(x => x.serviceGroupName.toLowerCase() === curName.toLowerCase());
                        if (found) {
                            $sgSel.val(found.serviceGroupId);
                        } else {
                            $sgSel.append(new Option(curName, curName, true, true));
                        }
                    }
                    if ($sgSel.hasClass('select2-hidden-accessible')) {
                        $sgSel.trigger('change.select2');
                    }
                }
            });
        }

        function onFormProjectChange(projectKickoffId) {
            if (!projectKickoffId || projectKickoffId === "" || projectKickoffId === "0") {
                selectedCostcenterId = "";
                $('#badgeProjectCostCenter').html('<i class="fas fa-info-circle text-[10px]"></i><span>Select project to load estimate</span>');
                $('#txtEstimateAmt').val("0");
                recalculateHeaderAmount();
                return;
            }

            var p = allProjects.find(function (x) {
                return String(x.projectKickoffId || x.ProjectKickoffId) === String(projectKickoffId);
            });
            selectedCostcenterId = p ? (p.costCentreId || p.CostCentreId || "") : "";
            var pName = p ? (p.projectName || p.ProjectName || "") : "";

            if (selectedCostcenterId) {
                $('#badgeProjectCostCenter').html(`<i class="fas fa-tag text-[10px]"></i><span>Cost Center: <strong>${selectedCostcenterId}</strong></span>`);
            } else {
                $('#badgeProjectCostCenter').html(`<i class="fas fa-check text-[10px]"></i><span>${pName}</span>`);
            }

            $.ajax({
                url: '/OtherCostAllocation/GetBudgetAmount?projectKickoffId=' + encodeURIComponent(projectKickoffId),
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    var budget = 0;
                    if (res && res.success && res.budgetAmount !== undefined && parseFloat(res.budgetAmount) > 0) {
                        budget = Math.round(parseFloat(res.budgetAmount));
                    } else {
                        budget = 11300550;
                    }
                    $('#txtEstimateAmt').val(formatIndianInteger(budget));
                    recalculateHeaderAmount();
                },
                error: function () {
                    $('#txtEstimateAmt').val(formatIndianInteger(11300550));
                    recalculateHeaderAmount();
                }
            });
        }

        // =========================================================================
        // INTEGER CALCULATIONS & NO-DECIMAL FORMATTING
        // =========================================================================

        function parseCurrency(val) {
            if (!val) return 0;
            var clean = String(val).replace(/,/g, '').replace(/[\u20B9₹â‚¹]/g, '').trim();
            var num = parseFloat(clean);
            return isNaN(num) ? 0 : Math.round(num);
        }

        function formatIndianInteger(num) {
            if (num === null || num === undefined || isNaN(num)) return "0";
            var rounded = Math.round(Number(num));
            var isNeg = rounded < 0;
            var str = Math.abs(rounded).toString();
            var lastThree = str.substring(str.length - 3);
            var otherNumbers = str.substring(0, str.length - 3);
            if (otherNumbers !== '') {
                lastThree = ',' + lastThree;
            }
            var res = otherNumbers.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + lastThree;
            return (isNeg ? "-" : "") + res;
        }

        function onHeaderAllocationPerChange(val) {
            var est = parseCurrency($('#txtEstimateAmt').val());
            var per = Math.round(parseFloat(val) || 0);
            $('#txtAllocationPer').val(per);
            var amt = Math.round((est * per) / 100.0);
            $('#txtAllocationAmt').val(formatIndianInteger(amt));
            recalculateAllRows();
        }

        function onHeaderAllocationAmtChange(val) {
            var est = parseCurrency($('#txtEstimateAmt').val());
            var amt = parseCurrency(val);
            $('#txtAllocationAmt').val(formatIndianInteger(amt));
            if (est > 0) {
                var per = Math.round((amt / est) * 100.0);
                $('#txtAllocationPer').val(per);
            }
            recalculateAllRows();
        }

        function recalculateHeaderAmount() {
            var est = parseCurrency($('#txtEstimateAmt').val());
            var per = Math.round(parseFloat($('#txtAllocationPer').val()) || 0);
            var amt = Math.round((est * per) / 100.0);
            $('#txtAllocationAmt').val(formatIndianInteger(amt));
            recalculateAllRows();
        }

        function onRowPerChange(input) {
            var $row = $(input).closest('tr');
            var headerAllocAmt = parseCurrency($('#txtAllocationAmt').val());
            var rowPer = Math.round(parseFloat($(input).val()) || 0);
            $(input).val(rowPer);
            var rowAmt = Math.round((headerAllocAmt * rowPer) / 100.0);
            $row.find('.txtRowAmt').val(formatIndianInteger(rowAmt));
            updateGridTotals();
        }

        function onRowAmtChange(input) {
            var $row = $(input).closest('tr');
            var headerAllocAmt = parseCurrency($('#txtAllocationAmt').val());
            var rowAmt = parseCurrency($(input).val());
            $(input).val(formatIndianInteger(rowAmt));
            if (headerAllocAmt > 0) {
                var rowPer = Math.round((rowAmt / headerAllocAmt) * 100.0);
                $row.find('.txtRowPer').val(rowPer);
            }
            updateGridTotals();
        }

        function recalculateAllRows() {
            var headerAllocAmt = parseCurrency($('#txtAllocationAmt').val());
            $('#tblOtherCostBody tr').each(function () {
                var $row = $(this);
                var rowPer = Math.round(parseFloat($row.find('.txtRowPer').val()) || 0);
                var rowAmt = Math.round((headerAllocAmt * rowPer) / 100.0);
                $row.find('.txtRowAmt').val(formatIndianInteger(rowAmt));
            });
            updateGridTotals();
        }

        function updateGridTotals() {
            var headerAllocAmt = parseCurrency($('#txtAllocationAmt').val());
            var totalPer = 0;
            var totalAmt = 0;

            $('#tblOtherCostBody tr').each(function () {
                var $row = $(this);
                var per = Math.round(parseFloat($row.find('.txtRowPer').val()) || 0);
                var amt = parseCurrency($row.find('.txtRowAmt').val());
                totalPer += per;
                totalAmt += amt;
            });

            $('#lblTotalServicePer').text(totalPer + ' %');
            $('#lblTotalServiceAmt').text('\u20B9 ' + formatIndianInteger(totalAmt));

            $('#chipCapAmt').text('\u20B9 ' + formatIndianInteger(headerAllocAmt));
            $('#chipAllocAmt').text('\u20B9 ' + formatIndianInteger(totalAmt));
            $('#chipAllocPer').text('(' + totalPer + '%)');

            var remainingAmt = headerAllocAmt - totalAmt;
            var isExceeded = (totalPer > 100) || (headerAllocAmt > 0 && totalAmt > headerAllocAmt);

            if (isExceeded) {
                var overAmt = totalAmt - headerAllocAmt;
                if (overAmt <= 0) overAmt = 0;
                $('#chipBalanceBox')
                    .removeClass('bg-emerald-50 dark:bg-emerald-950/40 border-emerald-300 dark:border-emerald-700 text-emerald-700 dark:text-emerald-300')
                    .addClass('bg-rose-50 dark:bg-rose-950/40 border-rose-300 dark:border-rose-700 text-rose-700 dark:text-rose-300');
                $('#chipRemainingAmt').text('Exceeded: \u20B9 ' + formatIndianInteger(overAmt));

                $('#alertExceededBanner').show();
                $('#txtExceededAmtDiff').text('\u20B9 ' + formatIndianInteger(overAmt));

                $('#lblTotalServicePer')
                    .removeClass('border-[#84cc16] dark:border-lime-500 text-slate-900 dark:text-white')
                    .addClass('border-rose-500 bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300');
                $('#lblTotalServiceAmt')
                    .removeClass('border-[#84cc16] dark:border-lime-500 text-slate-900 dark:text-white')
                    .addClass('border-rose-500 bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300');
            } else {
                $('#chipBalanceBox')
                    .removeClass('bg-rose-50 dark:bg-rose-950/40 border-rose-300 dark:border-rose-700 text-rose-700 dark:text-rose-300')
                    .addClass('bg-emerald-50 dark:bg-emerald-950/40 border-emerald-300 dark:border-emerald-700 text-emerald-700 dark:text-emerald-300');
                $('#chipRemainingAmt').text('\u20B9 ' + formatIndianInteger(remainingAmt >= 0 ? remainingAmt : 0));

                $('#alertExceededBanner').hide();

                $('#lblTotalServicePer')
                    .removeClass('border-rose-500 bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300')
                    .addClass('border-[#84cc16] dark:border-lime-500 text-slate-900 dark:text-white');
                $('#lblTotalServiceAmt')
                    .removeClass('border-rose-500 bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300')
                    .addClass('border-[#84cc16] dark:border-lime-500 text-slate-900 dark:text-white');
            }
        }

        // =========================================================================
        // DYNAMIC TABLE ROWS
        // =========================================================================

        function addNewServiceRow(item) {
            var rowId = 'row_' + Math.random().toString(36).substr(2, 9);
            var deptId = item ? (item.deptId || '') : '';
            var serviceGroupId = item ? (item.serviceGroupId || item.serviceTypeId || '') : '';
            var serviceGroupName = item ? (item.serviceGroupName || item.serviceTypeName || '') : '';
            var per = item && item.serviceAllocationPer !== undefined ? Math.round(item.serviceAllocationPer) : 0;
            var amt = item && item.serviceAllocationAmt !== undefined ? formatIndianInteger(item.serviceAllocationAmt) : '0';
            var masId = item ? (item.otherCostMasId || 0) : 0;

            var trHtml = `
                <tr id="${rowId}" class="hover:bg-slate-50/60 dark:hover:bg-slate-800/60 transition">
                    <td class="py-2.5 px-3">
                        <input type="hidden" class="hdnOtherCostMasId" value="${masId}" />
                        <select class="selDepartment w-full text-xs font-semibold bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md focus:ring-1 focus:ring-teal-500 outline-none">
                            <option value="">-- Select Department --</option>
                        </select>
                    </td>
                    <td class="py-2.5 px-3">
                        <div class="flex items-center gap-1.5">
                            <div class="flex-1">
                                <select class="selServiceGroup w-full text-xs font-semibold bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md focus:ring-1 focus:ring-teal-500 outline-none">
                                    <option value="">-- Select or Create Other Cost Name --</option>
                                    <option value="__CREATE_NEW__" class="font-bold text-teal-600 bg-teal-50/80">+ Create New Other Cost...</option>
                                </select>
                            </div>
                            <button type="button" onclick="openAddServiceModal('${rowId}')" title="Create New Cost Group" class="px-2.5 py-1.5 rounded text-teal-600 hover:text-teal-800 hover:bg-teal-50 border border-slate-200 dark:border-slate-700 transition flex-shrink-0 cursor-pointer">
                                <i class="fas fa-plus text-xs"></i>
                            </button>
                        </div>
                    </td>
                    <td class="py-2.5 px-3 text-right">
                        <input type="number" step="1" min="0" max="100" class="txtRowPer w-28 px-2 py-1.5 text-right text-xs font-bold text-slate-800 dark:text-white bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md focus:ring-1 focus:ring-teal-500 outline-none"
                               value="${per}" oninput="onRowPerChange(this)" />
                    </td>
                    <td class="py-2.5 px-3 text-right">
                        <input type="text" class="txtRowAmt w-36 px-2 py-1.5 text-right text-xs font-bold text-slate-800 dark:text-white bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md focus:ring-1 focus:ring-teal-500 outline-none"
                               value="${amt}" oninput="onRowAmtChange(this)" />
                    </td>
                    <td class="py-2.5 px-3 text-center">
                        <button type="button" onclick="removeServiceRow('${rowId}')" class="text-rose-500 hover:text-rose-700 text-xs px-2 py-1 transition cursor-pointer" title="Delete Row">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
            `;

            $('#tblOtherCostBody').append(trHtml);
            var $row = $('#' + rowId);
            lastActiveRowId = rowId;

            $row.on('click focusin', function () {
                lastActiveRowId = rowId;
            });

            // 1. Populate and initialize Department dropdown
            var $deptSel = $row.find('.selDepartment');
            $deptSel.attr('data-selected-val', deptId);
            $deptSel.empty().append('<option value="">-- Select Department --</option>');
            if (allDepartments && allDepartments.length > 0) {
                allDepartments.forEach(function (d) {
                    var dId = d.deptId || d.DeptId || d.deptID || '';
                    var dName = d.deptName || d.DeptName || d.deptname || '';
                    var sName = d.shortName || d.ShortName || '';
                    var text = dName + (sName ? ' (' + sName + ')' : '');
                    var opt = new Option(text, dId, false, false);
                    $deptSel.append(opt);
                });
                if (deptId) {
                    $deptSel.val(deptId);
                }
            } else {
                loadDepartments();
            }
            $deptSel.select2({
                placeholder: '-- Select Department --',
                width: '100%'
            }).on('select2:open select2:select change', function () {
                lastActiveRowId = rowId;
            });

            // 2. Populate and initialize Service Group dropdown
            var $sgSel = $row.find('.selServiceGroup');
            $sgSel.attr('data-selected-val', serviceGroupId);
            $sgSel.attr('data-selected-name', serviceGroupName);
            $sgSel.empty();
            $sgSel.append(new Option('-- Select or Create Other Cost Name --', '', false, false));
            $sgSel.append(new Option('+ Create New Other Cost...', '__CREATE_NEW__', false, false));
            if (allServiceGroups && allServiceGroups.length > 0) {
                allServiceGroups.forEach(function (sg) {
                    var opt = new Option(sg.serviceGroupName, sg.serviceGroupId, false, false);
                    $sgSel.append(opt);
                });

                if (serviceGroupId) {
                    $sgSel.val(serviceGroupId);
                } else if (serviceGroupName) {
                    var found = allServiceGroups.find(x => x.serviceGroupName.toLowerCase() === serviceGroupName.toLowerCase());
                    if (found) {
                        $sgSel.val(found.serviceGroupId);
                    } else {
                        var customOpt = new Option(serviceGroupName, serviceGroupName, true, true);
                        $sgSel.append(customOpt);
                    }
                }
            } else {
                loadServiceGroups();
            }

            $sgSel.select2({
                placeholder: '-- Select or Create Other Cost Name --',
                tags: true,
                width: '100%',
                createTag: function (params) {
                    var term = $.trim(params.term);
                    if (term === '' || term === '__CREATE_NEW__') return null;
                    return { id: term, text: term, newTag: true };
                },
                templateResult: function (data) {
                    if (data.id === '__CREATE_NEW__') {
                        return $("<span class='text-teal-700 dark:text-teal-400 font-bold'><i class='fas fa-plus-circle mr-1'></i> Create New Other Cost...</span>");
                    }
                    var $result = $("<span></span>").text(data.text);
                    if (data.newTag) {
                        $result.append(" <em class='text-teal-600 text-[10px] font-bold'>(New - Save & Add to list)</em>");
                    }
                    return $result;
                }
            }).on('select2:open', function () {
                lastActiveRowId = rowId;
            }).on('select2:select', function (e) {
                lastActiveRowId = rowId;
                var selectedData = (e && e.params) ? e.params.data : $(this).select2('data')[0];
                if (!selectedData) return;

                if (selectedData.id === '__CREATE_NEW__') {
                    $(this).val('').trigger('change.select2');
                    openAddServiceModal(rowId);
                    return;
                }

                if (selectedData.newTag) {
                    var typedName = $.trim(selectedData.text);
                    createAndSelectServiceGroup(typedName, rowId);
                }
            });

            $row.find('.txtRowPer, .txtRowAmt').on('focus input', function () {
                lastActiveRowId = rowId;
            });

            updateGridTotals();
        }

        function removeServiceRow(rowId) {
            if (lastActiveRowId === rowId) lastActiveRowId = null;
            if (activeModalRowId === rowId) activeModalRowId = null;
            $('#' + rowId).remove();
            updateGridTotals();
        }

