        function openNewAllocationForm() {
            currentEditProectKickOfId = null;
            lastActiveRowId = null;
            activeModalRowId = null;
            $('#formModeBadge').text('New Allocation').removeClass('bg-amber-100 text-amber-800').addClass('bg-blue-100 text-blue-800');
            
            $('#ddlFormProject').val('').trigger('change.select2');
            $('#badgeProjectCostCenter').html('<i class="fas fa-info-circle text-[10px]"></i><span>Select project to load estimate</span>');
            selectedCostcenterId = "";

            $('#txtEstimateAmt').val('0');
            $('#txtAllocationPer').val('10');
            $('#txtAllocationAmt').val('0');
            $('#txtRevisionId').val('0');
            $('#tblOtherCostBody').empty();

            addNewServiceRow();

            $('#viewAllocationList').hide();
            $('#viewAllocationForm').fadeIn(150, function () {
                if ($('#ddlFormProject').hasClass('select2-hidden-accessible')) {
                    $('#ddlFormProject').select2({
