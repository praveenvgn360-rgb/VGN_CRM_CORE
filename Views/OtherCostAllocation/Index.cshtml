        function loadGridData() {
            $.ajax({
                url: '/OtherCostAllocation/GetAll',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && res.data) {
                        var grid = $("#dxGridOtherCostAllocation").dxDataGrid("instance");
                        if (grid) grid.option("dataSource", res.data);

                        var totalProjects = res.data.length;
                        var totalAlloc = 0;
                        var totalUsed = 0;

                        res.data.forEach(function (r) {
                            totalAlloc += parseCurrency(r.allocationAmt);
                            totalUsed += parseCurrency(r.usedAmount);
                        });

                        var totalRemaining = totalAlloc - totalUsed;
                        if (totalRemaining < 0) totalRemaining = 0;

                        $('#badgeTotalRecords').text(totalProjects + ' Project' + (totalProjects !== 1 ? 's' : ''));
                        $('#statTotalCount').text(totalProjects);
                        $('#statTotalAllocated').text("\u20B9 " + formatIndianInteger(totalAlloc));
                        $('#statTotalUsed').text("\u20B9 " + formatIndianInteger(totalUsed));
                        $('#statTotalRemaining').text("\u20B9 " + formatIndianInteger(totalRemaining));
                    }
                }
            });
        }

        function deleteProjectAllocation(projectKickoffId, projectName) {
            if (!projectKickoffId) return;

            var name = projectName || ('Project #' + projectKickoffId);

            Swal.fire({
                title: 'Delete Cost Allocation?',
                text: `Are you sure you want to deactivate all allocations for "${name}"? This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete Allocation'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/OtherCostAllocation/Delete',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ proectKickOfId: String(projectKickoffId) }),
                        success: function (res) {
                            if (res && res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: res.message || 'Allocation deactivated successfully.',
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                                loadGridData();
                            } else {
                                Swal.fire('Error', res.message || 'Failed to delete allocation.', 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Failed to communicate with server.', 'error');
                        }
                    });
                }
            });
        }

