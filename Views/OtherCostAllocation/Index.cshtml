@{
    ViewBag.Title = "Other Cost Allocation - VGN ERP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <style>
        /* Scoped Select2 styling for Project Name dropdown */
        #ddlFormProject + .select2-container .select2-selection--single {
            height: 36px !important;
            border-radius: 0.5rem !important;
            display: flex !important;
            align-items: center !important;
            border-color: #cbd5e1 !important;
            background-color: #ffffff !important;
        }
        .dark #ddlFormProject + .select2-container .select2-selection--single {
            border-color: #475569 !important;
            background-color: #0f172a !important;
        }
        #ddlFormProject + .select2-container .select2-selection--single .select2-selection__rendered {
            line-height: 34px !important;
            font-weight: 700 !important;
            font-size: 0.75rem !important;
            color: #1e293b !important;
            padding-left: 0.75rem !important;
            padding-right: 1.75rem !important;
        }
        .dark #ddlFormProject + .select2-container .select2-selection--single .select2-selection__rendered {
            color: #f1f5f9 !important;
        }
        #ddlFormProject + .select2-container .select2-selection--single .select2-selection__arrow {
            height: 34px !important;
            right: 8px !important;
        }
        #ddlFormProject + .select2-container .select2-selection--single .select2-selection__clear {
            margin-right: 18px !important;
            font-size: 14px !important;
            color: #94a3b8 !important;
        }
    </style>
}

<div class="p-3 sm:p-5 space-y-4">

    <!-- =========================================================================
         1. LOAD SCREEN (LISTING VIEW)
         ========================================================================= -->
    <div id="viewAllocationList" class="space-y-4">
        <!-- Header Bar -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-[var(--surface)] p-4 sm:p-5 rounded-2xl shadow-sm border border-[var(--border)]">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-600 dark:text-teal-400 text-xl font-bold">
                    <i class="fas fa-hand-holding-usd"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-bold text-[var(--text)] tracking-tight">Other Cost Allocation</h1>
                        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-teal-500/10 text-teal-700 dark:text-teal-300 border border-teal-500/20" id="badgeTotalRecords">
                            0 Projects
                        </span>
                    </div>
                    <p class="text-xs text-[var(--text-muted)] mt-0.5">Allocate project budget overheads and additional services across departments and cost centers</p>
                </div>
            </div>

            <div class="flex items-center gap-2.5 w-full md:w-auto justify-end flex-wrap">
                <a href="@Url.Action("Index", "OtherCostBreakup")" class="px-3.5 py-2 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Manage Itemized Breakups">
                    <i class="fas fa-layer-group text-teal-600 dark:text-teal-400"></i>
                    <span>Cost Breakup</span>
                </a>
                <a href="@Url.Action("Index", "ProjectIOW")" class="px-3.5 py-2 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Bill of Quantities">
                    <i class="fas fa-th-list text-blue-600"></i>
                    <span>BOQ</span>
                </a>
                <button type="button" onclick="openCalculationHelpModal()" class="px-3.5 py-2 rounded-lg text-xs font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-300 dark:border-amber-700 hover:bg-amber-100 dark:hover:bg-amber-900/40 flex items-center gap-1.5 transition cursor-pointer shadow-2xs" title="View Allocation Formulas and Rules">
                    <i class="fas fa-calculator text-amber-600 dark:text-amber-400"></i>
                    <span>Calculation Help</span>
                </button>
                <button type="button" onclick="loadGridData()" class="btn-clear !text-xs !py-2 !px-3.5 cursor-pointer" title="Refresh List">
                    <i class="fas fa-sync-alt mr-1"></i> Refresh
                </button>
                <button type="button" onclick="openNewAllocationForm()" class="btn-save !text-xs !py-2 !px-4 text-white flex items-center gap-2 shadow-md bg-teal-700 hover:bg-teal-800 cursor-pointer">
                    <i class="fas fa-plus"></i>
                    <span>Add New Cost Allocation</span>
                </button>
            </div>
        </div>

        <!-- Summary Metric Cards (Whole Numbers Only - No Decimals) -->
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
            <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl p-4 flex items-center justify-between shadow-sm">
                <div>
                    <span class="text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider block">Allocated Projects</span>
                    <span class="text-2xl font-black text-[var(--text)] mt-1 block" id="statTotalCount">0</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center text-lg">
                    <i class="fas fa-layer-group"></i>
                </div>
            </div>
            <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl p-4 flex items-center justify-between shadow-sm">
                <div>
                    <span class="text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider block">Total Allocated</span>
                    <span class="text-2xl font-black text-blue-600 dark:text-blue-400 mt-1 block" id="statTotalAllocated">&#8377; 0</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center text-lg">
                    <i class="fas fa-calculator"></i>
                </div>
            </div>
            <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl p-4 flex items-center justify-between shadow-sm">
                <div>
                    <span class="text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider block">Breakup (Used)</span>
                    <span class="text-2xl font-black text-indigo-600 dark:text-indigo-400 mt-1 block" id="statTotalUsed">&#8377; 0</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-indigo-500/10 text-indigo-500 flex items-center justify-center text-lg">
                    <i class="fas fa-receipt"></i>
                </div>
            </div>
            <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl p-4 flex items-center justify-between shadow-sm">
                <div>
                    <span class="text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider block">Remaining Amount</span>
                    <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1 block" id="statTotalRemaining">&#8377; 0</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-lg">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
        </div>

        <!-- Data Grid (One Row Per Project With Master-Detail Department Breakdown) -->
        <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-md p-4 sm:p-5">
            <div id="dxGridOtherCostAllocation"></div>
        </div>
    </div>


    <!-- =========================================================================
         2. ADD / EDIT COST ALLOCATION SCREEN (CARD EFFECT DESIGN)
         ========================================================================= -->
    <div id="viewAllocationForm" style="display: none;" class="space-y-4">

        <!-- Top Navigation & Prominent Action Bar -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-[var(--surface)] p-3.5 sm:p-4 rounded-xl border border-[var(--border)] shadow-sm">
            <div class="flex items-center gap-2.5">
                <button type="button" onclick="switchToAllocationList()" class="px-3.5 py-2 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                    <i class="fas fa-arrow-left"></i>
                    <span>Back to Allocation List</span>
                </button>
                <span id="formModeBadge" class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-200">
                    New Allocation
                </span>
            </div>

            <!-- PROMINENT TOP SAVE & HELP BUTTONS -->
            <div class="flex items-center gap-2.5 w-full sm:w-auto justify-end">
                <button type="button" onclick="openCalculationHelpModal()" class="px-3.5 py-2 rounded-lg text-xs font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-300 dark:border-amber-700 hover:bg-amber-100 dark:hover:bg-amber-900/40 flex items-center gap-1.5 transition cursor-pointer shadow-2xs">
                    <i class="fas fa-calculator text-amber-600 dark:text-amber-400"></i>
                    <span>Calculation Help</span>
                </button>
                <button type="button" id="btnTopSaveAllocation" onclick="submitOtherCostAllocation()" class="px-6 py-2 rounded-lg text-xs font-bold text-white shadow-md bg-teal-600 hover:bg-teal-700 dark:bg-teal-600 dark:hover:bg-teal-700 flex items-center gap-2 transition cursor-pointer">
                    <i class="fas fa-save"></i>
                    <span>Save Allocation</span>
                </button>
            </div>
        </div>

        <!-- Hidden Revision Id field -->
        <input type="hidden" id="txtRevisionId" value="0" />

        <!-- CARD 1: PROJECT & BUDGET OVERHEAD DEFINITION (CARD EFFECT) -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 p-4 sm:p-5">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3 mb-4">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center text-sm font-bold">
                        <i class="fas fa-project-diagram"></i>
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-slate-800 dark:text-white tracking-tight">Project & Allocation Overhead Definition</h2>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">Select project to automatically load budget and calculate overhead allocation cap</p>
                    </div>
                </div>
                <span class="text-[11px] font-bold px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                    Step 1 of 2
                </span>
            </div>

            <!-- Card Grid: Project, Estimate, Allocation %, Allocation Amount -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Project Name Card -->
                <div class="p-3.5 rounded-xl bg-slate-50/90 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700">
                    <label for="ddlFormProject" class="block text-[11px] font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <i class="fas fa-building text-teal-600"></i>
                        <span>Project Name <span class="text-rose-500">*</span></span>
                    </label>
                    <select id="ddlFormProject" style="width: 100%;" class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-teal-500 focus:outline-none cursor-pointer">
                        <option value="">-- Select Project --</option>
                    </select>
                    <div id="badgeProjectCostCenter" class="text-[11px] text-teal-600 dark:text-teal-400 font-semibold mt-1.5 flex items-center gap-1">
                        <i class="fas fa-info-circle text-[10px]"></i>
                        <span>Select project to load estimate</span>
                    </div>
                </div>

                <!-- Estimate Amount Card -->
                <div class="p-3.5 rounded-xl bg-slate-50/90 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700">
                    <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <i class="fas fa-coins text-slate-500"></i>
                        <span>Estimate Amount</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-3 top-2 text-xs font-bold text-slate-400 select-none">&#8377;</span>
                        <input type="text" id="txtEstimateAmt" readonly
                               class="w-full pl-7 pr-3 py-2 text-right text-xs font-black text-slate-800 dark:text-white bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-lg cursor-not-allowed select-none"
                               value="0" />
                    </div>
                    <span class="text-[10px] text-slate-400 block mt-1.5">Total project estimated budget</span>
                </div>

                <!-- Header Allocation % Card (Integer Only) -->
                <div class="p-3.5 rounded-xl bg-slate-50/90 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700">
                    <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <i class="fas fa-percent text-blue-500"></i>
                        <span>Header Allocation %</span>
                    </label>
                    <div class="relative">
                        <input type="number" step="1" min="0" max="100" id="txtAllocationPer" oninput="onHeaderAllocationPerChange(this.value)"
                               class="w-full pl-3 pr-7 py-2 text-right text-xs font-black text-slate-800 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none"
                               value="10" />
                        <span class="absolute right-3 top-2 text-xs font-bold text-slate-400 select-none">%</span>
                    </div>
                    <span class="text-[10px] text-slate-400 block mt-1.5">Overhead budget percentage</span>
                </div>

                <!-- Header Allocation Amount Card (Cap) -->
                <div class="p-3.5 rounded-xl bg-teal-50/60 dark:bg-teal-950/30 border border-teal-200 dark:border-teal-800/60">
                    <label class="block text-[11px] font-bold text-teal-800 dark:text-teal-200 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <i class="fas fa-shield-alt text-teal-600"></i>
                        <span>Allocation Amount (Cap)</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-3 top-2 text-xs font-bold text-teal-600 dark:text-teal-400 select-none">&#8377;</span>
                        <input type="text" id="txtAllocationAmt" oninput="onHeaderAllocationAmtChange(this.value)"
                               class="w-full pl-7 pr-3 py-2 text-right text-xs font-black text-teal-800 dark:text-teal-200 bg-white dark:bg-slate-900 border border-teal-300 dark:border-teal-700 rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none"
                               value="0" />
                    </div>
                    <span class="text-[10px] text-teal-700 dark:text-teal-300 block mt-1.5 font-medium">Max allocation cap for all departments</span>
                </div>
            </div>
        </div>


        <!-- CARD 2: DEPARTMENT-WISE ALLOCATIONS (CARD EFFECT) -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
            
            <!-- Card Header & Live Budget Status Bar -->
            <div class="p-4 sm:p-5 border-b border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-800/80">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center text-sm font-bold">
                            <i class="fas fa-sitemap"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-sm font-bold text-slate-800 dark:text-white tracking-tight">Department-wise Service Allocations</h2>
                                <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Step 2 of 2</span>
                            </div>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">Select Department from CRM DB, then Other Cost Name from <code>Project_ServiceGroupMas</code></p>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex items-center gap-2 flex-wrap">
                        <button type="button" onclick="openAddServiceModal()" class="px-3.5 py-1.5 rounded-lg bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-2xs cursor-pointer">
                            <i class="fas fa-plus-circle text-xs"></i>
                            <span>Create New Cost Name</span>
                        </button>
                        <button type="button" onclick="addNewServiceRow()" class="px-3.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 text-teal-700 dark:text-teal-300 border border-teal-300 dark:border-teal-700 hover:bg-teal-50 text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-2xs">
                            <i class="fas fa-plus text-xs"></i>
                            <span>Add Service Row</span>
                        </button>
                    </div>
                </div>

                <!-- Live Status Chips Bar (No Decimals) -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mt-3.5 pt-3 border-t border-slate-200/80 dark:border-slate-700/80 text-xs">
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="openCalculationHelpModal()" class="w-7 h-7 rounded-lg bg-amber-500/10 border border-amber-500/25 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs font-bold transition cursor-pointer shadow-2xs" title="View Calculation Rules">
                            <i class="fas fa-calculator"></i>
                        </button>
                        <span class="text-xs font-bold text-slate-600 dark:text-slate-300">Live Allocation Constraint Monitor:</span>
                    </div>

                    <div class="flex items-center gap-2 flex-wrap">
                        <div class="px-3 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 flex items-center gap-1.5 shadow-2xs">
                            <span class="text-[10px] uppercase font-bold text-slate-400">Cap:</span>
                            <span class="font-black text-slate-700 dark:text-slate-200" id="chipCapAmt">&#8377; 0</span>
                        </div>
                        <div class="px-3 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 flex items-center gap-1.5 shadow-2xs">
                            <span class="text-[10px] uppercase font-bold text-slate-400">Allocated:</span>
                            <span class="font-black text-blue-600 dark:text-blue-400" id="chipAllocAmt">&#8377; 0</span>
                            <span class="text-[10px] font-bold text-slate-500" id="chipAllocPer">(0%)</span>
                        </div>
                        <div id="chipBalanceBox" class="px-3 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-700 text-emerald-700 dark:text-emerald-300 flex items-center gap-1.5 shadow-2xs">
                            <span class="text-[10px] uppercase font-bold">Remaining:</span>
                            <span class="font-black" id="chipRemainingAmt">&#8377; 0</span>
                        </div>
                    </div>
                </div>

                <!-- Warning banner when allocation exceeds limit -->
                <div id="alertExceededBanner" style="display: none;" class="mt-3 p-2.5 rounded-lg bg-rose-50 dark:bg-rose-950/50 border border-rose-300 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-xs flex items-center gap-2">
                    <i class="fas fa-exclamation-triangle text-rose-500 text-sm"></i>
                    <span><strong>Limit Exceeded:</strong> Total service allocation exceeds the Header Allocation Amount (<span id="txtExceededAmtDiff" class="font-bold">&#8377; 0</span> over). Please adjust the percentages so total is &le; 100%.</span>
                </div>
            </div>

            <!-- Detail Grid Table (Department First, then Other Cost Name) -->
            <div class="p-4 sm:p-5 overflow-x-auto">
                <table class="w-full border-collapse border border-slate-200 dark:border-slate-700 text-xs" id="tblOtherCostAllocation">
                    <thead>
                        <tr class="bg-[#eaf3f5] dark:bg-slate-800 text-slate-700 dark:text-slate-200 border-b border-slate-200 dark:border-slate-700 font-bold">
                            <th class="py-2.5 px-3 text-left font-bold text-xs min-w-[220px]">Department (from CRM DB)</th>
                            <th class="py-2.5 px-3 text-left font-bold text-xs min-w-[260px]">Other Cost Name (Project_ServiceGroupMas)</th>
                            <th class="py-2.5 px-3 text-right font-bold text-xs w-40">Allocation %</th>
                            <th class="py-2.5 px-3 text-right font-bold text-xs w-48">Allocation Amount (&#8377;)</th>
                            <th class="py-2.5 px-3 text-center font-bold text-xs w-16">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblOtherCostBody" class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-900">
                        <!-- Dynamic Rows Injected via JS -->
                    </tbody>
                    <tfoot>
                        <tr class="bg-slate-50 dark:bg-slate-800/80 font-bold border-t-2 border-slate-300 dark:border-slate-600">
                            <td colspan="2" class="py-3 px-3 text-right text-sm font-black text-[#4338ca] dark:text-indigo-400">
                                Total Service Allocations
                            </td>
                            <td class="py-3 px-3 text-right">
                                <div class="inline-block border-2 border-[#84cc16] dark:border-lime-500 rounded px-3 py-1 bg-white dark:bg-slate-900 text-xs font-black text-slate-900 dark:text-white transition shadow-2xs" id="lblTotalServicePer">
                                    0 %
                                </div>
                            </td>
                            <td class="py-3 px-3 text-right">
                                <div class="inline-block border-2 border-[#84cc16] dark:border-lime-500 rounded px-3 py-1 bg-white dark:bg-slate-900 text-xs font-black text-slate-900 dark:text-white transition shadow-2xs" id="lblTotalServiceAmt">
                                    &#8377; 0
                                </div>
                            </td>
                            <td class="py-3 px-3"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Bottom Action Buttons: Save & Cancel -->
            <div class="p-4 sm:p-5 border-t border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-800/80 flex items-center justify-end gap-3">
                <button type="button" onclick="switchToAllocationList()" class="px-6 py-2 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 hover:bg-slate-100 text-slate-700 dark:text-slate-200 transition cursor-pointer shadow-2xs">
                    Cancel
                </button>
                <button type="button" id="btnSubmitAllocation" onclick="submitOtherCostAllocation()" class="px-7 py-2 rounded-lg text-xs font-bold text-white shadow-md bg-teal-600 hover:bg-teal-700 dark:bg-teal-600 dark:hover:bg-teal-700 transition cursor-pointer flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    <span>Save Allocation</span>
                </button>
            </div>

        </div>

    </div>

</div>

<!-- =========================================================================
     MODAL 1: CALCULATION HELP & FORMULA MODAL
     ========================================================================= -->
<div id="modalCalculationHelp" class="fixed inset-0 z-[9999] overflow-y-auto" style="display: none; background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px);">
    <div class="min-h-full flex items-center justify-center p-3 sm:p-4 text-center">
        <div class="relative w-full max-w-3xl bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 text-left transform transition-all my-8 overflow-hidden inline-block">
            
            <div class="p-4 sm:p-5 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg font-bold">
                        <i class="fas fa-calculator"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-800 dark:text-white">Other Cost Allocation - Calculation Guide</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Formulas, constraint rules, and integer distribution examples</p>
                    </div>
                </div>
                <button type="button" onclick="closeCalculationHelpModal()" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-200 dark:hover:bg-slate-800 transition cursor-pointer">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>

            <div class="p-5 sm:p-6 space-y-5 max-h-[75vh] overflow-y-auto text-xs text-slate-700 dark:text-slate-300">
                <div class="p-3.5 rounded-xl bg-teal-50/70 dark:bg-teal-950/30 border border-teal-200 dark:border-teal-800/50 space-y-1">
                    <div class="font-bold text-teal-800 dark:text-teal-200 flex items-center gap-2">
                        <i class="fas fa-lightbulb text-teal-600"></i> What is Other Cost Allocation?
                    </div>
                    <p class="text-[12px] text-teal-900 dark:text-teal-300 leading-relaxed">
                        Other Cost Allocation distributes a portion of the project's overall estimated budget to overheads, legal fees, PMC, and indirect services. Allocations are distributed department-wise and tracked under standard Cost Groups (<code>Project_ServiceGroupMas</code>) without decimal fractions.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-2">
                        <div class="font-bold text-slate-900 dark:text-white text-xs uppercase tracking-wider flex items-center gap-1.5">
                            <span class="w-5 h-5 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 inline-flex items-center justify-center text-[10px] font-black">1</span>
                            Header Allocation Cap Formula
                        </div>
                        <div class="p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 font-mono text-[11px] text-blue-700 dark:text-blue-300 font-bold">
                            Allocation Amount = Estimate Amount &times; (Allocation % &divide; 100)
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">
                            <em>Example:</em> If Project Estimate is <strong>&#8377; 1,13,00,550</strong> and Header Allocation is <strong>10%</strong>, the Allocation Cap is <strong>&#8377; 11,30,055</strong>.
                        </p>
                    </div>

                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-2">
                        <div class="font-bold text-slate-900 dark:text-white text-xs uppercase tracking-wider flex items-center gap-1.5">
                            <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 inline-flex items-center justify-center text-[10px] font-black">2</span>
                            Service Row Amount Formula
                        </div>
                        <div class="p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 font-mono text-[11px] text-emerald-700 dark:text-emerald-300 font-bold">
                            Service Amount = Header Allocation Amount &times; (Service % &divide; 100)
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">
                            <em>Example:</em> If Header Allocation Amount is <strong>&#8377; 11,30,055</strong> and Legal is allocated <strong>30%</strong>, Legal gets <strong>&#8377; 3,39,017</strong>.
                        </p>
                    </div>
                </div>

                <div class="p-4 rounded-xl bg-amber-50/70 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/50 space-y-2">
                    <div class="font-bold text-amber-800 dark:text-amber-200 flex items-center gap-2">
                        <i class="fas fa-shield-alt text-amber-600"></i> The Strict 100% Allocation Cap Rule
                    </div>
                    <ul class="list-disc list-inside space-y-1 text-[11px] text-amber-900 dark:text-amber-300">
                        <li><strong>Percentage Limit:</strong> Sum of all department service rows cannot exceed <strong>100%</strong>.</li>
                        <li><strong>Amount Limit:</strong> Sum of all department row amounts cannot exceed the <strong>Header Allocation Amount</strong>.</li>
                        <li><strong>No Decimals:</strong> All allocation percentages and amounts are formatted as clean whole integers.</li>
                    </ul>
                </div>
            </div>

            <div class="p-4 sm:p-5 border-t border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/70 flex justify-end">
                <button type="button" onclick="closeCalculationHelpModal()" class="px-5 py-2 rounded-lg text-xs font-bold bg-teal-600 hover:bg-teal-700 text-white transition cursor-pointer shadow-md">
                    Got it, Close
                </button>
            </div>

        </div>
    </div>
</div>


<!-- =========================================================================
     MODAL 2: QUICK ADD SERVICE GROUP
     ========================================================================= -->
<div id="modalAddServiceType" class="fixed inset-0 z-[9999] overflow-y-auto" style="display: none; background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px);">
    <div class="min-h-full flex items-center justify-center p-3 sm:p-4 text-center">
        <div class="relative w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 text-left transform transition-all my-8 overflow-hidden inline-block">
            
            <div class="p-4 sm:p-5 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between bg-slate-50 dark:bg-slate-800/80">
                <h3 class="text-sm font-bold text-slate-800 dark:text-white">Create New Other Cost (Service Group)</h3>
                <button type="button" onclick="closeAddServiceModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 cursor-pointer"><i class="fas fa-times"></i></button>
