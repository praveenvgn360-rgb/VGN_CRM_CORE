                                </div>
                                <button type="button" onclick="handleEntryRateChevron(${wg.workGroupId})" class="w-5 h-5 rounded-full bg-purple-600 hover:bg-purple-700 text-white flex items-center justify-center text-[9px] flex-shrink-0 transition shadow-2xs cursor-pointer" title="Resource Rate Analysis">
