    function boqAddSpreadsheetRows(count) {
        if (!boqHotInstance) return;
        var currentCols = boqHotInstance.countCols();
        var newRows = [];
        for (var i = 0; i < count; i++) {
            newRows.push(new Array(currentCols).fill(''));
        }
        var currentData = boqHotInstance.getData();
        var combined = currentData.concat(newRows);
        boqHotInstance.loadData(combined);
        recalculateBoqMeasurement();
        updateHotDimensions();
    }

    function boqClearEmptySpreadsheetRows() {
        if (!boqHotInstance) return;
        var currentData = boqHotInstance.getData();
        if (!currentData || currentData.length <= 1) return;
        var headers = currentData[0];
        var filtered = [headers];
        for (var r = 1; r < currentData.length; r++) {
            var row = currentData[r];
            var hasContent = row.some(function(val) {
                return val !== null && val !== undefined && $.trim(String(val)) !== '';
            });
            if (hasContent) {
                filtered.push(row);
            }
        }
        while (filtered.length < 7) {
            filtered.push(new Array(headers.length).fill(''));
        }
        boqHotInstance.loadData(filtered);
        recalculateBoqMeasurement();
    }

    function detachBoqMeasurementSheet() {
        if (!boqMeasurementActiveTarget) return;
        var iowId = boqMeasurementActiveTarget.iowId;
        var targetType = boqMeasurementActiveTarget.targetType;
        var targetIdx = boqMeasurementActiveTarget.targetIdx;
        var it = state.items.find(function (i) { return i.iowId == iowId; });

        Swal.fire({
            title: 'Detach Measurement Sheet?',
            text: 'This will unlock the quantity for manual typing and remove the attached sheet calculations.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e11d48',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Yes, Detach & Unlock',
            cancelButtonText: 'Keep Sheet'
        }).then(function (result) {
            if (result.isConfirmed) {
                if (it) {
                    it.isQtyLocked = false;
                    it.hasMeasurementSheet = false;
                    it.measurementSheet = null;
                    if (targetType === 'wbs' && it.wbsBreakdown && it.wbsBreakdown[targetIdx]) {
                        it.wbsBreakdown[targetIdx].isQtyLocked = false;
                        it.wbsBreakdown[targetIdx].measurementSheet = null;
                    } else if (targetType === 'item' && it.wbsBreakdown && it.wbsBreakdown.length === 1) {
                        it.wbsBreakdown[0].isQtyLocked = false;
                        it.wbsBreakdown[0].measurementSheet = null;
                    }
                }
                closeBoqMeasurementModal();
                renderMainDataGrid();
                if (targetType === 'item') {
                    toggleDetailSection('item_' + iowId, 'wbs');
                }
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'info',
                    title: 'Measurement Sheet detached. Quantity is now unlocked for manual entry.',
                    showConfirmButton: false,
                    timer: 2500
                });
            }
        });
    }

    function updateHotDimensions() {
        if (!boqHotInstance) return;
