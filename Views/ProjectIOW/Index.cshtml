    function getResourceOptionsHtml(selectedResCode, filterGroupId) {
        var list = state.resources || [];

        // If filtered by Resource Group
        if (filterGroupId && filterGroupId !== '') {
            var grp = (state.resourceGroups || []).find(g => String(g.resourceGroupId) === String(filterGroupId));
            var grpName = grp ? grp.resourceGroupName.toLowerCase() : '';
            list = list.filter(r => 
                (r.resourceGroupId && String(r.resourceGroupId) === String(filterGroupId)) ||
                (grpName && r.resourceGroup && r.resourceGroup.toLowerCase() === grpName)
            );
        }

        var html = '<option value="">-- Select Resource Master --</option>';
        html += '<option value="__new__" class="font-bold text-emerald-600 bg-emerald-50 dark:bg-emerald-950 dark:text-emerald-300">+ Add New Resource to Master...</option>';

        if (!filterGroupId) {
            // Group by Resource Group Master
            var groups = state.resourceGroups || [];
            if (groups.length > 0) {
                groups.forEach(g => {
                    var gName = (g.resourceGroupName || '').toLowerCase();
                    var groupResources = list.filter(r => 
                        (r.resourceGroupId && String(r.resourceGroupId) === String(g.resourceGroupId)) ||
                        (r.resourceGroup && r.resourceGroup.toLowerCase() === gName)
                    );
                    if (groupResources.length > 0) {
                        html += `<optgroup label="${escapeHtml(g.resourceGroupName)}">`;
                        groupResources.forEach(r => {
                            var isSel = (selectedResCode && (String(selectedResCode) === String(r.code) || String(selectedResCode) === String(r.resourceId)));
                            var label = `[${r.code || ''}] ${r.resourceName || ''} (${r.type || 'AC'}${r.unit ? ' - ' + r.unit : ''})`;
                            html += `<option value="${escapeHtml(r.code || '')}" data-id="${r.resourceId || ''}" data-group-id="${r.resourceGroupId || g.resourceGroupId}" data-type="${escapeHtml(r.type || 'Activity')}" data-unit="${escapeHtml(r.unit || '')}" data-name="${escapeHtml(r.resourceName || '')}" ${isSel ? 'selected' : ''}>${escapeHtml(label)}</option>`;
                        });
                        html += `</optgroup>`;
                    }
                });
                var otherResources = list.filter(r => !groups.some(g => (r.resourceGroupId && String(r.resourceGroupId) === String(g.resourceGroupId)) || (r.resourceGroup && r.resourceGroup.toLowerCase() === (g.resourceGroupName || '').toLowerCase())));
                if (otherResources.length > 0) {
                    html += `<optgroup label="Other Resources">`;
                    otherResources.forEach(r => {
                        var isSel = (selectedResCode && (String(selectedResCode) === String(r.code) || String(selectedResCode) === String(r.resourceId)));
                        var label = `[${r.code || ''}] ${r.resourceName || ''} (${r.type || 'AC'}${r.unit ? ' - ' + r.unit : ''})`;
                        html += `<option value="${escapeHtml(r.code || '')}" data-id="${r.resourceId || ''}" data-group-id="${r.resourceGroupId || ''}" data-type="${escapeHtml(r.type || 'Activity')}" data-unit="${escapeHtml(r.unit || '')}" data-name="${escapeHtml(r.resourceName || '')}" ${isSel ? 'selected' : ''}>${escapeHtml(label)}</option>`;
                    });
                    html += `</optgroup>`;
                }
            } else {
                list.forEach(r => {
                    var isSel = (selectedResCode && (String(selectedResCode) === String(r.code) || String(selectedResCode) === String(r.resourceId)));
                    var label = `[${r.code || ''}] ${r.resourceName || ''} (${r.type || 'AC'}${r.unit ? ' - ' + r.unit : ''})`;
                    html += `<option value="${escapeHtml(r.code || '')}" data-id="${r.resourceId || ''}" data-group-id="${r.resourceGroupId || ''}" data-type="${escapeHtml(r.type || 'Activity')}" data-unit="${escapeHtml(r.unit || '')}" data-name="${escapeHtml(r.resourceName || '')}" ${isSel ? 'selected' : ''}>${escapeHtml(label)}</option>`;
                });
            }
        } else {
            list.forEach(r => {
                var isSel = (selectedResCode && (String(selectedResCode) === String(r.code) || String(selectedResCode) === String(r.resourceId)));
                var label = `[${r.code || ''}] ${r.resourceName || ''} (${r.type || 'AC'}${r.unit ? ' - ' + r.unit : ''})`;
                html += `<option value="${escapeHtml(r.code || '')}" data-id="${r.resourceId || ''}" data-group-id="${r.resourceGroupId || ''}" data-type="${escapeHtml(r.type || 'Activity')}" data-unit="${escapeHtml(r.unit || '')}" data-name="${escapeHtml(r.resourceName || '')}" ${isSel ? 'selected' : ''}>${escapeHtml(label)}</option>`;
            });
        }
        return html;
    }

