@{
    ViewBag.Title = "Request for Creation - Project IOW Add — VGN ERP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-3 sm:p-4 space-y-3 font-sans text-slate-800 dark:text-slate-100 max-w-[1700px] mx-auto">

    <!-- ═══════════════════════════════════════════════════════════════════════
         STEP 1 — HEADER SECTION (img-1)
         Exact Match: Light Blue Title, 3 Top-Right Action Buttons, Form Inputs
         ═══════════════════════════════════════════════════════════════════════ -->
    <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-2xs p-3.5 sm:p-4 space-y-3">
        <!-- Top Bar: Title & Top-Right Action Buttons (Exact Match to Image 1) -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-2.5 border-b border-slate-100 dark:border-slate-700">
            <div>
                <h1 class="text-base font-bold text-[#0088cc] dark:text-[#38bdf8] tracking-tight">Request for Creation - Project IOW Add</h1>
            </div>

            <!-- Top Right Action Buttons (Image 1: Sheet Rate Duplication, WBS Master, Apply Qualifier) -->
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button" class="px-3 py-1 rounded text-xs font-semibold bg-[#f3e8ff] text-[#7e22ce] hover:bg-[#e9d5ff] border border-[#e9d5ff] transition cursor-pointer shadow-2xs">
                    <i class="fas fa-bell mr-1 text-[10px]"></i> Sheet Rate Duplication
                </button>
                <button type="button" onclick="openWBSMasterModal()" class="px-3 py-1 rounded text-xs font-semibold bg-[#e0f2fe] text-[#0369a1] hover:bg-[#bae6fd] border border-[#bae6fd] transition cursor-pointer shadow-2xs">
                    <i class="fas fa-th-list mr-1 text-[10px]"></i> WBS Master
                </button>
                <button type="button" class="px-3 py-1 rounded text-xs font-semibold bg-[#ccfbf1] text-[#0f766e] hover:bg-[#99f6e4] border border-[#99f6e4] transition cursor-pointer shadow-2xs">
                    <i class="fas fa-sliders-h mr-1 text-[10px]"></i> Apply Qualifier
                </button>
            </div>
        </div>

        <!-- Form Inputs Strip: Reference Date, Ref No, Project Name (Dropdown), Type, Revision -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
            <!-- Reference Date: Date Picker (read-only, no manual keyboard typing allowed) -->
            <div>
                <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">
                    Reference Date <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                    <input type="text" id="txtReferenceDate" readonly value="@ViewBag.CurrentDate" class="w-full text-xs font-semibold px-3 py-1.5 rounded-lg bg-[#f8fafc] dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-100 cursor-pointer focus:ring-1 focus:ring-sky-500 focus:outline-none" placeholder="Select Date" />
                    <i class="fas fa-calendar-alt absolute right-3 top-2.5 text-slate-400 text-xs pointer-events-none"></i>
                </div>
            </div>

            <!-- Reference No: auto-generated ID, not editable -->
            <div>
                <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Reference No</label>
                <input type="text" id="txtReferenceNo" value="51070" readonly class="w-full text-xs font-bold px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900/80 border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-400 cursor-not-allowed select-none focus:outline-none" placeholder="51070" />
            </div>

            <!-- Project Name: comes from dropdown (User specified) -->
            <div>
                <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">
                    Project Name <span class="text-rose-500">*</span>
                </label>
                <select id="ddlProject" onchange="onProjectChange(this.value)" class="w-full text-xs font-bold px-3 py-1.5 rounded-lg bg-[#f8fafc] dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-100 focus:ring-1 focus:ring-sky-500 focus:outline-none cursor-pointer">
                    <option value="1">Demo Project</option>
                </select>
                <input type="hidden" id="txtProjectName" value="Demo Project" />
            </div>

            <!-- Type: Budget / Estimate / Actual -->
            <div>
                <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Type</label>
                <select id="ddlType" class="w-full text-xs font-medium px-3 py-1.5 rounded-lg bg-[#f8fafc] dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-100 focus:ring-1 focus:ring-sky-500 focus:outline-none cursor-pointer">
                    <option value="Budget" selected>Budget</option>
                    <option value="Estimate">Estimate</option>
                    <option value="Actual">Actual</option>
                </select>
            </div>

            <!-- Revision: default value = "No", user can switch to Yes/No -->
            <div>
                <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Revision</label>
                <select id="ddlRevision" class="w-full text-xs font-medium px-3 py-1.5 rounded-lg bg-[#f8fafc] dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-100 focus:ring-1 focus:ring-sky-500 focus:outline-none cursor-pointer">
                    <option value="No" selected>No</option>
                    <option value="Yes">Yes</option>
                </select>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         STEP 2 — DX GRID CARD, GREEN RIBBON & ACTION BAR (img-1, img-2)
         Exact Match: No unwanted buttons, Exact Column Widths, Smooth Scroll
         ═══════════════════════════════════════════════════════════════════════ -->
    <div class="space-y-0">
        <!-- Top Ribbon Tag: Only One WorkGroup Button + Library IOW PickList Button -->
        <div class="flex items-center gap-2 flex-wrap">
            <button type="button" onclick="openWorkgroupPickListModal()" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-t-md text-xs font-bold bg-[#0284c7] hover:bg-[#0369a1] text-white shadow-xs transition cursor-pointer" title="Choose WorkGroup">
                <i class="fas fa-folder-open text-[10px]"></i>
                <span>Choose WorkGroup</span>
            </button>
            <button type="button" onclick="openLibraryIOWModal(null)" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-t-md text-xs font-bold bg-[#84cc16] hover:bg-[#65a30d] text-white shadow-xs transition cursor-pointer" title="Browse Library IOWs">
                <i class="fas fa-external-link-alt text-[10px]"></i>
                <span>Library IOW PickList</span>
            </button>
        </div>

        <!-- Native HTML Table Container with Exact Column Widths, Sticky Header & Smooth Scrolling -->
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-b-xl rounded-tr-xl shadow-2xs overflow-hidden p-2.5 relative">
            <div class="overflow-x-auto overflow-y-auto custom-scrollbar rounded border border-[#bce1f4] dark:border-slate-700" style="max-height: calc(100vh - 290px);">
                <table id="tblProjectIOW" class="w-full border-collapse text-xs table-fixed">
                    <thead class="sticky top-0 z-20 bg-[#ebf5fa] dark:bg-slate-800 text-[#004085] dark:text-sky-200 font-bold border-b-2 border-[#bce1f4] dark:border-slate-700 shadow-xs">
                        <tr>
                            <th class="w-[40px] px-1 py-2 text-center">#</th>
                            <th class="w-[105px] px-2 py-2 text-left">RefNo</th>
                            <th class="min-w-[480px] px-2 py-2 text-left">Specification</th>
                            <th class="w-[85px] px-2 py-2 text-left">Unit</th>
                            <th class="w-[130px] px-2 py-2 text-right">Qty</th>
                            <th class="w-[140px] px-2 py-2 text-right">Rate</th>
                            <th class="w-[140px] px-2 py-2 text-right">Amount</th>
                            <th class="w-[65px] px-1 py-2 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblProjectIOWBody" class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-900">
                    </tbody>
                </table>
            </div>

            <!-- Total Amount Bar directly beneath Grid -->
            <div class="total-amount-bar flex justify-end items-center gap-3 mt-2 px-3 py-1.5 rounded-lg bg-[#eaf5d8] dark:bg-emerald-950/30 border border-[#d2e7b8] dark:border-emerald-800/60 select-none">
                <span class="text-xs font-bold text-slate-700 dark:text-emerald-200">Total Amount:</span>
                <div class="px-4 py-1 border border-emerald-500/50 rounded bg-white dark:bg-slate-900 text-right font-bold text-xs text-emerald-600 dark:text-emerald-400 min-w-[130px] shadow-2xs" id="lblGridTotalAmount">
                    0
                </div>
            </div>
        </div>

        <!-- Remarks & Project Resource Bar directly beneath (Exact Match to Image 1 & 2) -->
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-2.5 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 shadow-2xs mt-2">
            <div class="flex items-center gap-2.5 w-full md:w-auto">
                <label class="text-xs font-bold text-slate-600 dark:text-slate-400 whitespace-nowrap">Enter Remarks:</label>
                <input type="text" id="txtMainRemarks" placeholder="Enter Remarks" class="w-full sm:w-80 md:w-96 text-xs px-3 py-1.5 rounded-lg bg-[#f8fafc] dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-200 focus:ring-1 focus:ring-sky-500 focus:outline-none" />
            </div>

            <!-- Project Resource Button matching Image 1 & 2 bottom left -->
            <div>
                <button type="button" onclick="openResourcePickListModal(null)" class="px-3.5 py-1.5 rounded-md text-xs font-bold bg-[#65a30d] hover:bg-[#4d7c0f] text-white inline-flex items-center gap-2 shadow-2xs transition cursor-pointer">
                    <span>Project Resource :</span>
                    <i class="fas fa-arrow-right text-[10px]"></i>
                    <span id="badgeResourceCount" class="w-4 h-4 rounded-full bg-white text-[#65a30d] font-black text-[10px] inline-flex items-center justify-center">2</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         BOTTOM FOOTER BAR: READY FOR APPROVAL, CANCEL, SUBMIT (Matching Image 2)
         ═══════════════════════════════════════════════════════════════════════ -->
    <div class="sticky bottom-0 z-30 bg-white/95 dark:bg-slate-800/95 backdrop-blur-md border border-slate-200 dark:border-slate-700 rounded-xl shadow-md p-2.5 flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-2 select-none">
            <input type="checkbox" id="chkReadyForApproval" checked class="w-4 h-4 rounded text-sky-600 focus:ring-sky-500 border-slate-300 dark:border-slate-600 cursor-pointer" />
            <label for="chkReadyForApproval" class="text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">Ready for Approval</label>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" onclick="resetEntireForm()" class="px-4 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 transition cursor-pointer">
                Cancel
            </button>
            <button type="button" onclick="submitProjectIOW()" class="px-5 py-1.5 rounded-lg text-xs font-bold bg-[#0284c7] hover:bg-[#0369a1] text-white shadow-sm flex items-center gap-1.5 transition cursor-pointer">
                <i class="fas fa-check-circle text-xs"></i>
                <span>Submit</span>
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════
     MODAL 1: PROJECT WORKGROUP / HEADER PICKLIST (img-3 & img-4)
     ═══════════════════════════════════════════════════════════════════════ -->
<div id="modalWorkgroupOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-[1050] hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto" style="display: none;">
    <div class="relative w-full max-w-2xl bg-white dark:bg-slate-800 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-700 flex flex-col max-h-[85vh] my-auto overflow-hidden z-[1055]">
        <div class="px-4 py-2.5 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center bg-[#ebf5fa] dark:bg-slate-800 flex-shrink-0">
            <div class="flex items-center gap-2">
                <div class="w-5 h-5 rounded bg-sky-500 text-white flex items-center justify-center text-xs font-bold">
                    <i class="fas fa-list-ul"></i>
                </div>
                <h3 class="text-xs font-bold text-sky-950 dark:text-sky-200">Project Workgroup/Header PickList</h3>
            </div>
            <button onclick="closeWorkgroupPickListModal()" type="button" class="w-6 h-6 flex items-center justify-center rounded-full text-sky-400 hover:bg-sky-200/50 hover:text-sky-700 transition cursor-pointer">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>

        <div class="p-2.5 border-b border-slate-100 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/50 flex items-center gap-2 flex-wrap">
            <select id="ddlWgSearchField" class="text-xs font-semibold px-2 py-1 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200">
                <option value="SerialNo">SerialNo</option>
                <option value="Description">Description</option>
            </select>
            <div class="relative flex-1 min-w-[150px]">
                <input type="text" id="txtWgSearchKeyword" onkeyup="filterWorkgroupList()" placeholder="Search..." class="w-full text-xs px-2.5 py-1 pr-7 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-1 focus:ring-sky-500" />
                <i class="fas fa-search absolute right-2 top-1.5 text-slate-400 text-xs pointer-events-none"></i>
            </div>
            <button type="button" onclick="filterWorkgroupList()" class="w-6 h-6 rounded-full bg-amber-400 text-white flex items-center justify-center text-xs shadow-xs hover:bg-amber-500 transition" title="Search">
                <i class="fas fa-search"></i>
            </button>
            <button type="button" onclick="toggleExpandAllWorkgroups()" class="w-6 h-6 rounded-full bg-pink-400 text-white flex items-center justify-center text-xs shadow-xs hover:bg-pink-500 transition" title="Expand/Collapse">
                <i class="fas fa-arrows-alt-v"></i>
            </button>
            <a href="@Url.Action("Index", "WorkGroupMaster")" target="_blank" class="w-6 h-6 rounded-full bg-sky-500 text-white flex items-center justify-center text-xs shadow-xs hover:bg-sky-600 transition" title="Manage Work Groups">
                <i class="fas fa-pencil-alt"></i>
            </a>
        </div>

        <div class="p-2.5 overflow-y-auto flex-1 max-h-[50vh] custom-scrollbar">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="bg-[#ebf5fa] dark:bg-slate-700 text-sky-900 dark:text-sky-200 font-bold border-b border-sky-200 dark:border-slate-600">
                        <th class="py-1.5 px-3 w-32">SerialNo</th>
                        <th class="py-1.5 px-3">Description</th>
                        <th class="py-1.5 px-3 w-16 text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="tblWorkgroupPickListBody" class="divide-y divide-slate-100 dark:divide-slate-700">
                </tbody>
            </table>
        </div>

        <div class="px-4 py-2 border-t border-slate-100 dark:border-slate-700 bg-[#ebf5fa] dark:bg-slate-800 flex justify-between items-center flex-wrap gap-2 flex-shrink-0">
            <div class="flex items-center gap-2">
                <span class="text-xs text-slate-500 dark:text-slate-400" id="lblWgCountInfo">1-4 of 4</span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="closeWorkgroupPickListModal()" class="px-3 py-1 rounded text-xs font-semibold bg-[#a855f7] hover:bg-[#9333ea] text-white transition cursor-pointer">
                    Cancel
                </button>
                <button type="button" onclick="applySelectedWorkgroups()" class="px-4 py-1 rounded text-xs font-bold bg-[#06b6d4] hover:bg-[#0891b2] text-white transition cursor-pointer">
                    OK
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════
     MODAL 2: WBS MASTER PICKLIST (img-9 & img-10)
     ═══════════════════════════════════════════════════════════════════════ -->
<div id="modalWBSOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-[1060] hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto" style="display: none;">
    <div class="relative w-full max-w-2xl bg-white dark:bg-slate-800 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-700 flex flex-col max-h-[85vh] my-auto overflow-hidden z-[1065]">
        <div class="px-4 py-2.5 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center bg-[#ebf5fa] dark:bg-slate-800 flex-shrink-0">
            <div class="flex items-center gap-2">
                <i class="fas fa-list-ul text-sky-600 text-xs"></i>
                <h3 class="text-xs font-bold text-sky-950 dark:text-sky-200">PickList</h3>
            </div>
            <button onclick="closeWBSPickListModal()" type="button" class="w-6 h-6 flex items-center justify-center rounded-full text-sky-400 hover:text-sky-700 transition cursor-pointer">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>

        <div class="p-2.5 bg-[#ebf5fa]/50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-700 space-y-1">
            <span class="block text-[11px] font-bold text-slate-700 dark:text-slate-300">WBSName</span>
            <input type="text" id="txtWBSFilter" onkeyup="filterWBSPickList()" placeholder="" class="w-full text-xs px-2.5 py-1 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-1 focus:ring-sky-500" />
        </div>

        <div class="p-2.5 overflow-y-auto flex-1 max-h-[48vh] custom-scrollbar">
            <table class="w-full text-left text-xs border-collapse">
                <tbody id="tblWBSPickListBody" class="divide-y divide-slate-100 dark:divide-slate-700">
                </tbody>
            </table>
        </div>

        <div class="px-4 py-2 border-t border-slate-100 dark:border-slate-700 bg-[#ebf5fa] dark:bg-slate-800 flex justify-between items-center flex-wrap gap-2 flex-shrink-0">
            <div class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
                <span>Go to page:</span>
                <input type="number" id="wbsCurrentPage" value="1" min="1" class="w-10 text-center text-xs py-0.5 border border-slate-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200" />
                <span>Show rows:</span>
                <select id="wbsPageSize" onchange="filterWBSPickList()" class="text-xs py-0.5 border border-slate-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200">
                    <option value="10">10</option>
                    <option value="25">25</option>
                </select>
                <span id="lblWBSCountInfo">1-6 of 6</span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="closeWBSPickListModal()" class="px-3 py-1 rounded text-xs font-semibold bg-[#a855f7] hover:bg-[#9333ea] text-white transition cursor-pointer">
                    Cancel
                </button>
                <button type="button" onclick="applySelectedWBSToActiveIOW()" class="px-4 py-1 rounded text-xs font-bold bg-[#06b6d4] hover:bg-[#0891b2] text-white transition cursor-pointer">
                    OK
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════
     MODAL 3: RESOURCE / IOW PICKLIST (img-12, img-13, img-14)
     ═══════════════════════════════════════════════════════════════════════ -->
<div id="modalResourceOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-[1060] hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto" style="display: none;">
    <div class="relative w-full max-w-3xl bg-white dark:bg-slate-800 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-700 flex flex-col max-h-[88vh] my-auto overflow-hidden z-[1065]">
        <div class="px-4 py-2.5 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center bg-[#ebf5fa] dark:bg-slate-800 flex-shrink-0">
            <div class="flex items-center gap-2">
                <i class="fas fa-list-ul text-sky-600 text-xs"></i>
                <h3 class="text-xs font-bold text-sky-950 dark:text-sky-200">Resource/IOW Picklist</h3>
            </div>
            <button onclick="closeResourcePickListModal()" type="button" class="w-6 h-6 flex items-center justify-center rounded-full text-sky-400 hover:text-sky-700 transition cursor-pointer">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>

        <div class="flex border-b border-slate-200 dark:border-slate-700 px-3 bg-slate-50 dark:bg-slate-800/60">
            <button type="button" onclick="switchResourceModalTab('Resource')" id="tabBtnResource" class="py-1.5 px-3 text-xs font-bold border-b-2 border-teal-500 text-teal-600 dark:text-teal-400 focus:outline-none">
                Resource
            </button>
            <button type="button" onclick="switchResourceModalTab('IOW')" id="tabBtnIOW" class="py-1.5 px-3 text-xs font-semibold text-slate-500 hover:text-slate-700 dark:text-slate-400 border-b-2 border-transparent focus:outline-none">
                Item of Work
            </button>
        </div>

        <div class="p-2.5 border-b border-slate-100 dark:border-slate-700 bg-[#ebf5fa]/40 dark:bg-slate-800/40">
            <div class="grid grid-cols-5 gap-2 text-xs">
                <div>
                    <span class="block text-[10px] font-bold text-slate-600 dark:text-slate-300 mb-0.5">Code</span>
                    <input type="text" id="filResCode" onkeyup="filterResourcePickList()" class="w-full text-xs px-2 py-0.5 border border-slate-300 rounded bg-white dark:bg-slate-700" />
                </div>
                <div>
                    <span class="block text-[10px] font-bold text-slate-600 dark:text-slate-300 mb-0.5">ResourceName</span>
                    <input type="text" id="filResName" onkeyup="filterResourcePickList()" class="w-full text-xs px-2 py-0.5 border border-slate-300 rounded bg-white dark:bg-slate-700" />
                </div>
                <div>
                    <span class="block text-[10px] font-bold text-slate-600 dark:text-slate-300 mb-0.5">Unit</span>
