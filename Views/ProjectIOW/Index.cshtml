                    <td class="py-2 px-2 text-right">
                        <input type="number" step="any" value="${rateDisplay}" placeholder="" onfocus="this.select()" oninput="updateResourceRateDirect(${item.iowId}, ${idx}, this.value)" class="w-20 px-1 py-0.5 border border-slate-300 dark:border-slate-600 rounded text-right font-mono text-xs bg-white dark:bg-slate-700" />
