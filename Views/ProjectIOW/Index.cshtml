@{
    ViewBag.Title = "Bill of Quantity (BOQ) — VGN ERP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/lib/handsontable/css/handsontable.full.min.css" />
<script src="~/lib/handsontable/js/handsontable.full.js"></script>

<div class="p-3 sm:p-4 space-y-4 font-sans text-slate-800 dark:text-slate-100 max-w-[1700px] mx-auto">

    <!-- ═══════════════════════════════════════════════════════════════════════
         VIEW 1 — BILL OF QUANTITY LOAD SCREEN (DevExtreme DataGrid)
         Visible by default per user request
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="viewBOQList" class="space-y-4">
        <!-- Header Bar -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-[var(--surface)] p-4 sm:p-5 rounded-2xl shadow-sm border border-[var(--border)]">
            <div class="flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-[rgba(var(--primary-rgb),0.12)] border border-[rgba(var(--primary-rgb),0.25)] flex items-center justify-center text-primary text-xl shadow-sm">
                    <i class="fas fa-file-invoice-dollar"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2.5">
                        <h1 class="text-xl font-bold text-[var(--text)] tracking-tight">Bill of Quantity (BOQ)</h1>
                        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-600 border border-blue-500/20" id="badgeTotalBOQ">
                            0 BOQs
                        </span>
                    </div>
                    <p class="text-xs text-[var(--text-muted)] mt-0.5">Summary of project bill of quantities, rate analysis, WBS allocations, and revisions</p>
                </div>
            </div>

            <!-- Top Action Buttons: Refresh & + New IOW Button -->
            <div class="flex items-center gap-2.5 w-full md:w-auto justify-end flex-wrap">
                <a href="@Url.Action("Index", "OtherCostAllocation")" class="px-3.5 py-2 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Manage Overhead Allocations">
                    <i class="fas fa-hand-holding-usd text-teal-600"></i>
                    <span>Cost Allocations</span>
                </a>
                <a href="@Url.Action("Index", "OtherCostBreakup")" class="px-3.5 py-2 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Manage Itemized Breakups">
                    <i class="fas fa-layer-group text-teal-600"></i>
                    <span>Cost Breakup</span>
                </a>
                <button type="button" onclick="loadBOQGrid()" class="btn-clear !text-xs !py-2 !px-3.5 cursor-pointer" title="Refresh List">
                    <i class="fas fa-sync-alt mr-1.5 text-slate-500"></i> Refresh
                </button>
                <button type="button" onclick="openNewBOQForm()" class="btn-save !text-xs !py-2.5 !px-5 text-white flex items-center gap-2 shadow-md cursor-pointer">
                    <i class="fas fa-plus font-bold"></i>
                    <span class="font-bold">New IOW</span>
                </button>
            </div>
        </div>

        <!-- Summary Stats Strip -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl p-4 flex items-center justify-between shadow-sm">
                <div>
                    <span class="text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider block">Total BOQs</span>
                    <span class="text-2xl font-black text-[var(--text)] mt-1 block" id="statTotalBOQ">0</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-[rgba(var(--primary-rgb),0.1)] text-primary flex items-center justify-center text-lg">
                    <i class="fas fa-layer-group"></i>
                </div>
            </div>
            <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl p-4 flex items-center justify-between shadow-sm">
                <div>
                    <span class="text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider block">Total BOQ Value</span>
                    <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1 block" id="statTotalValue">₹ 0.00</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-lg">
                    <i class="fas fa-coins"></i>
                </div>
            </div>
            <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl p-4 flex items-center justify-between shadow-sm">
                <div>
                    <span class="text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider block">Active Status</span>
                    <span class="text-2xl font-black text-blue-600 dark:text-blue-400 mt-1 block" id="statActiveBOQ">0</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center text-lg">
                    <i class="fas fa-check-double"></i>
                </div>
            </div>
        </div>

        <!-- DevExtreme DataGrid Card -->
        <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-md p-4 sm:p-5">
            <div id="dxGridBOQ"></div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VIEW 2 — BILL OF QUANTITY CREATION / EDIT MODULE (IOW Module)
         Hidden by default, shown when "+ New IOW" or "Edit" is clicked
         ═══════════════════════════════════════════════════════════════════════ -->
    <div id="viewBOQForm" style="display: none;" class="space-y-3">
        <!-- Navigation Header Bar: Back to List & Form Mode Banner -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-2.5 border-b border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-3.5 rounded-xl shadow-2xs">
            <div class="flex items-center gap-3">
                <button type="button" onclick="switchToBOQList()" class="px-3 py-1.5 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                    <i class="fas fa-arrow-left text-xs"></i>
                    <span>Back to BOQ List</span>
                </button>
                <div class="h-4 w-[1px] bg-slate-300 dark:bg-slate-600"></div>
                <div>
                    <h1 id="lblBOQFormTitle" class="text-base font-bold text-[#0088cc] dark:text-[#38bdf8] tracking-tight">Request for Creation - Project IOW Add</h1>
                </div>
                <span id="badgeEditMode" class="hidden text-xs font-bold px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 border border-amber-500/20">
                    Edit Mode
                </span>
            </div>

            <!-- Top Right Action Buttons: Compact View Toggle & Manage Master -->
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button" id="btnToggleHeaderCollapse" onclick="toggleFormHeaderCollapse()" class="px-3 py-1.5 rounded-lg text-xs font-bold border border-slate-300 dark:border-slate-600 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs" title="Toggle compact header for more grid space">
                    <i class="fas fa-compress-alt text-xs" id="iconToggleHeaderCollapse"></i>
                    <span id="lblToggleHeaderCollapse">Compact View</span>
                </button>
                <button type="button" onclick="openMasterSelectionModal()" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-[#6366f1] hover:bg-[#4f46e5] text-white transition cursor-pointer shadow-xs inline-flex items-center gap-1.5" title="Manage Masters (WBS, Resource, WorkGroup)">
                    <i class="fas fa-database text-[11px]"></i>
                    <span>Manage Master</span>
                </button>
            </div>
        </div>

        <!-- Full Form Inputs Panel (Collapsible for maximum workspace) -->
        <div id="formHeaderFullPanel" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-2xs p-3.5 sm:p-4 space-y-3 transition-all">
            <!-- Form Inputs Strip: Reference Date, Ref No, Project Name (Dropdown), Type, Revision -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
                <!-- Reference Date: Locked to current date only (no calendar picker, no past/future dates) -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">
                        Reference Date <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="text" id="txtReferenceDate" readonly value="@ViewBag.CurrentDate" class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-900/80 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 cursor-not-allowed select-none focus:outline-none" title="Reference Date is locked to today's date" />
                        <i class="fas fa-lock absolute right-3 top-3 text-slate-400 text-xs pointer-events-none"></i>
                    </div>
                </div>

                <!-- Reference No: auto-increment ID starting from 1 -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Reference No</label>
                    <input type="text" id="txtReferenceNo" value="1" readonly class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-900/80 border border-slate-300 dark:border-slate-600 text-sky-700 dark:text-sky-400 cursor-not-allowed select-none focus:outline-none" placeholder="1" />
                </div>

                <!-- Project Name: Searchable + Selectable Dropdown -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">
                        Project Name <span class="text-rose-500">*</span>
                    </label>
                    <select id="ddlProject" class="w-full text-xs font-bold px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-100 focus:outline-none cursor-pointer">
                        <option value="">-- Select Project --</option>
                    </select>
                    <input type="hidden" id="txtProjectName" value="" />
                </div>

                <!-- Type: Default value must always be "Plan" -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Type</label>
                    <select id="ddlType" class="w-full text-xs font-semibold px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-100 focus:ring-1 focus:ring-sky-500 focus:outline-none cursor-pointer">
                        <option value="Plan" selected>Plan</option>
                        <option value="Budget">Budget</option>
                    </select>
                </div>

                <!-- Revision: default value = "No", user can switch to Yes/No -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Revision</label>
                    <select id="ddlRevision" class="w-full text-xs font-medium px-3 py-1.5 rounded-lg bg-[#f8fafc] dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-100 focus:ring-1 focus:ring-sky-500 focus:outline-none cursor-pointer">
                        <option value="No" selected>No</option>
                        <option value="Yes">Yes</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Sleek Compact Header Summary Bar (Visible when header is collapsed) -->
        <div id="formHeaderCompactBar" style="display: none;" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2 shadow-2xs flex items-center justify-between flex-wrap gap-2 text-xs">
            <div class="flex items-center gap-4 flex-wrap">
                <div class="flex items-center gap-1.5">
                    <span class="font-bold text-slate-400 uppercase text-[10px]">Project:</span>
                    <span class="font-bold text-sky-700 dark:text-sky-300" id="summaryProjectName">—</span>
                </div>
                <div class="h-3.5 w-[1px] bg-slate-300 dark:bg-slate-600"></div>
                <div class="flex items-center gap-1.5">
                    <span class="font-bold text-slate-400 uppercase text-[10px]">Ref No:</span>
                    <span class="font-mono font-bold text-slate-800 dark:text-slate-100" id="summaryRefNo">1</span>
                </div>
                <div class="h-3.5 w-[1px] bg-slate-300 dark:bg-slate-600"></div>
                <div class="flex items-center gap-1.5">
                    <span class="font-bold text-slate-400 uppercase text-[10px]">Date:</span>
                    <span class="font-medium text-slate-700 dark:text-slate-300" id="summaryRefDate">—</span>
                </div>
                <div class="h-3.5 w-[1px] bg-slate-300 dark:bg-slate-600"></div>
                <div class="flex items-center gap-1.5">
                    <span class="font-bold text-slate-400 uppercase text-[10px]">Type:</span>
                    <span class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 font-bold text-[10px]" id="summaryType">Plan</span>
                </div>
                <div class="h-3.5 w-[1px] bg-slate-300 dark:bg-slate-600"></div>
                <div class="flex items-center gap-1.5">
                    <span class="font-bold text-slate-400 uppercase text-[10px]">Revision:</span>
                    <span class="font-medium text-slate-700 dark:text-slate-300" id="summaryRevision">No</span>
                </div>
            </div>
            <button type="button" onclick="toggleFormHeaderCollapse()" class="text-sky-600 dark:text-sky-400 hover:underline font-bold text-xs flex items-center gap-1 cursor-pointer">
                <i class="fas fa-expand-alt text-[11px]"></i>
                <span>Expand Header</span>
            </button>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════════
             STEP 2 — MAIN DATA GRID CARD & WORKSPACE (Spacious, Clean, Collapsible)
             ═══════════════════════════════════════════════════════════════════════ -->
        <div class="space-y-0">
            <!-- Grid Action Toolbar: WorkGroup Picker, Expand/Collapse All WorkGroups & Drawers -->
            <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-2xs p-2.5 mb-2 flex items-center justify-between flex-wrap gap-2.5">
                <div class="flex items-center gap-2 flex-wrap">
                    <button type="button" onclick="openWorkgroupPickListModal()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-cyan-600 hover:bg-cyan-700 text-white shadow-2xs transition cursor-pointer flex items-center gap-1.5">
                        <i class="fas fa-folder-open text-xs"></i>
                        <span>Choose WorkGroup</span>
                    </button>
                    <button type="button" onclick="toggleExpandAllGridWorkgroups()" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-700 hover:bg-slate-100 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                        <i class="fas fa-layer-group text-xs text-sky-600"></i>
                        <span id="lblToggleAllWg">Collapse All WorkGroups</span>
                    </button>
                    <button type="button" onclick="toggleExpandAllDrawers()" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-700 hover:bg-slate-100 text-slate-700 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5 shadow-2xs">
                        <i class="fas fa-sliders-h text-xs text-purple-600"></i>
                        <span id="lblToggleAllDrawers">Expand All Details</span>
                    </button>
                </div>
                <div class="flex items-center gap-2.5 text-xs text-slate-500 dark:text-slate-400 font-medium">
                    <span class="px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 font-bold text-slate-700 dark:text-slate-200" id="badgeGridItemCount">0 Items</span>
                </div>
            </div>

            <!-- Native HTML Table Container with Exact Column Widths, Sticky Header & Smooth Scrolling -->
            <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-2xs overflow-hidden p-2.5 relative">
                <div class="overflow-x-auto overflow-y-auto custom-scrollbar rounded border border-[#bce1f4] dark:border-slate-700" id="gridTableScrollContainer" style="max-height: calc(100vh - 310px);">
                    <table id="tblProjectIOW" class="w-full border-collapse text-xs table-fixed">
                        <thead class="sticky top-0 z-20 bg-[#ebf5fa] dark:bg-slate-800 text-[#004085] dark:text-sky-200 font-bold border-b-2 border-[#bce1f4] dark:border-slate-700 shadow-xs">
                        <tr>
                            <th class="w-[40px] px-1 py-2 text-center">#</th>
                            <th class="w-[105px] px-2 py-2 text-left">RefNo</th>
                            <th class="min-w-[480px] px-2 py-2 text-left">Specification</th>
                            <th class="w-[105px] min-w-[95px] px-2 py-2 text-left">Unit</th>
                            <th class="w-[130px] px-2 py-2 text-right">Qty</th>
                            <th class="w-[140px] px-2 py-2 text-right">Rate</th>
                            <th class="w-[140px] px-2 py-2 text-right">Amount</th>
                            <th class="w-[65px] px-1 py-2 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblProjectIOWBody" class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-900">
                    </tbody>
                </table>
            </div>

            <!-- Total Amount Bar directly beneath Grid -->
            <div class="total-amount-bar flex justify-end items-center gap-3 mt-2 px-3 py-1.5 rounded-lg bg-[#eaf5d8] dark:bg-emerald-950/30 border border-[#d2e7b8] dark:border-emerald-800/60 select-none">
                <span class="text-xs font-bold text-slate-700 dark:text-emerald-200">Total Amount:</span>
                <div class="px-4 py-1 border border-emerald-500/50 rounded bg-white dark:bg-slate-900 text-right font-bold text-xs text-emerald-600 dark:text-emerald-400 min-w-[130px] shadow-2xs" id="lblGridTotalAmount">
                    0
                </div>
            </div>
        </div>

        <!-- Remarks Bar directly beneath -->
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-2.5 flex items-center gap-3 shadow-2xs mt-2">
            <label class="text-xs font-bold text-slate-600 dark:text-slate-400 whitespace-nowrap">Enter Remarks:</label>
            <input type="text" id="txtMainRemarks" placeholder="Enter Remarks" class="flex-1 max-w-xl text-xs px-3 py-1.5 rounded-lg bg-[#f8fafc] dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-200 focus:ring-1 focus:ring-sky-500 focus:outline-none" />
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         BOTTOM FOOTER BAR: READY FOR APPROVAL, CANCEL, SUBMIT (Matching Image 2)
         ═══════════════════════════════════════════════════════════════════════ -->
    <div class="sticky bottom-0 z-30 bg-white/95 dark:bg-slate-800/95 backdrop-blur-md border border-slate-200 dark:border-slate-700 rounded-xl shadow-md p-2.5 flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-2 select-none">
            <input type="checkbox" id="chkReadyForApproval" checked class="w-4 h-4 rounded text-sky-600 focus:ring-sky-500 border-slate-300 dark:border-slate-600 cursor-pointer" />
            <label for="chkReadyForApproval" class="text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">Ready for Approval</label>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" onclick="resetEntireForm()" class="px-4 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 transition cursor-pointer">
                Cancel
            </button>
            <button type="button" id="btnMainSaveBOQ" onclick="submitProjectIOW()" class="px-5 py-1.5 rounded-lg text-xs font-bold bg-[#0284c7] hover:bg-[#0369a1] text-white shadow-sm flex items-center gap-1.5 transition cursor-pointer">
                <i class="fas fa-save text-xs"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════
     MODAL 1: PROJECT WORKGROUP / HEADER PICKLIST (img-3 & img-4)
     ═══════════════════════════════════════════════════════════════════════ -->
<div id="modalWorkgroupOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-[1050] hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto" style="display: none;">
    <div class="relative w-full max-w-2xl bg-white dark:bg-slate-800 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-700 flex flex-col max-h-[85vh] my-auto overflow-hidden z-[1055]">
        <div class="px-4 py-2.5 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center bg-[#ebf5fa] dark:bg-slate-800 flex-shrink-0">
            <div class="flex items-center gap-2">
                <div class="w-5 h-5 rounded bg-sky-500 text-white flex items-center justify-center text-xs font-bold">
                    <i class="fas fa-list-ul"></i>
                </div>
                <h3 class="text-xs font-bold text-sky-950 dark:text-sky-200">Project Workgroup/Header PickList</h3>
            </div>
            <button onclick="closeWorkgroupPickListModal()" type="button" class="w-6 h-6 flex items-center justify-center rounded-full text-sky-400 hover:bg-sky-200/50 hover:text-sky-700 transition cursor-pointer">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>

        <div class="p-2.5 border-b border-slate-100 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/50 flex items-center gap-2 flex-wrap">
            <select id="ddlWgSearchField" class="text-xs font-semibold px-2 py-1 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200">
                <option value="SerialNo">SerialNo</option>
                <option value="Description">Description</option>
            </select>
            <div class="relative flex-1 min-w-[150px]">
                <input type="text" id="txtWgSearchKeyword" onkeyup="filterWorkgroupList()" placeholder="Search..." class="w-full text-xs px-2.5 py-1 pr-7 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-1 focus:ring-sky-500" />
                <i class="fas fa-search absolute right-2 top-1.5 text-slate-400 text-xs pointer-events-none"></i>
            </div>
            <button type="button" onclick="filterWorkgroupList()" class="w-6 h-6 rounded-full bg-amber-400 text-white flex items-center justify-center text-xs shadow-xs hover:bg-amber-500 transition" title="Search">
                <i class="fas fa-search"></i>
            </button>
            <button type="button" onclick="toggleExpandAllWorkgroups()" class="w-6 h-6 rounded-full bg-pink-400 text-white flex items-center justify-center text-xs shadow-xs hover:bg-pink-500 transition" title="Expand/Collapse">
                <i class="fas fa-arrows-alt-v"></i>
            </button>
