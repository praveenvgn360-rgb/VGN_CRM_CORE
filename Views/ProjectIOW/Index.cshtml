    // ── STEP 2 — RENDER BOQ NATIVE HTML TABLE (img-1, img-2, img-5) ──
    // Columns: RefNo | Specification | Unit | Qty | Rate | Amount | Action [📁]
    function escapeHtml(text) {
        if (text == null) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    // Formats numbers cleanly: shows '0' instead of '0.00'/'0.000', but preserves decimal precision when non-zero
    function cleanNum(val) {
        if (val == null || val === '') return '0';
        var n = Number(val);
        if (isNaN(n) || n === 0) return '0';
        return parseFloat(n.toFixed(3)).toString();
    }

    function cleanCurrency(val) {
        if (val == null || val === '') return '0';
        var n = Number(val);
        if (isNaN(n) || n === 0) return '0';
        return Number(n.toFixed(3)).toLocaleString('en-IN', { maximumFractionDigits: 3 });
    }

    function getUOMOptionsHtml(selectedVal) {
        var units = (state.uomList && state.uomList.length > 0) ? state.uomList : [
            { unitId: 1, unitName: 'Cum' }, { unitId: 2, unitName: 'Sqm' },
            { unitId: 3, unitName: 'Rmt' }, { unitId: 4, unitName: 'Nos' },
            { unitId: 5, unitName: 'Each' }, { unitId: 9, unitName: 'LS' },
            { unitId: 10, unitName: 'Sft' }, { unitId: 15, unitName: 'Cft' }
        ];
        return units.map(function (u) {
            var uName = u.unitName || u.UnitName;
            var uId = u.unitId || u.UnitId;
            var isSel = (String(selectedVal).toLowerCase() === String(uName).toLowerCase() || String(selectedVal) === String(uId)) ? 'selected' : '';
            return `<option value='${uName}' data-id='${uId}' ${isSel}>${uName}</option>`;
        }).join('');
    }

    function handleEntryWbsChevron(wgId) {
        var currRef = entryRowState[wgId]?.refNo;
        if (!currRef || currRef.trim() === '') {
            triggerRefNoEmptyValidation(wgId);
            return;
        }
        saveEntryRow(wgId, function (newItem) {
            if (newItem) toggleDetailSection('item_' + newItem.iowId, 'wbs');
        });
    }

    function handleEntryRateChevron(wgId) {
        var currRef = entryRowState[wgId]?.refNo;
        if (!currRef || currRef.trim() === '') {
            triggerRefNoEmptyValidation(wgId);
            return;
        }
        saveEntryRow(wgId, function (newItem) {
            if (newItem) toggleDetailSection('item_' + newItem.iowId, 'rate');
        });
    }

    function handleSpecKeydown(e, wgId) {
        if (e.key === 'Enter') {
            e.preventDefault();
            if ($("#specAutocompleteDropdown").is(":visible") && $(".spec-dropdown-item.active").length) {
                $(".spec-dropdown-item.active").click();
            } else {
                hideSpecAutocomplete();
                saveEntryRow(wgId);
            }
        } else if (e.key === 'Escape') {
            hideSpecAutocomplete();
        }
    }

