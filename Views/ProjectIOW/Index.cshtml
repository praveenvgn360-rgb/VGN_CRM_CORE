    function onProjectChange(val) {
        state.header.projectKickoffId = val;
        var ddl = document.getElementById("ddlProject");
        if (ddl && ddl.selectedIndex >= 0) {
            state.header.projectName = ddl.options[ddl.selectedIndex].text;
            var txtP = document.getElementById("txtProjectName");
            if (txtP) txtP.value = state.header.projectName;
        }
        loadWBSListForProject(val);
    }

    // ── STEP 2 — RENDER BOQ NATIVE HTML TABLE (img-1, img-2, img-5) ──
    // Columns: RefNo | Specification | Unit | Qty | Rate | Amount | Action [📁]
    function escapeHtml(text) {
        if (text == null) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    // Formats numbers cleanly: shows '0' instead of '0.00'/'0.000', but preserves decimal precision when non-zero
    function cleanNum(val) {
        if (val == null || val === '') return '0';
        var n = Number(val);
        if (isNaN(n) || n === 0) return '0';
        return parseFloat(n.toFixed(3)).toString();
    }

    function cleanCurrency(val) {
        if (val == null || val === '') return '0';
        var n = Number(val);
        if (isNaN(n) || n === 0) return '0';
        return Number(n.toFixed(3)).toLocaleString('en-IN', { maximumFractionDigits: 3 });
    }

    function getNextRefNoForWorkGroup(wgId) {
        var wg = (state.selectedWorkgroups || []).find(w => String(w.workGroupId) === String(wgId));
        var prefix = (wg && wg.serialNo) ? String(wg.serialNo).trim() : (wg ? String(wg.workGroupId) : String(wgId || '1'));
        var existingItems = (state.items || []).filter(i => String(i.workGroupId) === String(wgId));
        var nextIdx = existingItems.length + 1;
        return prefix + '.' + nextIdx;
    }

    function ensureItemHasRefNo(item) {
        if (!item) return '';
        var r = (item.refNo != null) ? String(item.refNo).trim() : '';
        if (!r) {
            var s = (item.serialNo != null) ? String(item.serialNo).trim() : '';
            if (s && s.toUpperCase() !== 'NEW') {
                r = s;
                item.refNo = r;
                item.serialNo = r;
                var inp = document.getElementById('itemRefInput_' + item.iowId);
                if (inp && r) inp.value = r;
            }
        }
        return r;
    }

    function ensureEntryRowHasRefNo(wgId) {
        if (!entryRowState[wgId]) {
            entryRowState[wgId] = { workGroupId: wgId, refNo: '' };
        }
        var entry = entryRowState[wgId];
        var r = ($('#refInput_' + wgId).val() || entry.refNo || '').toString().trim();
        entry.refNo = r;
        return r;
    }

    function getUOMOptionsHtml(selectedVal) {
        var units = (state.uomList && state.uomList.length > 0) ? state.uomList : [
            { unitId: 1, unitName: 'Cum' }, { unitId: 2, unitName: 'Sqm' },
            { unitId: 3, unitName: 'Rmt' }, { unitId: 4, unitName: 'Nos' },
            { unitId: 5, unitName: 'Each' }, { unitId: 9, unitName: 'LS' },
            { unitId: 10, unitName: 'Sft' }, { unitId: 15, unitName: 'Cft' }
        ];
        var emptySelected = (!selectedVal || selectedVal === '') ? 'selected' : '';
        var html = `<option value="" ${emptySelected}>-- Unit --</option>`;
        var found = false;
        html += units.map(function (u) {
            var uName = u.unitName || u.UnitName;
            var uId = u.unitId || u.UnitId;
            var isSel = (selectedVal && (String(selectedVal).toLowerCase() === String(uName).toLowerCase() || String(selectedVal) === String(uId)));
            if (isSel) found = true;
            return `<option value='${escapeHtml(uName)}' data-id='${uId}' ${isSel ? 'selected' : ''}>${escapeHtml(uName)}</option>`;
        }).join('');
        if (selectedVal && !found && String(selectedVal).trim()) {
            var sClean = String(selectedVal).trim();
            html += `<option value='${escapeHtml(sClean)}' data-id='${escapeHtml(sClean)}' selected>${escapeHtml(sClean)}</option>`;
        }
        return html;
    }

    function handleEntryWbsChevron(wgId) {
        ensureEntryRowHasRefNo(wgId);
        ensureEntryRowHasRefAndSpec(wgId, 'wbs');
    }

    function handleEntryRateChevron(wgId) {
        ensureEntryRowHasRefNo(wgId);
        ensureEntryRowHasRefAndSpec(wgId, 'rate');
    }

    function handleEntryQtyClick(wgId) {
        ensureEntryRowHasRefNo(wgId);
        ensureEntryRowHasRefAndSpec(wgId, 'wbs');
    }

    function handleEntryRateClick(wgId) {
        ensureEntryRowHasRefNo(wgId);
        ensureEntryRowHasRefAndSpec(wgId, 'rate');
    }

    function handleItemQtyClick(iowId) {
        var item = state.items.find(i => i.iowId == iowId);
        if (!item) return;
        ensureItemHasRefNo(item);

        // Main row Qty is in read-only / calculated mode from WBS breakdown; toggle WBS breakdown directly without asking for measurement sheet
        toggleDetailSection('item_' + iowId, 'wbs');
    }

    function handleWBSQtyClick(iowId, idx) {
        var item = state.items.find(i => i.iowId == iowId);
        if (!item || !item.wbsBreakdown || !item.wbsBreakdown[idx]) return;
        var w = item.wbsBreakdown[idx];

        if (w.isQtyLocked) {
            Swal.fire({
                title: 'Measurement Sheet Attached',
                html: '<div class="text-xs text-slate-600 dark:text-slate-300 text-left p-1 space-y-2">' +
                      '  <div class="p-2.5 rounded-lg bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300">' +
                      '    <i class="fas fa-calculator mr-1 text-amber-600"></i> WBS Quantity is calculated via Measurement Sheet: <strong class="font-mono text-sm">' + cleanNum(w.qty) + '</strong>' +
                      '  </div>' +
                      '  <p class="text-[11px] text-slate-500 mt-2">What would you like to do?</p>' +
                      '</div>',
                icon: 'question',
                showCancelButton: true,
                showDenyButton: true,
                confirmButtonColor: '#0284c7',
                denyButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="fas fa-edit mr-1"></i> Re-Edit Sheet',
                denyButtonText: '<i class="fas fa-unlock mr-1"></i> Unlock & Type Manually',
                cancelButtonText: 'Cancel'
            }).then(function (res) {
                if (res.isConfirmed) {
                    openBoqMeasurementModal(iowId, 'wbs', idx);
                } else if (res.isDenied) {
                    w.isQtyLocked = false;
                    w.measurementSheet = null;
                    renderWBSRows(item);
                    renderMainDataGrid();
                    setTimeout(function () {
                        var inp = document.getElementById('wbsQtyInput_' + iowId + '_' + idx);
                        if (inp) {
                            inp.removeAttribute('readonly');
                            inp.removeAttribute('disabled');
                            inp.focus();
                            inp.select();
                        }
                    }, 50);
                }
            });
            return;
        }

        // Prompt "Do you want measurement sheet?" (Yes / No)
        Swal.fire({
            title: 'Measurement Sheet?',
            text: 'Do you want measurement sheet?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0284c7',
            cancelButtonColor: '#10b981',
            confirmButtonText: 'Yes',
            cancelButtonText: 'No',
            reverseButtons: false
        }).then(function (result) {
            if (result.isConfirmed) {
                promptMeasurementSheet(iowId, 'wbs', idx);
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                w.isQtyLocked = false;
                var inp = document.getElementById('wbsQtyInput_' + iowId + '_' + idx);
                if (inp) {
                    inp.removeAttribute('readonly');
                    inp.removeAttribute('disabled');
                    inp.focus();
                    inp.select();
                }
            }
        });
    }

    function handleNewWBSQtyClick(iowId) {
        var inp = document.getElementById('txtNewWBSQty_' + iowId);
        Swal.fire({
            title: 'Measurement Sheet?',
            text: 'Do you want measurement sheet?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0284c7',
            cancelButtonColor: '#10b981',
            confirmButtonText: 'Yes',
            cancelButtonText: 'No',
            reverseButtons: false
        }).then(function (result) {
            if (result.isConfirmed) {
                promptMeasurementSheet(iowId, 'newWbs');
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                if (inp) {
                    inp.focus();
                    inp.select();
                }
            }
        });
    }

    function handleItemRateClick(iowId) {
        var item = state.items.find(i => i.iowId == iowId);
        if (!item) return;
        ensureItemHasRefNo(item);
        toggleDetailSection('item_' + iowId, 'rate');
    }

    function ensureEntryRowHasRefAndSpec(wgId, targetTab) {
        var entry = entryRowState[wgId] || {};
        var typedRef = ($('#refInput_' + wgId).val() || entry.refNo || '').toString().trim();
        if (typedRef.toUpperCase() === 'NEW') typedRef = '';
        entry.refNo = typedRef;

        // Requirement: Ref No must be typed by user, not automatic
        if (!typedRef) {
            Swal.fire({
                icon: 'warning',
                title: 'Enter Reference No',
                text: 'Please enter Reference No before configuring breakdown. Ref No must be typed.',
                confirmButtonColor: '#0284c7'
            });
            $('#refInput_' + wgId).focus();
            return;
        }

        // Check Specification
        if (!entry.specification || !String(entry.specification).trim()) {
            var $specEl = $('#specSelect_' + wgId);
            var valFromSelect = $specEl.val();
            if (valFromSelect && valFromSelect !== '__new__' && String(valFromSelect).trim()) {
                entry.specification = String(valFromSelect).trim();
            } else {
                if ($specEl.length && $specEl.data('select2')) {
                    $specEl.select2('open');
                } else if ($specEl.length) {
                    $specEl.focus();
                }
                Swal.fire({
                    icon: 'info',
                    title: 'Select Specification',
                    text: `Please select or enter a Specification for Ref ${entry.refNo}.`,
                    timer: 2000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
                return;
            }
        }

        // Save entry row and automatically open the target breakdown tab
        saveEntryRow(wgId, function (newItem) {
            if (newItem) toggleDetailSection('item_' + newItem.iowId, targetTab);
        });
    }

