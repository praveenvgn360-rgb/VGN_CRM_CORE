                    <input type="number" step="any" id="txtNewResRate_${item.iowId}" value="" placeholder="" onfocus="this.select()" oninput="calcNewResourceRowAmount(${item.iowId})" onkeydown="if (event.key === 'Enter') commitNewResourceRow(${item.iowId})" class="w-20 px-1 py-0.5 border border-slate-300 dark:border-slate-600 rounded text-right font-mono text-xs bg-white dark:bg-slate-700" />
