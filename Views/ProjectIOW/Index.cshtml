    function openBoqMeasurementModal(iowId, targetType, targetIdx, chosenTemplateId) {
        boqMeasurementActiveTarget = {
            iowId: iowId,
            targetType: targetType,
            targetIdx: targetIdx
        };

        var it = state.items.find(function (i) { return i.iowId == iowId; });
        if (it) ensureItemHasRefNo(it);
        var targetDesc = "BOQ Item #" + (it ? (it.refNo || it.specification || iowId) : iowId);
        if (targetType === 'wbs' && it && it.wbsBreakdown && it.wbsBreakdown[targetIdx]) {
            targetDesc = "WBS: " + (it.wbsBreakdown[targetIdx].fullWBSName || it.wbsBreakdown[targetIdx].wbsName);
        } else if (targetType === 'newWbs') {
            targetDesc = "New WBS Row for " + (it ? (it.specification || 'Item') : 'Item');
        }

        // Display modal immediately
        $('#modalBOQMeasurementOverlay').css('display', 'flex').removeClass('hidden');

        var existingSheet = (it && it.measurementSheet) ? it.measurementSheet : null;
        if (targetType === 'wbs' && it && it.wbsBreakdown && it.wbsBreakdown[targetIdx] && it.wbsBreakdown[targetIdx].measurementSheet) {
            existingSheet = it.wbsBreakdown[targetIdx].measurementSheet;
        }
        if (!existingSheet && it) {
            if (it.measurementSheet) existingSheet = it.measurementSheet;
            else if (it.wbsBreakdown) {
                for (var b = 0; b < it.wbsBreakdown.length; b++) {
                    if (it.wbsBreakdown[b] && it.wbsBreakdown[b].measurementSheet) {
                        existingSheet = it.wbsBreakdown[b].measurementSheet;
                        break;
                    }
                }
            }
        }

        if (existingSheet) {
            $('#badgeBoqEditingExistingSheet').removeClass('hidden');
            $('#btnDetachBoqMeasurement').removeClass('hidden');
            $('#lblBoqMeasurementTargetInfo').html('Re-editing Measurement Sheet (Current Total: <strong class="text-sky-600 dark:text-sky-400 font-mono">' + cleanNum(existingSheet.totalQty || 0) + '</strong>) for ' + targetDesc);
        } else {
            $('#badgeBoqEditingExistingSheet').addClass('hidden');
            $('#btnDetachBoqMeasurement').addClass('hidden');
            $('#lblBoqMeasurementTargetInfo').text('Enter dimensions below — total quantity calculates automatically for ' + targetDesc);
        }

        // Load templates into dropdown and open template or existing sheet data
        loadBoqMeasurementTemplates(function () {
            var selectedTplId = chosenTemplateId || (existingSheet ? existingSheet.templateId : null) || $('#ddlBoqMeasurementTemplate').val() || '1';
            $('#ddlBoqMeasurementTemplate').val(selectedTplId);

            if (existingSheet && existingSheet.sheetDataJson) {
                try {
                    var parsedData = typeof existingSheet.sheetDataJson === 'string' ? JSON.parse(existingSheet.sheetDataJson) : existingSheet.sheetDataJson;
                    if (Array.isArray(parsedData) && parsedData.length > 0) {
                        var col = existingSheet.selectedColumn || 'Qty';
                        boqActiveTargetColumn = col;
                        $('#lblBoqTotalColName').text(col);
                        $('#lblBoqActiveTargetColName').text(col);
                        syncBoqColumnsDropdown(parsedData[0] || [], col);
                        renderBoqSpreadsheet(parsedData, col);
                        return;
                    }
                } catch (e) {
                    console.error("Error parsing existing measurement sheet data:", e);
                }
            }
            loadBoqMeasurementTemplate(selectedTplId);
        }, chosenTemplateId || (existingSheet ? existingSheet.templateId : null));
    }

    function closeBoqMeasurementModal() {
        $('#modalBOQMeasurementOverlay').css('display', 'none').addClass('hidden');
        if (isBoqMeasurementFullscreen) {
            toggleBoqMeasurementFullscreen();
        }
    }

    function loadBoqMeasurementTemplates(callback, preserveSelectedId) {
        var currentSelected = preserveSelectedId || $('#ddlBoqMeasurementTemplate').val();
        $.ajax({
            url: '/MeasurementTemplateMaster/GetAll',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                if (res && res.success && res.data && res.data.length > 0) {
                    boqMasterTemplatesList = res.data;
                    var optsHtml = '';
                    boqMasterTemplatesList.forEach(function (t) {
                        optsHtml += '<option value="' + t.templateId + '">' + t.templateName + '</option>';
                    });
                    $('#ddlBoqMeasurementTemplate').html(optsHtml);
                    if (currentSelected && $('#ddlBoqMeasurementTemplate option[value="' + currentSelected + '"]').length > 0) {
                        $('#ddlBoqMeasurementTemplate').val(currentSelected);
                    }
                }
                if (callback) callback();
            },
            error: function () {
                if (callback) callback();
            }
        });
    }

    function onBoqMeasurementTemplateChange(templateId) {
        loadBoqMeasurementTemplate(templateId);
    }

    function onBoqMeasurementColumnChange(columnName) {
        if (!columnName) return;
        boqActiveTargetColumn = columnName;
        $('#lblBoqTotalColName').text(columnName);
        $('#lblBoqActiveTargetColName').text(columnName);
        recalculateBoqMeasurement();
        if (boqHotInstance) boqHotInstance.render();
    }

    function loadBoqMeasurementTemplate(templateId) {
        // Fetch via /MeasurementTemplateMaster/GetById?id= (EXACT same as openEditTemplate in MeasurementTemplateMaster)
        $.ajax({
            url: '/MeasurementTemplateMaster/GetById?id=' + templateId,
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                var model = (res && res.success && res.data) ? res.data : null;
                var isDefault = model ? (model.typeId > 0) : false;

                $('#lblBoqDefaultNotice').toggleClass('hidden', !isDefault);

                // Determine target column
                var savedCol = model ? $.trim(model.selectedColumns || '') : '';
                if (!savedCol || savedCol === '' || savedCol === 'Q') {
                    savedCol = (model && model.cellName && model.cellName.length > 1) ? model.cellName : 'Qty';
                }
                boqActiveTargetColumn = savedCol;
                $('#lblBoqMeasurementGrandTotal').text('0.00');
                $('#lblBoqTotalColName').text(savedCol);
                $('#lblBoqActiveTargetColName').text(savedCol);

                // Extract Row 1 headers from DB or standard fallback
                var loadedHeaders = null;
                if (model && model.description && $.trim(model.description) !== '') {
                    try {
                        var parsed = JSON.parse(model.description);
                        if (Array.isArray(parsed) && parsed.length > 0 && Array.isArray(parsed[0])) {
                            loadedHeaders = parsed[0];
                        }
                    } catch (e) { }
                }

                if (!loadedHeaders && isDefault && boqDefaultPresetTemplates[model.typeId]) {
                    loadedHeaders = boqDefaultPresetTemplates[model.typeId].data[0];
                }

                if (!loadedHeaders || loadedHeaders.length === 0) {
                    var preset = boqDefaultPresetTemplates[String(templateId)] || boqDefaultPresetTemplates['1'];
                    loadedHeaders = preset ? preset.data[0] : ["Description", "Nos1", "Nos2", "Length", "Breadth", (savedCol || "Qty")];
                }

                // Filter out trailing empty/null headers
                var validCols = loadedHeaders.length;
                for (var i = loadedHeaders.length - 1; i >= 0; i--) {
                    if (loadedHeaders[i] !== null && loadedHeaders[i] !== undefined && $.trim(String(loadedHeaders[i])) !== '') {
                        validCols = i + 1;
                        break;
                    }
                }
                var cleanHeaders = loadedHeaders.slice(0, validCols);
                if (cleanHeaders.length < 2) {
                    cleanHeaders = ["Description", "Nos1", "Nos2", "Length", "Breadth", (savedCol || "Qty")];
                }
                if (savedCol && !cleanHeaders.some(function (h) { return $.trim(String(h)).toLowerCase() === savedCol.toLowerCase(); })) {
                    cleanHeaders.push(savedCol);
                }

                // ALWAYS FRESH & CLEAN: Exact format from reference image with 100% empty data rows (same as edit case in Master)
                var cleanSheet = [cleanHeaders];
                for (var r = 0; r < 6; r++) {
                    cleanSheet.push(new Array(cleanHeaders.length).fill(''));
                }

                // Sync Choose Column(s) dropdown
                syncBoqColumnsDropdown(cleanHeaders, savedCol);

                // Render spreadsheet
                renderBoqSpreadsheet(cleanSheet, savedCol);
            },
            error: function () {
                var preset = boqDefaultPresetTemplates[String(templateId)] || boqDefaultPresetTemplates['1'];
                var cleanSheet = JSON.parse(JSON.stringify(preset.data));
                var savedCol = preset.targetCol || 'Qty';
                syncBoqColumnsDropdown(cleanSheet[0], savedCol);
                renderBoqSpreadsheet(cleanSheet, savedCol);
            }
        });
    }

    function syncBoqColumnsDropdown(headers, selectedCol) {
        var $sel = $('#selBoqMeasurementColumns');
        var target = selectedCol || boqActiveTargetColumn || 'Qty';
        var optsHtml = '';
        var found = false;

        headers.forEach(function (h) {
            var col = $.trim(h || '');
            if (col) {
                var isSel = (col.toLowerCase() === target.toLowerCase());
                if (isSel) found = true;
                optsHtml += '<option value="' + col + '" ' + (isSel ? 'selected="selected"' : '') + '>' + col + '</option>';
            }
        });

        if (!found && target) {
            optsHtml += '<option value="' + target + '" selected="selected">' + target + '</option>';
        }

        $sel.html(optsHtml);
        $sel.val(target);
    }

    function renderBoqSpreadsheet(sheetData, targetCol) {
        var container = document.getElementById('boqMeasurementSpreadsheet');
        if (!container) return;

        // Cleanly destroy previous instance to prevent column mismatch crashes
        if (boqHotInstance) {
            try { boqHotInstance.destroy(); } catch (e) { }
            boqHotInstance = null;
        }

        boqActiveTargetColumn = targetCol || 'Qty';

        // Wait a frame for layout dimensions to be fully computed
        setTimeout(function () {
            var wrapper = document.getElementById('boqMeasurementSpreadsheetWrapper');
            var dynamicHeight = (wrapper && wrapper.clientHeight > 200) ? wrapper.clientHeight : 460;

            boqHotInstance = new Handsontable(container, {
                data: sheetData,
                colHeaders: true,
                rowHeaders: true,
                contextMenu: true,
                minRows: 10,
                minSpareRows: 1,
                height: dynamicHeight,
                width: '100%',
                colWidths: function (colIndex) {
                    if (colIndex === 0) return 320; // Description column spacious
                    return 130;
                },
                stretchH: 'all',
                manualColumnResize: true,
                manualRowResize: true,
                enterBeginsEditing: true,
                tabMoves: { row: 0, col: 1 },
                autoWrapRow: true,
                cells: function (row, col) {
                    var cellProperties = {};
                    if (row === 0) {
                        cellProperties.renderer = function (instance, td, r, c, prop, value) {
                            Handsontable.renderers.TextRenderer.apply(this, arguments);
                            td.className = 'row-header-name';
                        };
                    } else {
                        cellProperties.renderer = function (instance, td, r, c, prop, value) {
                            Handsontable.renderers.TextRenderer.apply(this, arguments);
                            var headers = instance.getDataAtRow(0) || [];
                            var colName = $.trim(headers[c] || '').toLowerCase();
                            var targetName = (boqActiveTargetColumn || 'Qty').toLowerCase();

                            if (colName === targetName) {
                                td.className = 'qty-calculated-cell';
                            } else {
                                var num = parseFloat(value);
                                if (!isNaN(num) && $.trim(String(value)) !== '' && !isNaN(Number(value))) {
                                    td.style.textAlign = 'right';
                                } else {
                                    td.style.textAlign = 'left';
                                }
                            }
                        };
                    }
                    return cellProperties;
                },
                afterChange: function (changes, source) {
                    if (changes) {
                        var affectedRow0 = changes.some(function (c) { return c[0] === 0; });
                        if (affectedRow0) {
                            var row0 = boqHotInstance.getDataAtRow(0) || [];
                            syncBoqColumnsDropdown(row0, boqActiveTargetColumn);
                        }
                        if (source !== 'autoCalculation' && !isBoqRecalculating) {
                            recalculateBoqMeasurement();
                        }
                    }
                }
            });

            setTimeout(function () {
                if (boqHotInstance) {
                    boqHotInstance.render();
                    recalculateBoqMeasurement();
                    updateHotDimensions();
                }
            }, 80);
        }, 50);
    }

    // ── DIRECT AUTO-CALCULATION WHILE TYPING IN BOQ ──
    function recalculateBoqMeasurement() {
        if (!boqHotInstance || isBoqRecalculating) return;
        isBoqRecalculating = true;

        var headers = boqHotInstance.getDataAtRow(0) || [];
        var rowCount = boqHotInstance.countRows();
        var colCount = boqHotInstance.countCols();
        var grandTotal = 0;

        var targetColName = $.trim(boqActiveTargetColumn || 'Qty').toLowerCase();

        var qtyIdx = -1;
        if (targetColName) {
            for (var c = 0; c < headers.length; c++) {
                if ($.trim(headers[c] || '').toLowerCase() === targetColName) {
                    qtyIdx = c;
                    break;
                }
            }
        }
        if (qtyIdx === -1) {
            for (var c = 0; c < headers.length; c++) {
                var lower = $.trim(headers[c] || '').toLowerCase();
                if (lower === 'qty' || lower === 'quantity' || lower === 'total wt' || lower === 'totalwt' || lower === 'total') {
                    qtyIdx = c;
                    break;
                }
            }
        }
        if (qtyIdx === -1 && headers.length > 1) {
            qtyIdx = headers.length - 1;
        }

        var isSkipColumn = function(colName) {
            var lower = $.trim(colName || '').toLowerCase();
            return lower === 'description' || lower === 'particulars' || lower === 'particular' ||
                   lower === 'item' || lower === 'item name' || lower === 'item description' ||
                   lower === 'sl.no' || lower === 'sl no' || lower === 's.no' || lower === 'sno' ||
                   lower === 'serial no' || lower === 'remarks';
        };

        var changesToApply = [];

        for (var r = 1; r < rowCount; r++) {
            var product = 1;
            var hasNumericFactor = false;

            for (var c = 0; c < colCount; c++) {
                if (c === qtyIdx) continue;
                if (headers[c] && isSkipColumn(headers[c])) continue;

                var cellVal = boqHotInstance.getDataAtCell(r, c);
                if (cellVal === null || cellVal === undefined) continue;

                var strVal = $.trim(String(cellVal));
                if (strVal === '') continue;

                var num = parseFloat(strVal);
                if (!isNaN(num) && isFinite(num) && !isNaN(Number(strVal))) {
                    product *= num;
                    hasNumericFactor = true;
                }
            }

            var currentQtyVal = boqHotInstance.getDataAtCell(r, qtyIdx);
            if (hasNumericFactor) {
                var formatted = Math.round(product * 1000) / 1000;
                var displayStr = (Math.floor(formatted) === formatted) ? String(formatted) : formatted.toFixed(2);

                if (String(currentQtyVal) !== displayStr) {
                    changesToApply.push([r, qtyIdx, displayStr]);
                }
                grandTotal += formatted;
            } else {
                // If numbers were cleared in this row, clear Qty
                if (currentQtyVal !== null && currentQtyVal !== undefined && $.trim(String(currentQtyVal)) !== '') {
                    changesToApply.push([r, qtyIdx, '']);
                }
            }
        }

        if (changesToApply.length > 0) {
            boqHotInstance.setDataAtCell(changesToApply, 'autoCalculation');
        }

        grandTotal = Math.round(grandTotal * 1000) / 1000;
        var displayGrandTotal = (Math.floor(grandTotal) === grandTotal) ? String(grandTotal) : grandTotal.toFixed(2);
        $('#lblBoqMeasurementGrandTotal').text(displayGrandTotal);

        isBoqRecalculating = false;
        boqHotInstance.render();
    }

    function applyBoqMeasurementQty() {
        var rawTotal = $('#lblBoqMeasurementGrandTotal').text();
        var totalQty = parseFloat(rawTotal) || 0;

        if (!boqMeasurementActiveTarget) {
            closeBoqMeasurementModal();
            return;
        }

        var iowId = boqMeasurementActiveTarget.iowId;
        var targetType = boqMeasurementActiveTarget.targetType;
        var targetIdx = boqMeasurementActiveTarget.targetIdx;

        var it = state.items.find(function (i) { return i.iowId == iowId; });

        var sheetData = boqHotInstance ? boqHotInstance.getData() : [];
        var selectedTplId = $('#ddlBoqMeasurementTemplate').val() || '1';
        var selectedTplName = $('#ddlBoqMeasurementTemplate option:selected').text() || 'Standard Measurement';

        var sheetObj = {
            measurementSheetId: (it && it.measurementSheet) ? (it.measurementSheet.measurementSheetId || 0) : 0,
            boqId: state.editingBOQId || 0,
            project_IOWId: it ? (it.project_IOWId || it.projectIOWId || 0) : 0,
            project_WBSId: 0,
            templateId: parseInt(selectedTplId) || 1,
            templateName: selectedTplName,
            selectedColumn: boqActiveTargetColumn || 'Qty',
            sheetDataJson: JSON.stringify(sheetData),
            totalQty: totalQty
        };

        if (it) {
            it.measurementSheet = sheetObj;
            it.hasMeasurementSheet = true;
            it.isQtyLocked = true;
        }

        if (targetType === 'item') {
            // Apply to main BOQ Item
            updateItemDirect(iowId, 'qty', totalQty);
            $('.item-qty-val-' + iowId).val(cleanNum(totalQty));
            if (it && it.wbsBreakdown && it.wbsBreakdown.length === 1) {
                it.wbsBreakdown[0].qty = totalQty;
                it.wbsBreakdown[0].measurementSheet = sheetObj;
                it.wbsBreakdown[0].isQtyLocked = true;
                renderWBSRows(it);
                updateWBSTotalAndSync(it);
            }
            renderMainDataGrid();
        } else if (targetType === 'wbs') {
            // Apply to specific WBS row
            if (it && it.wbsBreakdown && it.wbsBreakdown[targetIdx]) {
                it.wbsBreakdown[targetIdx].measurementSheet = sheetObj;
                it.wbsBreakdown[targetIdx].isQtyLocked = true;
                updateWBSQty(iowId, targetIdx, totalQty);
                renderWBSRows(it);
            }
            renderMainDataGrid();
        } else if (targetType === 'newWbs') {
            // Apply to the new WBS input box
            $('#txtNewWBSQty_' + iowId).val(cleanNum(totalQty));
            var ddl = document.getElementById("ddlNewWBS_" + iowId);
            if (ddl && ddl.value && ddl.value !== '' && ddl.value !== '__new__') {
                handleWBSCommit(iowId);
            } else {
                $('#txtNewWBSQty_' + iowId).focus();
            }
            renderMainDataGrid();
        }

        closeBoqMeasurementModal();

        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: 'Quantity (' + cleanNum(totalQty) + ') applied & locked via Measurement Sheet!',
            showConfirmButton: false,
            timer: 2500
        });
    }
</script>
