                else if (t === '3') t = 'Equipment';
                else if (t === '4') t = 'Labour';
                for (var i = 0; i < typeDdl.options.length; i++) {
                    if (typeDdl.options[i].value.toLowerCase() === t.toLowerCase()) {
                        typeDdl.selectedIndex = i;
                        break;
