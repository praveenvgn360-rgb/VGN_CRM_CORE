    function onResourceDropdownChange(iowId, val) {
        if (val === '__new__') {
            var curGroup = (state.activeResourceGroupFilter && state.activeResourceGroupFilter[iowId]) ? state.activeResourceGroupFilter[iowId] : '';
            openAddNewResourceModal('', iowId, curGroup);
            return;
        }
        var lblType = document.getElementById("lblNewResType_" + iowId);
        var txtUnit = document.getElementById("txtNewResUnit_" + iowId);
        var txtRate = document.getElementById("txtNewResRate_" + iowId);
        var txtCoeff = document.getElementById("txtNewResCoeff_" + iowId);

        if (!val) {
            if (lblType) lblType.innerText = '';
            if (txtUnit) txtUnit.value = '';
            if (txtRate) txtRate.value = '';
            calcNewResourceRowAmount(iowId);
            return;
        }

        var res = (state.resources || []).find(r => String(r.code) === String(val) || String(r.resourceId) === String(val));
        if (res) {
            // Auto-sync Resource Group dropdown in this row from Resource Group Master!
            var grpDdl = document.getElementById("ddlNewResourceGroup_" + iowId);
            if (grpDdl) {
                var matchG = (state.resourceGroups || []).find(g => 
                    (res.resourceGroupId && String(g.resourceGroupId) === String(res.resourceGroupId)) ||
                    (res.resourceGroup && g.resourceGroupName.toLowerCase() === res.resourceGroup.toLowerCase())
                );
                if (matchG) {
                    grpDdl.value = matchG.resourceGroupId;
                    state.activeResourceGroupFilter[iowId] = matchG.resourceGroupId;
                }
            }

            if (lblType) {
                lblType.innerText = res.type === 'Material' ? 'MT' : (res.type === 'Equipment' ? 'EQ' : (res.type === 'Labour' ? 'LB' : 'AC'));
            }
            if (txtUnit) {
                txtUnit.value = (res.unit && res.unit !== 'LS') ? res.unit : '';
            }
            if (txtRate) {
                txtRate.value = '';
            }
            calcNewResourceRowAmount(iowId);
            if (txtCoeff) {
                setTimeout(() => txtCoeff.focus(), 50);
            }
        }
    }

