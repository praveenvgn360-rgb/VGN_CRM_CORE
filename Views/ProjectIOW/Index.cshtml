    function initSpecificationSelect2($el, idVal, isEntry, initialVal) {
        if (!$el || !$el.length) return;
        if ($el.data('select2')) {
            $el.select2('destroy');
        }

        $el.select2({
            dropdownAutoWidth: true,
            width: '100%',
            placeholder: '-- Select or Search Specification --',
            tags: true,
            ajax: {
                transport: function (params, success, failure) {
                    var term = (params.data.q || '').trim().toLowerCase();
                    var page = params.data.page || 1;
                    var pageSize = 40;
                    var all = state.libraryIOWs || [];
                    var filtered = term ? all.filter(function (x) {
                        var spec = (x.specification || '').toLowerCase();
                        var code = (x.serialNo || x.code || '').toLowerCase();
                        return spec.indexOf(term) !== -1 || code.indexOf(term) !== -1;
                    }) : all;
                    var start = (page - 1) * pageSize;
                    var paged = filtered.slice(start, start + pageSize);
                    var items = paged.map(function (x) {
                        var code = (x.serialNo || x.code || '').trim();
                        var spec = (x.specification || '').trim();
                        var label = (code && code.toUpperCase() !== 'NEW') ? ('[' + code + '] ' + spec) : spec;
                        return {
                            id: spec,
                            text: label
                        };
                    });
                    if (page === 1) {
                        items.unshift({ id: '__new__', text: '+ Add New Specification...' });
                    }
                    success({
                        results: items,
                        pagination: { more: (start + pageSize) < filtered.length }
                    });
                },
                delay: 150
            },
            createTag: function (params) {
                var term = $.trim(params.term);
                if (term === '') return null;
                return {
                    id: term,
                    text: term + ' (New Specification)',
                    newTag: true
                };
            }
        }).off('select2:select').on('select2:select', function (e) {
            var selectedVal = e.target.value;
            handleSpecDropdownChange(idVal, selectedVal, isEntry);
        });

        if (initialVal && initialVal.trim()) {
            var hasOpt = $el.find('option').filter(function () { return $(this).val() === initialVal; }).length > 0;
            if (!hasOpt) {
                $el.empty().append(new Option(initialVal, initialVal, true, true)).val(initialVal);
            } else {
                $el.val(initialVal);
            }
        }
    }

    function initUnitSelect2($el, idVal, isEntry, initialVal) {
        if (!$el || !$el.length) return;
        if (initialVal && String(initialVal).trim()) {
            $el.val(String(initialVal).trim());
        }
    }

    function handleSpecDropdownChange(id, val, isEntryRow) {
        if (val === '__new__') {
            promptAddNewSpecification(id, isEntryRow);
            return;
        }

        if (isEntryRow) {
            var wgId = id;
            var match = (state.libraryIOWs || []).find(lib => 
                (lib.specification || '').trim().toLowerCase() === (val || '').trim().toLowerCase()
            );

            var spec = val || '';
            var unit = match ? ((match.unit && match.unit !== 'LS') ? match.unit : '') : '';
            var rate = match ? Number(match.defaultRate || match.rate || 0) : 0;
            var ref = match ? (match.serialNo || match.code || '').trim() : '';
            if (ref.toUpperCase() === 'NEW') ref = '';

            updateEntryRowData(wgId, 'specification', spec);
            if (unit) updateEntryRowData(wgId, 'unitId', unit);
            if (rate) updateEntryRowData(wgId, 'rate', rate);

            if (entryRowState[wgId]) {
                if (ref && (!entryRowState[wgId].refNo || entryRowState[wgId].refNo.trim() === '')) {
                    entryRowState[wgId].refNo = ref;
                    var refInp = document.getElementById("refInput_" + wgId);
                    if (refInp) refInp.value = ref;
                }
                entryRowState[wgId].isNewSpec = match ? (match.sourceTable === 'Project_IOWMas') : true;
                entryRowState[wgId].libraryIOWId = match ? (match.iowId || match.IOWId) : null;
                entryRowState[wgId].libraryWorkGroup = match ? (match.workGroupName || 'CIVIL WORKS') : 'CIVIL WORKS';
                entryRowState[wgId].librarySerialNo = match ? (match.serialNo || match.code) : '';
            }

            // Directly update input elements without losing UI state
            var unitSel = document.getElementById('unitSelect_' + wgId);
            if (unitSel && unit) {
                var hasOpt = $(unitSel).find('option').filter(function () { return $(this).val() === unit; }).length > 0;
                if (!hasOpt) {
                    $(unitSel).append(new Option(unit, unit, true, true));
                }
                unitSel.value = unit;
            }

            var rateInp = document.getElementById("rateInput_" + wgId);
            if (rateInp && rate) rateInp.value = cleanNum(rate);

            var q = parseFloat(entryRowState[wgId]?.qty) || 0;
            var r = parseFloat(entryRowState[wgId]?.rate) || 0;
            var amt = q * r;
            if (entryRowState[wgId]) entryRowState[wgId].amount = amt;
            var amtInp = document.getElementById("amountInput_" + wgId);
            if (amtInp) amtInp.value = cleanCurrency(amt);

        } else {
            var iowId = id;
            var it = state.items.find(i => i.iowId == iowId);
            if (it) {
                var match = (state.libraryIOWs || []).find(lib => 
                    (lib.specification || '').trim().toLowerCase() === (val || '').trim().toLowerCase()
                );
                it.specification = val;
                if (match) {
                    if (match.unit && match.unit !== 'LS') {
                        it.unitId = match.unit;
                        it.unitName = match.unit;
                        var itemUnitSel = document.getElementById('itemUnitSelect_' + iowId);
                        if (itemUnitSel) {
                            var hasOpt = $(itemUnitSel).find('option').filter(function () { return $(this).val() === match.unit; }).length > 0;
                            if (!hasOpt) {
                                $(itemUnitSel).append(new Option(match.unit, match.unit, true, true));
                            }
                            itemUnitSel.value = match.unit;
                        }
                    }
                    if (match.defaultRate || match.rate) it.rate = Number(match.defaultRate || match.rate);
                    it.isNewSpec = (match.sourceTable === 'Project_IOWMas');
                } else {
                    it.isNewSpec = true;
                }
                it.amount = (it.qty || 0) * (it.rate || 0);
                recalculateOverallProject();
                renderMainDataGrid();
            }
        }
    }

    function promptAddNewSpecification(id, isEntryRow) {
        Swal.fire({
            title: 'Add New Specification',
            input: 'text',
            inputLabel: 'Specification Description',
            inputPlaceholder: 'Enter new specification description...',
            showCancelButton: true,
            confirmButtonText: 'Add & Select',
            confirmButtonColor: '#059669',
            preConfirm: (value) => {
                if (!value || !value.trim()) {
                    Swal.showValidationMessage('Specification cannot be empty');
                }
                return value.trim();
            }
        }).then((result) => {
            if (result.isConfirmed && result.value) {
                var newSpec = result.value;
                var currentRef = isEntryRow ? (entryRowState[id]?.refNo || '') : '';
                currentRef = currentRef.trim();
                if (currentRef.toUpperCase() === 'NEW') currentRef = '';

                var currentUnit = isEntryRow ? (entryRowState[id]?.unitId || '') : '';
                var currentRate = isEntryRow ? (parseFloat(entryRowState[id]?.rate) || 0) : 0;
                var projId = $('#ddlProject').val() || '1';

                var newLib = {
                    iowId: Date.now(),
                    code: currentRef,
                    serialNo: currentRef,
                    workGroupName: 'CIVIL WORKS',
                    specification: newSpec,
                    unit: currentUnit,
                    unitId: currentUnit,
                    defaultRate: currentRate,
                    sourceTable: 'IOWMas'
                };
                state.libraryIOWs.unshift(newLib);
                if (typeof renderLibraryIOWTable === 'function') renderLibraryIOWTable();

                $.ajax({
                    url: '/ProjectIOW/SaveNewSpecification',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        CostcenterId: projId,
                        ProectKickOfId: projId,
                        WorkGroupId: isEntryRow ? String(id) : null,
                        RefNo: currentRef,
                        SerialNo: currentRef,
                        Specification: newSpec,
                        UnitId: currentUnit,
                        Rate: currentRate
                    })
                });

                renderMainDataGrid();
                handleSpecDropdownChange(id, newSpec, isEntryRow);

                Swal.fire({
                    icon: 'success',
                    title: 'Specification Added',
                    text: `"${newSpec}" was added & selected!`,
                    timer: 1600,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            } else {
                if (isEntryRow) {
                    var prev = entryRowState[id]?.specification || '';
                    var ddl = document.getElementById('specSelect_' + id);
                    if (ddl) ddl.value = prev;
                } else {
                    renderMainDataGrid();
                }
            }
        });
    }

