                        { wbsId: 4, wbsName: "3rd Floor", fullWBSName: "3rd Floor" },
                        { wbsId: 5, wbsName: "Demo WBS2", fullWBSName: "Demo Project->Demo WBS2" },
                        { wbsId: 6, wbsName: "Demo WBS4", fullWBSName: "Demo Project->Demo WBS4" },
                        { wbsId: 7, wbsName: "Demo WBS5", fullWBSName: "Demo Project->Demo WBS5" },
                        { wbsId: 8, wbsName: "Demo WBS6", fullWBSName: "Demo Project->Demo WBS6" },
                        { wbsId: 9, wbsName: "Retaining Wall", fullWBSName: "Demo Project->Retaining Wall" },
                        { wbsId: 10, wbsName: "test", fullWBSName: "Demo Project->test" }
