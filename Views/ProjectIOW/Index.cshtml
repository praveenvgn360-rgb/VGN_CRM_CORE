    function saveWBSMasterForm(e) {
        e.preventDefault();
        var nameInput = document.getElementById("txtWBSModalName");
        var parentSelect = document.getElementById("ddlWBSModalParent");
        var targetIOWInput = document.getElementById("txtWBSModalTargetIOW");
        var btnSubmit = document.getElementById("btnSaveWBSMasterSubmit");

        var wbsName = nameInput ? nameInput.value.trim() : '';
        var parentId = parentSelect ? parentSelect.value : '0';
        var targetIOWId = targetIOWInput ? targetIOWInput.value : '';

        if (!wbsName) {
            Swal.fire({ icon: 'warning', text: 'Please enter a WBS Name.' });
            return;
        }

        if (btnSubmit) {
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<i class="fas fa-spinner fa-spin text-[11px]"></i> Saving...';
        }

        fetch('@Url.Action("SaveNewWBSMaster", "ProjectIOW")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ WBSName: wbsName, ParentId: parentId })
        })
        .then(r => r.json())
        .then(res => {
            if (btnSubmit) {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i class="fas fa-save text-[11px]"></i> <span>Save to Master</span>';
            }

            if (res.success && res.data) {
                var newWbs = {
                    wbsId: res.data.wbsId,
                    wbsName: res.data.wbsName,
                    fullWBSName: res.data.fullWBSName || res.data.wbsName,
                    parentId: res.data.parentId
                };

                // Add to in-memory state.wbsList
                if (!state.wbsList.some(w => w.wbsId == newWbs.wbsId)) {
                    state.wbsList.push(newWbs);
                }

                closeWbsMasterModal();

                // If this was triggered from an active WBS input row, apply and select!
                if (targetIOWId) {
                    var item = state.items.find(i => i.iowId == targetIOWId);
                    if (item) {
                        renderWBSRows(item);
                        var ddlTarget = document.getElementById("ddlNewWBS_" + targetIOWId);
                        if (ddlTarget) {
                            ddlTarget.value = newWbs.wbsId;
                            $(ddlTarget).removeClass("wbs-name-error");
                        }
                        var qtyEl = document.getElementById("txtNewWBSQty_" + targetIOWId);
                        if (qtyEl) {
                            if (parseFloat(qtyEl.value) > 0) {
                                handleWBSCommit(targetIOWId);
                            } else {
                                qtyEl.focus();
                            }
                        }
                    }
                }

                Swal.fire({
                    icon: 'success',
                    title: 'WBS Master Created',
                    text: `"${newWbs.wbsName}" was saved in Master successfully.`,
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'Failed to save WBS to Master.' });
            }
        })
        .catch(err => {
            if (btnSubmit) {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i class="fas fa-save text-[11px]"></i> <span>Save to Master</span>';
            }
            console.error("SaveNewWBSMaster error:", err);
            Swal.fire({ icon: 'error', title: 'Error', text: err.message || 'Server connection error.' });
        });
    }

