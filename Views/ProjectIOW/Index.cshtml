    function updateWorkingQty(iowId, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it) return;
        it.workingQty = parseFloat(val) || 1.0;
        recalculateResourceRate(it);
    }

    function updateItemCalculation(iowId, field, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it) return;
        it[field] = parseFloat(val) || 0;
        recalculateResourceRate(it);
    }

    // STEP 14: Rate Calculation & Auto-synchronization to parent item row's Rate column
    function recalculateResourceRate(item) {
        var totalWeightage = (item.resources || []).reduce((acc, r) => acc + (parseFloat(r.weightagePct) || 0), 0);
        var baseTotal = (item.resources || []).reduce((acc, r) => acc + (r.incExc ? (parseFloat(r.amount) || 0) : 0), 0);

        item.totalWeightagePct = totalWeightage;
        item.baseTotal = baseTotal;

        var qual = parseFloat(item.qualifierValue) || 0;
        var grandTotal = baseTotal + qual;
        item.grandTotal = grandTotal;

        var workQty = parseFloat(item.workingQty) || 1.0;
        if (workQty <= 0) workQty = 1.0;

        var netRate = (grandTotal / workQty) + (parseFloat(item.roundingOff) || 0);
        item.netRate = netRate;

        // Auto-sync Net Rate to parent item row's Rate column!
        item.rate = netRate;
        item.amount = (item.qty || 0) * netRate;

        var lblWeight = document.getElementById("lblTotalWeightage_" + item.iowId);
        if (lblWeight) lblWeight.value = cleanNum(totalWeightage) + " %";

        var elBase = document.getElementById("calcBaseTotal_" + item.iowId);
        if (elBase) elBase.innerText = "₹ " + cleanCurrency(baseTotal);

        var elGrand = document.getElementById("calcGrandTotal_" + item.iowId);
        if (elGrand) elGrand.innerText = "₹ " + cleanCurrency(grandTotal);

        var elBaseRate = document.getElementById("calcBaseRate_" + item.iowId);
        if (elBaseRate) elBaseRate.innerText = "₹ " + cleanCurrency(baseTotal);

        var elIOWRate = document.getElementById("calcIOWRate_" + item.iowId);
        if (elIOWRate) elIOWRate.innerText = "₹ " + cleanCurrency(netRate);

        var elNet = document.getElementById("calcNetRate_" + item.iowId);
        if (elNet) elNet.innerText = "₹ " + cleanCurrency(netRate);

        $(`.item-rate-val-${item.iowId}`).val(cleanNum(netRate));
        $(`.item-amount-val-${item.iowId}`).text(cleanCurrency(item.amount));

        recalculateOverallProject();
    }

    // ── OVERALL TOTAL RECALCULATION ──
    function recalculateOverallProject() {
        var grandTotal = state.items.reduce((acc, it) => acc + (parseFloat(it.amount) || 0), 0);
        state.header.totalAmount = grandTotal;

        var formatted = cleanCurrency(grandTotal);
        var el = document.getElementById("lblGridTotalAmount");
        if (el) el.innerText = formatted;
    }

