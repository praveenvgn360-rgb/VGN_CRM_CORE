    function loadBOQGrid() {
        $.ajax({
            url: '/ProjectIOW/GetBOQList',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                if (res && res.success && res.data) {
                    boqMasterList = res.data;
                    if (boqGridInstance) {
                        boqGridInstance.option("dataSource", boqMasterList);
                        boqGridInstance.refresh();
                    }
                    updateBOQStats(boqMasterList);
                } else {
                    if (boqGridInstance) boqGridInstance.option("dataSource", []);
                    updateBOQStats([]);
                }
            },
            error: function () {
                if (boqGridInstance) boqGridInstance.option("dataSource", []);
                updateBOQStats([]);
            }
        });
    }

    function updateBOQStats(list) {
        var total = list.length;
        var totalVal = list.reduce(function (acc, x) { 
            var a = Number(x.totalAmount);
            return acc + (isNaN(a) ? 0 : a); 
        }, 0);
        var activeCount = list.filter(function (x) { return x.readyForApproval === '1' || x.readyForApproval === true; }).length;

        $('#badgeTotalBOQ').text(total + " BOQs");
        $('#statTotalBOQ').text(total);
        $('#statTotalValue').text("₹ " + totalVal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#statActiveBOQ').text(activeCount);
    }

    function switchToBOQList() {
        $('#viewBOQForm').hide();
        $('#viewBOQList').show();
        loadBOQGrid();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function switchToBOQForm() {
        $('#viewBOQList').hide();
        $('#viewBOQForm').show();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function fetchNextRefNo() {
        $.get('@Url.Action("GetNextRefNo", "ProjectIOW")', function (res) {
            if (res && res.success) {
                var nextNo = res.nextRefNo || 1;
                $('#txtReferenceNo').val(nextNo);
                state.header.referenceNo = String(nextNo);
            }
        }).fail(function () {
            $('#txtReferenceNo').val(1);
            state.header.referenceNo = '1';
        });
    }

    function openNewBOQForm() {
        state.editingBOQId = 0;
        $('#lblBOQFormTitle').text("Request for Creation - Project IOW Add");
        $('#badgeEditMode').addClass('hidden');

        // Reset form to clean state
        state.selectedWorkgroups = [];
        state.items = [];
        entryRowState = {};
        state.collapsedWorkgroups = {};

        // Requirements 1, 2, 4
        $('#txtReferenceDate').val('@ViewBag.CurrentDate');
        state.header.referenceDate = '@ViewBag.CurrentDate';
        fetchNextRefNo();
        $('#ddlType').val('Plan');
        $('#ddlRevision').val('No');
        $('#chkReadyForApproval').prop('checked', true);
        $('#txtMainRemarks').val('');

        var firstProjVal = $('#ddlProject option:first').val();
        if (firstProjVal) {
            $('#ddlProject').val(firstProjVal).trigger('change.select2');
        }

        recalculateOverallProject();
        renderMainDataGrid();

        switchToBOQForm();
    }

    function editBOQ(boqId) {
        if (!boqId) return;

        Swal.fire({
            title: 'Loading Bill of Quantity...',
            text: 'Fetching data for BOQ #' + boqId,
            allowOutsideClick: false,
            didOpen: function () {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: '/ProjectIOW/GetBOQById',
            type: 'GET',
            data: { id: boqId },
            dataType: 'json',
            success: function (res) {
                Swal.close();
                if (res && res.success && res.header) {
                    var h = res.header;
                    state.editingBOQId = h.boqId;

                    // Update Header inputs
                    $('#txtReferenceNo').val(h.referenceNo || '');
                    if (h.referenceDate) {
                        $('#txtReferenceDate').val(h.referenceDate);
                    }
                    if (h.projectKickoffId) {
                        $('#ddlProject').val(h.projectKickoffId).trigger('change.select2');
                    }
                    if (h.projectName) {
                        $('#txtProjectName').val(h.projectName);
                    }
                    if (h.type) {
                        $('#ddlType').val(h.type);
                    }
                    if (h.revision) {
                        $('#ddlRevision').val(h.revision);
                    }
                    $('#chkReadyForApproval').prop('checked', h.readyForApproval);
                    $('#txtMainRemarks').val(h.remarks || '');

                    // Update state header
                    state.header = {
                        boqId: h.boqId,
                        referenceDate: h.referenceDate || '',
                        referenceNo: h.referenceNo || '',
                        projectKickoffId: h.projectKickoffId || 1,
                        projectName: h.projectName || '',
                        costCentreId: h.costcenterId || '1',
                        type: h.type || 'Plan',
                        revision: h.revision || 'No',
                        readyForApproval: h.readyForApproval,
                        remarks: h.remarks || '',
                        totalAmount: h.totalAmount || 0.0
                    };

                    // Workgroups
                    state.selectedWorkgroups = [];
                    if (res.workgroups && res.workgroups.length > 0) {
                        res.workgroups.forEach(function (w) {
                            var existing = state.selectedWorkgroups.find(sw => sw.workGroupId == w.workGroupId);
                            if (!existing) {
                                state.selectedWorkgroups.push({
                                    workGroupId: w.workGroupId,
                                    parentId: w.parentId || '0',
                                    parentName: 'Root',
                                    serialNo: w.serialNo || w.workGroupId,
                                    workGroupName: w.workGroupName || ('WorkGroup ' + w.workGroupId),
                                    level: (w.parentId && w.parentId !== '0') ? 1 : 0
                                });
                            }
                        });
                    }

                    // Items with Measurement Sheets and child IDs mapped
                    state.items = (res.items || []).map(function (it, idx) {
                        var wbs = (it.wbsBreakdown || []).map(function (wb) {
                            return {
                                project_WBSId: wb.projectWBSId || 0,
                                wbsId: wb.wbsId,
                                wbsName: wb.wbsName,
                                fullWBSName: wb.fullWBSName || wb.wbsName,
                                qty: Number(wb.qty || 0)
                            };
                        });

                        var resources = (it.resources || []).map(function (r) {
                            return {
                                project_ResourceId: r.projectResourceId || r.resourceDetailId || 0,
                                resourceDetailId: r.resourceDetailId,
                                iowId: it.projectIOWId || it.iowId,
                                resourceCode: r.resourceCode || '',
                                resourceName: r.resourceName || '',
                                resourceId: r.resourceId,
                                incExc: r.incExc,
                                coefficient: Number(r.coefficient || 1.0),
                                unitId: r.unitId || '',
                                unit: r.unit || r.unitName || '',
                                rate: Number(r.rate || 0),
                                amount: Number(r.amount || 0),
                                weightagePct: Number(r.weightagePct || 0),
                                wastagePct: Number(r.wastagePct || 0)
                            };
                        });

                        var calcs = it.calculations || {};

                        var rawRef = (it.refNo != null) ? String(it.refNo).trim() : '';
                        var rawSerial = (it.serialNo != null) ? String(it.serialNo).trim() : '';
                        var wgObj = (res.workgroups || []).find(w => String(w.workGroupId) === String(it.workGroupId));
                        var wgPrefix = wgObj ? (wgObj.serialNo || wgObj.workGroupId || '1') : (it.workGroupId || '1');
                        var autoRef = wgPrefix + '.' + (idx + 1);
                        var finalRef = rawRef || rawSerial || autoRef;

                        return {
                            iowId: it.projectIOWId || it.iowId || (Date.now() + idx),
                            project_IOWId: it.projectIOWId || 0,
                            workGroupId: it.workGroupId || '1',
                            workGroupName: it.workGroupName || '',
                            refNo: finalRef,
                            serialNo: rawSerial || finalRef,
                            specification: it.specification || '',
                            shortSpec: it.specification ? (it.specification.length > 40 ? it.specification.substring(0, 40) + '...' : it.specification) : '',
                            unitId: it.unitId || '',
                            unitName: it.unitName || it.unitId || '',
                            qty: Number(it.qty || 1.0),
                            rate: Number(it.rate || 0.0),
                            amount: Number(it.amount || 0.0),
                            isNewSpec: false,
                            hasMeasurementSheet: it.hasMeasurementSheet === true,
                            isQtyLocked: it.isQtyLocked === true,
                            measurementSheet: it.measurementSheet || null,
                            wbsBreakdown: wbs,
                            resources: resources,
                            calculations: {
                                totalWeightagePct: Number(calcs.totalWeightagePct || 0),
                                wastageAmount: Number(calcs.wastageAmount || 0),
                                loadingUnloading: Number(calcs.loadingUnloading || 0),
                                handlingCharges: Number(calcs.handlingCharges || 0),
                                baseTotal: Number(calcs.baseTotal || 0),
                                qualifierValue: Number(calcs.qualifierValue || 0),
                                grandTotal: Number(calcs.grandTotal || 0),
                                roundingOff: Number(calcs.roundingOff || 0),
                                netRate: Number(calcs.netRate || it.rate || 0)
                            }
                        };
                    });

                    // Pre-populate entry rows for each workgroup with empty Ref No so user types it
                    entryRowState = {};
                    (state.selectedWorkgroups || []).forEach(function (sw) {
                        entryRowState[sw.workGroupId] = {
                            workGroupId: sw.workGroupId,
                            refNo: '', // Typeable, not automatic!
                            specification: '',
                            unitId: '',
                            unitName: '',
                            qty: '0',
                            rate: '',
                            amount: '0'
                        };
                    });

                    // Update UI labels & banners
                    $('#lblBOQFormTitle').text("Edit Bill of Quantity #" + h.boqId + " (" + (h.referenceNo ? "Ref: " + h.referenceNo : "") + ")");
                    $('#badgeEditMode').removeClass('hidden').text("Editing BOQ #" + h.boqId);

                    // Switch view & render
                    switchToBOQForm();
                    renderMainDataGrid();
                    recalculateOverallProject();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Load Failed',
                        text: (res && res.message) ? res.message : 'Could not fetch BOQ details.'
                    });
                }
            },
            error: function () {
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Network error fetching BOQ details.'
                });
            }
        });
    }

    function quickViewBOQ(boqId) {
        editBOQ(boqId);
    }

    function deleteBOQItem(boqId, refNo) {
        Swal.fire({
            title: 'Delete Bill of Quantity?',
            text: 'Are you sure you want to delete BOQ #' + boqId + (refNo ? ' (Ref: ' + refNo + ')' : '') + '? This action cannot be undone.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Yes, Delete'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/ProjectIOW/DeleteBOQ',
                    type: 'POST',
                    data: { id: boqId },
                    dataType: 'json',
                    success: function (res) {
                        if (res && res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: res.message || 'Bill of Quantity deleted successfully.',
                                timer: 1500,
                                showConfirmButton: false
                            });
                            loadBOQGrid();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Delete Failed',
                                text: (res && res.message) ? res.message : 'Error deleting BOQ.'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Network error deleting BOQ.'
                        });
                    }
                });
            }
        });
    }

    // ── INITIALIZATION ──
    document.addEventListener("DOMContentLoaded", function () {
        // Requirement 1: Reference Date is locked to today only. Calendar picker removed.
        $('#txtReferenceDate').val('@ViewBag.CurrentDate');
        state.header.referenceDate = '@ViewBag.CurrentDate';

        // Requirement 2: Fetch Next RefNo
        fetchNextRefNo();

        initDataLoad();
        initBOQGrid();
        loadBOQGrid();
    });

    // ── STEP 1: INITIAL DATA LOADING ──
    async function initDataLoad() {
        try {
            // 1. Projects Dropdown (Requirement 3: Searchable dropdown via Select2)
            fetch('@Url.Action("GetProjects", "ProjectIOW")')
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.data && res.data.length > 0) {
                        var ddl = document.getElementById("ddlProject");
                        if (ddl) {
                            ddl.innerHTML = "";
                            res.data.forEach(p => {
                                var pId = p.projectKickoffId || p.ProjectKickoffId || 1;
                                var pName = p.projectName || p.ProjectName || ('Project ' + pId);
                                var opt = document.createElement("option");
                                opt.value = pId;
                                opt.text = pName;
                                ddl.appendChild(opt);
                            });
                            state.header.projectKickoffId = ddl.value;
                            state.header.projectName = ddl.options[ddl.selectedIndex].text;
                            var txtP = document.getElementById("txtProjectName");
                            if (txtP) txtP.value = state.header.projectName;

                            // Initialize Select2 on ddlProject
                            $('#ddlProject').select2({
                                placeholder: '-- Select Project --',
                                width: '100%'
                            }).off('change select2:select').on('change select2:select', function () {
                                onProjectChange(this.value);
                            });
                        }
                    }
                });

            // 2. Workgroups Hierarchy Master
            fetch('@Url.Action("GetWorkgroups", "ProjectIOW")')
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.data) {
                        state.workgroups = res.data;
                        renderWorkgroupPickListTable();
                        renderMainDataGrid(); // STEP 2: Render initial empty grid
                    }
                });

            // 3. Library IOWs (dbo.IOWMas)
            fetch('@Url.Action("GetLibraryIOWs", "ProjectIOW")')
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.data) {
                        state.libraryIOWs = res.data;
                        renderLibraryIOWTable();
                        renderMainDataGrid();
                    }
                });

            // 4. Resources Master (dbo.ResourceMas)
            fetch('@Url.Action("GetResources", "ProjectIOW")')
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.data) {
                        state.resources = res.data;
                        renderResourcePickListTable();
                    }
                });

            // 4b. Resource Groups Master (dbo.ResourceGroupMas)
            fetch('@Url.Action("GetResourceGroups", "ProjectIOW")')
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.data) {
                        state.resourceGroups = res.data;
                        populateResourceGroupModalDropdown();
                        populateResourcePickListGroupFilter();
                    }
                });

            // 5. UOM Master (dbo.UOM)
            fetch('@Url.Action("GetUOMList", "ProjectIOW")')
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.data) {
                        state.uomList = res.data;
                    }
                });

            // 6. Project WBS List (dbo.Web_GetProjectWBSList)
            loadWBSListForProject(state.header.projectKickoffId || 1);

            // Render table immediately
            renderMainDataGrid();

        } catch (err) {
            console.error("Data load error:", err);
        }
    }

