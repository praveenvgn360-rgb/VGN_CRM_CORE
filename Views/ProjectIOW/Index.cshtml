                        </div>
                    </div>
                </td>
                <td class="py-1.5 px-2 text-right">
                    <input type="number" step="any" id="txtNewResCoeff_${item.iowId}" value="" placeholder="" onfocus="this.select()" oninput="calcNewResourceRowAmount(${item.iowId})" onkeydown="if (event.key === 'Enter') commitNewResourceRow(${item.iowId})" class="w-16 px-1 py-0.5 border border-slate-300 dark:border-slate-600 rounded text-right font-mono text-xs bg-white dark:bg-slate-700" />
