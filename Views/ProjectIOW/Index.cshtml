    // ── SYNC SAVED BOQ STATE — Background sync of database IDs for continuous editing ──
    function syncSavedBOQState(boqId, callback) {
        if (!boqId) return;
        $.ajax({
            url: '/ProjectIOW/GetBOQById',
            type: 'GET',
            data: { id: boqId },
            dataType: 'json',
            success: function (res) {
                if (res && res.success && res.header) {
                    state.editingBOQId = res.header.boqId;
                    if (res.header.totalAmount != null) {
                        state.header.totalAmount = res.header.totalAmount;
                    }

                    // Preserve open drawer state
                    var openDrawers = Object.assign({}, state.expandedIOWs || {});

                    if (res.items && res.items.length > 0) {
                        state.items = res.items.map(function (it, idx) {
                            var wbs = (it.wbsBreakdown || []).map(function (wb) {
                                return {
                                    project_WBSId: wb.projectWBSId || 0,
                                    wbsId: wb.wbsId,
                                    wbsName: wb.wbsName,
                                    fullWBSName: wb.fullWBSName || wb.wbsName,
                                    qty: Number(wb.qty || 0)
                                };
                            });

                            var resources = (it.resources || []).map(function (r) {
                                return {
                                    project_ResourceId: r.projectResourceId || r.resourceDetailId || 0,
                                    resourceDetailId: r.resourceDetailId,
                                    iowId: it.projectIOWId || it.iowId,
                                    resourceCode: r.resourceCode || '',
                                    resourceName: r.resourceName || '',
                                    resourceId: r.resourceId,
                                    incExc: r.incExc,
                                    coefficient: Number(r.coefficient || 1.0),
                                    unitId: r.unitId || '',
                                    unit: r.unit || r.unitName || '',
                                    rate: Number(r.rate || 0),
                                    amount: Number(r.amount || 0),
                                    weightagePct: Number(r.weightagePct || 0),
                                    wastagePct: Number(r.wastagePct || 0)
                                };
                            });

                            var calcs = it.calculations || {};

                            return {
                                iowId: it.projectIOWId || it.iowId || (Date.now() + idx),
                                project_IOWId: it.projectIOWId || 0,
                                workGroupId: it.workGroupId || '1',
                                workGroupName: it.workGroupName || '',
                                refNo: it.refNo || '',
                                serialNo: it.serialNo || it.refNo || '',
                                specification: it.specification || '',
                                shortSpec: it.specification ? (it.specification.length > 40 ? it.specification.substring(0, 40) + '...' : it.specification) : '',
                                unitId: it.unitId || '',
                                unitName: it.unitName || it.unitId || '',
                                qty: Number(it.qty || 1.0),
                                rate: Number(it.rate || 0.0),
                                amount: Number(it.amount || 0.0),
                                isNewSpec: false,
                                hasMeasurementSheet: it.hasMeasurementSheet === true,
                                isQtyLocked: it.isQtyLocked === true,
                                measurementSheet: it.measurementSheet || null,
                                wbsBreakdown: wbs,
                                resources: resources,
                                calculations: {
                                    totalWeightagePct: Number(calcs.totalWeightagePct || 0),
                                    wastageAmount: Number(calcs.wastageAmount || 0),
                                    loadingUnloading: Number(calcs.loadingUnloading || 0),
                                    handlingCharges: Number(calcs.handlingCharges || 0),
                                    baseTotal: Number(calcs.baseTotal || 0),
                                    qualifierValue: Number(calcs.qualifierValue || 0),
                                    grandTotal: Number(calcs.grandTotal || 0),
                                    roundingOff: Number(calcs.roundingOff || 0),
                                    netRate: Number(calcs.netRate || it.rate || 0)
                                }
                            };
                        });
                    }

                    state.expandedIOWs = openDrawers;
                    renderMainDataGrid();
                    recalculateOverallProject();

                    (state.selectedWorkgroups || []).forEach(function (sw) {
                        if (!entryRowState[sw.workGroupId]) {
                            entryRowState[sw.workGroupId] = {
                                workGroupId: sw.workGroupId,
                                refNo: '',
                                specification: '',
                                unitId: '',
                                unitName: '',
                                qty: '0',
                                rate: '',
                                amount: '0'
                            };
                        }
                    });

                    if (typeof callback === 'function') callback();
                }
            }
        });
    }

    // ── FINAL SAVE — SAVE TRANSACTIONALLY TO 4 TABLES & OUTPUT SUMMARY ──
    function submitProjectIOW() {
        var refDateVal = state.header.referenceDate || document.getElementById("txtReferenceDate").value;
        if (refDateVal) {
            var dateParts = refDateVal.split("-");
            if (dateParts.length === 3) {
                var chosenDate = new Date(parseInt(dateParts[2], 10), parseInt(dateParts[1], 10) - 1, parseInt(dateParts[0], 10));
                var todayDate = new Date();
                todayDate.setHours(23, 59, 59, 999);
                if (chosenDate > todayDate) {
                    Swal.fire({ icon: 'error', title: 'Invalid Reference Date', text: 'Future dates are not allowed for Reference Date.' });
                    return;
                }
            }
        }

        var headerRefNo = (document.getElementById("txtReferenceNo")?.value || state.header.referenceNo || "").trim();
        if (!headerRefNo) {
            Swal.fire({
                icon: 'warning',
                title: 'Reference No Required',
                text: 'Please enter a BOQ Reference No before saving. Empty Ref No is not allowed.',
                confirmButtonColor: '#0284c7'
            });
            $('#txtReferenceNo').focus();
            return;
        }

        // Auto-commit any pending entry row that has a specification filled in
        for (var i = 0; i < (state.selectedWorkgroups || []).length; i++) {
            var w = state.selectedWorkgroups[i];
            var pEntry = entryRowState[w.workGroupId];
            if (pEntry) {
                var inputVal = $('#specSelect_' + w.workGroupId).val() || '';
                if (inputVal && inputVal.trim() && inputVal !== '__new__') {
                    pEntry.specification = inputVal.trim();
                }
                var hasSpec = pEntry.specification && pEntry.specification.trim() !== '';
                if (hasSpec) {
                    var inputRef = ($('#refInput_' + w.workGroupId).val() || pEntry.refNo || '').toString().trim();
                    if (inputRef.toUpperCase() === 'NEW') inputRef = '';
                    if (!inputRef) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Empty Ref No Not Allowed',
                            text: 'Please enter a Reference No for the pending row in WorkGroup "' + (w.workGroupName || w.workGroupId) + '". Empty Ref No is not allowed.',
                            confirmButtonColor: '#0284c7'
                        });
                        $('#refInput_' + w.workGroupId).focus();
                        return;
                    }
                    pEntry.refNo = inputRef;
                    saveEntryRow(w.workGroupId);
                }
            }
        }

        if (!state.items || state.items.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'No Items Added',
                text: 'Please add at least one line item (specification) before saving.',
                confirmButtonColor: '#0284c7'
            });
            return;
        }

        // Strict Validation: Empty Ref No and Specification rows are not allowed to save
        for (var i = 0; i < state.items.length; i++) {
            var itm = state.items[i];
            var itmRef = (itm.refNo != null ? String(itm.refNo) : '').trim();
            if (itmRef.toUpperCase() === 'NEW') itmRef = '';
            var itmSpec = (itm.specification != null ? String(itm.specification) : '').trim();

            if (!itmRef) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Empty Ref No Not Allowed',
                    text: 'Item row #' + (i + 1) + ' (' + (itmSpec || 'Untitled') + ') has an empty Ref No. Empty Ref No and Specification rows are not allowed to save.',
                    confirmButtonColor: '#0284c7'
                });
                $('#itemRefBox_' + itm.iowId).addClass('ref-empty-error');
                $('#itemRefInput_' + itm.iowId).addClass('ref-empty-error').focus();
                return;
            }

            if (!itmSpec) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Empty Specification Not Allowed',
                    text: 'Item row #' + (i + 1) + ' (Ref No: ' + itmRef + ') has an empty Specification. Empty Ref No and Specification rows are not allowed to save.',
                    confirmButtonColor: '#0284c7'
                });
                $('#itemSpecSelect_' + itm.iowId).focus();
                return;
            }
        }

        var header = {
            BOQId: state.editingBOQId || 0,
            ReferenceDate: state.header.referenceDate || document.getElementById("txtReferenceDate").value,
            ReferenceNo: state.header.referenceNo || document.getElementById("txtReferenceNo").value,
            CostCentreId: document.getElementById("ddlProject")?.value || state.header.costCentreId || '1',
            ProjectKickoffId: state.header.projectKickoffId || document.getElementById("ddlProject")?.value || '1',
            ProjectName: state.header.projectName || $("#ddlProject option:selected").text(),
            Type: document.getElementById("ddlType").value,
            Revision: document.getElementById("ddlRevision").value,
            ReadyForApproval: document.getElementById("chkReadyForApproval").checked,
            Remarks: document.getElementById("txtMainRemarks").value,
            TotalAmount: Number(state.header.totalAmount) || 0,
            CreatedBy: 'Admin',
            CreatedDate: new Date().toISOString()
        };

        var fullPayload = {
            Header: header,
            WorkGroups: state.selectedWorkgroups.map(w => ({
                WorkGroupId: w.workGroupId != null ? String(w.workGroupId) : '',
                SerialNo: w.serialNo || '',
                WorkGroupName: w.workGroupName || '',
                ParentId: w.parentId ? String(w.parentId) : '0',
                ParentName: w.parentName || 'Root'
            })),
            Items: state.items.map(it => {
                var itRef = (it.refNo || '').toString().trim();
                if (itRef.toUpperCase() === 'NEW') itRef = '';
                var itSerial = (it.serialNo || itRef).toString().trim();
                if (itSerial.toUpperCase() === 'NEW') itSerial = '';

                var itQty = Number(it.qty) || 0;
                var itRate = Number(it.rate) || 0;
                var itAmount = Number(it.amount) || (itQty * itRate);

                var pIowId = it.project_IOWId || it.projectIOWId || 0;
                var hasSheet = it.hasMeasurementSheet === true || (it.measurementSheet != null);
                var isLocked = it.isQtyLocked === true || hasSheet;

                var sheetModel = null;
                if (it.measurementSheet) {
                    sheetModel = {
                        MeasurementSheetId: it.measurementSheet.measurementSheetId || 0,
                        BOQId: state.editingBOQId || 0,
                        Project_IOWId: pIowId,
                        Project_WBSId: 0,
                        TemplateId: it.measurementSheet.templateId || 0,
                        TemplateName: it.measurementSheet.templateName || '',
                        SelectedColumn: it.measurementSheet.selectedColumn || 'Qty',
                        SheetDataJson: typeof it.measurementSheet.sheetDataJson === 'string' ? it.measurementSheet.sheetDataJson : JSON.stringify(it.measurementSheet.sheetDataJson || []),
                        TotalQty: Number(it.measurementSheet.totalQty) || itQty
                    };
                }

                return {
                    Project_IOWId: pIowId,
                    IOWId: it.iowId || 0,
                    WorkGroupId: it.workGroupId != null ? String(it.workGroupId) : '',
                    WorkGroupName: it.workGroupName || '',
                    RefNo: itRef,
                    SerialNo: itSerial,
                    Specification: (it.specification || '').trim(),
                    Unit: it.unitId || 'LS',
                    UnitId: it.unitId || 'LS',
                    Qty: itQty,
                    Rate: itRate,
                    Amount: itAmount,
                    IsNewSpec: it.isNewSpec === true,
                    HasMeasurementSheet: hasSheet,
                    IsQtyLocked: isLocked,
                    MeasurementSheet: sheetModel,
                    WBSBreakdown: (it.wbsBreakdown || []).map(w => ({
                        Project_WBSId: w.project_WBSId || w.projectWBSId || 0,
                        WBSId: w.wbsId != null ? String(w.wbsId) : '0',
                        WBSName: w.wbsName || '',
                        FullWBSName: w.fullWBSName || w.wbsName || '',
                        Qty: Number(w.qty) || 0
                    })),
                    Resources: (it.resources || []).map(r => ({
                        Project_ResourceId: r.project_ResourceId || r.projectResourceId || r.resourceDetailId || 0,
                        ResourceId: r.resourceId != null ? String(r.resourceId) : '',
                        RefNo: r.refNo || '',
                        Type: r.type || 'AC',
                        ResourceCode: r.resourceCode || '',
                        ResourceName: r.resourceName || '',
                        IncExc: r.incExc !== false,
                        Coefficient: (r.coefficient != null && r.coefficient !== '') ? (Number(r.coefficient) || 0) : 0,
                        Unit: r.unitId || r.unit || 'LS',
                        UnitId: r.unitId || r.unit || 'LS',
                        Rate: Number(r.rate) || 0,
                        Amount: Number(r.amount) || 0,
                        WeightagePct: Number(r.weightagePct) || 0,
                        WastagePct: Number(r.wastagePct) || 0
                    })),
                    Calculations: {
                        TotalWeightagePct: Number(it.totalWeightagePct) || 0,
                        WastageAmount: Number(it.wastageAmount) || 0,
                        LoadingUnloading: Number(it.loadingUnloading) || 0,
                        HandlingCharges: Number(it.handlingCharges) || 0,
                        BaseTotal: Number(it.baseTotal) || 0,
                        QualifierValue: Number(it.qualifierValue) || 0,
                        GrandTotal: Number(it.grandTotal) || 0,
                        RoundingOff: Number(it.roundingOff) || 0,
                        NetRate: Number(it.netRate) || 0
                    }
                };
            }),
            MeasurementSheets: state.items.filter(it => it.measurementSheet).map(it => ({
                MeasurementSheetId: it.measurementSheet.measurementSheetId || 0,
                BOQId: state.editingBOQId || 0,
                Project_IOWId: it.project_IOWId || it.projectIOWId || 0,
                Project_WBSId: 0,
                TemplateId: it.measurementSheet.templateId || 0,
                TemplateName: it.measurementSheet.templateName || '',
                SelectedColumn: it.measurementSheet.selectedColumn || 'Qty',
                SheetDataJson: typeof it.measurementSheet.sheetDataJson === 'string' ? it.measurementSheet.sheetDataJson : JSON.stringify(it.measurementSheet.sheetDataJson || []),
                TotalQty: Number(it.measurementSheet.totalQty) || Number(it.qty) || 0
            }))
        };

        var jsonString = JSON.stringify(fullPayload, null, 2);
        var resCount = state.items.reduce((acc, i) => acc + (i.resources?.length || 0), 0);
        var formattedTotal = cleanCurrency(state.header.totalAmount || 0);

        var countEl = document.getElementById("payloadModalItemCount");
        var resEl = document.getElementById("payloadModalResCount");
        var amtEl = document.getElementById("payloadModalTotalAmount");
        var jsonEl = document.getElementById("txtThemedJsonContent");
        if (countEl) countEl.innerText = state.items.length;
        if (resEl) resEl.innerText = resCount;
        if (amtEl) amtEl.innerText = "₹ " + formattedTotal;
        if (jsonEl) jsonEl.innerText = jsonString;

        // UI Loading State on Save Button
        var btnSave = document.getElementById("btnMainSaveBOQ");
        var origHtml = btnSave ? btnSave.innerHTML : '';
        if (btnSave) {
            btnSave.disabled = true;
            btnSave.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i> <span>Saving...</span>';
        }

        $.ajax({
            url: '/ProjectIOW/Save',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: jsonString,
            success: function (res) {
                if (btnSave) {
                    btnSave.disabled = false;
                    btnSave.innerHTML = origHtml;
                }

                if (res.success) {
                    state.editingBOQId = res.boqId;
                    $('#lblBOQFormTitle').text("Edit Bill of Quantity #" + res.boqId + " (" + (header.ReferenceNo ? "Ref: " + header.ReferenceNo : "") + ")");
                    $('#badgeEditMode').removeClass('hidden').text("Editing BOQ #" + res.boqId);

                    // Update client items with returned saved item IDs immediately
                    if (res.savedItems && res.savedItems.length > 0) {
                        res.savedItems.forEach(function (sv) {
                            var match = (state.items || []).find(function (it) {
                                return (sv.clientIowId && it.iowId == sv.clientIowId) ||
                                       (it.refNo && String(it.refNo).trim() === String(sv.refNo).trim());
                            });
                            if (match) {
                                match.project_IOWId = sv.project_IOWId;
                                match.projectIOWId = sv.project_IOWId;
                                match.iowId = sv.project_IOWId;
                            }
                        });
                    }

                    // Background sync full state with database IDs for continuous editing
                    syncSavedBOQState(res.boqId);

                    Swal.fire({
                        icon: 'success',
                        title: 'Saved to Database!',
                        html: `
                            <div class="text-left text-xs space-y-2.5 p-2 bg-slate-50 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700">
                                <div class="flex justify-between items-center pb-2 border-b border-slate-200 dark:border-slate-700">
                                    <span class="font-bold text-emerald-600 dark:text-emerald-400 text-sm">BOQ #${res.boqId}</span>
                                    <span class="font-bold text-slate-800 dark:text-slate-100 text-sm">₹ ${cleanCurrency(res.totalAmount || state.header.totalAmount)}</span>
                                </div>
                                <div class="space-y-1 text-slate-600 dark:text-slate-300">
                                    <div class="flex items-center gap-1.5"><i class="fas fa-check text-emerald-500"></i> <b>Project_BOQ_Mas:</b> Master Header saved (${header.BOQId > 0 ? 'Updated' : 'Created'})</div>
                                    <div class="flex items-center gap-1.5"><i class="fas fa-check text-emerald-500"></i> <b>Project_BOQ_IOWMas:</b> ${res.itemCount} items saved</div>
                                    <div class="flex items-center gap-1.5"><i class="fas fa-check text-emerald-500"></i> <b>Project_BOQ_WBSMas:</b> ${res.wbsCount} WBS breakdowns saved</div>
                                    <div class="flex items-center gap-1.5"><i class="fas fa-check text-emerald-500"></i> <b>Project_BOQ_ResourceMas:</b> ${res.resourceCount} rate analysis resources saved</div>
                                </div>
                            </div>
                        `,
                        showCancelButton: true,
                        showDenyButton: true,
                        confirmButtonText: 'Back to BOQ List',
                        confirmButtonColor: '#0284c7',
                        cancelButtonText: 'Stay in Form',
                        cancelButtonColor: '#64748b',
                        denyButtonText: 'View JSON Payload',
                        denyButtonColor: '#8b5cf6'
                    }).then((r) => {
                        if (r.isConfirmed) {
                            switchToBOQList();
                        } else if (r.isDenied) {
                            var modalEl = document.getElementById("modalBOQJsonPayload");
                            if (modalEl) {
                                modalEl.style.display = "flex";
                                modalEl.classList.remove("hidden");
                            }
                        }
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Save Failed',
                        text: res.message || 'Unknown database error occurred.',
                        confirmButtonColor: '#ef4444'
                    });
                }
            },
            error: function (xhr) {
                if (btnSave) {
                    btnSave.disabled = false;
                    btnSave.innerHTML = origHtml;
                }
                var errMsg = 'Failed to communicate with server.';
                try {
                    var parsed = JSON.parse(xhr.responseText);
                    if (parsed && parsed.message) errMsg = parsed.message;
                } catch(e) {}
                Swal.fire({
                    icon: 'error',
                    title: 'Network / Server Error',
                    text: errMsg,
                    confirmButtonColor: '#ef4444'
                });
            }
        });
    }

