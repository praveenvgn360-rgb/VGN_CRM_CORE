<!-- ═══════════════════════════════════════════════════════════════════════
     MODAL: RESOURCE CALCULATION FORMULA & EXPLANATION (Change 8)
     ═══════════════════════════════════════════════════════════════════════ -->
<div id="modalCalculationFormulaOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-[1070] hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto" style="display: none;">
    <div class="relative w-full max-w-2xl bg-white dark:bg-slate-800 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-700 flex flex-col max-h-[85vh] my-auto overflow-hidden z-[1075]">
        <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center bg-gradient-to-r from-amber-500 to-amber-600 text-white flex-shrink-0">
            <div class="flex items-center gap-2">
                <i class="fas fa-calculator text-sm"></i>
                <h3 class="text-xs font-bold uppercase tracking-wider">Resource Rate Calculation & Formula Guide</h3>
            </div>
            <button onclick="closeCalculationFormulaModal()" type="button" class="w-6 h-6 flex items-center justify-center rounded-full text-white/80 hover:text-white hover:bg-white/10 transition cursor-pointer">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>

        <div class="p-4 overflow-y-auto space-y-3.5 text-xs text-slate-700 dark:text-slate-200 custom-scrollbar">
            <div class="p-3 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/50">
                <p class="font-semibold text-amber-900 dark:text-amber-200 mb-1">How Resource Calculation Works</p>
                <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                    Each Item of Work (IOW) calculates its final unit rate through a structured breakdown of constituent resources (materials, labour, equipment, and activities). Follow the sequence of formulas below:
                </p>
            </div>

            <!-- Formula 1: Resource Row Amount -->
            <div class="border border-slate-200 dark:border-slate-700 rounded-lg p-3 bg-white dark:bg-slate-850 space-y-1">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900 dark:text-slate-100">1. Individual Resource Amount</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200">Per Resource</span>
                </div>
                <div class="font-mono text-xs bg-slate-100 dark:bg-slate-900 p-2 rounded text-sky-700 dark:text-sky-300 font-bold">
                    Resource Amount = Coefficient × Unit Rate
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">
                    Calculated only if the resource toggle is set to <span class="text-emerald-600 font-semibold">Included</span>. Excluded resources are excluded from total amounts.
                </p>
            </div>

            <!-- Formula 2: Total Weightage -->
            <div class="border border-slate-200 dark:border-slate-700 rounded-lg p-3 bg-white dark:bg-slate-850 space-y-1">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900 dark:text-slate-100">2. Total Weightage %</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-200">Weightage</span>
                </div>
                <div class="font-mono text-xs bg-slate-100 dark:bg-slate-900 p-2 rounded text-teal-700 dark:text-teal-300 font-bold">
                    Total Weightage % = Σ (Individual Resource Weightage %)
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">
                    Represents the combined percentage allocation of all assigned resources.
                </p>
            </div>

            <!-- Formula 3: Base Total -->
            <div class="border border-slate-200 dark:border-slate-700 rounded-lg p-3 bg-white dark:bg-slate-850 space-y-1">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900 dark:text-slate-100">3. Base Total</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200">Subtotal</span>
                </div>
                <div class="font-mono text-xs bg-slate-100 dark:bg-slate-900 p-2 rounded text-indigo-700 dark:text-indigo-300 font-bold">
                    Base Total = Σ (All Included Resource Amounts)
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">
                    The sum of amounts for all active resources before qualifiers and adjustments.
                </p>
            </div>

            <!-- Formula 4: Grand Total -->
            <div class="border border-slate-200 dark:border-slate-700 rounded-lg p-3 bg-white dark:bg-slate-850 space-y-1">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900 dark:text-slate-100">4. Grand Total</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200">Adjusted Total</span>
                </div>
                <div class="font-mono text-xs bg-slate-100 dark:bg-slate-900 p-2 rounded text-purple-700 dark:text-purple-300 font-bold">
                    Grand Total = Base Total + Qualifier Value + Wastage Amount
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">
                    Includes taxes, qualifiers, and site wastage surcharges.
                </p>
            </div>

            <!-- Formula 5: Net Rate (Unit Rate) -->
            <div class="border border-slate-200 dark:border-slate-700 rounded-lg p-3 bg-white dark:bg-slate-850 space-y-1">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900 dark:text-slate-100">5. Net Rate (IOW Unit Rate)</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200">Unit Rate</span>
                </div>
                <div class="font-mono text-xs bg-slate-100 dark:bg-slate-900 p-2 rounded text-emerald-700 dark:text-emerald-300 font-bold">
                    Net Rate = (Grand Total ÷ Working Qty) + Rounding Off
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">
                    The derived unit rate that is automatically synchronized back to the main BOQ table's Rate column.
                </p>
            </div>

            <!-- Formula 6: BOQ Total Amount -->
            <div class="border border-slate-200 dark:border-slate-700 rounded-lg p-3 bg-white dark:bg-slate-850 space-y-1">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900 dark:text-slate-100">6. Total BOQ Item Amount</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">Line Amount</span>
                </div>
                <div class="font-mono text-xs bg-slate-100 dark:bg-slate-900 p-2 rounded text-blue-700 dark:text-blue-300 font-bold">
                    Amount = IOW Quantity × Net Rate
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">
                    Calculated for the IOW line item and added to the project's overall Total Amount.
                </p>
            </div>
        </div>

        <div class="px-4 py-2.5 bg-slate-50 dark:bg-slate-800/80 border-t border-slate-100 dark:border-slate-700 text-right">
            <button type="button" onclick="closeCalculationFormulaModal()" class="px-4 py-1.5 rounded-lg text-xs font-bold bg-slate-700 hover:bg-slate-800 text-white transition cursor-pointer">
                Close Help
            </button>
        </div>
    </div>
</div>

