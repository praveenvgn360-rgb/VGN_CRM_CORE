    function toggleResourceIncExc(iowId, idx, isChecked) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it || !it.resources[idx]) return;
        it.resources[idx].incExc = isChecked;
        it.resources[idx].amount = isChecked ? ((it.resources[idx].coefficient != null ? it.resources[idx].coefficient : 0) * (it.resources[idx].rate || 0)) : 0;
        renderCompactResourceTable(it);
        recalculateResourceRate(it);
    }

    function updateResourceWeightage(iowId, idx, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it || !it.resources[idx]) return;
        it.resources[idx].weightagePct = parseFloat(val) || 0;
        recalculateResourceRate(it);
    }

    function updateResourceCoeff(iowId, idx, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it || !it.resources[idx]) return;
        var c = parseFloat(val);
        it.resources[idx].coefficient = isNaN(c) ? null : c;
        var amt = (it.resources[idx].coefficient != null ? it.resources[idx].coefficient : 0) * (it.resources[idx].rate || 0);
        if (it.resources[idx].incExc) it.resources[idx].amount = amt;
        var cellAmt = document.getElementById("resRowAmt_" + iowId + "_" + idx);
        if (cellAmt) cellAmt.innerText = amt > 0 ? ('₹ ' + cleanCurrency(amt)) : '';
        recalculateResourceRate(it);
    }

    function updateResourceRateDirect(iowId, idx, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it || !it.resources[idx]) return;
        var r = parseFloat(val);
        it.resources[idx].rate = isNaN(r) ? 0 : r;
        var amt = (it.resources[idx].coefficient != null ? it.resources[idx].coefficient : 0) * it.resources[idx].rate;
        if (it.resources[idx].incExc) it.resources[idx].amount = amt;
        var cellAmt = document.getElementById("resRowAmt_" + iowId + "_" + idx);
        if (cellAmt) cellAmt.innerText = amt > 0 ? ('₹ ' + cleanCurrency(amt)) : '';
        recalculateResourceRate(it);
    }

    function deleteResourceRow(iowId, idx) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it) return;
        it.resources.splice(idx, 1);
        renderCompactResourceTable(it);
        recalculateResourceRate(it);
    }

    // ── RESOURCE NORMAL DROPDOWN COMMIT & HELPERS ──
    function calcNewResourceRowAmount(iowId) {
        var coeff = parseFloat(document.getElementById("txtNewResCoeff_" + iowId)?.value) || 0;
        var rate = parseFloat(document.getElementById("txtNewResRate_" + iowId)?.value) || 0;
        var amtEl = document.getElementById("lblNewResAmount_" + iowId);
        if (amtEl) {
            if (coeff > 0 && rate > 0) {
                amtEl.innerText = "₹ " + cleanCurrency(coeff * rate);
            } else {
                amtEl.innerText = "";
            }
        }
    }

    function selectResourceFromAutocomplete(res, iowId) {
        if (!res || !iowId) return;
        var ddlGroup = document.getElementById("ddlNewResourceGroup_" + iowId);
        if (ddlGroup && res.resourceGroupId) {
            ddlGroup.value = res.resourceGroupId;
            state.activeResourceGroupFilter = state.activeResourceGroupFilter || {};
            state.activeResourceGroupFilter[iowId] = res.resourceGroupId;
            var ddlRes = document.getElementById("ddlNewResource_" + iowId);
            if (ddlRes) {
                ddlRes.innerHTML = getResourceOptionsHtml(res.code || res.resourceId, res.resourceGroupId);
            }
        }
        var ddlRes = document.getElementById("ddlNewResource_" + iowId);
        if (ddlRes) {
            ddlRes.value = res.code || res.resourceId || '';
            onResourceDropdownChange(iowId, ddlRes.value);
        }
    }

    function commitNewResourceRow(iowId) {
        var ddlRes = document.getElementById("ddlNewResource_" + iowId);
        var txtCoeff = document.getElementById("txtNewResCoeff_" + iowId);
        var txtUnit = document.getElementById("txtNewResUnit_" + iowId);
        var txtRate = document.getElementById("txtNewResRate_" + iowId);
        var txtWeight = document.getElementById("txtNewResWeightage_" + iowId);

        if (!ddlRes) return;
        var val = ddlRes.value;
        if (!val || val === '__new__') {
            return;
        }

        var resMatch = (state.resources || []).find(r => 
            String(r.code) === String(val) || String(r.resourceId) === String(val)
        );

        var item = state.items.find(i => i.iowId == iowId);
        if (!item) return;
        if (!item.resources) item.resources = [];

        var coeffRaw = txtCoeff?.value.trim();
        var coeffVal = coeffRaw !== '' && !isNaN(parseFloat(coeffRaw)) ? parseFloat(coeffRaw) : null;
        var rateRaw = txtRate?.value.trim();
        var rateVal = (rateRaw !== '' && !isNaN(parseFloat(rateRaw))) ? parseFloat(rateRaw) : 0;
        var unitVal = txtUnit?.value.trim() || ((resMatch && resMatch.unit !== 'LS') ? resMatch.unit : '') || '';
        var weightVal = parseFloat(txtWeight?.value) || 0;

        var nextRefNo = 'C' + (item.resources.length + 1);
        var finalAmount = coeffVal != null ? (coeffVal * rateVal) : 0;

        var rType = resMatch ? resMatch.type : 'Activity';
        var typeCode = rType === 'Material' ? 'MT' : (rType === 'Equipment' ? 'EQ' : (rType === 'Labour' ? 'LB' : 'AC'));
        var resName = resMatch ? (resMatch.code + ' ' + resMatch.resourceName) : val;

        item.resources.push({
            resourceDetailId: Date.now() + Math.random(),
            incExc: true,
            refNo: nextRefNo,
            type: typeCode,
            resourceId: resMatch ? resMatch.resourceId : 0,
            resourceCode: resMatch ? resMatch.code : '',
            resourceName: resName,
            resourceGroupId: resMatch ? (resMatch.resourceGroupId || '') : '',
            resourceGroup: resMatch ? (resMatch.resourceGroup || '') : '',
            coefficient: coeffVal,
            unitId: unitVal,
            rate: rateVal,
            amount: finalAmount,
            weightagePct: weightVal,
            wastagePct: 0.0
        });

        renderCompactResourceTable(item);
        recalculateResourceRate(item);
        setTimeout(() => {
            var rCont = document.getElementById("resourceTableContainer_" + item.iowId);
            if (rCont) rCont.scrollTop = rCont.scrollHeight;
        }, 50);
    }

