    // ── STEP 3 — WORK GROUP SELECTION LOGIC (img-3 & img-4) ──
    function openWorkgroupPickListModal() {
        renderWorkgroupPickListTable();
        document.getElementById("modalWorkgroupOverlay").style.display = "flex";
        document.getElementById("modalWorkgroupOverlay").classList.remove("hidden");
    }

    function closeWorkgroupPickListModal() {
        document.getElementById("modalWorkgroupOverlay").style.display = "none";
        document.getElementById("modalWorkgroupOverlay").classList.add("hidden");
    }

    function toggleWorkGroupCollapse(wgId) {
        state.collapsedWorkgroups[wgId] = !state.collapsedWorkgroups[wgId];
        renderMainDataGrid();
    }

    function getParentWorkgroup(wg) {
        if (!wg) return null;
        var pId = wg.parentId;
        if (pId && pId !== '0' && pId !== 0 && String(pId).trim() !== '') {
            var byId = state.workgroups.find(w => String(w.workGroupId) === String(pId));
            if (byId) return byId;
            var bySerial = state.workgroups.find(w => w.serialNo === String(pId));
            if (bySerial) return bySerial;
        }
        if (wg.serialNo && String(wg.serialNo).includes('.')) {
            var parts = String(wg.serialNo).split('.');
            parts.pop();
            var parentSerial = parts.join('.');
            var bySerialDot = state.workgroups.find(w => w.serialNo === parentSerial);
            if (bySerialDot) return bySerialDot;
        }
        return null;
    }

    function getAncestorsAndSelf(targetWg) {
        if (!targetWg) return [];
        var chain = [targetWg];
        var curr = targetWg;
        var loopGuard = 0;
        while (curr && loopGuard < 20) {
            loopGuard++;
            var parent = getParentWorkgroup(curr);
            if (parent && !chain.some(c => c.workGroupId == parent.workGroupId)) {
                chain.unshift(parent); // Top-down order: [Parent, Child]
                curr = parent;
            } else {
                break;
            }
        }
        return chain;
    }

    function renderWorkgroupPickListTable(keyword) {
        var tbody = document.getElementById("tblWorkgroupPickListBody");
        if (!tbody) return;
        tbody.innerHTML = "";

        var filtered = state.workgroups;
        if (keyword) {
            filtered = state.workgroups.filter(w => w.workGroupName.toLowerCase().includes(keyword.toLowerCase()) || w.serialNo.includes(keyword));
        }

        function getDirectChildren(pId) {
            var pWg = filtered.find(w => w.workGroupId == pId);
            return filtered.filter(w => {
                if (w.workGroupId == pId) return false;
                if (String(w.parentId) === String(pId)) return true;
                if (pWg && pWg.serialNo && w.serialNo && String(w.serialNo).startsWith(String(pWg.serialNo) + '.')) {
                    var pDots = (String(pWg.serialNo).match(/\./g) || []).length;
                    var wDots = (String(w.serialNo).match(/\./g) || []).length;
                    return wDots === pDots + 1;
                }
                return false;
            }).sort((a, b) => String(a.serialNo || '').localeCompare(String(b.serialNo || ''), undefined, { numeric: true, sensitivity: 'base' }));
        }

        function renderNode(node, level, parentChainIds) {
            var children = getDirectChildren(node.workGroupId);
            var hasChildren = children.length > 0;
            var isSelected = (state.selectedWorkgroupRadioId == node.workGroupId);

            var tr = document.createElement("tr");
            var childClasses = parentChainIds.map(p => `wg-child-of-${p}`).join(' ');
            tr.className = `hover:bg-sky-50/70 dark:hover:bg-slate-700/60 transition cursor-pointer ${childClasses} ${isSelected ? 'highlight-green' : ''}`;
            tr.dataset.wgId = node.workGroupId;

            var padLeft = 12 + (level * 20);
            tr.style.display = (level === 0) ? "table-row" : "none";

            tr.onclick = function (e) {
                if (e.target.tagName !== 'BUTTON' && e.target.tagName !== 'I') {
                    onWgRadioSelect(node.workGroupId);
                }
            };

            var titleWeight = (level === 0) ? "font-bold text-slate-800 dark:text-slate-200" : "font-semibold text-slate-700 dark:text-slate-300";

            tr.innerHTML = `
                <td class="py-2 px-3" style="padding-left: ${padLeft}px;">
                    <div class="flex items-center gap-2">
                        ${hasChildren ? `<i class="fas fa-caret-right wg-caret-${node.workGroupId} text-sky-600 text-xs cursor-pointer p-1" onclick="event.stopPropagation(); toggleWgNodeChildren(this, '${node.workGroupId}')"></i>` : `<span class="w-3 inline-block"></span>`}
                        <input type="radio" name="wgSelectRadio" value="${node.workGroupId}" ${isSelected ? 'checked' : ''} onchange="onWgRadioSelect(${node.workGroupId})" class="wg-radio w-3.5 h-3.5 text-sky-600 focus:ring-sky-500 border-slate-300 cursor-pointer" />
                        <span class="${titleWeight}">${node.serialNo}</span>
                    </div>
                </td>
                <td class="py-2 px-3 ${titleWeight}">${node.workGroupName}</td>
                <td class="py-2 px-3 text-center">
                    <button type="button" onclick="event.stopPropagation(); selectWorkGroupWithHierarchy(${node.workGroupId})" class="w-5 h-5 rounded bg-sky-500 hover:bg-sky-600 text-white inline-flex items-center justify-center text-xs shadow-2xs" title="Select WorkGroup">
                        <i class="fas fa-plus"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);

            if (hasChildren) {
                var nextChain = parentChainIds.concat([node.workGroupId]);
                children.forEach(c => renderNode(c, level + 1, nextChain));
            }
        }

        var roots = filtered.filter(w => {
            if (!w.parentId || w.parentId === '0' || w.parentId === 0 || String(w.parentId).trim() === '') {
                if (w.serialNo && String(w.serialNo).includes('.')) {
                    var parts = String(w.serialNo).split('.');
                    parts.pop();
                    var pSerial = parts.join('.');
                    if (filtered.some(other => other.serialNo === pSerial)) return false;
                }
                return true;
            }
            if (filtered.some(other => String(other.workGroupId) === String(w.parentId))) return false;
            return true;
        }).sort((a, b) => String(a.serialNo || '').localeCompare(String(b.serialNo || ''), undefined, { numeric: true, sensitivity: 'base' }));

        roots.forEach(root => renderNode(root, 0, []));
    }

    function onWgRadioSelect(wgId) {
        state.selectedWorkgroupRadioId = wgId;
        var tbody = document.getElementById("tblWorkgroupPickListBody");
        if (!tbody) return;

        tbody.querySelectorAll("tr").forEach(r => r.classList.remove("highlight-green"));
        tbody.querySelectorAll(".wg-radio").forEach(r => {
            if (r.value == wgId) {
                r.checked = true;
                var tr = r.closest("tr");
                if (tr) tr.classList.add("highlight-green");
            } else {
                r.checked = false;
            }
        });
    }

    function toggleWgNodeChildren(icon, parentId) {
        var isExpanding = icon.classList.contains("fa-caret-right");
        var childRows = document.querySelectorAll(`.wg-child-of-${parentId}`);

        if (isExpanding) {
            icon.classList.remove("fa-caret-right");
            icon.classList.add("fa-caret-down");
            childRows.forEach(r => r.style.display = 'table-row');
        } else {
            icon.classList.remove("fa-caret-down");
            icon.classList.add("fa-caret-right");
            childRows.forEach(r => r.style.display = 'none');
        }
    }

    function toggleExpandAllWorkgroups() {
        var anyHidden = false;
        document.querySelectorAll("[class*='wg-child-of-']").forEach(r => {
            if (r.style.display === 'none') anyHidden = true;
        });
        document.querySelectorAll("[class*='wg-child-of-']").forEach(r => {
            r.style.display = anyHidden ? 'table-row' : 'none';
        });
        document.querySelectorAll("[class*='wg-caret-']").forEach(icon => {
            if (anyHidden) {
                icon.classList.remove("fa-caret-right");
                icon.classList.add("fa-caret-down");
            } else {
                icon.classList.remove("fa-caret-down");
                icon.classList.add("fa-caret-right");
            }
        });
    }

    function selectWorkGroupWithHierarchy(wgId) {
        var selected = state.workgroups.find(w => w.workGroupId == wgId);
        if (!selected) return;

        state.selectedWorkgroupRadioId = wgId;
        var chain = getAncestorsAndSelf(selected);

        state.selectedWorkgroups = chain;

        var leafWg = chain[chain.length - 1];
        if (!entryRowState[leafWg.workGroupId]) {
            entryRowState[leafWg.workGroupId] = {
                workGroupId: leafWg.workGroupId,
                refNo: '',
                specification: '',
                unitId: 'LS',
                qty: '',
                rate: '',
                amount: ''
            };
        }

        closeWorkgroupPickListModal();
        renderMainDataGrid();
    }

    function applySelectedWorkgroups() {
        if (!state.selectedWorkgroupRadioId) {
            Swal.fire({ icon: 'info', text: 'Please select a workgroup from the list.' });
            return;
        }
        selectWorkGroupWithHierarchy(state.selectedWorkgroupRadioId);
    }

    function deleteWorkGroup(wgId) {
        state.selectedWorkgroups = state.selectedWorkgroups.filter(w => w.workGroupId != wgId);
        state.items = state.items.filter(i => i.workGroupId != wgId);
        delete entryRowState[wgId];
        delete state.collapsedWorkgroups[wgId];
        recalculateOverallProject();
        renderMainDataGrid();
    }

    // ── STEP 4 & 6 — REFNO HANDLING & LIBRARY VALIDATION (img-4, img-5, img-6) ──
    function handleRefNoInput(wgId, val) {
        if (!entryRowState[wgId]) entryRowState[wgId] = { workGroupId: wgId };
        entryRowState[wgId].refNo = val;

        // Clear error highlight when user starts typing RefNo
        $(`#refInput_${wgId}`).removeClass("ref-empty-error");
        $(`#refBox_${wgId}`).removeClass("ref-empty-error");
        $(`#refInput_${wgId}`).closest(".grid-cell-box").removeClass("ref-empty-error");

        if (!val || val.trim().length === 0) return;

        // Check if entered RefNo matches an existing library item in dbo.IOWMas
        var cleanVal = val.trim().toLowerCase();
        var match = (state.libraryIOWs || []).find(lib => 
            (lib.serialNo && String(lib.serialNo).toLowerCase() === cleanVal) ||
            (lib.code && String(lib.code).toLowerCase() === cleanVal)
        );

        if (match) {
            // Auto-load Specification, Unit, Rate from dbo.IOWMas library!
            var spec = match.specification || '';
            var unit = match.unit || 'LS';
            var rate = Number(match.defaultRate || match.rate || 0);

            updateEntryRowData(wgId, 'specification', spec);
            updateEntryRowData(wgId, 'unitId', unit);
            updateEntryRowData(wgId, 'rate', rate);

            if (entryRowState[wgId]) {
                entryRowState[wgId].isNewSpec = false;
                entryRowState[wgId].libraryIOWId = match.iowId || match.IOWId;
                entryRowState[wgId].libraryWorkGroup = match.workGroupName || 'CIVIL WORKS';
                entryRowState[wgId].librarySerialNo = match.serialNo || match.code;
            }

            // Directly update input elements in DOM without full grid re-render (preserves focus!)
            $(`#specInput_${wgId}`).val(spec);
            $(`#unitSelect_${wgId}`).val(unit);
            $(`#rateInput_${wgId}`).val(rate === 0 ? '0' : cleanNum(rate));

            var q = parseFloat(entryRowState[wgId].qty) || 0;
            var amt = q * rate;
            entryRowState[wgId].amount = amt;
            $(`#amountInput_${wgId}`).val(cleanCurrency(amt));
        }
    }

    function validateAndApplyRefNo(wgId, val) {
        if (!val || val.trim() === '') return;

        var cleanVal = val.trim().toLowerCase();
        var match = (state.libraryIOWs || []).find(lib => 
            (lib.serialNo && String(lib.serialNo).toLowerCase() === cleanVal) ||
            (lib.code && String(lib.code).toLowerCase() === cleanVal)
        );

        if (match) {
            handleRefNoInput(wgId, val);
            $(`#specInput_${wgId}`).focus();
        }
    }

    function handleRefNoBlur(wgId, val) {
        if (val && val.trim() !== '') {
            validateAndApplyRefNo(wgId, val);
        }
    }

    // Specification handling with library autocomplete from IOWMas & Project_IOWMas
    function handleSpecInput(inputEl, workGroupId, iowId, isEntryRow) {
        state.activeSpecContext = { workGroupId: workGroupId, iowId: iowId, isEntryRow: isEntryRow, inputEl: inputEl };
        var q = $(inputEl).val() || '';

        if (isEntryRow) {
            updateEntryRowData(workGroupId, 'specification', q);

            var match = (state.libraryIOWs || []).find(lib => 
                (lib.specification || '').trim().toLowerCase() === q.trim().toLowerCase()
            );

            if (match) {
                entryRowState[workGroupId].isNewSpec = (match.sourceTable === 'Project_IOWMas');
                entryRowState[workGroupId].libraryIOWId = match.iowId || match.IOWId;
                entryRowState[workGroupId].libraryWorkGroup = match.workGroupName || 'CIVIL WORKS';
                entryRowState[workGroupId].librarySerialNo = match.serialNo || match.code;
            } else {
                entryRowState[workGroupId].isNewSpec = true;
                entryRowState[workGroupId].libraryIOWId = null;
                entryRowState[workGroupId].libraryWorkGroup = 'CIVIL WORKS';
                entryRowState[workGroupId].librarySerialNo = entryRowState[workGroupId].refNo || '';
            }
        }

        if (q.trim().length === 0) {
            showSpecAutocomplete(state.libraryIOWs.slice(0, 15), inputEl, "");
            return;
        }

        var matches = state.libraryIOWs.filter(lib => {
            return (lib.specification && lib.specification.toLowerCase().includes(q.toLowerCase())) ||
                   (lib.serialNo && lib.serialNo.toLowerCase().includes(q.toLowerCase())) ||
                   (lib.code && lib.code.toLowerCase().includes(q.toLowerCase()));
        });

        showSpecAutocomplete(matches, inputEl, q);
    }

    function handleSpecBlur(wgId) {
        setTimeout(function () {
            hideSpecAutocomplete();
        }, 250);
    }

    function showSpecAutocomplete(matches, anchorEl, q) {
        var dropdown = $("#specAutocompleteDropdown");
        var itemsContainer = $("#specAutocompleteItems");
        itemsContainer.empty();

        var rect = anchorEl.getBoundingClientRect();
        dropdown.css({
            top: (rect.bottom + 2) + "px",
            left: rect.left + "px",
            width: Math.max(rect.width, 560) + "px"
        });

        q = (q || '').trim();

        // 1. Render matches
        if (matches && matches.length > 0) {
            matches.slice(0, 12).forEach((m, idx) => {
                var code = m.serialNo || m.code || '';
                var isProjectIOW = (m.sourceTable === 'Project_IOWMas');
                var tagBadge = isProjectIOW 
                    ? `<span class="text-[9px] px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 font-bold uppercase tracking-wider">Project_IOWMas</span>`
                    : `<span class="text-[9px] px-1.5 py-0.5 rounded bg-sky-100 dark:bg-sky-950/80 text-sky-700 dark:text-sky-300 font-bold uppercase tracking-wider">IOWMas</span>`;

                var itemEl = $(`
                    <div class="spec-dropdown-item px-3 py-1.5 hover:bg-sky-50 dark:hover:bg-slate-700 cursor-pointer flex items-center justify-between text-xs transition" data-idx="${idx}">
                        <div class="font-medium text-slate-800 dark:text-slate-200 flex-1 pr-2 truncate">
                            <span class="font-bold text-sky-700 dark:text-sky-300 mr-1.5">${code}</span>
                            <span>${m.specification}</span>
                        </div>
                        <div class="text-[11px] text-slate-500 flex items-center gap-2 flex-shrink-0">
                            ${tagBadge}
                            <span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold">${m.unit || 'LS'}</span>
                            <span class="font-mono font-bold text-emerald-600">₹ ${cleanCurrency(m.defaultRate)}</span>
                        </div>
                    </div>
                `);

                itemEl.on("mousedown", function (e) {
                    e.preventDefault();
                    selectLibrarySpecification(m);
                });
                itemsContainer.append(itemEl);
            });
        }

        // 2. "+ Add New Specification to Project_IOWMas" Option
        var exactMatch = state.libraryIOWs.some(lib => (lib.specification || '').trim().toLowerCase() === q.toLowerCase());
        if (q.length > 0 && !exactMatch) {
            var addEl = $(`
                <div class="px-3 py-2 bg-emerald-50 dark:bg-slate-800/90 border-t border-emerald-200 dark:border-slate-700 flex items-center justify-between hover:bg-emerald-100 dark:hover:bg-slate-700 cursor-pointer text-xs transition">
                    <div class="flex items-center gap-2">
                        <span class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center text-[10px] font-bold"><i class="fas fa-plus"></i></span>
                        <div>
                            <span class="font-bold text-emerald-800 dark:text-emerald-300">Save "${escapeHtml(q)}"</span>
                            <span class="text-[10px] text-slate-500 dark:text-slate-400 block">Add to Project_IOWMas table & load</span>
                        </div>
                    </div>
                    <button type="button" class="text-xs font-bold px-2.5 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-white shadow-2xs transition cursor-pointer">
                        + Add & Load
                    </button>
                </div>
            `);
            addEl.on("mousedown", function (e) {
                e.preventDefault();
                addNewSpecificationDirect(q);
            });
            itemsContainer.append(addEl);
        } else if (!matches || matches.length === 0) {
            itemsContainer.append(`<div class="p-2.5 text-slate-500 text-xs italic">No matching specifications found in IOWMas. Type your specification above to save to Project_IOWMas.</div>`);
        }

        dropdown.show();
    }

    function hideSpecAutocomplete() {
        $("#specAutocompleteDropdown").hide();
    }

    function addNewSpecificationDirect(specText) {
        var ctx = state.activeSpecContext;
        var wgId = ctx?.workGroupId;
        var currentRef = wgId ? (entryRowState[wgId]?.refNo || '') : '';
        var currentUnit = wgId ? (entryRowState[wgId]?.unitId || 'LS') : 'LS';
        var currentRate = wgId ? (parseFloat(entryRowState[wgId]?.rate) || 0) : 0;
        var projId = $('#ddlProject').val() || '1';

        $.ajax({
            url: '/ProjectIOW/SaveNewSpecification',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                CostcenterId: projId,
                ProectKickOfId: projId,
                WorkGroupId: wgId ? String(wgId) : null,
                RefNo: currentRef,
                SerialNo: currentRef,
                Specification: specText,
                UnitId: currentUnit,
                Rate: currentRate
            }),
            success: function (res) {
                var newLib = {
                    iowId: (res.success && res.data && res.data.Project_IOWId) ? res.data.Project_IOWId : Date.now(),
                    code: currentRef || 'NEW',
                    serialNo: currentRef || 'NEW',
                    workGroupName: 'CIVIL WORKS',
                    specification: specText,
                    unit: currentUnit,
                    unitId: currentUnit,
                    defaultRate: currentRate,
                    sourceTable: 'Project_IOWMas'
                };
                state.libraryIOWs.unshift(newLib);
                if (typeof renderLibraryIOWTable === 'function') renderLibraryIOWTable();
                selectLibrarySpecification(newLib);
                hideSpecAutocomplete();
                Swal.fire({
                    icon: 'success',
                    title: 'Saved to Project_IOWMas',
                    text: `"${specText}" added to Project_IOWMas & loaded!`,
                    timer: 1600,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            },
            error: function () {
                var newLib = {
                    iowId: Date.now(),
                    code: currentRef || 'NEW',
                    serialNo: currentRef || 'NEW',
                    workGroupName: 'CIVIL WORKS',
                    specification: specText,
                    unit: currentUnit,
                    unitId: currentUnit,
                    defaultRate: currentRate,
                    sourceTable: 'Project_IOWMas'
                };
                state.libraryIOWs.unshift(newLib);
                if (typeof renderLibraryIOWTable === 'function') renderLibraryIOWTable();
                selectLibrarySpecification(newLib);
                hideSpecAutocomplete();
            }
        });
    }

    function selectLibrarySpecification(libItem) {
        var ctx = state.activeSpecContext;
        if (!ctx) return;

        var spec = libItem.specification || '';
        var unit = libItem.unit || 'LS';
        var rate = Number(libItem.defaultRate || 0);

        if (ctx.isEntryRow) {
            updateEntryRowData(ctx.workGroupId, 'specification', spec);
            updateEntryRowData(ctx.workGroupId, 'unitId', unit);
            updateEntryRowData(ctx.workGroupId, 'rate', rate);

            if (entryRowState[ctx.workGroupId]) {
                entryRowState[ctx.workGroupId].isNewSpec = (libItem.sourceTable === 'Project_IOWMas');
                entryRowState[ctx.workGroupId].libraryIOWId = libItem.iowId;
                entryRowState[ctx.workGroupId].libraryWorkGroup = libItem.workGroupName || 'CIVIL WORKS';
                entryRowState[ctx.workGroupId].librarySerialNo = libItem.serialNo || libItem.code;
            }

            // Immediately display picked values in row inputs
            $(`#specInput_${ctx.workGroupId}`).val(spec);
            $(`#unitSelect_${ctx.workGroupId}`).val(unit);
            $(`#rateInput_${ctx.workGroupId}`).val(rate === 0 ? '0' : cleanNum(rate));

            var q = parseFloat(entryRowState[ctx.workGroupId].qty) || 0;
            var amt = q * rate;
            entryRowState[ctx.workGroupId].amount = amt;
            $(`#amountInput_${ctx.workGroupId}`).val(cleanCurrency(amt));

            hideSpecAutocomplete();

            var currentRef = entryRowState[ctx.workGroupId]?.refNo;
            if (!currentRef || currentRef.trim() === '') {
                var $refInput = $(`#refInput_${ctx.workGroupId}`);
                $refInput.focus();
            }
        } else if (ctx.iowId) {
            var it = state.items.find(i => i.iowId == ctx.iowId);
            if (it) {
                it.specification = spec;
                it.unitId = unit;
                it.rate = rate;
                it.isNewSpec = (libItem.sourceTable === 'Project_IOWMas');
                it.amount = (it.qty || 0) * rate;
                $(`.item-amount-val-${it.iowId}`).text(cleanCurrency(it.amount));
                $(`.item-rate-val-${it.iowId}`).val(cleanNum(rate));
            }
            hideSpecAutocomplete();
            recalculateOverallProject();
            renderMainDataGrid();
        }
    }

    function updateEntryRowData(wgId, field, val) {
        if (!entryRowState[wgId]) entryRowState[wgId] = { workGroupId: wgId };
        entryRowState[wgId][field] = val;

        var q = parseFloat(entryRowState[wgId].qty) || 0;
        var r = parseFloat(entryRowState[wgId].rate) || 0;
        entryRowState[wgId].amount = (q * r);
    }

    function updateItemDirect(iowId, prop, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it) return;

        if (prop === 'qty') {
            it.qty = parseFloat(val) || 0;
            it.amount = it.qty * (it.rate || 0);
            $(`.item-amount-val-${iowId}`).text(cleanCurrency(it.amount));
        } else if (prop === 'rate') {
            it.rate = parseFloat(val) || 0;
            it.amount = (it.qty || 0) * it.rate;
            $(`.item-amount-val-${iowId}`).text(cleanCurrency(it.amount));
        } else if (prop === 'refNo') {
            it.refNo = val;
        } else if (prop === 'specification') {
            it.specification = val;
            var match = (state.libraryIOWs || []).find(lib => 
                (lib.specification || '').trim().toLowerCase() === (val || '').trim().toLowerCase()
            );
            it.isNewSpec = !match;
        } else if (prop === 'unitId') {
            it.unitId = val;
        }

        recalculateOverallProject();
    }

    // ── STEP 6 — REFNO VALIDATION (Clean non-blocking toast, no infinite loops!) ──
    function triggerRefNoEmptyValidation(wgId) {
        var $refInput = $(`#refInput_${wgId}`);
        var $refBox = $(`#refBox_${wgId}`).length ? $(`#refBox_${wgId}`) : $refInput.closest('.grid-cell-box');

        $refInput.addClass("ref-empty-error");
        $refBox.addClass("ref-empty-error");
        $refInput.focus();

        Swal.fire({
            icon: 'warning',
            title: 'RefNo is Required',
            text: 'Please enter a RefNo before saving the item.',
            timer: 2200,
            showConfirmButton: false,
            toast: true,
            position: 'top-end'
        });
    }

    function saveEntryRow(wgId, callback) {
        var entry = entryRowState[wgId] || {};

        // STEP 6: RefNo cannot be empty
        if (!entry.refNo || !entry.refNo.trim()) {
            triggerRefNoEmptyValidation(wgId);
            return;
        }

        if (!entry.specification || !entry.specification.trim()) {
            Swal.fire({ icon: 'warning', text: 'Please enter Specification or select from library.' });
            return;
        }

        var specTrimmed = (entry.specification || '').trim();
        var matchLib = (state.libraryIOWs || []).find(lib => 
            (lib.specification || '').trim().toLowerCase() === specTrimmed.toLowerCase()
        );
        var isNew = !matchLib;

        var newId = Date.now();
        var q = parseFloat(entry.qty) || 0;
        var r = parseFloat(entry.rate) || 0;

        var targetWg = state.workgroups.find(w => w.workGroupId == wgId);
        var wgName = targetWg ? targetWg.workGroupName : '';

        var newItem = {
            iowId: newId,
            workGroupId: wgId,
            workGroupName: wgName,
            refNo: entry.refNo.trim(),
            serialNo: entry.refNo.trim(),
            specification: specTrimmed,
            unitId: entry.unitId || 'LS',
            qty: q,
            rate: r,
            amount: q * r,
            isNewSpec: isNew,
            libraryWorkGroup: entry.libraryWorkGroup || (matchLib ? matchLib.workGroupName : 'CIVIL WORKS'),
            librarySerialNo: entry.librarySerialNo || (matchLib ? (matchLib.serialNo || matchLib.code) : entry.refNo.trim()),
            librarySpecification: specTrimmed,
            workingQty: 1.0,
            wbsBreakdown: [],
            resources: [],
            totalWeightagePct: 0.0,
            wastageAmount: 0.0,
            loadingUnloading: 0.0,
            handlingCharges: 0.0,
            baseTotal: r,
            qualifierValue: 0.0,
            grandTotal: r,
            roundingOff: 0.0,
            netRate: r
        };

        // If specification is not present in library dropdown, save as new and add to state.libraryIOWs so it immediately appears in dropdown!
        if (isNew && specTrimmed.length > 0) {
            var newLibItem = {
                iowId: newId,
                code: entry.refNo.trim(),
                serialNo: entry.refNo.trim(),
                workGroupName: wgName || 'CIVIL WORKS',
                specification: specTrimmed,
                unit: entry.unitId || 'LS',
                unitId: entry.unitId || '9',
                defaultRate: r,
                sourceTable: 'Project_IOWMas'
            };
            state.libraryIOWs.unshift(newLibItem);
            if (typeof renderLibraryIOWTable === 'function') {
                renderLibraryIOWTable();
            }

            // Persist to dbo.Project_IOWMas
            var projId = $('#ddlProject').val() || '1';
            $.ajax({
                url: '/ProjectIOW/SaveNewSpecification',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    CostcenterId: projId,
                    ProectKickOfId: projId,
                    WorkGroupId: wgId ? String(wgId) : null,
                    RefNo: entry.refNo.trim(),
                    SerialNo: entry.refNo.trim(),
                    Specification: specTrimmed,
                    UnitId: entry.unitId || '9',
                    Rate: r
                })
            });
        }

        state.items.push(newItem);

        // Reset entry row
        entryRowState[wgId] = {
            workGroupId: wgId,
            refNo: '',
            specification: '',
            unitId: 'LS',
            qty: '0',
            rate: '',
            amount: '0'
        };

        recalculateOverallProject();
        renderMainDataGrid();

        if (callback) callback(newItem);
    }

    function deleteIOWItem(iowId) {
        state.items = state.items.filter(i => i.iowId != iowId);
        recalculateOverallProject();
        renderMainDataGrid();
    }

    // ── STEP 7 & STEPS 8–12 — WBS FLOW & DEFAULT INPUT ROW (img-6, img-8, img-9) ──
    function showMeasurementSheetTooltip(anchorEl, wgId, iowId) {
        var rect = anchorEl.getBoundingClientRect();
        var tooltip = $("#tooltipMeasurementSheet");
        tooltip.css({
            top: (rect.top - 34) + "px",
            left: rect.left + "px"
        }).show();

        tooltip.data("context", { wgId: wgId, iowId: iowId });
    }

    function confirmMeasurementSheet(isYes) {
        var tooltip = $("#tooltipMeasurementSheet");
        var ctx = tooltip.data("context");
        tooltip.hide();

        if (isYes && ctx) {
            if (ctx.iowId) {
                toggleDetailSection('item_' + ctx.iowId, 'wbs');
            } else if (ctx.wgId) {
                saveEntryRow(ctx.wgId, function (newItem) {
                    if (newItem) toggleDetailSection('item_' + newItem.iowId, 'wbs');
                });
            }
        }
    }

    function updateRowChevronIcons(iowId, isOpen, activeTab) {
        var rowIcon = document.getElementById('toggleIcon_' + iowId);
        var wbsIcon = document.getElementById('iconToggleWBS_' + iowId);
        var rateIcon = document.getElementById('iconToggleRate_' + iowId);

        if (rowIcon) {
            rowIcon.classList.toggle('fa-chevron-up', isOpen);
            rowIcon.classList.toggle('fa-chevron-down', !isOpen);
        }
        if (wbsIcon) {
            var isWbsOpen = isOpen && activeTab === 'wbs';
            wbsIcon.classList.toggle('fa-chevron-up', isWbsOpen);
            wbsIcon.classList.toggle('fa-chevron-down', !isWbsOpen);
        }
        if (rateIcon) {
            var isRateOpen = isOpen && activeTab === 'rate';
            rateIcon.classList.toggle('fa-chevron-up', isRateOpen);
            rateIcon.classList.toggle('fa-chevron-down', !isRateOpen);
        }
    }

    function toggleDetailRow(rowKey) {
        var iowId = parseInt(String(rowKey).replace('item_', ''));
        if (isNaN(iowId)) return;
        state.expandedIOWs = state.expandedIOWs || {};
        var isCurrentlyOpen = state.expandedIOWs[iowId] === true;

        // Collapse all other rows
        state.items.forEach(it => {
            if (it.iowId !== iowId) {
                state.expandedIOWs[it.iowId] = false;
                var r = document.getElementById('drawerRow_' + it.iowId);
                if (r) r.classList.add('hidden');
                updateRowChevronIcons(it.iowId, false, 'wbs');
            }
        });

        state.expandedIOWs[iowId] = !isCurrentlyOpen;
        var drawer = document.getElementById('drawerRow_' + iowId);
        var currentTab = itemActiveSection[iowId] || 'wbs';

        if (state.expandedIOWs[iowId]) {
            if (drawer) drawer.classList.remove('hidden');
            updateRowChevronIcons(iowId, true, currentTab);
            var item = state.items.find(it => it.iowId == iowId);
            if (item) {
                var wbsSec = document.getElementById('detailSectionWBS_' + iowId);
                var rateSec = document.getElementById('detailSectionRate_' + iowId);
                if (wbsSec) wbsSec.classList.toggle('hidden', currentTab !== 'wbs');
                if (rateSec) rateSec.classList.toggle('hidden', currentTab !== 'rate');
                renderWBSRows(item);
                renderCompactResourceTable(item);
            }
        } else {
            if (drawer) drawer.classList.add('hidden');
            updateRowChevronIcons(iowId, false, currentTab);
        }
    }

    function toggleDetailSection(rowKey, targetTab) {
        var iowId = parseInt(String(rowKey).replace('item_', ''));
        if (isNaN(iowId)) return;
        state.expandedIOWs = state.expandedIOWs || {};

        var isCurrentlyOpen = state.expandedIOWs[iowId] === true;
        var currentTab = itemActiveSection[iowId] || 'wbs';

        // If drawer is already open and clicked the same tab button, toggle (close) the drawer
        if (isCurrentlyOpen && currentTab === targetTab) {
            toggleDetailRow(rowKey);
            return;
        }

        itemActiveSection[iowId] = targetTab;

        // If drawer is not open, open it and close any other open drawer
        if (!isCurrentlyOpen) {
            state.items.forEach(it => {
                if (it.iowId !== iowId) {
                    state.expandedIOWs[it.iowId] = false;
                    var r = document.getElementById('drawerRow_' + it.iowId);
                    if (r) r.classList.add('hidden');
                    updateRowChevronIcons(it.iowId, false, 'wbs');
                }
            });

            state.expandedIOWs[iowId] = true;
            var drawer = document.getElementById('drawerRow_' + iowId);
            if (drawer) drawer.classList.remove('hidden');
        }

        updateRowChevronIcons(iowId, true, targetTab);

        // Switch visible tab inside drawer
        var wbsSec = document.getElementById('detailSectionWBS_' + iowId);
        var rateSec = document.getElementById('detailSectionRate_' + iowId);
        if (wbsSec) wbsSec.classList.toggle('hidden', targetTab !== 'wbs');
        if (rateSec) rateSec.classList.toggle('hidden', targetTab !== 'rate');

        var item = state.items.find(it => it.iowId == iowId);
        if (item) {
            if (targetTab === 'wbs') {
                renderWBSRows(item);
            } else {
                renderCompactResourceTable(item);
            }
        }
    }

    // Render WBS rows inside item drawer (img-8, img-9, Slice 6 & 9)
    // ALWAYS shows the Default Input Row matching user request!
    function renderWBSRows(item) {
        var container = document.getElementById("wbsRowsContainer_" + item.iowId);
        if (!container) return;
        container.innerHTML = "";

        // 1. Existing rows
        if (item.wbsBreakdown && item.wbsBreakdown.length > 0) {
            item.wbsBreakdown.forEach((w, idx) => {
                var row = document.createElement("div");
                row.className = "flex items-center justify-between border-b border-[#b8d7ee]/50 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-sky-50/50";
                row.innerHTML = `
                    <div class="flex items-center gap-2 flex-1 min-w-0 px-3 py-1.5">
                        <span class="w-4 h-4 rounded bg-sky-100 text-sky-700 font-bold text-[9px] flex items-center justify-center">${idx + 1}</span>
                        <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 truncate">${w.fullWBSName || w.wbsName}</span>
                    </div>
                    <div class="w-32 px-2 py-1 text-right">
                        <input type="number" step="any" value="${cleanNum(w.qty)}" 
                               oninput="updateWBSQty(${item.iowId}, ${idx}, this.value)" 
                               class="w-full text-xs font-bold font-mono py-0.5 px-2 border border-slate-300 dark:border-slate-600 rounded text-right bg-white dark:bg-slate-700 focus:outline-none focus:ring-1 focus:ring-sky-500" />
                    </div>
                    <div class="w-8 text-center px-1">
                        <button type="button" onclick="deleteWBSRow(${item.iowId}, ${idx})" class="text-slate-400 hover:text-rose-600 p-1 transition cursor-pointer" title="Remove WBS"><i class="fas fa-trash-alt text-xs"></i></button>
                    </div>
                `;
                container.appendChild(row);
            });
        }

        // 2. DEFAULT INPUT ROW (Matches zoom_slice_4 & zoom_slice_5: Always shown by default!)
        var inputRow = document.createElement("div");
        inputRow.className = "flex items-center justify-between bg-white dark:bg-slate-800 p-1 border-t border-[#b8d7ee]/50 dark:border-slate-700 relative";
        inputRow.innerHTML = `
            <div class="flex-1 relative pr-2">
                <input type="text" id="txtNewWBSName_${item.iowId}" 
                       placeholder="Select or type WBS..." 
                       autocomplete="off"
                       class="w-full text-xs font-semibold px-2.5 py-1 rounded border-2 border-slate-600 dark:border-slate-400 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-sky-500 wbs-input-target" 
                       onfocus="openWBSAutocomplete(this, ${item.iowId})" 
                       oninput="handleWBSInput(this, ${item.iowId})"
                       onkeydown="handleWBSNameKeydown(${item.iowId}, event)" />
            </div>
            <div class="w-32 text-right">
                <input type="number" step="any" id="txtNewWBSQty_${item.iowId}" 
                       placeholder="0" 
                       class="w-full text-xs font-mono font-bold text-right px-2 py-1 border-2 border-slate-600 dark:border-slate-400 rounded bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-sky-500" 
                       onkeydown="if(event.key === 'Enter') handleWBSCommit(${item.iowId})" 
                       onblur="handleWBSCommit(${item.iowId})" />
            </div>
            <div class="w-8 text-center flex items-center justify-center">
            </div>
        `;
        container.appendChild(inputRow);
    }

    // Floating WBS Dropdown under WBS Name Input (Slice 4 & 5)
    var wbsSearchDebounce = null;

    function openWBSAutocomplete(inputEl, iowId) {
        state.activeWBSInputContext = { inputEl: inputEl, iowId: iowId };
        showWBSAutocomplete(inputEl, inputEl.value || '');
    }

    function handleWBSInput(inputEl, iowId) {
        state.activeWBSInputContext = { inputEl: inputEl, iowId: iowId };
        var q = inputEl.value || '';
        showWBSAutocomplete(inputEl, q);

        clearTimeout(wbsSearchDebounce);
        wbsSearchDebounce = setTimeout(function () {
            var projId = $('#ddlProject').val() || '1';
            fetch('@Url.Action("GetProjectWBSList", "ProjectIOW")?projectId=' + projId + '&q=' + encodeURIComponent(q))
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.data && res.data.length > 0) {
                        res.data.forEach(d => {
                            if (!state.wbsList.some(w => w.wbsId == d.wbsId)) {
                                state.wbsList.push(d);
                            }
                        });
                        if (state.activeWBSInputContext?.inputEl === inputEl) {
                            showWBSAutocomplete(inputEl, inputEl.value || '');
                        }
                    }
                })
                .catch(err => console.log("WBS search error:", err));
        }, 150);
    }

    function showWBSAutocomplete(anchorEl, q) {
        var dropdown = $("#wbsAutocompleteDropdown");
        var itemsContainer = $("#wbsAutocompleteItems");
        itemsContainer.empty();

        var rect = anchorEl.getBoundingClientRect();
        dropdown.css({
            top: (rect.bottom + 2) + "px",
            left: rect.left + "px",
            width: Math.max(rect.width, 480) + "px"
        });

        var query = (q || '').trim().toLowerCase();
        var matches = (state.wbsList || []).filter(w => 
            (w.fullWBSName || '').toLowerCase().includes(query) || 
            (w.wbsName || '').toLowerCase().includes(query)
        );

        if (matches.length > 0) {
            matches.forEach((w, idx) => {
                var itemEl = $(`
                    <div class="wbs-drop-item px-3 py-2 hover:bg-sky-50 dark:hover:bg-slate-700 cursor-pointer flex items-center justify-between text-xs transition" data-idx="${idx}">
                        <div class="font-medium text-slate-800 dark:text-slate-200 flex-1 pr-2 truncate">
                            <i class="fas fa-folder text-sky-600 dark:text-sky-400 mr-2 text-[11px]"></i>
                            <span>${w.fullWBSName || w.wbsName}</span>
                        </div>
                        <span class="text-[9px] px-1.5 py-0.5 rounded bg-sky-100 dark:bg-sky-950/80 text-sky-700 dark:text-sky-300 font-bold uppercase tracking-wider">WBS</span>
                    </div>
                `);

                itemEl.on("mousedown", function (e) {
                    e.preventDefault();
                    selectWBSItem(w);
                });

                itemsContainer.append(itemEl);
            });
        } else {
            itemsContainer.append(`<div class="p-3 text-slate-500 dark:text-slate-400 text-xs italic">No matching WBS found. Press Enter to use "${escapeHtml(q)}".</div>`);
        }

        dropdown.show();
    }

    function hideWBSAutocomplete() {
        $("#wbsAutocompleteDropdown").hide();
    }

    function selectWBSItem(w) {
        var ctx = state.activeWBSInputContext;
        if (!ctx || !ctx.inputEl) return;

        var inputEl = ctx.inputEl;
        var iowId = ctx.iowId;

        inputEl.value = w.fullWBSName || w.wbsName;
        inputEl.dataset.wbsId = w.wbsId;
        inputEl.dataset.wbsName = w.wbsName;
        inputEl.dataset.fullWBSName = w.fullWBSName || w.wbsName;
        $(inputEl).removeClass("wbs-name-error");

        hideWBSAutocomplete();

        setTimeout(function () {
            var qtyEl = document.getElementById("txtNewWBSQty_" + iowId);
            if (qtyEl) qtyEl.focus();
        }, 50);
    }

    function handleWBSNameKeydown(iowId, e) {
        var dropdown = $("#wbsAutocompleteDropdown");
        if (e.key === 'Enter' || e.key === 'Tab') {
            if (dropdown.is(":visible")) {
                var firstItem = dropdown.find(".wbs-drop-item").first();
                if (firstItem.length && !$("#txtNewWBSName_" + iowId).val().trim()) {
                    firstItem.trigger("mousedown");
                    return;
                }
                hideWBSAutocomplete();
            }
            if (e.key === 'Enter') {
                e.preventDefault();
                $("#txtNewWBSQty_" + iowId).focus();
            }
        } else if (e.key === 'Escape') {
            hideWBSAutocomplete();
        }
    }

    // Save/Commit WBS Row from the Default Input Row
    function handleWBSCommit(iowId) {
        var txtName = document.getElementById("txtNewWBSName_" + iowId);
        var txtQty = document.getElementById("txtNewWBSQty_" + iowId);
        if (!txtName || !txtQty) return;

        var nameVal = txtName.value.trim();
        var qtyRaw = txtQty.value.trim();
        var qtyVal = parseFloat(qtyRaw);

        // If user entered quantity without WBS Name -> Highlight WBS Name in RED! (Image 5/Zoom 5)
        if (!nameVal && !isNaN(qtyVal) && qtyVal > 0) {
            $(txtName).addClass("wbs-name-error");
            setTimeout(function () {
                txtName.focus();
            }, 50);
            return;
        }

        // If both WBS Name and Qty are valid (> 0):
        if (nameVal && !isNaN(qtyVal) && qtyVal > 0) {
            $(txtName).removeClass("wbs-name-error");

            var item = state.items.find(i => i.iowId == iowId);
            if (!item) return;

            if (!item.wbsBreakdown) item.wbsBreakdown = [];

            var wbsId = txtName.dataset.wbsId ? parseInt(txtName.dataset.wbsId) : (Date.now() % 10000);
            var fullWBSName = txtName.dataset.fullWBSName || nameVal;

            var existing = item.wbsBreakdown.find(w => w.wbsId == wbsId || w.fullWBSName === fullWBSName);
            if (existing) {
                existing.qty = (parseFloat(existing.qty) || 0) + qtyVal;
            } else {
                item.wbsBreakdown.push({
                    wbsId: wbsId,
                    wbsName: txtName.dataset.wbsName || nameVal,
                    fullWBSName: fullWBSName,
                    qty: qtyVal
                });
            }

            renderWBSRows(item);
            updateWBSTotalAndSync(item);

            setTimeout(function () {
                var nextInput = document.getElementById("txtNewWBSName_" + iowId);
                if (nextInput) nextInput.focus();
            }, 50);
        }
    }

    function updateWBSQty(iowId, idx, val) {
        var item = state.items.find(i => i.iowId == iowId);
        if (!item || !item.wbsBreakdown[idx]) return;

        item.wbsBreakdown[idx].qty = parseFloat(val) || 0;
        updateWBSTotalAndSync(item);
    }

    function deleteWBSRow(iowId, idx) {
        var item = state.items.find(i => i.iowId == iowId);
        if (!item) return;
        item.wbsBreakdown.splice(idx, 1);
        renderWBSRows(item);
        updateWBSTotalAndSync(item);
    }

    // STEP 12: Calculate WBS Total and synchronize back to parent row Qty & Amount
    function updateWBSTotalAndSync(item) {
        var sum = (item.wbsBreakdown || []).reduce((acc, w) => acc + (parseFloat(w.qty) || 0), 0);
        item.qty = sum;
        item.amount = sum * (item.rate || 0);

        var lbl = document.getElementById("lblWBSTotalQty_" + item.iowId);
        if (lbl) lbl.innerText = cleanNum(sum);

        $(`.item-qty-val-${item.iowId}`).val(cleanNum(sum));
        $(`.item-amount-val-${item.iowId}`).text(cleanCurrency(item.amount));

        recalculateOverallProject();
    }

    // WBS PickList Modal
    function openWBSPickListModal(item) {
        state.activeIOWForWBS = item;
        renderWBSPickListTable();
        document.getElementById("modalWBSOverlay").style.display = "flex";
        document.getElementById("modalWBSOverlay").classList.remove("hidden");
    }

    function closeWBSPickListModal() {
        document.getElementById("modalWBSOverlay").style.display = "none";
        document.getElementById("modalWBSOverlay").classList.add("hidden");
    }

    function renderWBSPickListTable() {
        var tbody = document.getElementById("tblWBSPickListBody");
        if (!tbody) return;
        tbody.innerHTML = "";

        var q = (document.getElementById("txtWBSFilter").value || '').toLowerCase();
        var filtered = state.wbsList.filter(w => (w.fullWBSName || w.wbsName || '').toLowerCase().includes(q));

        var activeItem = state.activeIOWForWBS;
        var existingWBSIds = (activeItem && activeItem.wbsBreakdown) ? activeItem.wbsBreakdown.map(w => w.wbsId) : [];

        filtered.forEach(w => {
            var isChecked = existingWBSIds.includes(w.wbsId);
            var tr = document.createElement("tr");
            tr.className = `hover:bg-sky-50 dark:hover:bg-slate-700 transition cursor-pointer ${isChecked ? 'highlight-green' : ''}`;
            tr.innerHTML = `
                <td class="py-1.5 px-3 w-10 text-center">
                    <input type="checkbox" value="${w.wbsId}" ${isChecked ? 'checked' : ''} onchange="toggleWBSCheck(this)" class="wbs-pick-chk rounded text-sky-600 cursor-pointer" />
                </td>
                <td class="py-1.5 px-3 font-bold text-slate-800 dark:text-slate-200">${w.fullWBSName || w.wbsName}</td>
            `;
            tbody.appendChild(tr);
        });

        document.getElementById("lblWBSCountInfo").innerText = `1-${filtered.length} of ${filtered.length}`;
    }

    function toggleWBSCheck(chk) {
        var tr = chk.closest("tr");
        if (chk.checked) tr.classList.add("highlight-green");
        else tr.classList.remove("highlight-green");
    }

    function filterWBSPickList() {
        renderWBSPickListTable();
        var q = (document.getElementById("txtWBSFilter").value || '').trim();
        if (q.length > 0) {
            var projId = $('#ddlProject').val() || '1';
            fetch('@Url.Action("GetProjectWBSList", "ProjectIOW")?projectId=' + projId + '&q=' + encodeURIComponent(q))
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.data && res.data.length > 0) {
                        res.data.forEach(d => {
                            if (!state.wbsList.some(w => w.wbsId == d.wbsId)) {
                                state.wbsList.push(d);
                            }
                        });
                        renderWBSPickListTable();
                    }
                });
        }
    }

    function applySelectedWBSToActiveIOW() {
        var item = state.activeIOWForWBS;
        if (!item) return;

        var selectedIds = [];
        document.querySelectorAll(".wbs-pick-chk:checked").forEach(c => selectedIds.push(parseInt(c.value)));

        if (!item.wbsBreakdown) item.wbsBreakdown = [];

        var newBreakdown = [];
        selectedIds.forEach(id => {
            var existing = item.wbsBreakdown.find(w => w.wbsId == id);
            if (existing) {
                newBreakdown.push(existing);
            } else {
                var wObj = state.wbsList.find(w => w.wbsId == id);
                if (wObj) {
                    newBreakdown.push({
                        wbsId: id,
                        wbsName: wObj.wbsName,
                        fullWBSName: wObj.fullWBSName || wObj.wbsName,
                        qty: 0.0
                    });
                }
            }
        });

        item.wbsBreakdown = newBreakdown;
        closeWBSPickListModal();
        renderWBSRows(item);
        updateWBSTotalAndSync(item);
    }

    // ── STEP 14 — RESOURCE RATE CALCULATION (img-14+) ──
    function openResourcePickListModal(iowId) {
        state.activeIOWForResource = iowId || (state.items.length > 0 ? state.items[0].iowId : null);
        renderResourcePickListTable();
        document.getElementById("modalResourceOverlay").style.display = "flex";
        document.getElementById("modalResourceOverlay").classList.remove("hidden");
    }

    function closeResourcePickListModal() {
        document.getElementById("modalResourceOverlay").style.display = "none";
        document.getElementById("modalResourceOverlay").classList.add("hidden");
    }

    function switchResourceModalTab(tab) {
        var btnRes = document.getElementById("tabBtnResource");
        var btnIOW = document.getElementById("tabBtnIOW");
        if (tab === 'Resource') {
            btnRes.className = "py-1.5 px-3 text-xs font-bold border-b-2 border-teal-500 text-teal-600 dark:text-teal-400";
            btnIOW.className = "py-1.5 px-3 text-xs font-semibold text-slate-500 hover:text-slate-700 border-b-2 border-transparent";
            renderResourcePickListTable();
        } else {
            btnIOW.className = "py-1.5 px-3 text-xs font-bold border-b-2 border-teal-500 text-teal-600 dark:text-teal-400";
            btnRes.className = "py-1.5 px-3 text-xs font-semibold text-slate-500 hover:text-slate-700 border-b-2 border-transparent";
        }
    }

    function renderResourcePickListTable() {
        var tbody = document.getElementById("tblResourcePickListBody");
        if (!tbody) return;
        tbody.innerHTML = "";

        var codeFil = (document.getElementById("filResCode")?.value || "").toLowerCase();
        var nameFil = (document.getElementById("filResName")?.value || "").toLowerCase();
        var typeFil = (document.getElementById("filResType")?.value || "").toLowerCase();
        var groupFil = (document.getElementById("filResGroup")?.value || "").toLowerCase();

        var filtered = state.resources.filter(r => {
            return (r.code || "").toLowerCase().includes(codeFil) &&
                   (r.resourceName || "").toLowerCase().includes(nameFil) &&
                   (r.type || "").toLowerCase().includes(typeFil) &&
                   (r.resourceGroup || "").toLowerCase().includes(groupFil);
        });

        filtered.forEach(res => {
            var tr = document.createElement("tr");
            tr.className = "hover:bg-teal-50 dark:hover:bg-slate-700 transition cursor-pointer";
            tr.innerHTML = `
                <td class="py-1.5 px-3 text-center">
                    <input type="checkbox" value="${res.code}" onchange="toggleResourceRowHighlight(this)" class="res-check rounded text-teal-600 cursor-pointer" />
                </td>
                <td class="py-1.5 px-3 font-bold text-slate-800 dark:text-slate-200">${res.code}</td>
                <td class="py-1.5 px-3 font-semibold text-slate-700 dark:text-slate-300">${res.resourceName}</td>
                <td class="py-1.5 px-3 font-medium text-slate-600 dark:text-slate-400">${res.unit}</td>
                <td class="py-1.5 px-3 font-semibold text-teal-600">${res.type}</td>
                <td class="py-1.5 px-3 text-slate-600 dark:text-slate-400">${res.resourceGroup}</td>
            `;
            tbody.appendChild(tr);
        });

        document.getElementById("lblResPageInfo").innerText = `1-${filtered.length} of ${filtered.length}`;
    }

    function toggleResourceRowHighlight(chk) {
        var tr = chk.closest("tr");
        if (chk.checked) tr.classList.add("highlight-green");
        else tr.classList.remove("highlight-green");
    }

    function toggleSelectAllResources(masterChk) {
        document.querySelectorAll(".res-check").forEach(chk => {
            chk.checked = masterChk.checked;
            toggleResourceRowHighlight(chk);
        });
    }

    function filterResourcePickList() {
        renderResourcePickListTable();
    }

    function applySelectedResourcesToActiveIOW() {
        var targetIOW = state.items.find(i => i.iowId === state.activeIOWForResource);
        if (!targetIOW) {
            Swal.fire({ icon: 'info', text: 'Please select an IOW row first.' });
            return;
        }

        var selectedCodes = [];
        document.querySelectorAll(".res-check:checked").forEach(chk => selectedCodes.push(chk.value));

        if (selectedCodes.length === 0) {
            closeResourcePickListModal();
            return;
        }

        if (!targetIOW.resources) targetIOW.resources = [];

        selectedCodes.forEach(code => {
            var rData = state.resources.find(r => r.code === code);
            if (rData) {
                var nextRefNo = 'C' + (targetIOW.resources.length + 1);
                targetIOW.resources.push({
                    resourceDetailId: Date.now() + Math.random(),
                    incExc: true,
                    refNo: nextRefNo,
                    type: rData.type === 'Activity' ? 'AC' : (rData.type === 'Material' ? 'MT' : 'EQ'),
                    resourceId: rData.resourceId,
                    resourceCode: rData.code,
                    resourceName: rData.code + ' ' + rData.resourceName,
                    coefficient: 1.0,
                    unitId: rData.unit || 'LS',
                    rate: rData.rate || 0,
                    amount: rData.rate || 0,
                    weightagePct: 0.0,
                    wastagePct: 0.0
                });
            }
        });

        closeResourcePickListModal();
        renderCompactResourceTable(targetIOW);
        recalculateResourceRate(targetIOW);
    }

    // Render Compact Table for Resources with Row-Level Weightage % (Image 15)
    function renderCompactResourceTable(item) {
        var container = document.getElementById("resourceTableContainer_" + item.iowId);
        if (!container) return;

        if (!item.resources || item.resources.length === 0) {
            container.innerHTML = `<div class="p-3 text-slate-500 text-xs italic bg-white dark:bg-slate-800">No resources assigned. Click <b>Resource/IOW PickList</b> above to add resources.</div>`;
            return;
        }

        var html = `
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="bg-[#ebf5fa] dark:bg-slate-800 text-sky-950 dark:text-sky-200 font-bold border-b border-sky-200 dark:border-slate-700">
                        <th class="py-1 px-2 w-14 text-center">Inc/Exc</th>
                        <th class="py-1 px-2 w-12 text-center">RefNo</th>
                        <th class="py-1 px-2 w-12">Type</th>
                        <th class="py-1 px-3">Resource & Weightage %</th>
                        <th class="py-1 px-2 w-20 text-right">Coefficient</th>
                        <th class="py-1 px-2 w-14">Unit</th>
                        <th class="py-1 px-2 w-24 text-right">Rate (₹)</th>
                        <th class="py-1 px-2 w-24 text-right">Amount (₹)</th>
                        <th class="py-1 px-2 w-10 text-center"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
        `;

        item.resources.forEach((r, idx) => {
            html += `
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/80 transition">
                    <td class="py-1 px-2 text-center">
                        <label class="switch-inc-exc">
                            <input type="checkbox" ${r.incExc ? 'checked' : ''} onchange="toggleResourceIncExc(${item.iowId}, ${idx}, this.checked)">
                            <span class="slider-inc-exc"></span>
                        </label>
                    </td>
                    <td class="py-1 px-2 text-center font-bold text-slate-600 dark:text-slate-400 font-mono">${r.refNo || ('C' + (idx + 1))}</td>
                    <td class="py-1 px-2 font-bold text-teal-700 dark:text-teal-300 font-mono">${r.type || 'AC'}</td>
                    <td class="py-1 px-3">
                        <div class="space-y-0.5">
                            <span class="font-semibold text-slate-800 dark:text-slate-200">${r.resourceName}</span>
                            <div class="flex items-center gap-1 text-[11px] text-slate-500">
                                <span>Weightage %:</span>
                                <input type="number" step="any" min="0" max="100" value="${cleanNum(r.weightagePct)}" oninput="updateResourceWeightage(${item.iowId}, ${idx}, this.value)" class="w-14 px-1 py-0.5 border border-slate-300 rounded text-right bg-white dark:bg-slate-700 font-mono text-[11px]" />
                            </div>
                        </div>
                    </td>
                    <td class="py-1 px-2 text-right">
                        <input type="number" step="any" value="${cleanNum(r.coefficient != null ? r.coefficient : 1.0)}" oninput="updateResourceCoeff(${item.iowId}, ${idx}, this.value)" class="w-16 px-1 py-0.5 border border-slate-300 rounded text-right font-mono text-xs bg-white dark:bg-slate-700" />
                    </td>
                    <td class="py-1 px-2 text-slate-600 font-medium">${r.unitId || 'LS'}</td>
                    <td class="py-1 px-2 text-right">
                        <input type="number" step="any" value="${cleanNum(r.rate)}" oninput="updateResourceRateDirect(${item.iowId}, ${idx}, this.value)" class="w-20 px-1 py-0.5 border border-slate-300 rounded text-right font-mono text-xs bg-white dark:bg-slate-700" />
                    </td>
                    <td class="py-1 px-2 text-right font-bold text-emerald-600 dark:text-emerald-400 font-mono">
                        ₹ ${cleanCurrency(r.amount)}
                    </td>
                    <td class="py-1 px-2 text-center">
                        <button type="button" onclick="deleteResourceRow(${item.iowId}, ${idx})" class="text-slate-400 hover:text-rose-600 p-1 transition cursor-pointer" title="Delete Resource"><i class="fas fa-trash-alt text-xs"></i></button>
                    </td>
                </tr>
            `;
        });

        html += `</tbody></table>`;
        container.innerHTML = html;
    }

    function toggleResourceIncExc(iowId, idx, isChecked) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it || !it.resources[idx]) return;
        it.resources[idx].incExc = isChecked;
        it.resources[idx].amount = isChecked ? ((it.resources[idx].coefficient || 1.0) * (it.resources[idx].rate || 0)) : 0;
        renderCompactResourceTable(it);
        recalculateResourceRate(it);
    }

    function updateResourceWeightage(iowId, idx, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it || !it.resources[idx]) return;
        it.resources[idx].weightagePct = parseFloat(val) || 0;
        recalculateResourceRate(it);
    }

    function updateResourceCoeff(iowId, idx, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it || !it.resources[idx]) return;
        var c = parseFloat(val) || 0;
        it.resources[idx].coefficient = c;
        if (it.resources[idx].incExc) it.resources[idx].amount = c * (it.resources[idx].rate || 0);
        renderCompactResourceTable(it);
        recalculateResourceRate(it);
    }

    function updateResourceRateDirect(iowId, idx, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it || !it.resources[idx]) return;
        var r = parseFloat(val) || 0;
        it.resources[idx].rate = r;
        if (it.resources[idx].incExc) it.resources[idx].amount = (it.resources[idx].coefficient || 1.0) * r;
        renderCompactResourceTable(it);
        recalculateResourceRate(it);
    }

    function deleteResourceRow(iowId, idx) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it) return;
        it.resources.splice(idx, 1);
        renderCompactResourceTable(it);
        recalculateResourceRate(it);
    }

    function updateWorkingQty(iowId, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it) return;
        it.workingQty = parseFloat(val) || 1.0;
        recalculateResourceRate(it);
    }

    function updateItemCalculation(iowId, field, val) {
        var it = state.items.find(i => i.iowId == iowId);
        if (!it) return;
        it[field] = parseFloat(val) || 0;
        recalculateResourceRate(it);
    }

    // STEP 14: Rate Calculation & Auto-synchronization to parent item row's Rate column
    function recalculateResourceRate(item) {
        var totalWeightage = (item.resources || []).reduce((acc, r) => acc + (parseFloat(r.weightagePct) || 0), 0);
        var baseTotal = (item.resources || []).reduce((acc, r) => acc + (r.incExc ? (parseFloat(r.amount) || 0) : 0), 0);

        item.totalWeightagePct = totalWeightage;
        item.baseTotal = baseTotal;

        var qual = parseFloat(item.qualifierValue) || 0;
        var grandTotal = baseTotal + qual;
        item.grandTotal = grandTotal;

        var workQty = parseFloat(item.workingQty) || 1.0;
        if (workQty <= 0) workQty = 1.0;

        var netRate = (grandTotal / workQty) + (parseFloat(item.roundingOff) || 0);
        item.netRate = netRate;

        // Auto-sync Net Rate to parent item row's Rate column!
        item.rate = netRate;
        item.amount = (item.qty || 0) * netRate;

        var lblWeight = document.getElementById("lblTotalWeightage_" + item.iowId);
        if (lblWeight) lblWeight.value = cleanNum(totalWeightage) + " %";

        var elBase = document.getElementById("calcBaseTotal_" + item.iowId);
        if (elBase) elBase.innerText = "₹ " + cleanCurrency(baseTotal);

        var elGrand = document.getElementById("calcGrandTotal_" + item.iowId);
        if (elGrand) elGrand.innerText = "₹ " + cleanCurrency(grandTotal);

        var elBaseRate = document.getElementById("calcBaseRate_" + item.iowId);
        if (elBaseRate) elBaseRate.innerText = "₹ " + cleanCurrency(baseTotal);

        var elIOWRate = document.getElementById("calcIOWRate_" + item.iowId);
        if (elIOWRate) elIOWRate.innerText = "₹ " + cleanCurrency(netRate);

        var elNet = document.getElementById("calcNetRate_" + item.iowId);
        if (elNet) elNet.innerText = "₹ " + cleanCurrency(netRate);

        $(`.item-rate-val-${item.iowId}`).val(cleanNum(netRate));
        $(`.item-amount-val-${item.iowId}`).text(cleanCurrency(item.amount));

        recalculateOverallProject();
    }

    // ── OVERALL TOTAL RECALCULATION ──
    function recalculateOverallProject() {
        var grandTotal = state.items.reduce((acc, it) => acc + (parseFloat(it.amount) || 0), 0);
        state.header.totalAmount = grandTotal;

        var formatted = cleanCurrency(grandTotal);
        var el = document.getElementById("lblGridTotalAmount");
        if (el) el.innerText = formatted;
    }

    // ── MODAL 4: LIBRARY IOWS TABLE ──
    function openLibraryIOWModal(wgId) {
        renderLibraryIOWTable();
        document.getElementById("modalLibraryIOWOverlay").style.display = "flex";
        document.getElementById("modalLibraryIOWOverlay").classList.remove("hidden");
    }

    function closeLibraryIOWModal() {
        document.getElementById("modalLibraryIOWOverlay").style.display = "none";
        document.getElementById("modalLibraryIOWOverlay").classList.add("hidden");
    }

    function renderLibraryIOWTable() {
        var tbody = document.getElementById("tblLibraryIOWBody");
        if (!tbody) return;
        tbody.innerHTML = "";

        var q = (document.getElementById("txtLibrarySearch").value || '').toLowerCase();
        var filtered = state.libraryIOWs.filter(lib => 
            (lib.specification || '').toLowerCase().includes(q) || 
            (lib.code || '').toLowerCase().includes(q) || 
            (lib.serialNo || '').toLowerCase().includes(q) ||
            (lib.sourceTable || '').toLowerCase().includes(q)
        );

        filtered.forEach(lib => {
            var tr = document.createElement("tr");
            tr.className = "hover:bg-emerald-50/70 dark:hover:bg-slate-700/60 transition";
            var sourceBadge = (lib.sourceTable === 'Project_IOWMas')
                ? `<span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-bold bg-purple-100 dark:bg-purple-950/70 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800 whitespace-nowrap">Project_IOWMas</span>`
                : `<span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-bold bg-sky-100 dark:bg-sky-950/70 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800 whitespace-nowrap">IOWMas</span>`;

            tr.innerHTML = `
                <td class="py-1.5 px-3 font-bold text-slate-800 dark:text-slate-200">${lib.code || lib.serialNo || ''}</td>
                <td class="py-1.5 px-3">${sourceBadge}</td>
                <td class="py-1.5 px-3 text-slate-600 dark:text-slate-300">${lib.workGroupName || 'CIVIL WORKS'}</td>
                <td class="py-1.5 px-3 font-semibold text-slate-800 dark:text-slate-200">${lib.specification}</td>
                <td class="py-1.5 px-3 font-medium text-slate-600 dark:text-slate-300">${lib.unit || 'LS'}</td>
                <td class="py-1.5 px-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">₹ ${cleanCurrency(lib.defaultRate || 0)}</td>
                <td class="py-1.5 px-3 text-center">
                    <button type="button" onclick='pickLibraryIOWDirect(${JSON.stringify(lib)})' class="px-2.5 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-2xs transition cursor-pointer">
                        Select
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function pickLibraryIOWDirect(lib) {
        closeLibraryIOWModal();

        if (!state.selectedWorkgroups || state.selectedWorkgroups.length === 0) {
            if (state.workgroups.length > 0) {
                selectWorkGroupWithHierarchy(state.workgroups[0].workGroupId);
            }
        }

        var activeWg = state.selectedWorkgroups[state.selectedWorkgroups.length - 1];
        if (activeWg) {
            // STEP 6: Validate RefNo is not empty
            var currRef = entryRowState[activeWg.workGroupId]?.refNo;
            if (!currRef || currRef.trim() === '') {
                // If RefNo is empty, prefill RefNo with library serialNo or alert
                entryRowState[activeWg.workGroupId] = entryRowState[activeWg.workGroupId] || {};
                entryRowState[activeWg.workGroupId].refNo = lib.serialNo || lib.code || '123';
            }
            state.activeSpecContext = { workGroupId: activeWg.workGroupId, isEntryRow: true };
            selectLibrarySpecification(lib);
        }
    }

    function filterLibraryIOWList() {
        renderLibraryIOWTable();
    }

    function openWBSMasterModal() {
        if (state.items.length > 0) openWBSPickListModal(state.items[0]);
        else Swal.fire({ icon: 'info', text: 'Please add an item to configure WBS.' });
    }

    function resetEntireForm() {
        Swal.fire({
            title: 'Reset Form?',
            text: 'All entered items and breakdowns will be cleared.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0284c7',
            cancelButtonColor: '#ef4444',
            confirmButtonText: 'Yes, Reset'
        }).then((result) => {
            if (result.isConfirmed) {
                state.selectedWorkgroups = [];
                state.items = [];
                entryRowState = {};
                state.collapsedWorkgroups = {};
                recalculateOverallProject();
                renderMainDataGrid();
            }
        });
    }

    // ── FINAL SAVE — OUTPUT COMPLETE COLLECTED VALUES AS JSON ──
    function submitProjectIOW() {
        var header = {
            ReferenceDate: state.header.referenceDate || document.getElementById("txtReferenceDate").value,
            ReferenceNo: state.header.referenceNo || document.getElementById("txtReferenceNo").value,
            ProjectKickoffId: state.header.projectKickoffId || document.getElementById("ddlProject").value,
            ProjectName: state.header.projectName || $("#ddlProject option:selected").text(),
            Type: document.getElementById("ddlType").value,
            Revision: document.getElementById("ddlRevision").value,
            ReadyForApproval: document.getElementById("chkReadyForApproval").checked,
            Remarks: document.getElementById("txtMainRemarks").value,
            TotalAmount: state.header.totalAmount,
            CreatedBy: 'Admin',
            CreatedDate: new Date().toISOString()
        };

        var fullPayload = {
            Header: header,
            WorkGroups: state.selectedWorkgroups.map(w => ({
                WorkGroupId: w.workGroupId,
                SerialNo: w.serialNo,
                WorkGroupName: w.workGroupName,
                ParentId: w.parentId || '0',
                ParentName: w.parentName || 'Root'
            })),
            Items: state.items.map(it => ({
                IOWId: it.iowId,
                WorkGroupId: it.workGroupId,
                WorkGroupName: it.workGroupName,
                RefNo: it.refNo,
                SerialNo: it.serialNo,
                Specification: it.specification,
                Unit: it.unitId,
                Qty: it.qty,
                Rate: it.rate,
                Amount: it.amount,
                IsNewSpec: it.isNewSpec === true,
                WBSBreakdown: (it.wbsBreakdown || []).map(w => ({
                    WBSId: w.wbsId,
                    WBSName: w.wbsName,
                    FullWBSName: w.fullWBSName,
                    Qty: w.qty
                })),
                Resources: (it.resources || []).map(r => ({
                    RefNo: r.refNo,
                    Type: r.type,
                    ResourceCode: r.resourceCode,
                    ResourceName: r.resourceName,
                    IncExc: r.incExc !== false,
                    Coefficient: r.coefficient,
                    Unit: r.unitId,
                    Rate: r.rate,
                    Amount: r.amount,
                    WeightagePct: r.weightagePct || 0,
                    WastagePct: r.wastagePct || 0
                })),
                Calculations: {
                    TotalWeightagePct: it.totalWeightagePct || 0,
                    WastageAmount: it.wastageAmount || 0,
                    LoadingUnloading: it.loadingUnloading || 0,
                    HandlingCharges: it.handlingCharges || 0,
                    BaseTotal: it.baseTotal || 0,
                    QualifierValue: it.qualifierValue || 0,
                    GrandTotal: it.grandTotal || 0,
                    RoundingOff: it.roundingOff || 0,
                    NetRate: it.netRate || 0
                }
            }))
        };

        var jsonString = JSON.stringify(fullPayload, null, 2);

        var resCount = state.items.reduce((acc, i) => acc + (i.resources?.length || 0), 0);
        var formattedTotal = cleanCurrency(state.header.totalAmount || 0);

        var modalEl = document.getElementById("modalBOQJsonPayload");
        var countEl = document.getElementById("payloadModalItemCount");
        var resEl = document.getElementById("payloadModalResCount");
        var amtEl = document.getElementById("payloadModalTotalAmount");
        var jsonEl = document.getElementById("txtThemedJsonContent");

        if (countEl) countEl.innerText = state.items.length;
        if (resEl) resEl.innerText = resCount;
        if (amtEl) amtEl.innerText = "₹ " + formattedTotal;
        if (jsonEl) jsonEl.innerText = jsonString;

        if (modalEl) {
            modalEl.style.display = "flex";
            modalEl.classList.remove("hidden");
        }
    }

    function closeBOQJsonModal() {
        var modalEl = document.getElementById("modalBOQJsonPayload");
        if (modalEl) {
            modalEl.style.display = "none";
            modalEl.classList.add("hidden");
        }
    }

    function copyBOQJsonToClipboard() {
        var jsonEl = document.getElementById("txtThemedJsonContent");
        if (!jsonEl) return;
        var text = jsonEl.innerText;
        navigator.clipboard.writeText(text).then(function () {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'BOQ JSON copied to clipboard!',
                showConfirmButton: false,
                timer: 2000
            });
        }).catch(function (err) {
            console.error("Copy failed", err);
        });
    }
</script>
