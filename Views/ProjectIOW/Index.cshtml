    function promptMeasurementSheet(iowId, targetType, targetIdx, onNoCallback, onFinishedCallback) {
        var it = state.items.find(function (i) { return i.iowId == iowId; });

        // Ensure Reference No. before opening measurement sheet!
        if (it) ensureItemHasRefNo(it);

        var targetLabel = "Quantity";
        if (targetType === 'item') {
            targetLabel = "BOQ Item #" + (it ? (it.refNo || it.specification || iowId) : iowId);
        } else if (targetType === 'wbs') {
            var wbsTitle = (it && it.wbsBreakdown && it.wbsBreakdown[targetIdx]) ? (it.wbsBreakdown[targetIdx].fullWBSName || it.wbsBreakdown[targetIdx].wbsName) : 'WBS Row';
            targetLabel = "WBS: " + wbsTitle;
        } else if (targetType === 'newWbs') {
            targetLabel = "New WBS Row for " + (it ? (it.specification || 'Item') : 'Item');
